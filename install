#!/bin/sh
set -e

. ./YMIR_VERSION

YMIR_SHORT_VERSION=$(echo "$YMIR_BOOTSTRAP_VERSION" | cut -d. -f1,2)
GCC_MAJOR_VERSION=$(echo "$GCC_VERSION" | cut -d. -f1)

rm -rf "/usr/include/ymir/${YMIR_SHORT_VERSION}"
mkdir -p "/usr/include/ymir/${YMIR_SHORT_VERSION}"
cd midgard
find * -regex '.*\.\(yr\)$' | cpio -updm "/usr/include/ymir/${YMIR_SHORT_VERSION}"

cd ..
rm -rf "/usr/libexec/gcc/x86_64-linux-gnu/${GCC_MAJOR_VERSION}/include/ymir/${YMIR_SHORT_VERSION}"
mkdir -p "/usr/libexec/gcc/x86_64-linux-gnu/${GCC_MAJOR_VERSION}/include/ymir/${YMIR_SHORT_VERSION}"
cd midgard/
find * -regex '.*\.\(yr\)$' | cpio -updm "/usr/libexec/gcc/x86_64-linux-gnu/${GCC_MAJOR_VERSION}/include/ymir/${YMIR_SHORT_VERSION}"
