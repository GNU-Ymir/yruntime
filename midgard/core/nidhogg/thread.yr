/**
 * The threads: their registration, the handshake through which the collector interrupts a few of
 * them at a time, the rounds the collector makes over them, and their allocations.
 *
 * In a handshake the thread does what the collector asks of it in the handler of the handshake
 * signal, the top of its stack recorded: it copies its stack and its grey objects for the collector
 * to scan, or hands its spans back, taking no lock, then goes on. Only when it cannot does it park,
 * sleeping on a futex until the collector, which does it meanwhile, lets it go. A thread parked may
 * hold any lock: the collector takes none until it lets it go, and never waits for one thread while
 * another is parked. A thread interrupted in a write barrier or an assist parks once it is done, so
 * that none is ever parked with an object shaded but not in its grey buffer yet.
 */
in thread;

use core::nidhogg::{heap, mark, state, sys, thread_state};

/**
 * The flag of an allocation holding no pointer
 * */
pub def NOSCAN = 1u8;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===============================          REGISTRATION          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Make the calling thread known to the collector, its stack and its TLS block being scanned from
 * then on, until it ends
 * @returns: its state
 * */
@{nogc, unsafe}
pub fn register ()-> usize {
    let current = _yrt_i_nh_get_self ();
    if (current != 0us) return current;

    let g = G ();
    let ts = calloc (1us, ThreadState::size);
    if (ts == 0us) {
        fatal ("nidhogg: out of memory for the collector metadata\n");
    }

    let dmut t = thread (ts);
    {
        (*t).thread = _yrt_i_nh_thread_self ();
        _yrt_i_nh_stack_bounds (cast!usize (&((*t).stackLo)), cast!usize (&((*t).stackHi)));
        _yrt_i_nh_tls_bounds (cast!usize (&((*t).tlsLo)), cast!usize (&((*t).tlsHi)));
        (*t).cache = words (NLISTS);
        (*t).returned = words (NLISTS);
        (*t).grey = words (GREY_WORDS);

        _yrt_i_nh_mutex_lock ((*g).threadsLock);
        (*t).next = ld ((*g).threads);
        if ((*t).next != 0us) {
            let dmut n = thread ((*t).next);
            (*n).prev = ts;
        }

        st ((*g).threads, ts);
        _yrt_i_nh_set_self (ts);
        _yrt_i_nh_mutex_unlock ((*g).threadsLock);
    }

    _yrt_i_nh_set_thread_key (ts);
    ts
}

/**
 * Forget the thread whose state is `ts`, which ends
 * */
@nogc
pub extern (C) fn _yrt_i_nh_thread_exit (ts: usize) {
    if (ts == 0us) return;

    let g = G ();
    let dmut t = thread (ts);

    // what it shaded is handed over before it leaves the rounds of the collector, its spans are
    // handed back as an allocation does
    (*t).inAlloc = 1u8;
    flushGrey (ts);
    releaseCache (ts);
    flushAllocated (ts);
    (*t).inAlloc = 0u8;

    _yrt_i_nh_mutex_lock ((*g).threadsLock);
    let prev = (*t).prev, next = (*t).next;
    if (prev != 0us) {
        let dmut p = thread (prev);
        (*p).next = next;
    } else {
        st ((*g).threads, next);
    }

    if (next != 0us) {
        let dmut n = thread (next);
        (*n).prev = prev;
    }

    _yrt_i_nh_set_self (0us);
    _yrt_i_nh_mutex_unlock ((*g).threadsLock);

    free ((*t).cache);
    free ((*t).returned);
    free ((*t).grey);
    free (ts);
}

/**
 * Hand the spans the thread `ts` allocates from back to their lists
 * */
@{nogc, unsafe}
pub fn releaseCache (ts: usize) {
    let cache = { (*thread (ts)).cache };
    for k in 0us .. NLISTS {
        let s = ld (cache + k * 8us);
        if (s != 0us) {
            release (s);
            st (cache + k * 8us, 0us);
        }
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          HANDSHAKES          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * What a handshake asks of a thread: to wait until the collector lets it go, to acknowledge it, to
 * hand its grey objects over, to hand them over with a copy of its stack, or to hand the spans of
 * its cache back
 * */
pub def TASK_PARK    = 0u8;
pub def TASK_ACK     = 1u8;
pub def TASK_GREY    = 2u8;
pub def TASK_STACK   = 3u8;
pub def TASK_RECLAIM = 4u8;

/**
 * What came of the task of a handshake: the thread waits for the collector to do it, it did it,
 * or it could not and went on, to be asked again
 * */
pub def OUT_WAIT  = 0u8;
pub def OUT_DONE  = 1u8;
pub def OUT_RETRY = 2u8;

/**
 * Do the task of the handshake the collector asked for, in the handler of the handshake signal,
 * then park the calling thread until the collector lets it go if it could not
 * @params:
 *    - sp: the lowest address of its stack in use, the registers it was interrupted with included
 * */
@nogc
pub extern (C) fn _yrt_i_nh_handshake (sp: usize) {
    let ts = _yrt_i_nh_get_self ();
    if (ts == 0us) return;

    if (_yrt_i_nh_defer () != 0u8) return;

    let dmut t = thread (ts);

    let seq = _yrt_i_nh_load32 (cast!usize (&((*t).req)));
    if (_yrt_i_nh_load32 (cast!usize (&((*t).go))) == seq || crashing ()) return;

    let parks = cast!usize (&((*G ()).parks));
    let start = _yrt_i_nh_now_ns ();
    (*t).sp = sp;
    (*t).parkedAt = start;
    let outcome = doTask (ts);
    (*t).outcome = outcome;
    (*t).pauseNs = _yrt_i_nh_now_ns () - start;
    _yrt_i_nh_store32 (cast!usize (&((*t).parked)), seq);
    _yrt_i_nh_add32 (parks, 1u32);
    _yrt_i_nh_futex_wake (parks);
    if (outcome != OUT_WAIT) return;

    // a handshake nested in the park of leaveBusy can let `go` past `seq` before it is read here
    let go = cast!usize (&((*t).go));
    let releases = cast!usize (&((*G ()).releases));
    loop {
        let r = _yrt_i_nh_load32 (releases);
        if (_yrt_i_nh_load32 (go) != seq - 1u32) break;
        _yrt_i_nh_futex_wait (releases, r);
    }
}

/**
 * Do the task of the handshake the thread `ts`, the calling one, was asked for
 * @returns: what came of it
 * @info: run in the handler of the handshake signal, out of a write barrier and of an assist: it
 * takes no lock and allocates nothing
 * */
@{nogc, unsafe}
fn doTask (ts: usize)-> u8 {
    let dmut t = thread (ts);
    let task = (*t).task;
    if (task == TASK_ACK) return OUT_DONE;
    if (task == TASK_GREY || task == TASK_STACK) {
        return if (copyThread (ts, task == TASK_STACK)) { OUT_DONE } else { OUT_WAIT };
    }

    if (task == TASK_RECLAIM) {
        if (_yrt_i_nh_load8 (cast!usize (&((*t).inAlloc))) != 0u8) return OUT_RETRY;

        let cache = (*t).cache;
        for k in 0us .. NLISTS {
            st ((*t).returned + k * 8us, ld (cache + k * 8us));
            st (cache + k * 8us, 0us);
        }

        flushAllocated (ts);
        return OUT_DONE;
    }

    OUT_WAIT
}

/**
 * Ask the thread `ts` to do the task `task`, sending it the handshake signal
 * @returns: false iif the thread could not be signaled
 * */
@{nogc, unsafe}
fn request (ts: usize, task: u8)-> bool {
    let dmut t = thread (ts);
    {
        let seq = _yrt_i_nh_load32 (cast!usize (&((*t).req))) + 1u32;
        (*t).task = task;
        (*t).handed = 0us;
        (*t).parkWords = 0u64;
        _yrt_i_nh_store32 (cast!usize (&((*t).req)), seq);
        (*t).since = _yrt_i_nh_now_ns ();
        if (_yrt_i_nh_signal ((*t).thread) != 0) {
            _yrt_i_nh_store32 (cast!usize (&((*t).go)), seq);
            (*t).signaled = 0u8;
            return false;
        }

        (*t).signaled = 1u8;
    }

    true
}

/**
 * @returns: true iif the thread `ts` parked in the handshake it was last asked for
 * */
@{nogc, unsafe}
fn isParked (ts: usize)-> bool {
    let t = thread (ts);
    {
        _yrt_i_nh_load32 (cast!usize (&((*t).parked))) == _yrt_i_nh_load32 (cast!usize (&((*t).req)))
    }
}

/**
 * @returns: true iif the thread `ts` is parked, and was not let go yet
 * */
@{nogc, unsafe}
pub fn isHeld (ts: usize)-> bool {
    let t = thread (ts);
    {
        isParked (ts) && (*t).outcome == OUT_WAIT && _yrt_i_nh_load32 (cast!usize (&((*t).go))) != _yrt_i_nh_load32 (cast!usize (&((*t).req)))
    }
}

/**
 * Wait until a thread parks, if none did since `seen` was read from the number of parks
 * */
@{nogc, unsafe}
fn awaitPark (seen: u32) {
    {
        _yrt_i_nh_futex_wait (cast!usize (&((*G ()).parks)), seen);
    }
}

/**
 * @returns: the number of handshakes a thread parked in
 * */
@{nogc, unsafe}
fn parks ()-> u32 {
    {
        _yrt_i_nh_load32 (cast!usize (&((*G ()).parks)))
    }
}

/**
 * Wait until the thread `ts`, asked for a handshake, parks in it
 * */
@{nogc, unsafe}
fn awaitParked (ts: usize) {
    loop {
        let seen = parks ();
        if (isParked (ts)) break;
        awaitPark (seen);
    }

    let dmut t = thread (ts);
    (*t).servedAt = _yrt_i_nh_now_ns ();
}

/**
 * Interrupt the thread `ts`, until resume is called
 * @returns: false iif the thread could not be signaled
 * */
@{nogc, unsafe}
pub fn suspend (ts: usize)-> bool {
    if (!request (ts, TASK_PARK)) return false;
    awaitParked (ts);
    true
}

/**
 * Let the thread `ts` interrupted by suspend go
 * */
@{nogc, unsafe}
pub fn resume (ts: usize) {
    letGo (ts);
    wakeReleased ();
}

/**
 * Close the handshake of the thread `ts`, parked: a thread waiting for the collector not asleep yet
 * goes on at once, wakeReleased wakes the others
 * */
@{nogc, unsafe}
pub fn letGo (ts: usize) {
    let dmut t = thread (ts);
    {
        (*t).signaled = 0u8;
        _yrt_i_nh_store32 (cast!usize (&((*t).go)), _yrt_i_nh_load32 (cast!usize (&((*t).req))));
        _yrt_i_nh_add32 (cast!usize (&((*G ()).releases)), 1u32);
        if ((*t).task != TASK_ACK && (*t).outcome != OUT_RETRY) {
            parked (ts);
        }
    }
}

/**
 * Wake every parked thread up, the ones released since going on, the others sleeping again
 * */
@{nogc, unsafe}
pub fn wakeReleased () {
    {
        _yrt_i_nh_futex_wake (cast!usize (&((*G ()).releases)));
    }
}

/**
 * Record how long the thread `ts` was parked, from its park to its release, or doing its task
 * itself, and how long its handshake signal took to reach it
 * */
@{nogc, unsafe}
fn parked (ts: usize) {
    let dmut g = G ();
    let t = thread (ts);
    {
        let waited = (*t).outcome == OUT_WAIT;
        let d = if (waited) { _yrt_i_nh_now_ns () - (*t).parkedAt } else { (*t).pauseNs };
        let signal = (*t).parkedAt - (*t).since;
        if (signal > (*g).statLongestSignal) {
            (*g).statLongestSignal = signal;
        }

        (*g).statParks = (*g).statParks + 1u64;
        (*g).statParkNs = (*g).statParkNs + d;
        if (d > (*g).statLongestPark) {
            (*g).statLongestPark = d;
            (*g).statParkWait = if (waited) { (*t).servedAt - (*t).parkedAt } else { 0u64 };
            (*g).statParkWords = (*t).parkWords;
        }
    }
}

/**
 * Copy the grey objects of the thread `ts`, and its stack and its TLS block if `stack` is set,
 * into a record of the copies, scanned once the round let the threads go (scanCopies)
 * @returns: false iif the copies have no room for them
 * @info: called by the thread itself, in the handler of the handshake signal, or by the collector
 * while it is parked
 * */
@{nogc, unsafe}
fn copyThread (ts: usize, stack: bool)-> bool {
    let g = G ();
    let dmut t = thread (ts);
    {
        let ng = (*t).greyLen;
        let stackLo = (((*t).sp + 7us) / 8us) * 8us;
        let tlsLo = (((*t).tlsLo + 7us) / 8us) * 8us;
        let mut stackLen = 0us, mut tlsLen = 0us;
        if (stack) {
            stackLen = if ((*t).stackHi > stackLo) { (((*t).stackHi - stackLo) / 8us) * 8us } else { 0us };
            tlsLen = if ((*t).tlsHi > tlsLo) { (((*t).tlsHi - tlsLo) / 8us) * 8us } else { 0us };
        }

        let ns = (stackLen + tlsLen) / 8us;
        if (ng == 0us && ns == 0us) return true;

        let size = (2us + ng + ns) * 8us;
        let len = cast!usize (&((*g).copiesLen));
        let mut at = 0u64;
        loop {
            at = _yrt_i_nh_load64 (len);
            if (cast!usize (at) + size > COPY_CAP) return false;
            if (_yrt_i_nh_cas64 (len, at, at + cast!u64 (size)) == 1u8) break;
        }

        let rec = (*g).copies + cast!usize (at);
        st (rec, ng);
        st (rec + 8us, ns);
        memmove (rec + 16us, (*t).grey + 16us, ng * 8us);
        memmove (rec + 16us + ng * 8us, stackLo, stackLen);
        memmove (rec + 16us + ng * 8us + stackLen, tlsLo, tlsLen);

        (*t).greyLen = 0us;
        (*t).handed = ng;
        (*t).parkWords = cast!u64 (ns);
    }

    true
}

/**
 * Scan the stack and the TLS block of the thread `ts` in place, while it is parked
 * */
@{nogc, unsafe}
fn scanThread (ts: usize) {
    let dmut t = thread (ts);
    {
        scanRange ((*t).sp, (*t).stackHi);
        scanRange ((*t).tlsLo, (*t).tlsHi);
        (*t).parkWords = cast!u64 (((*t).stackHi - (*t).sp) / 8us + ((*t).tlsHi - (*t).tlsLo) / 8us);
    }
}

/**
 * Push the grey objects of the records of the copies on the mark stack, scan the copies of the
 * stacks, and decommit what they took past COPY_KEEP
 * @info: no thread writes a record: every thread asked for a handshake by the round parked in it
 * */
@{nogc, unsafe}
fn scanCopies () {
    let dmut g = G ();
    {
        let len = cast!usize ((*g).copiesLen);
        if (len == 0us) return;

        let mut rec = (*g).copies;
        while (rec < (*g).copies + len) {
            let ng = ld (rec), ns = ld (rec + 8us);
            for i in 0us .. ng {
                markPush (ld (rec + (2us + i) * 8us));
            }

            let words = rec + (2us + ng) * 8us;
            scanRange (words, words + ns * 8us);
            rec = words + ns * 8us;
        }

        if (len > COPY_KEEP) {
            madvise ((*g).copies + COPY_KEEP, len - COPY_KEEP, MADV_DONTNEED);
        }

        (*g).copiesLen = 0u64;
    }
}

/**
 * Move the objects of the grey buffer of the thread `ts`, parked, to the mark stack
 * @returns: their number
 * */
@{nogc, unsafe}
pub fn takeGrey (ts: usize)-> usize {
    let dmut t = thread (ts);
    {
        let n = (*t).greyLen;
        for i in 0us .. n {
            markPush (ld ((*t).grey + (2us + i) * 8us));
        }

        (*t).greyLen = 0us;
        n
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          ROUNDS          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * The work done on a thread during a round
 * */
pub def ROUND_ACK     = 0u8;
pub def ROUND_SCAN    = 1u8;
pub def ROUND_FLUSH   = 2u8;
pub def ROUND_RECLAIM = 3u8;

/**
 * The number of threads a round signals ahead of the ones it works on
 * */
pub def WINDOW = 8us;

/**
 * Interrupt every thread, the work of the round done on it
 * @params:
 *    - kind: the work of the round
 *    - cycle: the number of the cycle
 * @returns: the number of grey objects found, and the stacks scanned during a flush
 * @info: a round other than a reclaim signals up to WINDOW threads at once, and serves them in the
 * order they park: one of them can wait, in a write barrier, for a lock another one holds. A thread
 * does the work of an ACK, SCAN or FLUSH round itself, in its handler, and goes on: it waits for the
 * collector only if the copies have no room for what it hands over, and the threads that do are
 * woken at once at the end of a pass. The copies are scanned once every thread went
 * */
@{nogc, unsafe}
pub fn round (kind: u8, cycle: u64)-> usize {
    let g = G ();
    let mut found = 0us;

    _yrt_i_nh_mutex_lock ((*g).threadsLock);
    if (kind == ROUND_RECLAIM) {
        let mut ts = ld ((*g).threads);
        while (ts != 0us) {
            reclaim (ts);
            ts = (*thread (ts)).next;
        }

        _yrt_i_nh_mutex_unlock ((*g).threadsLock);
        return 0us;
    }

    let mut first = ld ((*g).threads);
    let mut ahead = first;
    let mut inflight = 0us;
    loop {
        while (ahead != 0us && inflight < WINDOW) {
            if (request (ahead, taskOf (ahead, kind, cycle))) {
                inflight = inflight + 1us;
            }

            ahead = (*thread (ahead)).next;
        }

        if (inflight == 0us) break;

        let seen = parks ();
        let mut served = 0us;
        let mut waiting = 0us;
        let mut ts = first;
        while (ts != ahead) {
            let dmut t = thread (ts);
            if ((*t).signaled == 1u8 && isParked (ts)) {
                (*t).servedAt = _yrt_i_nh_now_ns ();
                let task = (*t).task;
                if ((*t).outcome == OUT_WAIT) {
                    waiting = waiting + 1us;
                    if (!copyThread (ts, task == TASK_STACK)) {
                        (*t).handed = takeGrey (ts);
                        if (task == TASK_STACK) {
                            scanThread (ts);
                        }
                    }
                }

                found = found + (*t).handed;
                if (task == TASK_STACK) {
                    (*t).scanned = cycle;
                    if (kind == ROUND_FLUSH) {
                        found = found + 1us;
                    }
                }

                letGo (ts);
                served = served + 1us;
            }

            ts = (*t).next;
        }

        if (waiting != 0us) {
            wakeReleased ();
        }

        inflight = inflight - served;
        while (first != ahead && (*thread (first)).signaled == 0u8) {
            first = (*thread (first)).next;
        }

        if (served == 0us) {
            awaitPark (seen);
        }
    }

    scanCopies ();
    _yrt_i_nh_mutex_unlock ((*g).threadsLock);
    found
}

/**
 * @returns: the task a round of kind `kind` of the cycle `cycle` asks of the thread `ts`
 * */
@{nogc, unsafe}
fn taskOf (ts: usize, kind: u8, cycle: u64)-> u8 {
    if (kind == ROUND_ACK) return TASK_ACK;
    if (kind == ROUND_SCAN) return TASK_STACK;

    {
        if ((*thread (ts)).scanned != cycle) return TASK_STACK;
    }

    TASK_GREY
}

/**
 * Take back the spans the thread `ts` allocates from, so that every span is swept before the
 * collector forgets the marks of the last cycle, and add what it allocated to the live heap. The
 * thread hands them over in its handler if it is out of an allocation and of a fork, when it holds
 * no lock of a list and no span but the ones of its cache, and is asked again otherwise; the
 * spans are handed back to their lists once it went, the lock of a list being held by a thread
 * sweeping a span.
 * */
@{nogc, unsafe}
fn reclaim (ts: usize) {
    let inAlloc = cast!usize (&((*thread (ts)).inAlloc));
    loop {
        while (_yrt_i_nh_load8 (inAlloc) != 0u8) {
            _yrt_i_nh_yield ();
        }

        if (!request (ts, TASK_RECLAIM)) return;
        awaitParked (ts);

        let done = { (*thread (ts)).outcome == OUT_DONE };
        letGo (ts);
        if (done) {
            let returned = { (*thread (ts)).returned };
            for k in 0us .. NLISTS {
                let s = ld (returned + k * 8us);
                if (s != 0us) {
                    release (s);
                    st (returned + k * 8us, 0us);
                }
            }

            return;
        }
    }
}

/**
 * Wait until no thread runs a write barrier or an assist anymore, the collector no longer marking:
 * a round parks each thread once it is out of them
 * */
@{nogc, unsafe}
pub fn quiesce (cycle: u64) {
    let g = G ();
    round (ROUND_ACK, cycle);
    while (_yrt_i_nh_load64 (cast!usize (&((*g).foreignBusy))) != 0u64) {
        _yrt_i_nh_yield ();
    }
}

/**
 * Mark the calling thread as running a write barrier or an assist
 * @returns: its state, 0 if it is unknown to the collector
 * */
@{nogc, unsafe}
pub fn enterBusy ()-> usize {
    let ts = _yrt_i_nh_get_self ();
    if (ts != 0us) {
        _yrt_i_nh_enter_busy ();
    } else {
        _yrt_i_nh_add64 (cast!usize (&((*G ()).foreignBusy)), 1u64);
        _yrt_i_nh_fence ();
    }

    ts
}

/**
 * Mark the thread `ts` returned by enterBusy as done, parking it if a handshake interrupted it
 * meanwhile
 * @returns: true iif it parked
 * */
@{nogc, unsafe}
pub fn leaveBusy (ts: usize)-> bool {
    if (ts != 0us) {
        return _yrt_i_nh_leave_busy () != 0u8;
    }

    _yrt_i_nh_sub64 (cast!usize (&((*G ()).foreignBusy)), 1u64);
    false
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ================================          ALLOCATION          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: true iif the calling thread prints the trace of a crash: it allocates from the C
 * allocator, and never parks, the collector or a parked thread may hold a lock it needs
 * */
@{nogc, unsafe}
pub fn crashing ()-> bool {
    let crashed = { _yrt_i_nh_load64 (cast!usize (&((*G ()).crashed))) };
    crashed != 0u64 && crashed == _yrt_i_nh_thread_self ()
}

/**
 * @returns: true while the collector marks
 * */
@{nogc, unsafe}
pub fn marking ()-> bool {
    _yrt_i_nh_load8 (cast!usize (&_yrt_nh_marking)) == 1u8
}

/**
 * @returns: true while the collector marks and every thread acknowledged it: an assist making an
 * object black before then could miss the store of a thread that read the flag at 0 into it
 * */
@{nogc, unsafe}
pub fn assisting ()-> bool {
    marking () && { _yrt_i_nh_load8 (cast!usize (&((*G ()).assistOn))) == 1u8 }
}

/**
 * Allocate a zeroed object of `size` bytes from the calling thread
 * @params:
 *    - size: the size of the object
 *    - flags: NOSCAN if it holds no pointer
 * @returns: the address of the object
 * */
@{nogc, unsafe}
pub fn allocate (size: usize, flags: u8)-> usize {
    if (crashing ()) {
        return calloc (1us, size + 1us);
    }

    let mut ts = _yrt_i_nh_get_self ();
    if (ts == 0us) {
        ts = register ();
    }

    let dmut t = thread (ts);
    (*t).inAlloc = 1u8;

    // one byte more, so that a pointer to the end of an object is still in it
    let need = (if (size == 0us) { 1us } else { size }) + 1us;
    let noscan = (flags & NOSCAN) != 0u8;

    let mut obj = 0us;
    let mut real = 0us;
    if (need <= MAX_SMALL) {
        let k = classOf (need) * 2us + (if (noscan) { 1us } else { 0us });
        let slot = (*t).cache + k * 8us;
        let mut s = ld (slot);

        // a span the end of a cycle left unswept is handed back, to be swept before its objects are reused
        if (s != 0us && (*span (s)).sweepGen != sweepGen ()) {
            release (s);
            st (slot, 0us);
            s = 0us;
        }

        if (s != 0us) {
            obj = spanAlloc (s, false);
        }

        if (obj == 0us) {
            if (s != 0us) {
                release (s);
            }

            s = refill (k);
            st (slot, s);
            obj = spanAlloc (s, false);
        }

        let x = span (s);
        real = (*x).elemSize;
        memset (obj, 0, real);

        // zeroed first, so that no marked object holds stale words; an allocation the end of the
        // cycle came across is in a span about to be swept
        if (marking () || (*x).sweepGen != sweepGen ()) {
            st8 ((*x).marks + (obj - (*x).base) / (*x).elemSize, 1u8);
        }
    } else {
        obj = allocLarge (need, noscan);
        real = ((need + PAGE - 1us) / PAGE) * PAGE;
    }

    let over = account (ts, cast!u64 (real));
    (*t).inAlloc = 0u8;
    if (over) {
        pace (ts);
    }

    obj
}

/**
 * Account for `bytes` the thread `ts` allocated: the live heap, its debt to the marking and its
 * assists while the collector marks, and the trigger of the next cycle
 * @returns: true iif the live heap reached its hard limit while a cycle runs, or the thread owes
 * the marking more than DEBT_MAX once it assisted, past the goal
 * */
@{nogc, unsafe}
fn account (ts: usize, bytes: u64)-> bool {
    let g = G ();
    let dmut t = thread (ts);
    let mut over = false;

    (*t).allocated = (*t).allocated + bytes;
    if ((*t).allocated >= ALLOC_BATCH) {
        let live = flushAllocated (ts);
        if (live >= (*g).trigger) {
            trigger ();
        }

        over = live >= (*g).hard && collecting ();
    }

    if (marking ()) {
        (*t).sinceAssist = (*t).sinceAssist + bytes;
        if ((*t).sinceAssist >= ALLOC_BATCH) {
            charge (ts, (*t).sinceAssist);
            (*t).sinceAssist = 0u64;
            if (settle (ts)) {
                over = true;
            }
        }
    }

    over
}

/**
 * Add the scan work `bytes` allocated call for to the debt of the thread `ts`, forgetting what it
 * owed an earlier marking
 * */
@{nogc, unsafe}
fn charge (ts: usize, bytes: u64) {
    let dmut t = thread (ts);
    let cycle = { _yrt_i_nh_load64 (cast!usize (&((*G ()).markCycle))) };
    if ((*t).debtCycle != cycle) {
        (*t).debtCycle = cycle;
        (*t).debt = 0i64;
    }

    (*t).debt = (*t).debt + cast!i64 ((bytes * assistRatio ()) >> 16u64);
}

/**
 * @returns: the scan work an allocated byte calls for, in 1/65536 of a byte: the work the marking
 * expects left over the heap left before the goal, or once either is overrun the heap the marking
 * started from left to scan over the heap left before the hard limit
 * */
@{nogc, unsafe}
fn assistRatio ()-> u64 {
    let g = G ();
    {
        let done = _yrt_i_nh_load64 (cast!usize (&((*g).scanWork)));
        let expected = _yrt_i_nh_load64 (cast!usize (&((*g).scanExpected)));
        let live = liveHeap (_yrt_i_nh_load64 (cast!usize (&((*g).heapLive))));
        let mut work = 0u64, mut room = 0u64;
        if (done < expected && live < (*g).goal) {
            work = expected - done;
            room = (*g).goal - live;
        } else {
            let base = _yrt_i_nh_load64 (cast!usize (&((*g).markBase)));
            work = if (base > done) { base - done } else { ALLOC_BATCH };
            room = if ((*g).hard > live) { (*g).hard - live } else { 0u64 };
        }

        if (room < ALLOC_BATCH) room = ALLOC_BATCH;
        if (work > 1099511627776u64) work = 1099511627776u64;

        let ratio = (work << 16u64) / room;
        if (ratio > MAX_RATIO) { MAX_RATIO } else { ratio }
    }
}

/**
 * Pay the debt of the thread `ts` to the marking from the credit of the collector, then by
 * assisting it
 * @returns: true iif it still owes more than DEBT_MAX while the collector marks past the goal
 * */
@{nogc, unsafe}
fn settle (ts: usize)-> bool {
    let dmut t = thread (ts);
    if (!marking () || (*t).debt <= 0i64) return false;
    {
        if ((*t).debtCycle != _yrt_i_nh_load64 (cast!usize (&((*G ()).markCycle)))) {
            (*t).debt = 0i64;
            return false;
        }
    }

    (*t).debt = (*t).debt - cast!i64 (takeCredit (cast!u64 ((*t).debt)));
    if ((*t).debt > 0i64) {
        let b = enterBusy ();
        if (assisting ()) {
            (*t).debt = (*t).debt - cast!i64 (assist (cast!u64 ((*t).debt)));
        }

        leaveBusy (b);
    }

    if (!marking () || (*t).debt <= DEBT_MAX) return false;
    {
        liveHeap (_yrt_i_nh_load64 (cast!usize (&((*G ()).heapLive)))) >= (*G ()).goal
    }
}

/**
 * @returns: true while the collector runs a cycle
 * */
@{nogc, unsafe}
fn collecting ()-> bool {
    {
        _yrt_i_nh_load8 (cast!usize (&((*G ()).collecting))) != 0u8
    }
}

/**
 * Hold the calling thread `ts`, out of any allocation, until the cycle running ends, the live heap
 * is back under its hard limit, and it owes the marking no more than DEBT_MAX past the goal: the
 * objects allocated while the collector marks are kept until the next cycle, a thread allocating
 * faster than it marks would make the heap grow without bound
 * */
@{nogc, unsafe}
fn pace (ts: usize) {
    let g = G ();
    let cycle = { _yrt_i_nh_load64 (cast!usize (&((*g).cycle))) };
    loop {
        let full = { liveHeap (_yrt_i_nh_load64 (cast!usize (&((*g).heapLive)))) >= (*g).hard };
        let owes = settle (ts);
        if (!full && !owes) break;

        let mut over = false;
        {
            _yrt_i_nh_mutex_lock ((*g).lock);
            if ((*g).collecting == 0u8 || (*g).cycle != cycle) {
                over = true;
            } else {
                _yrt_i_nh_cond_timedwait ((*g).cond, (*g).lock, if (full) { PACE_NS } else { ASSIST_WAIT_NS });
            }

            _yrt_i_nh_mutex_unlock ((*g).lock);
        }

        if (over) break;
    }
}

/**
 * Add the bytes the thread `ts` allocated since it last did to the live heap
 * @returns: the live heap
 * @info: the thread is the calling one, or it is parked out of an allocation
 * */
@{nogc, unsafe}
fn flushAllocated (ts: usize)-> u64 {
    let dmut g = G ();
    let dmut t = thread (ts);

    let live = liveHeap (_yrt_i_nh_add64 (cast!usize (&((*g).heapLive)), (*t).allocated));
    (*g).statAllocated = (*g).statAllocated + (*t).allocated;
    if (live > (*g).statPeak) {
        (*g).statPeak = live;
    }

    (*t).allocated = 0u64;
    live
}

/**
 * Wake the collector up, the live heap having reached its trigger
 * */
@{nogc, unsafe}
pub fn trigger () {
    let g = G ();
    startCollector ();
    _yrt_i_nh_mutex_lock ((*g).lock);
    _yrt_i_nh_cond_broadcast ((*g).cond);
    _yrt_i_nh_mutex_unlock ((*g).lock);
}

/**
 * Start the threads of the collector and of the finalizers, the first time
 * */
@{nogc, unsafe}
pub fn startCollector () {
    let dmut g = G ();
    if (_yrt_i_nh_load64 (cast!usize (&((*g).started))) != 0u64) return;
    if (_yrt_i_nh_cas64 (cast!usize (&((*g).started)), 0u64, 1u64) == 1u8) {
        _yrt_i_nh_spawn (0u8);
        _yrt_i_nh_spawn (1u8);
    }
}
