/**
 * The state of the collector: the layout of its spans and of the threads it knows, its global
 * state, and their initialization at the first allocation.
 */
in state;

use core::nidhogg::{globals_, span_, sys, thread_state};

/**
 * A page of the heap, the unit of the page map, is 8KiB
 * */
pub def PAGE_SHIFT = 13us;
pub def PAGE = 8192us;

/**
 * The heap is mapped by chunks of 4MiB, aligned on their size, of 512 pages
 * */
pub def CHUNK_SHIFT = 22us;
pub def CHUNK = 4194304us;
pub def CHUNK_PAGES = 512us;

/**
 * The page map has a first level of 8192 entries for the bits 35 to 47 of an address, a second
 * of 8192 entries for its bits 22 to 34, naming the page table of its chunk
 * */
pub def MAP_L1 = 8192us;
pub def MAP_L2 = 8192us;

/**
 * The size classes of the small objects, the larger ones having a span of their own
 * */
pub def NCLASSES = 40us;
pub def MAX_SMALL = 32768us;

/**
 * Each size class has a list of spans holding pointers, and one of spans holding none
 * */
pub def NLISTS = 80us;

/**
 * The number of objects a grey buffer holds, its two first words being its link and its length
 * */
pub def GREY_CAP = 1022us;
pub def GREY_WORDS = 1024us;

/**
 * The number of entries of the mark stack of the collector, reserved but not committed, the most
 * NIDHOGG_MARK_STACK can set
 * */
pub def MARK_CAP = 67108864us;

/**
 * The bytes reserved for the grey objects and the copies of the stacks the threads hand over in a
 * round, reserved but not committed, and the bytes of them left committed between two rounds
 * */
pub def COPY_CAP = 67108864us;
pub def COPY_KEEP = 1048576us;

/**
 * The bytes a thread allocates between two updates of the live heap, and two assists
 * */
pub def ALLOC_BATCH = 65536u64;

/**
 * The smallest goal of a cycle
 * */
pub def MIN_GOAL = 4194304u64;

/**
 * The growth a memory limit always leaves past the heap the last marking found reachable
 * */
pub def LIMIT_SLACK = 1048576u64;

/**
 * The scan work a thread may owe the marking, in bytes, before it waits for the collector, and the
 * longest it waits before it tries to pay again
 * */
pub def DEBT_MAX = 262144i64;
pub def ASSIST_WAIT_NS = 100000u64;

/**
 * The most scan work an allocated byte calls for, in 1/65536 of a byte
 * */
pub def MAX_RATIO = 4194304u64;

/**
 * The objects the collector scans between two publications of its work
 * */
pub def PUBLISH_EVERY = 256us;

/**
 * The number of cycles in a row at whose end a chunk is entirely free before it is unmapped
 * */
pub def IDLE_CYCLES = 2us;

/**
 * The longest a thread held past the hard limit of the heap sleeps before it checks it again
 * */
pub def PACE_NS = 1000000u64;

/**
 * The states of a span
 * */
pub def SPAN_FREE    = 0u8;
pub def SPAN_AVAIL   = 1u8;
pub def SPAN_FULL    = 2u8;
pub def SPAN_UNSWEPT = 3u8;
pub def SPAN_CACHED  = 4u8;
pub def SPAN_LARGE   = 5u8;

/**
 * @returns: the global state of the collector, initialized at its first use
 * */
@{nogc, unsafe}
pub fn G ()-> dmut *Globals {
    {
        if (_yrt_i_nh_globals == 0us) {
            init ();
        }

        cast!{*Globals} (_yrt_i_nh_globals)
    }
}

/**
 * @returns: the address of the global state of the collector, initialized at its first use
 * */
@{nogc, unsafe}
pub fn gaddr ()-> usize {
    {
        if (_yrt_i_nh_globals == 0us) {
            init ();
        }

        _yrt_i_nh_globals
    }
}

/**
 * @returns: the span at `addr`
 * */
@{nogc, unsafe}
pub fn span (addr: usize)-> dmut *Span {
    {
        cast!{*Span} (addr)
    }
}

/**
 * Set the state of the span `s` to `v`
 * */
@{nogc, unsafe}
pub fn setState (s: usize, v: u8) {
    let dmut x = span (s);
    (*x).state = v;
}

/**
 * @returns: the thread state at `addr`
 * */
@{nogc, unsafe}
pub fn thread (addr: usize)-> dmut *ThreadState {
    {
        cast!{*ThreadState} (addr)
    }
}

/**
 * Create the global state of the collector, the first allocation of the program being made
 * before any other thread exists
 * */
@{nogc, unsafe}
fn init () {
    let addr = calloc (1us, Globals::size);
    if (addr == 0us) {
        fatal ("nidhogg: cannot allocate the state of the collector\n");
    }

    {
        let dmut g = cast!{*Globals} (addr);
        (*g).l1 = words (MAP_L1);
        (*g).freeSpans = words (1us);
        (*g).spareSpans = words (1us);
        (*g).large = words (1us);
        (*g).threads = words (1us);
        (*g).work = words (1us);
        (*g).capChunks = 64us;
        (*g).chunks = words (64us);
        (*g).chunkIdle = words (64us);
        (*g).heapLo = 18446744073709551615us;
        (*g).heapLock = _yrt_i_nh_mutex_new ();

        (*g).classSize = words (NCLASSES);
        (*g).classPages = words (NCLASSES);
        initClasses ((*g).classSize, (*g).classPages);

        (*g).listLocks = words (NLISTS);
        (*g).avail = words (NLISTS);
        (*g).full = words (NLISTS);
        (*g).unswept = words (NLISTS);
        for i in 0us .. NLISTS {
            st ((*g).listLocks + i * 8us, _yrt_i_nh_mutex_new ());
        }

        (*g).sweepGen = 2u64;
        (*g).gogc = envNum ("NIDHOGG_GOGC\u{0}", 100u64);
        (*g).memLimit = envBytes ("NIDHOGG_MEMLIMIT\u{0}", 0u64);
        let (goal, hard) = limits (0u64, (*g).gogc, (*g).memLimit);
        (*g).goal = goal;
        (*g).hard = hard;
        (*g).trigger = triggerOf (0u64, goal, 0u64);
        (*g).verify = cast!u8 (envNum ("NIDHOGG_VERIFY\u{0}", 0u64) != 0u64);
        (*g).stats = cast!u8 (envNum ("NIDHOGG_STATS\u{0}", 0u64) != 0u64);

        (*g).lock = _yrt_i_nh_mutex_new ();
        (*g).cond = _yrt_i_nh_cond_new ();
        (*g).threadsLock = _yrt_i_nh_mutex_new ();
        (*g).workLock = _yrt_i_nh_mutex_new ();
        (*g).rootsLock = _yrt_i_nh_mutex_new ();
        (*g).finLock = _yrt_i_nh_mutex_new ();
        (*g).finCond = _yrt_i_nh_cond_new ();

        (*g).finCap = 1024us;
        (*g).finTable = words (2048us);
        (*g).finQueueCap = 256us;
        (*g).finQueue = words (512us);

        let stack = mmap (0us, MARK_CAP * 8us, PROT_RW, MAP_ANON_PRIVATE | MAP_NORESERVE, -1, 0i64);
        if (stack == MAP_FAILED) {
            fatal ("nidhogg: cannot reserve the mark stack\n");
        }

        (*g).markStack = stack;
        let cap = cast!usize (envNum ("NIDHOGG_MARK_STACK\u{0}", cast!u64 (MARK_CAP)));
        (*g).markCap = if (cap == 0us || cap > MARK_CAP) { MARK_CAP } else { cap };

        let copies = mmap (0us, COPY_CAP, PROT_RW, MAP_ANON_PRIVATE | MAP_NORESERVE, -1, 0i64);
        if (copies == MAP_FAILED) {
            fatal ("nidhogg: cannot reserve the copies of the stacks\n");
        }

        (*g).copies = copies;
        _yrt_i_nh_globals = addr;
    }

    _yrt_i_nh_install_handshake ();
}

/**
 * Write the size and the number of pages of the objects of each class: by 16 bytes up to 128,
 * then four classes between two powers of two, up to 32KiB
 * */
@{nogc, unsafe}
fn initClasses (sizes: usize, pages: usize) {
    let mut c = 0us;
    let mut size = 16us;
    while (size <= 128us) {
        st (sizes + c * 8us, size);
        c = c + 1us;
        size = size + 16us;
    }

    let mut step = 32us;
    while (c < NCLASSES) {
        for _ in 0us .. 4us {
            size = ld (sizes + (c - 1us) * 8us) + step;
            st (sizes + c * 8us, size);
            c = c + 1us;
        }

        step = step * 2us;
    }

    for i in 0us .. NCLASSES {
        let s = ld (sizes + i * 8us);
        let mut n = (s * 8us + PAGE - 1us) / PAGE;
        if (n < 1us) n = 1us;
        st (pages + i * 8us, n);
    }
}

/**
 * @returns: the size class of an object of `size` bytes, NCLASSES if it is a large one
 * */
@{nogc, unsafe}
pub fn classOf (size: usize)-> usize {
    if (size <= 128us) return (size + 15us) / 16us - 1us;
    if (size > MAX_SMALL) return NCLASSES;

    let sizes = { (*G ()).classSize };
    let mut c = 8us;
    while (ld (sizes + c * 8us) < size) {
        c = c + 1us;
    }

    c
}

/**
 * @returns: the hard limit of a heap whose last cycle left `live` bytes and whose next one starts
 * at `goal`: the growth allowed past the goal once more, and at least the smallest goal
 * */
@nogc
pub fn hardLimit (live: u64, goal: u64)-> u64 {
    let slack = goal - live;
    goal + (if (slack < MIN_GOAL) { MIN_GOAL } else { slack })
}

/**
 * @returns: the goal and the hard limit after a marking found `marked` bytes reachable, `gogc`
 * percent more (MIN_GOAL at least) and that growth once more; a memory limit `limit` (0 if none)
 * lowers them to 15/16 of it and to it, leaving LIMIT_SLACK or `marked` / 16 of growth at least
 * */
@nogc
pub fn limits (marked: u64, gogc: u64, limit: u64)-> (u64, u64) {
    let mut goal = marked + (marked / 100u64) * gogc;
    if (goal < MIN_GOAL) goal = MIN_GOAL;

    let mut hard = hardLimit (marked, goal);
    if (limit != 0u64) {
        let slack = if (marked / 16u64 < LIMIT_SLACK) { LIMIT_SLACK } else { marked / 16u64 };
        let room = limit - limit / 16u64;
        let capped = if (room < marked + slack) { marked + slack } else { room };
        if (goal > capped) goal = capped;

        let cap = if (limit < goal + slack) { goal + slack } else { limit };
        if (hard > cap) hard = cap;
    }

    (goal, hard)
}

/**
 * @returns: the live heap at which the cycle after a marking that found `marked` bytes reachable
 * starts, the heap growing by `runway` bytes during a marking: soon enough for the marking to end
 * at `goal`, between 60% and 95% of the way from `marked` to it
 * */
@nogc
pub fn triggerOf (marked: u64, goal: u64, runway: u64)-> u64 {
    let span = goal - marked;
    let lo = marked + (span / 10u64) * 6u64;
    let hi = goal - span / 20u64;
    let t = if (runway >= goal - lo) { lo } else { goal - runway };
    if (t > hi) { hi } else { t }
}
