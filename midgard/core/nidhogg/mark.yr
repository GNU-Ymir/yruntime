/**
 * The marking: the shading of an object, by the collector onto its mark stack or by a thread
 * into its grey buffer, the scanning of the words of a range or of an object, and the grey
 * buffers the threads hand over to the collector.
 */
in mark;

use core::nidhogg::{heap, state, sys};

/**
 * Mark the object `p` points into, if it is an allocated object of the heap not marked yet
 * @returns: the address of the object if it must be scanned, 0 otherwise
 * */
@{nogc, unsafe}
pub fn shade (p: usize)-> usize {
    let g = G ();
    {
        if (p < (*g).heapLo || p >= (*g).heapHi) return 0us;
    }

    let (s, i) = findObject (p);
    if (s == 0us) return 0us;

    let x = span (s);
    {
        if (_yrt_i_nh_load8 ((*x).marks + i) != 0u8) return 0us;
        if (_yrt_i_nh_xchg8 ((*x).marks + i, 1u8) != 0u8) return 0us;
        if ((*x).noscan == 1u8) return 0us;

        (*x).base + i * (*x).elemSize
    }
}

/**
 * @returns: true iif the object at `p` is marked, or is not one of the heap
 * */
@{nogc, unsafe}
pub fn isMarked (p: usize)-> bool {
    let (s, i) = findObject (p);
    if (s == 0us) return true;

    {
        (_yrt_i_nh_load8 ((*span (s)).marks + i) & 1u8) != 0u8
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ================================          COLLECTOR          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Push the object `obj`, marked, on the mark stack of the collector, or leave it to the next
 * rescan if the stack has no room for it
 * */
@{nogc, unsafe}
pub fn markPush (obj: usize) {
    let dmut g = G ();
    {
        if ((*g).markTop >= (*g).markCap) {
            (*g).markOverflow = 1u8;
            return;
        }

        st ((*g).markStack + (*g).markTop * 8us, obj);
        (*g).markTop = (*g).markTop + 1us;
    }
}

/**
 * Shade the object `p` points into, pushing it on the mark stack of the collector
 * */
@{nogc, unsafe}
pub fn markGrey (p: usize) {
    let obj = shade (p);
    if (obj != 0us) {
        markPush (obj);
    }
}

/**
 * Shade every object a word of the range [lo, hi) points into, onto the mark stack, a word equal
 * to the one before it being skipped
 * */
@{nogc, unsafe}
pub fn scanRange (lo: usize, hi: usize) {
    let mut a = ((lo + 7us) / 8us) * 8us;
    let mut last = 0us;
    while (a + 8us <= hi) {
        let w = ld (a);
        if (w != last) {
            markGrey (w);
            last = w;
        }

        a = a + 8us;
    }
}

/**
 * Shade every object the object `obj` points to, onto the mark stack
 * @returns: the bytes scanned
 * */
@{nogc, unsafe}
pub fn scanObject (obj: usize)-> u64 {
    let s = spanOf (obj);
    if (s == 0us) return 0u64;

    let size = { (*span (s)).elemSize };
    scanRange (obj, obj + size);
    cast!u64 (size)
}

/**
 * Scan the objects of the mark stack, and of the grey buffers handed over, until there is none
 * @returns: the number of grey buffers taken, and of rescans
 * */
@{nogc, unsafe}
pub fn drain ()-> usize {
    let mut taken = 0us;
    loop {
        taken = taken + drainStack ();
        if (!takeWork ()) break;
        taken = taken + 1us;
    }

    taken
}

/**
 * Scan the objects of the mark stack until there is none, rescanning the heap each time it had no
 * room for an object
 * @returns: the number of rescans
 * */
@{nogc, unsafe}
pub fn drainStack ()-> usize {
    let dmut g = G ();
    let mut rescans = 0us;
    loop {
        {
            let mut n = 0us;
            while ((*g).markTop != 0us) {
                (*g).markTop = (*g).markTop - 1us;
                (*g).markWork = (*g).markWork + scanObject (ld ((*g).markStack + (*g).markTop * 8us));
                n = n + 1us;
                if (n == PUBLISH_EVERY) {
                    n = 0us;
                    publishWork ();
                }
            }

            publishWork ();
            if ((*g).markOverflow == 0u8) break;
            (*g).markOverflow = 0u8;
        }

        rescan ();
        rescans = rescans + 1us;
        (*g).statRescans = (*g).statRescans + 1u64;
    }

    rescans
}

/**
 * Push every marked object of the heap holding pointers on the mark stack, scanning it whenever
 * it is full: an object the stack had no room for is marked, and nothing else scans it
 * @info: the page heap is locked while its spans are walked, but not while the stack is scanned;
 * a span in use is only freed by the sweep, and a free one only split under the lock
 * */
@{nogc, unsafe}
fn rescan () {
    let dmut g = G ();
    let lock = { (*g).heapLock };
    _yrt_i_nh_mutex_lock (lock);
    let mut c = 0us;
    while (c < { (*g).nchunks }) {
        let chunk = ld ({ (*g).chunks } + c * 8us);
        let mut page = 0us;
        while (page < CHUNK_PAGES) {
            let s = spanAt (chunk, page);
            if (s == 0us) {
                page = page + 1us;
                continue;
            }

            let x = span (s);
            {
                if ((*x).state != SPAN_FREE && (*x).noscan == 0u8) {
                    for i in 0us .. (*x).nelems {
                        if (_yrt_i_nh_load8 ((*x).alloc + i) == 0u8 || _yrt_i_nh_load8 ((*x).marks + i) == 0u8) continue;
                        if ((*g).markTop >= (*g).markCap) {
                            _yrt_i_nh_mutex_unlock (lock);
                            while ((*g).markTop != 0us) {
                                (*g).markTop = (*g).markTop - 1us;
                                (*g).markWork = (*g).markWork + scanObject (ld ((*g).markStack + (*g).markTop * 8us));
                            }

                            _yrt_i_nh_mutex_lock (lock);
                        }

                        markPush ((*x).base + i * (*x).elemSize);
                    }
                }

                page = page + (*x).npages;
            }
        }

        c = c + 1us;
    }

    _yrt_i_nh_mutex_unlock (lock);
}

/**
 * Add the bytes the collector scanned since it last did to the scan work of the marking and to its
 * credit, and hand GREY_CAP objects of its mark stack over to the assists if one found nothing to
 * scan, while sharing is set and the stack holds twice as many
 * */
@{nogc, unsafe}
pub fn publishWork () {
    let dmut g = G ();
    {
        let w = (*g).markWork;
        if (w != 0u64) {
            (*g).markWork = 0u64;
            _yrt_i_nh_add64 (cast!usize (&((*g).scanWork)), w);
            _yrt_i_nh_add64 (cast!usize (&((*g).bgCredit)), w);
        }

        if ((*g).sharing == 0u8 || (*g).markTop < 2us * GREY_CAP) return;
        if (_yrt_i_nh_load8 (cast!usize (&((*g).assistWanted))) == 0u8) return;

        _yrt_i_nh_store8 (cast!usize (&((*g).assistWanted)), 0u8);
        let buf = words (GREY_WORDS);
        (*g).markTop = (*g).markTop - GREY_CAP;
        memmove (buf + 16us, (*g).markStack + (*g).markTop * 8us, GREY_CAP * 8us);
        st (buf + 8us, GREY_CAP);
        link (buf);
        (*g).statShared = (*g).statShared + 1u64;
    }
}

/**
 * @returns: up to `want` bytes taken from the credit of the collector
 * */
@{nogc, unsafe}
pub fn takeCredit (want: u64)-> u64 {
    let credit = { cast!usize (&((*G ()).bgCredit)) };
    loop {
        let c = _yrt_i_nh_load64 (credit);
        if (c == 0u64) return 0u64;

        let take = if (c < want) { c } else { want };
        if (_yrt_i_nh_cas64 (credit, c, c - take) == 1u8) return take;
    }

    0u64
}

/**
 * Move the objects of a grey buffer handed over to the mark stack
 * @returns: false iif there was none
 * */
@{nogc, unsafe}
pub fn takeWork ()-> bool {
    let g = G ();
    let lock = { (*g).workLock };
    _yrt_i_nh_mutex_lock (lock);
    let buf = ld ({ (*g).work });
    if (buf != 0us) {
        st ({ (*g).work }, ld (buf));
    }

    _yrt_i_nh_mutex_unlock (lock);
    if (buf == 0us) return false;

    let n = ld (buf + 8us);
    for i in 0us .. n {
        markPush (ld (buf + (2us + i) * 8us));
    }

    free (buf);
    true
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          THREADS          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Shade the object `p` points into from a thread, into its grey buffer
 * @info: the thread is busy, the collector marking
 * */
@{nogc, unsafe}
pub fn shadeFromThread (p: usize) {
    let obj = shade (p);
    if (obj == 0us) return;

    let ts = _yrt_i_nh_get_self ();
    if (ts == 0us) {
        handOver (obj);
        return;
    }

    let dmut t = thread (ts);
    {
        let n = (*t).greyLen;
        st ((*t).grey + (2us + n) * 8us, obj);
        (*t).greyLen = n + 1us;
        if (n + 1us == GREY_CAP) {
            flushGrey (ts);
        }
    }
}

/**
 * Shade every object a word of the range [lo, hi) points to, from a thread
 * */
@{nogc, unsafe}
pub fn scanRangeFromThread (lo: usize, hi: usize) {
    let mut a = ((lo + 7us) / 8us) * 8us;
    while (a + 8us <= hi) {
        shadeFromThread (ld (a));
        a = a + 8us;
    }
}

/**
 * Hand the grey buffer of the thread `ts` over to the collector, and give it a new one
 * */
@{nogc, unsafe}
pub fn flushGrey (ts: usize) {
    let dmut t = thread (ts);
    {
        let n = (*t).greyLen;
        if (n == 0us) return;

        let buf = (*t).grey;
        (*t).grey = words (GREY_WORDS);
        (*t).greyLen = 0us;
        st (buf + 8us, n);
        link (buf);
    }
}

/**
 * Hand the object `obj` shaded by a thread the collector does not know over to the collector
 * */
@{nogc, unsafe}
fn handOver (obj: usize) {
    let buf = words (3us);
    st (buf + 8us, 1us);
    st (buf + 16us, obj);
    link (buf);
}

/**
 * Link the grey buffer `buf` into the ones handed over to the collector
 * */
@{nogc, unsafe}
fn link (buf: usize) {
    let g = G ();
    {
        _yrt_i_nh_mutex_lock ((*g).workLock);
        st (buf, ld ((*g).work));
        st ((*g).work, buf);
        _yrt_i_nh_mutex_unlock ((*g).workLock);
    }
}

/**
 * Scan grey buffers handed over to the collector, for a thread that allocates while the collector
 * marks, until `budget` bytes are scanned, asking the collector for some of its mark stack if none
 * is left
 * @returns: the bytes scanned
 * @info: the thread is busy
 * */
@{nogc, unsafe}
pub fn assist (budget: u64)-> u64 {
    let dmut g = G ();
    let lock = { (*g).workLock };
    let mut done = 0u64;
    while (done < budget) {
        _yrt_i_nh_mutex_lock (lock);
        let buf = ld ({ (*g).work });
        if (buf != 0us) {
            st ({ (*g).work }, ld (buf));
            {
                _yrt_i_nh_add64 (cast!usize (&((*g).assists)), 1u64);
            }
        }

        _yrt_i_nh_mutex_unlock (lock);
        if (buf == 0us) {
            {
                _yrt_i_nh_store8 (cast!usize (&((*g).assistWanted)), 1u8);
            }

            break;
        }

        let n = ld (buf + 8us);
        for i in 0us .. n {
            let obj = ld (buf + (2us + i) * 8us);
            let s = spanOf (obj);
            if (s != 0us) {
                let size = { (*span (s)).elemSize };
                scanRangeFromThread (obj, obj + size);
                done = done + cast!u64 (size);
            }
        }

        free (buf);
    }

    if (done != 0u64) {
        {
            _yrt_i_nh_add64 (cast!usize (&((*g).scanWork)), done);
            _yrt_i_nh_add64 (cast!usize (&((*g).statAssistWork)), done);
        }
    }

    done
}
