in resolve_error_code;

/**
 * The reasons a host name cannot be resolved
 * */
pub enum ResolveErrorCode: u8
// the name does not exist, or has no address
| UNKNOWN_HOST = 0u8
// the name server failed temporarily, the resolution can be retried
| TEMPORARY    = 1u8
// the resolver failed for any other reason
| FAILURE      = 2u8;
