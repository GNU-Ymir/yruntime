in ip_addr;

/**
 * Ancestor class of ipv4 and ipv6 addresses
 * */
@abstract
pub class IpAddr {
    pub self () {}

    pub fn isLoopback(self)-> bool;
    pub fn isUnspecified(self)-> bool;

    pub fn opEquals(self, o: &IpAddr)-> bool;

    impl std::stream::Streamable;
    impl core::types::Hashable;
}

