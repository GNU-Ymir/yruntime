/**
 * This module implements the checksums, which detect the accidental corruption of data: a
 * transmission or storage error changes the checksum of the data with a high probability.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * @warning: a checksum is not a digest. Anyone can forge data of a given checksum, it detects
 * accidents but authenticates nothing, use `std::digest` against an adversary.
 * @example:
 * ```
 * use std::checksum;
 *
 * let data = "some content";
 * let stored = crc32(data);
 *
 * assert(crc32(data) == stored);
 * assert(crc32("some c0ntent") != stored);
 * ```
 */

in checksum;

mod ::crc32_;
mod ::utils;

pub def Crc32: crc32_::Crc32;

pub def crc32 = utils::crc32;
