/**
 * Module used to parse command line options
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in args;

pub mod ::argument;
pub mod ::errors;

use std::{stream, traits};
use std::algorithm::searching;
use std::config::{args::_, data};
use std::conv::errors;

/**
 * Argument parser
 * */
pub class ArgumentParser {

    // The list of position arguments(with no name)
    let mut _positions: [Argument] = [];

    // The list of option arguments(named with a value)
    let mut _options: [Argument] = [];

    // The list of sub command arguments(triggered by a flag)
    let mut _subCommands: [Argument] = [];

    // The list of flag argument that when set throws the help required error
    let mut _helps: [Argument] = [];

    // The list of flag arguments(named with no values)
    let mut _flags: [Argument] = [];

    /**
     * Create an empty argument parser
     * */
    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PARSING          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Parse command line options
     * @params:
     *   - args: the command line options to parse
     * @info:
     *   - an option value is either the next token(`--jobs 4`), attached after `=`(`--jobs=4`, `-j=4`)
     *     or glued to the short name(`-j4`)
     *   - a token that looks like a negative number(`-5`, `-.5`) is a value unless an argument is named after it
     *   - `--` ends the options, every token after it is positional
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{i64} ("jobs", short-> "j")
     *              :.position!{[[c8]]} ("files");
     *
     * let args = parser.parse(copy ["./a.out", "-j4", "--", "-weird-file", "--jobs=2"]);
     *
     * assert(args["jobs"].to!{i64} () == 4);
     * assert(args["files"].to!{[[c8]]} () == ["-weird-file", "--jobs=2"]);
     * ```
     * */
    pub fn parse(self, args: [[c8]])-> &Dict
        throws CommandLineError
    {
        let mut currentPositional = 0us;
        let mut rest = args[1 .. $];
        let mut literal = false;
        let dmut resultConfig = copy Dict();

        while rest.len > 0 {
            if !literal && rest[0] == "--" {
                literal = true;
                rest = rest[1 .. $];
                continue;
            }

            let (name, isHyphenated) = self.parseToken(rest[0], literal);
            if (isHyphenated) {
                if let Ok(sub) = self.isSubCommand(name, true) {
                    resultConfig[sub.long] = self.parseSubCommand(sub, rest);
                    break;
                }

                else if let Ok(flg) = self.isFlag(name) {
                    resultConfig[flg.long] = copy Bool(true);
                    rest = rest[1 .. $];
                }

                else if let Ok() = self.isHelp(name) {
                    throw copy HelpRequestError();
                }

                else if let Ok(opt) = self.isOption(name) {
                    let (val, rest_) = self.parseOption(opt, rest[1 .. $]);
                    rest = rest_;
                    self.insertOption(alias resultConfig, opt, val);
                }

                else if let Ok((opt, value)) = self.isAttachedOption(rest[0], name) {
                    let (val, rest_) = self.parseOption(opt, (copy [value]) ~ rest[1 .. $], forced-> true, literal-> literal);
                    rest = rest_;
                    self.insertOption(alias resultConfig, opt, val);
                }

                else {
                    throw copy UnknownArgument(name);
                }
            } else {
                if let Ok(sub) = self.isSubCommand(name, false, literal-> literal) {
                    resultConfig[sub.long] = self.parseSubCommand(sub, rest);
                    break;
                }

                else if currentPositional < self._positions.len {
                    let opt = self._positions[currentPositional];
                    let (val, rest_) = self.parseOption(opt, rest, literal-> literal);
                    resultConfig[opt.long] = val;
                    currentPositional += 1;
                    rest = rest_;
                }

                else {
                    throw copy UnknownArgument(name);
                }
            }
        }

        self.checkMandatories(currentPositional, resultConfig);
        self.insertMissingFlags(alias resultConfig);
        self.insertMissingDefaults(alias resultConfig);

        resultConfig
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          EXPLANATION          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Generate the error message according to the given error
     * */
    pub fn explain(self, err: &CommandLineError, usage: [c8] = "usage")-> [c8] {
        match err {
            HelpRequestError() => return self.getHelp(usage-> usage);
            m: &MalformedArgument => {
                return self.getUsage(usage-> usage) ~ "\n" ~ self.explainMalformed(m);
            }
            m: &MissingArgument => {
                let mut result = self.getUsage(usage-> usage) ~ "\n";
                result ~= "missing argument '" ~ m.key ~ "'";
                return result;
            }
            m: &UnknownArgument => {
                let mut result = self.getUsage(usage-> usage) ~ "\n";
                result ~= "unknown argument '" ~ m.key ~ "'";
                return result;
            }
        }

        return std::conv::to!{[c8]} (err);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the usage of the argument parser in a single line
     * @params:
     *    - usage: the name of the executable to put in from of the usage explainer
     * */
    pub fn getUsage(self, usage: [c8] = "usage")-> [c8] {
        let dmut stream = copy StringStream();
        stream:.write(usage, " ");
        let mut i = 0;
        for f in self._flags {
            if i != 0 { stream:.write(" "); }
            self.exportUsageOption(f, alias stream, isFlag-> true);
            i += 1;
        }

        for f in self._helps {
            if i != 0 { stream:.write(" "); }
            self.exportUsageOption(f, alias stream, isFlag-> true);
            i += 1;
        }

        for f in self._options {
            if i != 0 { stream:.write(" "); }
            self.exportUsageOption(f, alias stream);
            i += 1;
        }

        for f in self._positions {
            if i != 0 { stream:.write(" "); }
            self.exportUsageOption(f, alias stream, isPositional-> true);
            i += 1;
        }

        for f in self._subCommands {
            if i != 0 { stream:.write(" "); }
            self.exportUsageOption(f, alias stream, isSub-> true, hyphenated-> f.hyphenated);
            i += 1;
        }

        stream[]
    }

    /**
     * @returns: the help of the argument parser
     * @params:
     *    - usage: the name of the executable to put in from of the usage explainer
     * */
    pub fn getHelp(self, usage: [c8] = "usage")-> [c8] {
        let dmut stream = copy StringStream();
        let (shortAlign, longAlign, nbMandatory, nbOptions) = self.computeHelpAlignment();
        let aligns = (shortAlign, longAlign);

        stream:.writeln(self.getUsage(usage-> usage), "\n");
        if (self._positions.len != 0) {
            stream:.writeln("positional arguments: ");
        }

        for f in self._positions {
            self.exportHelpOption(f, alias stream, aligns, hyphenated-> false);
        }

        if (nbMandatory != 0) {
            stream:.writeln("mandatory arguments: ");
        }
        for f in self._options {
            if (f.isMandatory) {
                self.exportHelpOption(f, alias stream, aligns);
            }
        }

        for f in self._subCommands {
            if (f.isMandatory) {
                self.exportHelpOption(f, alias stream, aligns, hyphenated-> f.hyphenated);
            }
        }

        if (nbOptions != 0) {
            stream:.writeln("optional arguments: ");
        }
        for f in self._options {
            if (!f.isMandatory) {
                self.exportHelpOption(f, alias stream, aligns);
            }
        }
        for f in self._subCommands {
            if (!f.isMandatory) {
                self.exportHelpOption(f, alias stream, aligns, hyphenated-> f.hyphenated);
            }
        }
        for f in self._flags {
            self.exportHelpOption(f, alias stream, aligns);
        }
        for f in self._helps {
            self.exportHelpOption(f, alias stream, aligns);
        }

        stream[]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          POSITIONAL          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a position argument
     * @params:
     *    - name: the name used to retreive the position argument in the generated configuration(e.g. 'list').
     *    - comments: the comments to print for help
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.position!{i64} ("A", comments-> "first int")
     *              :.position!{i64} ("B", comments-> "second int")
     *              :.position!{[c8]} ("C", comments-> "a string")
     *              :.position!{f64} ("D", comments-> "a float");
     *
     * let args = parser.parse(copy ["./a.out", "1", "2", "foo", "87.12"]);
     *
     * assert(args["A"].to!{i64} () == 1);
     * assert(args["B"].to!{i64} () == 2);
     * assert(args["C"].to!{[c8]} () == "foo");
     * assert(args["D"].to!{f64} () == 87.12);
     * ```
     * */
    pub fn if (isIntegral!{T} || isFloating!{T}) position {T} (mut self, name: [c8], comments: [c8] = "")-> dmut &ArgumentParser {
        let type = cte if isIntegral!{T} {
            copy Int(0)
        } else {
            copy Float(0.0)
        };

        self._positions ~= [Argument(long-> name, short-> "", comments-> comments, type-> type?, hyphenated-> false, mandatory-> true)];
        alias self
    }

    /**
     * Add a position argument with a default value, making it optional
     * @params:
     *    - name: the name used to retreive the position argument in the generated configuration(e.g. 'list').
     *    - default: the value of the argument when it is not on the command line
     *    - comments: the comments to print for help
     * @info: only position arguments with a default value can follow a position argument with a default value
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.position!{i64} ("A", comments-> "first int")
     *              :.position!{i64} ("B", default-> 2, comments-> "second int");
     *
     * assert(parser.parse(copy ["./a.out", "1"])["B"].to!{i64} () == 2);
     * assert(parser.parse(copy ["./a.out", "1", "9"])["B"].to!{i64} () == 9);
     * ```
     * */
    pub fn if (isIntegral!{T} || isFloating!{T}) position {T} (mut self, name: [c8], @default: T, comments: [c8] = "")-> dmut &ArgumentParser {
        let type = cte if isIntegral!{T} {
            copy Int(0)
        } else {
            copy Float(0.0)
        };

        self._positions ~= [Argument(long-> name, short-> "", comments-> comments, type-> type?, hyphenated-> false, mandatory-> false, default-> self.scalarDefault!{T} (default)?)];
        alias self
    }

    /**
     * Add a position argument
     * @params:
     *    - name: the name used to retreive the position argument in the generated configuration(e.g. 'list').
     *    - comments: the comments to print for help
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.position!{i64} ("A", comments-> "first int")
     *              :.position!{i64} ("B", comments-> "second int")
     *              :.position!{[c8]} ("C", comments-> "a string")
     *              :.position!{f64} ("D", comments-> "a float");
     *
     * let args = parser.parse(copy ["./a.out", "1", "2", "foo", "87.12"]);
     *
     * assert(args["A"].to!{i64} () == 1);
     * assert(args["B"].to!{i64} () == 2);
     * assert(args["C"].to!{[c8]} () == "foo");
     * assert(args["D"].to!{f64} () == 87.12);
     * ```
     * */
    pub fn position {T of [U], U of c8} (mut self, name: [c8], comments: [c8] = "")-> dmut &ArgumentParser {
        let type = copy Str("");
        self._positions ~= [Argument(long-> name, short-> "", comments-> comments, type-> type?, hyphenated-> false, mandatory-> true)];
        alias self
    }

    /**
     * Add a position argument with a default value, making it optional
     * @params:
     *    - name: the name used to retreive the position argument in the generated configuration(e.g. 'list').
     *    - default: the value of the argument when it is not on the command line
     *    - comments: the comments to print for help
     * @info: only position arguments with a default value can follow a position argument with a default value
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.position!{[c8]} ("file", default-> "a.out", comments-> "a string");
     *
     * assert(parser.parse(copy ["./a.out"])["file"].to!{[c8]} () == "a.out");
     * ```
     * */
    pub fn position {T of [U], U of c8} (mut self, name: [c8], @default: T, comments: [c8] = "")-> dmut &ArgumentParser {
        let type = copy Str("");
        self._positions ~= [Argument(long-> name, short-> "", comments-> comments, type-> type?, hyphenated-> false, mandatory-> false, default-> (copy Str(default))?)];
        alias self
    }

    /**
     * Add a list position argument
     * @params:
     *    - name: the name used to retreive the position argument in the generated configuration(e.g. 'list').
     *    - comments: the comments to print for help
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.position!{[i64]} ("list", comments-> "list of int");
     *
     * let args = parser.parse(copy ["./a.out", "1", "2", "3"])
     *                  .to!{[[c8] => [i64]]} (); // transform the configuration into a map
     *
     * assert(args["list"] == (copy [1i64, 2i64, 3i64])?);
     * ```
     * */
    pub fn  if (isIntegral!{U} || isFloating!{U} || template!{U}{X of [c8]}) position {T of [U], U} (mut self, name: [c8], comments: [c8] = "")-> dmut &ArgumentParser {
        let dmut lst = copy Array();

        cte if isIntegral!{U} {
            lst:.push(copy Int(0));
        } else cte if isFloating!{U} {
            lst:.push(copy Float(0.0));
        } else {
            lst:.push(copy Str(""));
        }

        self._positions ~= [Argument(long-> name, short-> "", comments-> comments, type-> lst?, hyphenated-> false, mandatory-> true)];
        alias self
    }

    /**
     * Add a list position argument with a default value, making it optional
     * @params:
     *    - name: the name used to retreive the position argument in the generated configuration(e.g. 'list').
     *    - default: the value of the argument when it is not on the command line
     *    - comments: the comments to print for help
     * @info: only position arguments with a default value can follow a position argument with a default value
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.position!{[i64]} ("list", default-> copy [1i64], comments-> "list of int");
     *
     * assert(parser.parse(copy ["./a.out"])["list"].to!{[i64]} () == [1i64]);
     * ```
     * */
    pub fn  if (isIntegral!{U} || isFloating!{U} || template!{U}{X of [c8]}) position {T of [U], U} (mut self, name: [c8], @default: T, comments: [c8] = "")-> dmut &ArgumentParser {
        let dmut lst = copy Array();

        cte if isIntegral!{U} {
            lst:.push(copy Int(0));
        } else cte if isFloating!{U} {
            lst:.push(copy Float(0.0));
        } else {
            lst:.push(copy Str(""));
        }

        self._positions ~= [Argument(long-> name, short-> "", comments-> comments, type-> lst?, hyphenated-> false, mandatory-> false, default-> self.arrayDefault(default)?)];
        alias self
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          SUBCOMMAND          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a sub command parser
     * @params:
     *    - name: the name of the command(long name of the option to set for the sub command to be executed)
     *    - cmd: the function to call when the argument is found
     *    - short: the short name of the argument
     *    - comments: the comments to print in the help
     *    - hyphenated: true iif '--' are mandatory for the option to be triggered
     * @example:
     * ```
     * use std::config::_;
     *
     * fn subCmd(args: [[c8]])-> (&Config)? {
     *    let subParser = ArgumentParser()
     *                    :.option!{i64} ("foo", comments-> "Int value of foo");
     *
     *    // needs to return an option to catch errors in a function pointer
     *    return subParser.parse(args)?;
     * }
     *
     *
     * let superCmd = ArgumentParser()
     *                :.sub("sub", &subCmd, short-> "s", comments-> "sub command", hyphenated-> false);
     *
     * let cfg = superCmd.parse(copy ["./a.out", "sub", "--foo", "78"]);
     * println(cfg["sub"]["foo"]); // 78
     * ```
     * */
    pub fn sub(mut self, name: [c8], cmd: dg ([[c8]])-> (&Config)?, short: [c8] = "", comments: [c8] = "", hyphenated: bool = true, mandatory: bool = false)-> dmut &ArgumentParser {
        self._subCommands ~= [Argument(long-> name, short-> short, comments-> comments, cmd-> cmd, hyphenated-> hyphenated, mandatory-> mandatory)];
        alias self
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          OPTION          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a option argument
     * @params:
     *    - name: the name used to retreive the option argument in the generated configuration(e.g. 'list').
     *    - comments: the comments to print for help
     *    - list: true iif the option can be set multiple times(result a slice in config instead of a single value)
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{i64} ("fst", comments-> "first int")
     *              :.option!{i64} ("scd", short-> "s", comments-> "second int")
     *              :.option!{[c8]} ("thd", comments-> "a string")
     *              :.option!{f64} ("fth", comments-> "a float");
     *
     * let args = parser.parse(copy ["./a.out", "--fst", "1", "-s", "2", "--thd", "foo", "--fth", "87.12"]);
     *
     * assert(args["fst"].to!{i64} () == 1);
     * assert(args["scd"].to!{i64} () == 2);
     * assert(args["thd"].to!{[c8]} () == "foo");
     * assert(args["fth"].to!{f64} () == 87.12);
     * ```
     * */
    pub fn if (isIntegral!{T} || isFloating!{T}) option {T} (mut self, name: [c8], short: [c8] = "", comments: [c8] = "", mandatory: bool = false, list: bool = false)-> dmut &ArgumentParser {
        let type = cte if isIntegral!{T} {
            copy Int(0)
        } else {
            copy Float(0.0)
        };

        self._options ~= [Argument(long-> name, short-> short, comments-> comments, type-> type?, hyphenated-> true, mandatory-> mandatory, list-> list)];
        alias self
    }

    /**
     * Add a option argument with a default value, inserted in the configuration when the option is not on the command line
     * @params:
     *    - name: the name used to retreive the option argument in the generated configuration(e.g. 'list').
     *    - default: the value of the option when it is not on the command line
     *    - short: the short name of the option
     *    - comments: the comments to print for help
     *    - list: true iif the option can be set multiple times(result a slice in config instead of a single value)
     * @info: an option with a default value is never mandatory, and its default is not an occurrence of the option
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{i64} ("jobs", default-> 1, short-> "j", comments-> "number of jobs");
     *
     * assert(parser.parse(copy ["./a.out"])["jobs"].to!{i64} () == 1);
     * assert(parser.parse(copy ["./a.out", "-j", "4"])["jobs"].to!{i64} () == 4);
     * ```
     * */
    pub fn if (isIntegral!{T} || isFloating!{T}) option {T} (mut self, name: [c8], @default: T, short: [c8] = "", comments: [c8] = "", list: bool = false)-> dmut &ArgumentParser {
        let type = cte if isIntegral!{T} {
            copy Int(0)
        } else {
            copy Float(0.0)
        };

        self._options ~= [Argument(long-> name, short-> short, comments-> comments, type-> type?, hyphenated-> true, mandatory-> false, list-> list, default-> self.listDefault(self.scalarDefault!{T} (default), list)?)];
        alias self
    }

    /**
     * Add a option argument
     * @params:
     *    - name: the name used to retreive the option argument in the generated configuration(e.g. 'list').
     *    - comments: the comments to print for help
     *    - list: true iif the option can be set multiple times(result a slice in config instead of a single value)
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{i64} ("fst", comments-> "first int")
     *              :.option!{i64} ("scd", short-> "s", comments-> "second int")
     *              :.option!{[c8]} ("thd", comments-> "a string")
     *              :.option!{f64} ("fth", comments-> "a float");
     *
     * let args = parser.parse(copy ["./a.out", "--fst", "1", "-s", "2", "--thd", "foo", "--fth", "87.12"]);
     *
     * assert(args["fst"].to!{i64} () == 1);
     * assert(args["scd"].to!{i64} () == 2);
     * assert(args["thd"].to!{[c8]} () == "foo");
     * assert(args["fth"].to!{f64} () == 87.12);
     * ```
     * */
    pub fn option {T of [U], U of c8} (mut self, name: [c8], short: [c8] = "", comments: [c8] = "", mandatory: bool = false, list: bool = false)-> dmut &ArgumentParser {
        let type = copy Str("");

        self._options ~= [Argument(long-> name, short-> short, comments-> comments, type-> type?, hyphenated-> true, mandatory-> mandatory, list-> list)];
        alias self
    }

    /**
     * Add a option argument with a default value, inserted in the configuration when the option is not on the command line
     * @params:
     *    - name: the name used to retreive the option argument in the generated configuration(e.g. 'list').
     *    - default: the value of the option when it is not on the command line
     *    - short: the short name of the option
     *    - comments: the comments to print for help
     *    - list: true iif the option can be set multiple times(result a slice in config instead of a single value)
     * @info: an option with a default value is never mandatory, and its default is not an occurrence of the option
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{[c8]} ("output", default-> "a.out", short-> "o", comments-> "a string");
     *
     * assert(parser.parse(copy ["./a.out"])["output"].to!{[c8]} () == "a.out");
     * assert(parser.parse(copy ["./a.out", "-o", "foo"])["output"].to!{[c8]} () == "foo");
     * ```
     * */
    pub fn option {T of [U], U of c8} (mut self, name: [c8], @default: T, short: [c8] = "", comments: [c8] = "", list: bool = false)-> dmut &ArgumentParser {
        let type = copy Str("");

        self._options ~= [Argument(long-> name, short-> short, comments-> comments, type-> type?, hyphenated-> true, mandatory-> false, list-> list, default-> self.listDefault(copy Str(default), list)?)];
        alias self
    }

    /**
     * Add a list option argument
     * @params:
     *    - name: the name used to retreive the option argument in the generated configuration(e.g. 'list').
     *    - comments: the comments to print for help
     *    - short: the short name of the option
     *    - list: true iif the option can be set multiple times(result a slice in config instead of a single value)
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{[i64]} ("list", short-> "l", comments-> "list of int");
     *
     * let args = parser.parse(copy ["./a.out", "-l", "1", "2", "3"])
     *                  .to!{[[c8] => [i64]]} (); // transform the configuration into a map
     *
     * assert(args["list"] == (copy [1i64, 2i64, 3i64])?);
     * ```
     * */
    pub fn if (isIntegral!{U} || isFloating!{U} || template!{U}{X of [c8]}) option {T of [U], U} (mut self, name: [c8], short: [c8] = "", comments: [c8] = "", mandatory: bool = false, list: bool = false)-> dmut &ArgumentParser {
        let dmut lst = copy Array();

        cte if isIntegral!{U} {
            lst:.push(copy Int(0));
        } else cte if isFloating!{U} {
            lst:.push(copy Float(0.0));
        } else {
            lst:.push(copy Str(""));
        }

        self._options ~= [Argument(long-> name, short-> short, comments-> comments, type-> lst?, hyphenated-> true, mandatory-> mandatory, list-> list)];
        alias self
    }

    /**
     * Add a list option argument with a default value, inserted in the configuration when the option is not on the command line
     * @params:
     *    - name: the name used to retreive the option argument in the generated configuration(e.g. 'list').
     *    - default: the value of the option when it is not on the command line
     *    - short: the short name of the option
     *    - comments: the comments to print for help
     *    - list: true iif the option can be set multiple times(result a slice in config instead of a single value)
     * @info: an option with a default value is never mandatory, and its default is not an occurrence of the option
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.option!{[i64]} ("list", default-> copy [1i64, 2i64], short-> "l", comments-> "list of int");
     *
     * assert(parser.parse(copy ["./a.out"])["list"].to!{[i64]} () == [1i64, 2i64]);
     * assert(parser.parse(copy ["./a.out", "-l", "3"])["list"].to!{[i64]} () == [3i64]);
     * ```
     * */
    pub fn if (isIntegral!{U} || isFloating!{U} || template!{U}{X of [c8]}) option {T of [U], U} (mut self, name: [c8], @default: T, short: [c8] = "", comments: [c8] = "", list: bool = false)-> dmut &ArgumentParser {
        let dmut lst = copy Array();

        cte if isIntegral!{U} {
            lst:.push(copy Int(0));
        } else cte if isFloating!{U} {
            lst:.push(copy Float(0.0));
        } else {
            lst:.push(copy Str(""));
        }

        self._options ~= [Argument(long-> name, short-> short, comments-> comments, type-> lst?, hyphenated-> true, mandatory-> false, list-> list, default-> self.listDefault(self.arrayDefault(default), list)?)];
        alias self
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          FLAGS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Add a flag argument
     * @params:
     *    - name: the name of the flag
     *    - short: the short name of the flag
     *    - comments: the comments to display in the help
     * @example:
     * ```
     * use std::config::_;
     *
     * let parser = ArgumentParser()
     *              :.flag("foo", short-> "f", comments-> "a flag");
     *
     * let args1 = parser.parse(copy ["./a.out", "-f"]);
     * // flag inserted in the result dictionnary and set to true
     * assert(args1["foo"].to!{bool} () == true);
     *
     * let args2 = parser.parse(copy ["./a.out"]);
     * // still present in the dictionnary but set to false
     * assert(args2["foo"].to!{bool} () == false);
     * ```
     * */
    pub fn flag(mut self, name: [c8], short: [c8] = "", comments: [c8] = "")-> dmut &ArgumentParser {
        self._flags ~= [Argument(name, short-> short, comments-> comments, type-> none, hyphenated-> true, mandatory-> false)];
        alias self
    }

    /**
     * Add an help flag argument.
     * An help flag triggers an HelpRequestError error throwing when the flag is set instead setting it in the result dictionnary.
     * @params:
     *    - name: the name of the flag
     *    - short: the short name of the flag
     *    - comments: the comments to display in the help
     * @example:
     * ```
     * use std::config::args;
     *
     * let parser = ArgumentParser()
     *              :.help("help", short-> "h", comments-> "print help and exit");
     *
     * {
     *    let args1 = parser.parse(copy ["./a.out", "-h"]);
     *    println("Cmd options: ", args1);
     * } catch {
     *    err => {
     *       // print the error message(here the help message)
     *       println(parser.explain(err));
     *    }
     * }
     * ```
     * * */
    pub fn help(mut self, name: [c8], short: [c8] = "", comments: [c8] = "")-> dmut &ArgumentParser {
        self._helps ~= [Argument(name, short-> short, comments-> comments, type-> none, hyphenated-> true, mandatory-> false)];
        alias self
    }

    /**
     * Add the conventional help flag, `-h`/`--help`, printing the help generated by `getHelp`.
     * Use `help` instead for another name or another comment.
     * @params:
     *    - comments: the comments to display in the help
     * @example:
     * ```
     * use std::config::args;
     *
     * let parser = ArgumentParser()
     *              :.option!{i64} ("jobs", short-> "j", comments-> "number of jobs")
     *              :.defaultHelp();
     *
     * {
     *    let args = parser.parse(copy ["./a.out", "--help"]);
     *    println("Cmd options: ", args);
     * } catch {
     *    err => {
     *       println(parser.explain(err));
     *    }
     * }
     * ```
     * */
    pub fn defaultHelp(mut self, comments: [c8] = "print this help and exit")-> dmut &ArgumentParser {
        self:.help("help", short-> "h", comments-> comments)
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          PRIVATE DEFAULTS          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the configuration encoding of a scalar default value
     * */
    prv fn if (isIntegral!{T} || isFloating!{T}) scalarDefault {T} (self, value: T)-> &Config {
        cte if isIntegral!{T} {
            copy Int(cast!i64 (value))
        } else {
            copy Float(cast!f64 (value))
        }
    }

    /**
     * @returns: the configuration encoding of an array default value
     * */
    prv fn arrayDefault {U} (self, values: [U])-> &Config {
        let dmut lst = copy Array();
        for v in values {
            cte if isIntegral!{U} {
                lst:.push(copy Int(cast!i64 (v)));
            } else cte if isFloating!{U} {
                lst:.push(copy Float(cast!f64 (v)));
            } else {
                lst:.push(copy Str(v));
            }
        }

        lst
    }

    /**
     * @returns: 'value' as a single occurrence of a list argument, or 'value' itself if the argument is not a list
     * */
    prv fn listDefault(self, value: &Config, list: bool)-> &Config {
        if !list { return value; }

        let dmut lst = copy Array();
        lst:.push(value);

        lst
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===============================          PRIVATE SEARCHING          ================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Search for a sub command whose name is 'name'
     * @params:
     *    - name: the name of the subcommand to find
     *    - hyphenated: true if the name was hyphenated
     *    - literal: true if the name was found after `--`, where no sub command can be triggered
     * @returns: the sub command or none if not found
     * */
    prv fn isSubCommand(self, name: [c8], hyphenated: bool, literal: bool = false)-> (Argument)? {
        if literal { return none; }
        for s in self._subCommands {
            if (hyphenated || !s.hyphenated) && (s.long == name || s.short == name) {
                return s?;
            }
        }

        none
    }

    /**
     * Search for a flag whose name is 'name'
     * @params:
     *   - name: the name of the flag to find
     *  @returns: the flag or none if not found
     * */
    prv fn isFlag(self, name: [c8])-> (Argument)? {
        for s in self._flags {
            if s.long == name || s.short == name {
                return s?;
            }
        }

        none
    }

    /**
     * Search for an option whose name is 'name'
     * @params:
     *   - name: the name of the option to find
     *  @returns: the flag or none if not found
     * */
    prv fn isOption(self, name: [c8])-> (Argument)? {
        for s in self._options {
            if s.long == name || s.short == name {
                return s?;
            }
        }

        none
    }

    /**
     * Search for an option whose value is attached to its name, either after a `=`(`--jobs=4`, `-j=4`)
     * or glued to its short name(`-j4`, the longest short name wins)
     * @params:
     *   - token: the command line token
     *   - name: the token without its hyphens
     * @returns: the option and its attached value, or none if not found
     * */
    prv fn isAttachedOption(self, token: [c8], name: [c8])-> (Argument, [c8])? {
        if let Ok(i) = find(name, '=') {
            if let Ok(opt) = self.isOption(name[0us .. i]) {
                return (opt, name[i + 1us .. $])?;
            }
        }

        if token.len < 2 || token[1] == '-' {
            return none;
        }

        let mut found: (Argument)? = none;
        let mut foundLen = 0us;
        for o in self._options {
            if o.short.len > foundLen && o.short.len < name.len && name[0us .. o.short.len] == o.short {
                found = o?;
                foundLen = o.short.len;
            }
        }

        if let Ok(opt) = found {
            return (opt, name[foundLen .. $])?;
        }

        none
    }

    /**
     * @returns: true iif an argument that can be hyphenated is named 'name'
     * */
    prv fn isHyphenatedName(self, name: [c8])-> bool {
        if let Ok() = self.isSubCommand(name, true) { return true; }
        if let Ok() = self.isFlag(name) { return true; }
        if let Ok() = self.isHelp(name) { return true; }
        if let Ok() = self.isOption(name) { return true; }
        false
    }

    /**
     * Search for an help flag whose name is 'name'
     * @params:
     *   - name: the name of the flag to find
     *  @returns: the flag or none if not found
     * */
    prv fn isHelp(self, name: [c8])-> (Argument)? {
        for s in self._helps {
            if s.long == name || s.short == name {
                return s?;
            }
        }

        none
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ================================          PRIVATE PARSING          =================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Parse an option name
     * @params:
     *    - name: the possible name
     *  @returns:
     *     - .0: the parsed name
     *     - .1: true if it was hyphenated
     * */
    prv fn parseOptionName(self, name: [c8])-> ([c8], bool) {
        if (name.len > 2 && name[0] == '-' && name[1] == '-') {
            return (name[2 .. $], true);
        }

        else if (name.len > 1 && name[0] == '-') {
            return (name[1 .. $], true);
        }

        (name, false)
    }

    /**
     * Parse a command line token
     * @params:
     *    - token: the token
     *    - literal: true iif the token is a value whatever it looks like
     * @returns:
     *     - .0: the parsed name, or the token itself if it is a value
     *     - .1: true if it is an argument name, false if it is a value
     * */
    prv fn parseToken(self, token: [c8], literal: bool)-> ([c8], bool) {
        if literal {
            return (token, false);
        }

        let (name, hyphenated) = self.parseOptionName(token);
        if hyphenated && self.isNegativeNumber(token) && !self.isHyphenatedName(name) {
            return (token, false);
        }

        (name, hyphenated)
    }

    /**
     * @returns: true iif the token looks like a negative number(`-5`, `-.5`, `-1e3`)
     * */
    prv fn isNegativeNumber(self, token: [c8])-> bool {
        if token.len < 2 || token[0] != '-' {
            return false;
        }

        let c = if token[1] == '.' && token.len > 2 { token[2] } else { token[1] };
        c >= '0' && c <= '9'
    }

    /**
     * Insert the value of an option in the configuration, appending it if the option is a list
     * @throws:
     *    - &DuplicateArgument: if the option is not a list and already has a value
     * */
    prv fn insertOption(self, dmut cfg: &Dict, opt: Argument, val: &Config)
        throws CommandLineError
    {
        if opt.isList {
            let dmut lst = copy Array();
            if let Ok(old: &Array) = cfg[opt.long]? {
                for i in old[] { lst:.push(i); }
            }

            lst:.push(val);
            cfg[opt.long] = lst;
        } else if opt.long in cfg {
            throw copy DuplicateArgument(opt.long);
        } else {
            cfg[opt.long] = val;
        }
    }

    /**
     * Parse a sub command line option
     * @params:
     *    - sub: the sub command to run
     *    - rest: the argument to pass to the sub command
     * */
    prv fn parseSubCommand(self, sub: Argument, rest: [[c8]])-> &Config
        throws CommandLineError
    {
        if let Ok(func) = sub.subCommand {
            match func(rest) {
                Ok(cfg) => return cfg;
                Err(err) => throw copy MalformedArgument(sub.long, err?);
            }
        }

        throw copy InvalidCommandLine();
    }


    /**
     * Parse an option
     * @params:
     *    - opt: the argument option to parse
     *    - rest: the command line arguments
     *    - forced: true iif the first argument is a value whatever it looks like
     *    - literal: true iif every argument is a value whatever it looks like
     * @returns:
     *    - .0: the configuration
     *    - .1: the argument that are not consumed
     * */
    prv fn parseOption(self, opt: Argument, rest: [[c8]], forced: bool = false, literal: bool = false)-> (&Config, [[c8]])
        throws CommandLineError
    {
        match opt.type {
            Ok(Int()) => return self.parseIntOption(opt, rest);
            Ok(Float()) => return self.parseFloatOption(opt, rest);
            Ok(Str()) => return self.parseStrOption(opt, rest, forced-> forced || literal);
            Ok(a: &Array) => return self.parseArrayOption(opt, a, rest, forced-> forced, literal-> literal);
        }

        throw copy InvalidCommandLine();
    }

    /**
     * Parse a int option
     * @params:
     *    - opt: the argument option to parse
     *    - rest: the command line arguments
     * @returns:
     *    - .0: the configuration
     *    - .1: the argument that are not consumed
     * */
    prv fn parseIntOption(self, opt: Argument, rest: [[c8]])-> (&Config, [[c8]])
        throws CommandLineError
    {
        if rest.len == 0 {
            throw copy MalformedArgument(
                key-> opt.long,
                (copy CastFailure((&Int)::__typeinfo__, [c8]::typeinfo))?);
        }

        {
            return (copy Int(std::conv::to!{i64} (rest[0])), rest[1 .. $]);
        } catch {
            err => {
                throw copy MalformedArgument(opt.long, err?);
            }
        }
    }

    /**
     * Parse a float option
     * @params:
     *    - opt: the argument option to parse
     *    - rest: the command line arguments
     * @returns:
     *    - .0: the configuration
     *    - .1: the argument that are not consumed
     * */
    prv fn parseFloatOption(self, opt: Argument, rest: [[c8]])-> (&Config, [[c8]])
        throws CommandLineError
    {
        if rest.len == 0 {
            throw copy MalformedArgument(opt.long,
                                         (copy CastFailure((&Float)::__typeinfo__, [c8]::typeinfo))?);
        }

        {
            return (copy Float(std::conv::to!{f64} (rest[0])), rest[1 .. $]);
        } catch {
            err => {
                throw copy MalformedArgument(opt.long, err?);
            }
        }
    }

    /**
     * Parse a string option
     * @params:
     *    - opt: the argument option to parse
     *    - rest: the command line arguments
     *    - forced: true iif the first argument is a value whatever it looks like
     * @returns:
     *    - .0: the configuration
     *    - .1: the argument that are not consumed
     * */
    prv fn parseStrOption(self, opt: Argument, rest: [[c8]], forced: bool = false)-> (&Config, [[c8]])
        throws CommandLineError
    {
        if rest.len == 0 {
            throw copy MalformedArgument(opt.long,
                                         (copy CastFailure((&Str)::__typeinfo__, [c8]::typeinfo))?);
        }

        let (_, hyphenated) = self.parseToken(rest[0], forced);
        if (hyphenated) { // --foo --bar, does not mean foo takes the value --bar
            throw copy MalformedArgument(
                opt.long,
                (copy CastFailure((&Str)::__typeinfo__, [c8]::typeinfo))?);
        }

        return (copy Str(rest[0]), rest[1 .. $]);
    }

    /**
     * Parse a array option
     * @params:
     *    - opt: the argument option to parse
     *    - rest: the command line arguments
     *    - forced: true iif the first argument is a value whatever it looks like
     *    - literal: true iif every argument is a value whatever it looks like
     * @returns:
     *    - .0: the configuration
     *    - .1: the argument that are not consumed
     * */
    prv fn parseArrayOption(self, opt: Argument, a: &Array, rest: [[c8]], forced: bool = false, literal: bool = false)-> (&Config, [[c8]])
        throws CommandLineError
    {
        if rest.len == 0 {
            throw copy MalformedArgument(
                opt.long,
                (copy CastFailure(a.__typeinfo__, [c8]::typeinfo))?);
        }

        let inner = a[0]?;
        let mut args = rest;
        let dmut result = copy Array();
        let mut castError: (&core::exception::Exception)? = none;
        loop {
            {
                let (z, rest_) = match inner {
                    Ok(Int()) => { self.parseIntOption(opt, args) }
                    Ok(Float()) => { self.parseFloatOption(opt, args) }
                    Ok(Str()) => { self.parseStrOption(opt, args, forced-> literal || (forced && result.len == 0us)) }
                    _ => {
                        throw copy InvalidCommandLine();
                    }
                };

                result:.push(z);
                args = rest_;
            } catch {
                err => {
                    castError = err?;
                    break;
                }
            }
        }

        if result.len == 0 {
            throw copy MalformedArgument(opt.long, castError);
        }

        return (result, args);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ============================          CHECKING AND FINALIZING          =============================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Check for missing mandatory arguments
     * @params:
     *    - cfg: the generated configuration
     * */
    prv fn checkMandatories(self, nbPositional: usize, cfg: &Dict)
        throws CommandLineError
    {
        for i in nbPositional .. self._positions.len {
            if !self._positions[i].hasDefault {
                throw copy MissingArgument(self._positions[i].long);
            }
        }

        for o in self._options {
            if o.isMandatory && o.long !in cfg {
                throw copy MissingArgument(o.long);
            }
        }

        for o in self._subCommands {
            if o.isMandatory && o.long !in cfg {
                throw copy MissingArgument(o.long);
            }
        }
    }

    /**
     * Insert the flags that where not found in cmd line options
     * */
    prv fn insertMissingFlags(self, dmut cfg: &Dict) {
        for f in self._flags {
            if (f.long !in cfg) {
                cfg[f.long] = copy Bool(false);
            }
        }
    }

    /**
     * Insert the default values of the arguments that where not found in cmd line options
     * */
    prv fn insertMissingDefaults(self, dmut cfg: &Dict) {
        for a in self._positions ~ self._options {
            if (a.long !in cfg) {
                if let Ok(d) = a.defaultValue {
                    cfg[a.long] = d;
                }
            }
        }
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Export an option into usage
     * */
    prv fn exportUsageOption(self, o: Argument, dmut stream: &StringStream, isFlag: bool = false, isSub: bool = false, isPositional: bool = false, hyphenated: bool = true) {
        if (isPositional) {
            if (!o.isMandatory) stream:.write("[");
            self.exportUsageType(o, alias stream);
            stream:.write("(", o.long, ")");
            self.exportDefault(o, alias stream);
            if (!o.isMandatory) stream:.write("]");
        } else {
            if (!o.isMandatory) stream:.write("[");
            if o.short != "" { stream:.write("-", o.short, ","); }
            if (hyphenated) {
                stream:.write("--");
            }

            stream:.write(o.long);
            if (!isFlag && !isSub) {
                stream:.write(" ");
                self.exportUsageType(o, alias stream);
                self.exportDefault(o, alias stream);
            } else if isSub {
                stream:.write("(...)");
            }
            if (!o.isMandatory) stream:.write("]");
        }
    }

    /**
     * Export the default value of the argument to the stream, prefixed by a '=', and nothing if it has no default
     * */
    prv fn exportDefault(self, f: Argument, dmut stream: &StringStream) {
        if let Ok(d) = f.defaultValue {
            stream:.write("=");
            self.exportValue(d, alias stream);
        }
    }

    /**
     * Export the value of a configuration to the stream, as it would be written on the command line
     * */
    prv fn exportValue(self, c: &Config, dmut stream: &StringStream) {
        match c {
            Int(value-> i) => stream:.write(i);
            Float(value-> f) => stream:.write(f);
            Str(value-> s) => stream:.write(s);
            a: &Array => {
                stream:.write("[");
                for i, j in a[] {
                    if i != 0 { stream:.write(","); }
                    self.exportValue(j, alias stream);
                }
                stream:.write("]");
            }
        }
    }

    /**
     * Export the type of the argument to the stream
     * */
    prv fn exportUsageType(self, f: Argument, dmut stream: &StringStream) {
        match f.type {
            Ok(Int()) => stream:.write("int");
            Ok(Float()) => stream:.write("float");
            Ok(Str()) => stream:.write("str");
            Ok(a: &Array) => {
                match a[0]? {
                    Ok(Int()) => stream:.write("[int...]");
                    Ok(Float()) => stream:.write("[float...]");
                    Ok(Str()) => stream:.write("[str...]");
                }
            }
        }
    }

    /**
     * Compute the alignment of the arguments in the command line help
     * @returns:
     *    - .0: the alignment of short elements
     *    - .1: the alignment of long elements
     *    - .2: the number of mandatory elements
     *    - .3: the number of optional elements
     * */
    prv fn computeHelpAlignment(self)-> (u32, u32, u32, u32) {
        let mut longAlign = 0u32, mut shortAlign = 0u32;
        let mut nbOptions = 0u32, mut nbMandatory = 0u32;
        for i in self._positions {
            if cast!u32(i.long.len) > longAlign {
                longAlign = cast!u32(i.long.len);
            }
        }

        for i in self._options {
            if cast!u32(i.long.len + 2) > longAlign { // -short, --long + 4 space before and after
                longAlign = cast!u32(i.long.len + 2);
            }

            if (i.short != "" && cast!u32(i.short.len + 1) > shortAlign) {
                shortAlign = cast!u32(i.short.len + 1);
            }

            if (i.isMandatory) nbMandatory += 1;
            else nbOptions += 1;
        }

        for i in self._flags {
            if cast!u32(i.long.len + 2) > longAlign { // -short, --long + 4 space before and after
                longAlign = cast!u32(i.long.len + 2);
            }

            if (i.short != "" && cast!u32(i.short.len + 1) > shortAlign) {
                shortAlign = cast!u32(i.short.len + 1);
            }

            nbOptions += 1;
        }

        for i in self._helps {
            if cast!u32(i.long.len + 2) > longAlign { // -short, --long + 4 space before and after
                longAlign = cast!u32(i.long.len + 2);
            }

            if (i.short != "" && cast!u32(i.short.len + 1) > shortAlign) {
                shortAlign = cast!u32(i.short.len + 1);
            }

            nbOptions += 1;
        }

        for i in self._subCommands {
            if cast!u32(i.long.len + 2) > longAlign {
                longAlign = cast!u32(i.long.len + 2);
            }

            if (i.short != "" && cast!u32(i.short.len + 1) > shortAlign) {
                shortAlign = cast!u32(i.short.len + 1);
            }

            if (i.isMandatory) nbMandatory += 1;
            else nbOptions += 1;
        }

        (shortAlign + 2, longAlign + 2, nbMandatory, nbOptions)
    }

    /**
     * Export the helper of an option to the stream
     * @params:
     *    - o: the option to export
     *    - stream: the stream to fill
     *    - aligns: the short and long alignements
     *    - hyphenated: add hyphens before option name
     * */
    prv fn exportHelpOption(self, o: Argument, dmut stream: &StringStream, aligns: (u32, u32), hyphenated: bool = true) {
        for _ in 0 .. 4 {
            stream:.write(" ");
        }

        let written = if (hyphenated && o.short.len != 0) {
            stream:.write("-", o.short, ",");
            cast!u32(o.short.len + 2)
        } else { 0 };

        for _ in written .. aligns.0 {
            stream:.write(" ");
        }

        if (hyphenated) {
            stream:.write("--", o.long);
        } else {
            stream:.write("  ", o.long);
        }

        for _ in cast!u32(o.long.len + 2) .. aligns.1 {
            stream:.write(" ");
        }

        stream:.write(o.comments);
        if let Ok(d) = o.defaultValue {
            if o.comments != "" { stream:.write(" "); }
            stream:.write("(default: ");
            self.exportValue(d, alias stream);
            stream:.write(")");
        }

        stream:.writeln("");
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          EXPLAINING          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Explain an malformed error
     * */
    prv fn explainMalformed(self, m: &MalformedArgument)-> [c8] {
        let dmut stream = copy StringStream();
        stream:.write("error parsing argument '", m.key, "'");
        let mut subError = m.subError;

        while let Ok(sub) = subError {
            stream:.write(":\n\t=> ");
            match sub {
                innerM: &MalformedArgument => {
                    stream:.write("error parsing argument '", innerM.key, "'");
                    subError = innerM.subError;
                }
                im: &MissingArgument => {
                    stream:.write("missing argument '" ~ im.key ~ "'");
                    break;
                }
                im: &UnknownArgument => {
                    stream:.write("unknown argument '" ~ im.key ~ "'");
                    break;
                }
                c: &CastFailure => {
                    stream:.write("incompatible types: ", c.from.name, " => ", c.to.name);
                    break;
                }
                _ => {
                    stream:.write(sub);
                    break;
                }
            }
        }

        stream[]
    }


}
