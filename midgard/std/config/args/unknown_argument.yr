in unknown_argument;

use std::config::args::command_line_error;

use std::stream;

/**
 * Error thrown when an argument is missing in command line
 * */
@final
pub class UnknownArgument over CommandLineError {
    pub let key: [c8];

    pub self (key: [c8])
        with key = key
    {}

    impl stream::Streamable {
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write(self.__typeinfo__.name):.write(" (", self.key, ")");
            if (self.hasTrace()) {
                stream:.writeln(""):.write(":"):.write(self.getStackTrace());
            }
        }
    }
}
