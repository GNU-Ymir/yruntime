/**
 * Json dumper to dump a json string from a configuration
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in dumper;

use std::stream;


/**
 * A json dumper that produces an utf8 string from a configuration
 * */
pub record JsonDumper {

    // The root node of the config to dump
    let _root: &Config;

    // The number of spaces per level of nesting, none to dump on a single line
    let _indent: (u32)?;

    /**
     * @params:
     *    - root: the configuration to dump
     *    - indent: the number of spaces per level of nesting, each entry on its own line, `0` putting them on their own line without indenting them, none to dump on a single line
     * */
    pub self (root: &Config, indent: (u32)? = none)
        with _root = root, _indent = indent
    {}

    /**
     * Dump the configuration to an utf8 string
     * */
    pub fn dump(self)-> [c8] {
        let dmut res = copy StringStream();
        self.dump(self._root, alias res, 0u32);

        res[]
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATES          ====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Dump the configuration to the stream
     * @params:
     *    - c: the configuration to dump
     *    - stream: the stream to fill
     *    - depth: the level of nesting of `c`
     * */
    prv fn dump(self, c: &Config, dmut stream: &StringStream, depth: u32) {
        match c {
            d: &Dict => {
                self.dumpDict(d, alias stream, depth);
            }
            a: &Array => {
                self.dumpArray(a, alias stream, depth);
            }
            Int(value-> i) => {
                stream:.write(i);
            }
            Float(value-> f) => {
                stream:.write(f);
            }
            Bool(value-> b) => {
                if (b) stream:.write("true");
                else   stream:.write("false");
            }
            Str(value-> s) => {
                self.dumpString(s, alias stream);
            }
            None() => {
                stream:.write("null");
            }
        }
    }

    /**
     * Write `s` to `stream`, wrapped in double quotes, with `"`, `\` and control characters escaped
     * (as `\uXXXX` when they have no shorter form), so the result is valid json and round-trips
     * through `JsonParser`
     * @params:
     *    - s: the string to write
     *    - stream: the stream to fill
     * */
    prv fn dumpString(self, s: [c8], dmut stream: &StringStream) {
        stream:.write("\"");
        for c in s {
            match c {
                '"' => { stream:.write("\\\""); }
                '\\' => { stream:.write("\\\\"); }
                '\n' => { stream:.write("\\n"); }
                '\r' => { stream:.write("\\r"); }
                '\t' => { stream:.write("\\t"); }
                '\b' => { stream:.write("\\b"); }
                '\f' => { stream:.write("\\f"); }
                _ => {
                    let u = cast!u8(c);
                    if u < 0x20u8 || u == 0x7Fu8 {
                        let hex = "0123456789ABCDEF";
                        stream:.write("\\u00", hex[u >> 4u8], hex[u & 0xFu8]);
                    } else {
                        stream:.write(c);
                    }
                }
            }
        }
        stream:.write("\"");
    }

    /**
     * Write the separator before the element of a dict or an array at the level of nesting `depth`
     * @params:
     *    - first: true if it is the first element of its container, false otherwise
     * */
    prv fn separate(self, dmut stream: &StringStream, first: bool, depth: u32) {
        if let Ok(n) = self._indent {
            if !first {
                stream:.write(",");
            }

            self.newLine(alias stream, n, depth);
        } else if !first {
            stream:.write(", ");
        }
    }

    /**
     * Write the end of line closing a non empty dict or array at the level of nesting `depth`
     * */
    prv fn close(self, dmut stream: &StringStream, depth: u32) {
        if let Ok(n) = self._indent {
            self.newLine(alias stream, n, depth);
        }
    }

    /**
     * Write a new line indented by `n` spaces per level of nesting
     * */
    prv fn newLine(self, dmut stream: &StringStream, n: u32, depth: u32) {
        stream:.write("\n");
        for _ in 0u32 .. n * depth {
            stream:.write(" ");
        }
    }

    /**
     * Dump an array in json format
     * @params:
     *    - a: the array to dump
     *    - stream: the stream to fill
     *    - depth: the level of nesting of `a`
     * */
    prv fn dumpArray(self, a: &Array, dmut stream: &StringStream, depth: u32) {
        stream:.write("[");
        for i, v in a[] {
            self.separate(alias stream, i == 0us, depth + 1u32);
            self.dump(v, alias stream, depth + 1u32);
        }

        if a.len != 0us {
            self.close(alias stream, depth);
        }

        stream:.write("]");
    }

    /**
     * Dump a dictionnary in json format, its keys sorted, so that dumping twice produces the same text
     * @params:
     *    - d: the dict to dump
     *    - stream: the stream to fill
     *    - depth: the level of nesting of `d`
     * */
    prv fn dumpDict(self, d: &Dict, dmut stream: &StringStream, depth: u32) {
        stream:.write("{");
        let mut first = true;
        let content = d[];
        for k in d.sortedKeys() {
            if let Ok(v) = content[k] {
                self.separate(alias stream, first, depth + 1u32);
                self.dumpString(k, alias stream);
                stream:.write(": ");
                self.dump(v, alias stream, depth + 1u32);
                first = false;
            }
        }

        if !first {
            self.close(alias stream, depth);
        }

        stream:.write("}");
    }

}
