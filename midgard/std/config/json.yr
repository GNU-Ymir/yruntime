in json;

mod ::dumper;
mod ::parser;
mod ::utils;

pub def parse = utils::parse;
pub def dump = utils::dump;

/**
 * Macro that can be used to write json like content directly in Ymir.
 * @example:
 * ```
 * let x = json#{
 *     "fst" : {
 *           "foo" : {"bar" : "baz"},
 *           "scd" : [1, "inner", 2.0f, 3]
 *     }
 * };
 *
 * println(x);
 *
 * let j = json#{
 *     "id": "file",
 *     "value": "File",
 *     "popup": {
 *         // Ignored comments
 *         "menuitem": [
 *            {"value": "New", "onclick": "CreateNewDoc()"},
 *            {"value": "Open", "onclick": "OpenDoc()"},
 *            {"value": "Close", "onclick": "CloseDoc()"}]
 *     }
 * };
 *
 * println(j);
 * ```
 */
pub macro json {
    self (a=(dictEntry) b=("," inner=(dictEntry))* (" " | "\n" | "\t" | "\r")*) skips(" " | "\n" | "\t" | "\r") #{
        {
            let dmut d_#{__index} = copy Dict();
            let v_#{__index}_base = #{a};
            d_#{__index}[v_#{__index}_base._0] = v_#{__index}_base._1;
            #(for x in b) {{
                let v_#{__index} = #{x::inner};
                d_#{__index}[v_#{__index}._0] = v_#{__index}._1;
            }}
            alias d_#{__index}
        }
    }

    fn dict("{" a=(dictEntry) b=("," inner=dictEntry)* "}") skips(" " | "\n" | "\t" | "\r") #{
        {
            let dmut d_#{__index} = copy Dict();
            let v_#{__index}_base = #{a};
            d_#{__index}[v_#{__index}_base._0] = v_#{__index}_base._1;
            #(for x in b) {{
                let v_#{__index} = #{x::inner};
                d_#{__index}[v_#{__index}._0] = v_#{__index}._1;
            }}

            alias d_#{__index}
        }
    }

    fn emptyDict("{" "}") skips(" " | "\n" | "\t" | "\r") #{
        {
            copy Dict()
        }
    }

    fn array("[" a=(array | dict | emptyDict | nullValue | value) b=("," inner=(array | dict | emptyDict | nullValue | value))* "]") skips(" " | "\n" | "\t" | "\r") #{
        {
            let dmut array_#{__index} = copy Array();
            array_#{__index}:.push(#{a});
            #(for i in b) {
                array_#{__index}:.push(#{i::inner});
            }
            alias array_#{__index}
        }
    }

    fn dictEntry(key=__str ":" value=(array | dict | emptyDict | nullValue | value)) skips(" " | "\n" | "\t" | "\r") #{(std::conv::to!{[c8]} (#{key}), #{value})}
    fn nullValue(__key["null"]) skips(" " | "\n" | "\t" | "\r") #{
        copy std::config::None()
    }

    fn value(a=__expr) skips(" " | "\n" | "\t" | "\r") #{
        std::config::to!{&Config} (#{a})
    }
}
