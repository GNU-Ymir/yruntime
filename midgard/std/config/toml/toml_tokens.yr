in toml_tokens;

/**
 * The list of tokens that can be found inside a Toml file
 *
 */
pub enum TomlTokens
| LCRO   = "["
| RCRO   = "]"
| LACC   = "{"
| RACC   = "}"
| EQUALS = "="
| COMA   = ","
| QUOTE  = "'"
| DQUOTE = "\""
| ESCAPE = "\\";
