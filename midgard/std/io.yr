in io;

mod ::utils;

use std::traits;
use std::io::utils;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          CHARS          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print a char to stdout.
 */
pub fn print(c: c8)  {
    putc(c, utils::_yrt_stdout())
}

/**
 * Print an utf8 char to stderr.
 */
pub fn eprint(c: c8) {
    putc(c, utils::_yrt_stderr());
}

/**
 * Print an utf32 char to stdout.
 */
pub fn print(c: c32)  {
    let dmut rets: [c8 ; 4] = ['\u{0}' ; 4];

    let nbProduced = std::conv::utf::toUtf8(c, ref rets);
    utils::fwrite(rets.ptr, 1us, cast!usize(nbProduced), utils::_yrt_stdout());
}

/**
 * Print an utf32 char to stderr.
 */
pub fn eprint(c: c32) {
    let dmut rets: [c8 ; 4] = ['\u{0}' ; 4];

    let nbProduced = std::conv::utf::toUtf8(c, ref rets);
    utils::fwrite(rets.ptr, 1us, cast!usize(nbProduced), utils::_yrt_stderr());
}

/**
 * Print an utf16 char to stdout
 * */
pub fn print(c: c16) {
    let dmut rets: [c8 ; 4] = ['\u{0}' ; 4];

    let nbProduced = std::conv::utf::toUtf8(c, ref rets);
    utils::fwrite(rets.ptr, 1us, cast!usize(nbProduced), utils::_yrt_stdout());
}

/**
 * Print an utf16 char to stderr
 * */
pub fn eprint(c: c16) {
    let dmut rets: [c8 ; 4] = ['\u{0}' ; 4];

    let nbProduced = std::conv::utf::toUtf8(c, ref rets);
    utils::fwrite(rets.ptr, 1us, cast!usize(nbProduced), utils::_yrt_stderr());
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          STRINGS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print an utf32 string to stdout.
 */
pub fn print(s: [c32]) {
    utils::flockfile(utils::_yrt_stdout());
    for c in s {
        print(c);
    }
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print an utf32 string to stderr.
 */
pub fn eprint(s:  [c32]) {
    utils::flockfile(utils::_yrt_stderr());
    for c in s {
        eprint(c);
    }
    utils::funlockfile(utils::_yrt_stderr());
}

/**
 * Print an utf16 string to stdout.
 */
pub fn print(s: [c16]) {
    if s.len == 0 { return; }
    utils::flockfile(utils::_yrt_stdout());

    let dmut codes = ['\u{0}'c8 ; 4];
    let mut i = 0us;
    while i < s.len - 1 {
        let (nbConsumed, nbProduced) = std::conv::utf::toUtf8((s[i], s[i + 1]), ref codes);
        for z in 0 .. nbProduced {
            putc(codes[z], utils::_yrt_stdout());
        }

        i += cast!usize(nbConsumed);
    }

    if i == s.len - 1 {
        print(s[$ - 1]);
    }
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print an utf16 string to stdout.
 */
pub fn eprint(s: [c16]) {
    if s.len == 0 { return; }
    utils::flockfile(utils::_yrt_stderr());

    let dmut codes = ['\u{0}'c8 ; 4];
    let mut i = 0us;
    while i < s.len - 1 {
        let (nbConsumed, nbProduced) = std::conv::utf::toUtf8((s[i], s[i + 1]), ref codes);
        for z in 0 .. nbProduced {
            putc(codes[z], utils::_yrt_stderr());
        }

        i += cast!usize(nbConsumed);
    }

    if i == s.len - 1 {
        eprint(s[$ - 1]);
    }
    utils::funlockfile(utils::_yrt_stderr());
}

/**
 * Print an utf8 string to stdout.
 */
pub fn print(s: [c8]) {
    utils::fwrite(s.ptr, 1us, s.len, utils::_yrt_stdout());
}

/**
 * Print an utf8 string to stderr.
 */
pub fn eprint(s: [c8]) {
    utils::fwrite(s.ptr, 1us, s.len, utils::_yrt_stderr());
}

