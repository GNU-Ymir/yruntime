/**
 * Print a bool value to stdout.
 */
pub fn print(b: bool)  {
    if (b)
        fprintf(utils::_yrt_stdout(), "true".ptr);
    else
        fprintf(utils::_yrt_stdout(), "false".ptr);
}

/**
 * Print a bool value to stderr.
 */
pub fn eprint(b: bool)  {
    if (b)
        fprintf(utils::_yrt_stderr(), "true".ptr);
    else
        fprintf(utils::_yrt_stderr(), "false".ptr);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          SLICES          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print a slice of type U to stdout.
 * @params:
 *    - s: a slice to print
 * @templates:
 *    - T: a slice type
 *    - U: any
 */
pub fn print {T of [U], U} (s: T)  {
    utils::flockfile(utils::_yrt_stdout());
    putc('[', utils::_yrt_stdout());
    if s.len > 0 {
        print(s[0]);
        for i in s[1 .. $] {
            putc(',', utils::_yrt_stdout());
            putc(' ', utils::_yrt_stdout());
            print(i);
        }
    }

    putc(']', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print a slice of type U to stderr.
 * @params:
 *    - s: an slice to print
 * @templates:
 *    - T: a slice type
 *    - U: any
 */
pub fn eprint {T of [U], U} (s: T)  {
    utils::flockfile(utils::_yrt_stderr());
    eprint('[');
    if s.len > 0 {
        eprint(s[0]);
        for i in s[1 .. $] {
            fprintf(utils::_yrt_stderr(), ", ".ptr);
            eprint(i);
        }
    }

    eprint(']');
    utils::funlockfile(utils::_yrt_stderr());
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ======================================          MAP          =======================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print a map of type K => V to stdout
 * @params:
 *    - m: the map to print
 * */
pub fn print {M of [K => V], K, V} (m: M) {
    utils::flockfile(utils::_yrt_stdout());
    putc('[', utils::_yrt_stdout());
    let mut fst = true;
    for k, v in m {
        if (!fst) {
            putc(',', utils::_yrt_stdout());
            putc(' ', utils::_yrt_stdout());
        } else fst = false;

        print(k);
        print(" => ");
        print(v);
    }
    putc(']', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print a map of type K => V to stderr
 * @params:
 *    - m: the map to print
 * */
pub fn eprint {M of [K => V], K, V} (m: M) {
    utils::flockfile(utils::_yrt_stderr());
    eprint('[');
    let mut fst = true;
    for k, v in m {
        if (!fst) {
            eprint(',');
            eprint(' ');
        } else fst = false;

        eprint(k);
        eprint(" => ");
        eprint(v);
    }
    eprint(']');
    utils::funlockfile(utils::_yrt_stderr());
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          ARRAYS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print a static array of type U to stdout
 * @params:
 *    - a: an array to print
 * @templates:
 *    - T: an static array type
 *    - U: any
 *    - N: the static size
 */
pub fn print {T of [U;N], U, N: usize} (a: T)  {
    utils::flockfile(utils::_yrt_stdout());
    putc('[', utils::_yrt_stdout());
    cte if N > 0 {
        print(a[0]);
        for i in a[1 .. $] {
            putc(',', utils::_yrt_stdout());
            putc(' ', utils::_yrt_stdout());
            print(i);
        }
    }
    putc(']', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print a static array of type U to stderr
 * @params:
 *    - a: an array to print
 * @templates:
 *    - T: an static array type
 *    - U: any
 *    - N: the static size
 */
pub fn eprint {T of [U;N], U, N: usize} (a: T)  {
    utils::flockfile(utils::_yrt_stderr());
    eprint('[');
    cte if N > 0 {
        eprint(a[0]);
        for i in a[1 .. $] {
            fprintf(utils::_yrt_stderr(), ", ".ptr);
            eprint(i);
        }
    }
    eprint(']');
    utils::funlockfile(utils::_yrt_stderr());
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          RANGES          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print a range type to stdout
 * @params:
 *    - a: the value of type range
 * @template:
 *    - T: any type
 * */
pub fn print {T} (a: ..T) {
    print("range!", T::typeid, " (", a.fst, "->", a.scd, " by ", a.step, " ? ", a.contains, ')');
}

/**
 * Print a range type to stderr
 * @params:
 *    - a: the value of type range
 * @template:
 *    - T: any type
 * */
pub fn eprint {T} (a: ..T) {
    eprint("range!", T::typeid, " (", a.fst, "->", a.scd, " by ", a.step, " ? ", a.contains, ')');
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          OPTIONS          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Print an option type to stdout
 * @params:
 *   - a: a value of type option
 * @templates:
 *   - T: any type
 */
pub fn print {T} (a: T?)  {
    cte if (!(template!{T}{U of void})) {
        match a {
            Ok(x) => print("Ok(", x, ")");
            Err(msg) => print("Err(", msg, ")");
            Err() => print("Err()");
        }
    } else {
        match a {
            Ok() => print("Ok()");
            Err(msg) => print("Err(", msg, ")");
            Err() => print("Err()");
        }
    }
}

/**
 * Print an option type to stderr.
 * @params:
 *   - a: a value of type option
 * @templates:
 *   - T: any type
 */
pub fn eprint {T} (a: T?)  {
    cte if (!(template!{T}{U of void})) {
        match a {
            Ok(x) => eprint("Ok(", x, ")");
            Err(msg) => eprint("Err(", msg, ")");
            Err() => eprint("Err()");
        }
    } else {
        match a {
            Ok() => eprint("Ok()");
            Err(msg) => eprint("Err(", msg, ")");
            Err() => eprint("Err()");
        }
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          TUPLES          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Print a tuple to stdout
 * @params:
 *    - a: a tuple of arbitrary arity
 */
pub fn print {T of (U,), U...} (a: T) {
    utils::flockfile(utils::_yrt_stdout());
    print('(');
    cte if T::arity > 0 {
        print(a.0);
        cte for i in 1 .. T::arity {
            putc(',', utils::_yrt_stdout());
            putc(' ', utils::_yrt_stdout());
            print(a.i);
        }
    }

    cte if (T::arity == 1) putc(',', utils::_yrt_stdout());
    putc(')', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}


/**
 * Print a tuple to stderr
 * @params:
 *    - a: a tuple of arbitrary arity
 */
pub fn eprint {T of (U,), U...} (a: T) {
    utils::flockfile(utils::_yrt_stderr());
    eprint('(');
    cte if T::arity > 0 {
        eprint(a.0);
        cte for i in 1 .. T::arity {
            fprintf(utils::_yrt_stderr(), ", ".ptr);
            eprint(a.i);
        }
    }

    cte if (T::arity == 1) fprintf(utils::_yrt_stderr(), ",)".ptr);
    else {
        fprintf(utils::_yrt_stderr(), ")".ptr);
    }
    utils::funlockfile(utils::_yrt_stderr());
}

/**
 * Print an empty tuple to stdout
 * */
pub fn print(_: ()) {
    utils::flockfile(utils::_yrt_stdout());
    putc('(', utils::_yrt_stdout());
    putc(')', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print an empty tuple to stderr
 * */
pub fn eprint(_: ()) {
    fprintf(utils::_yrt_stderr(), "()".ptr);
}


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          CLASS/STRUCTS          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print a class or a record object to stdout
 * @params:
 *    - a: the object to print
 * */
pub fn if (template!{T}{class C} || template!{T}{record R}) print {T} (a: T) {
    let dmut stream = copy std::stream::StringStream();
    stream:.write(a);
    print(stream[]);
}

/**
 * Print a record or entity to stdout
 * @params:
 *    - a: the object to print
 * */
pub fn if (template!{T}{record R} || template!{T}{entity E}) print {T} (ref a: T) {
    let dmut stream = copy std::stream::StringStream();
    stream:.write(a);
    print(stream[]);
}

/**
 * Print a class or a record object to stderr
 * @params:
 *    - a: the object to print
 * */
pub fn if (template!{T}{class C} || template!{T}{record R}) eprint {T} (a: T) {
    let dmut stream = copy std::stream::StringStream();
    stream:.write(a);
    eprint(stream[]);
}

/**
 * Print a record or entity to stderr
 * @params:
 *    - a: the object to print
 * */
pub fn if (template!{T}{record R} || template!{T}{entity E}) eprint {T} (ref a: T) {
    let dmut stream = copy std::stream::StringStream();
    stream:.write(a);
    eprint(stream[]);
}

/**
 * Print a union to stdout, as `std::stream::StringStream` writes it
 * @params:
 *    - a: the union to print
 * */
pub fn if (template!{T}{union U}) print {T} (a: T) {
    let dmut stream = copy std::stream::StringStream();
    stream:.write(a);
    print(stream[]);
}

/**
 * Print a union to stderr, as `std::stream::StringStream` writes it
 * @params:
 *    - a: the union to print
 * */
pub fn if (template!{T}{union U}) eprint {T} (a: T) {
    let dmut stream = copy std::stream::StringStream();
    stream:.write(a);
    eprint(stream[]);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          VARIADICS          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


/**
 * Print multiple elements to stdout
 * */
pub fn print  {F, T...} (a: F, b: T) {
    utils::flockfile(utils::_yrt_stdout());
    print(a);
    cte if ((T,)::arity >= 2us) {
        cte for i in b {
            print(i);
        }
    } else {
        print(b);
    }
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print multiple elements to stderr
 * */
pub fn eprint  {F, T...} (a: F, b: T) {
    utils::flockfile(utils::_yrt_stderr());
    eprint(a);
    cte if ((T,)::arity >= 2us) {
        cte for i in b {
            eprint(i);
        }
    } else {
        eprint(b);
    }
    utils::funlockfile(utils::_yrt_stderr());
}


/**
 * Print variadic elements to stdout, and end the writing by a line return
 * */
pub fn println {F, T...} (a: F, b: T) {
    utils::flockfile(utils::_yrt_stdout());
    print(a);
    cte if ((T,)::arity >= 2us) {
        cte for i in b {
            print(i);
        }
    } else {
        print(b);
    }
    putc('\n', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print an element to stdout, and end the writing by a line return
 * */
pub fn println {T} (a: T) {
    utils::flockfile(utils::_yrt_stdout());
    print(a);
    putc('\n', utils::_yrt_stdout());
    utils::funlockfile(utils::_yrt_stdout());
}

/**
 * Print a line return to stdout.
 */
pub fn println() {
    putc('\n', utils::_yrt_stdout());
}

/**
 * Print variadic elements to stderr, and end the writing by a line return
 * */
pub fn eprintln {F, T...} (a: F, b: T) {
    utils::flockfile(utils::_yrt_stderr());
    eprint(a);
    cte if ((T,)::arity >= 2us) {
        cte for i in b {
            eprint(i);
        }
    } else {
        eprint(b);
    }
    fprintf(utils::_yrt_stderr(), "\n".ptr);
    utils::funlockfile(utils::_yrt_stderr());
}

/**
 * Print an element to stdout, and end the writing by a line return
 * */
pub fn eprintln {T} (a: T) {
    utils::flockfile(utils::_yrt_stderr());
    eprint(a);
    fprintf(utils::_yrt_stderr(), "\n".ptr);
    utils::funlockfile(utils::_yrt_stderr());
}

/**
 * Print a line return to stdout.
 */
pub fn eprintln() {
    fprintf(utils::_yrt_stderr(), "\n".ptr);
}

/**
 * Flush stdout, writing out immediately whatever `print` and `println` left buffered.
 * @example:
 * ```
 * use std::io;
 *
 * print("working...");
 * flush();
 * ```
 */
pub fn flush() {
    utils::_yrt_fflush_stdout();
}

/**
 * Termination of variadic execution
 * @info: does nothing
 * */
fn print() {}

/**
 * Termination of variadic execution
 * @info: does nothing
 * */
fn eprint() {}


/*!
 * =========================================================================================
 * =========================================================================================
 * ===============                            SCAN                  ========================
 * =========================================================================================
 * =========================================================================================
 * */

/**
 * Read a i32 from the stdin
 * @returns: a i32
 */
pub fn if isIntegral!{T} read {T} (ask: [c8] = "")-> T {
    print(ask);
    utils::_yrt_fflush_stdout();
    let mut x: T = 0;
    cte if 4 >= T::size  {
        scanf("%d"s8.ptr, &x);
    } else {
        scanf("%ld"s8.ptr, &x);
    }
    x
}

/**
 * Read a c8 from the stdin
 * @returns: a c8
 */
pub fn read {T of c8} (ask: [c8] = "")-> c8 {
    print(ask);
    utils::_yrt_fflush_stdout();
    let mut x: c8 = '\u{0}'c8;
    if (utils::etc::read(utils::etc::stdin, alias &x, 1us) == 0) {
        return '\u{0}';
    }
    x
}

/**
 * Read a utf8 string from the stdin
 * @info: this function waits for a line termination char
 * @returns: a[c8]
 */
pub fn read {T of [U], U of c8} (ask: [c8] = "")-> [c8] {
    print(ask);
    utils::_yrt_fflush_stdout();
    let dmut v: [U] = [];
    loop {
        let mut c = '\u{0}'c8;
        let size = utils::etc::read(utils::etc::stdin, alias &c, 1us);
        if (size != 0) {
            if (c == '\n') break;
            v ~= [c];
        } else break;
    }

    v
}
