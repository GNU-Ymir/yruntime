/**
 * This module implements the cryptographic digests, which reduce a message of any length to a
 * value of a fixed size that nobody can choose a message to match, and the HMAC message
 * authentication code built on them.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * Each digest comes as a function digesting a whole message at once, and as a class absorbing it
 * piece by piece through `update`, whose `finish` returns the digest and starts a new message. A
 * message is a sequence of bytes, a slice or a static array of `u8`, or a string, digested as its
 * UTF-8 bytes. To detect accidental corruption only, `std::checksum` is cheaper.
 * @warning: MD5 and SHA-1 are broken, they are only here for the formats and protocols that
 * require them. Use SHA-256 or SHA-512 for anything else.
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha256("hello")));
 *
 * let dmut h = copy Sha256();
 * h:.update("hel");
 * h:.update("lo");
 * assert(h:.finish() == sha256("hello"));
 *
 * let code = hmac!{&Sha256} ("secret key", "hello");
 * assert(equals(code, hmac!{&Sha256} ("secret key", "hello")));
 * ```
 */

in digest;

mod ::block;
mod ::hmac_;
mod ::md5_;
mod ::sha1_;
mod ::sha224_;
mod ::sha256_;
mod ::sha384_;
mod ::sha512_;
mod ::utils;

pub def Hmac = hmac_::Hmac;
pub def Md5: md5_::Md5;
pub def Sha1: sha1_::Sha1;
pub def Sha224: sha224_::Sha224;
pub def Sha256: sha256_::Sha256;
pub def Sha384: sha384_::Sha384;
pub def Sha512: sha512_::Sha512;

pub def md5 = utils::md5;
pub def sha1 = utils::sha1;
pub def sha224 = utils::sha224;
pub def sha256 = utils::sha256;
pub def sha384 = utils::sha384;
pub def sha512 = utils::sha512;
pub def hmac = utils::hmac;
pub def equals = utils::equals;
