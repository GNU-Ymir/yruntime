/**
 * Containers beyond the builtin slice `[T]` and hashmap `[K => V]`, and the functions using these two
 * as a growable buffer, a map and a set (`[K => ()]`).
 * <br>
 * - `slice`: the capacity of a slice, and the insertions and removals in it (`pop`, `insert`, `removeAt`, ...)
 * - `map`: the keys and values of a hashmap as generators
 * - `Ring`: a double-ended queue in a ring buffer
 * - `PriorityQueue`: a binary heap popping the smallest value first
 * - `OrderedMap`, `OrderedSet`: a map and a set sorted by key, in a balanced binary search tree
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in collection;

pub mod ::slice;
pub mod ::map;
pub mod ::ring;
pub mod ::heap;
pub mod ::ordered_map;
pub mod ::ordered_set;
mod ::tree;

pub def Ring = ring::Ring;
pub def PriorityQueue = heap::PriorityQueue;
pub def OrderedMap = ordered_map::OrderedMap;
pub def OrderedSet = ordered_set::OrderedSet;
