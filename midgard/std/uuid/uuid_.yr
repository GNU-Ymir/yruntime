in uuid_;

use std::stream;
use std::uuid::utils;

/**
 * A 128 bits universally unique identifier, as defined by RFC 9562
 * @example:
 * ```
 * use std::{conv, uuid};
 *
 * let id = Uuid([0x01u8, 0x99u8, 0x3au8, 0x18u8, 0x4fu8, 0x0eu8, 0x7cu8, 0xdbu8,
 *                0xb3u8, 0x2eu8, 0xc6u8, 0x62u8, 0x1eu8, 0x1au8, 0x64u8, 0x4bu8]);
 *
 * assert(id.version == 7u8);
 * assert(id.variant == UuidVariant::RFC9562);
 * assert(id.to![c8] () == "01993a18-4f0e-7cdb-b32e-c6621e1a644b");
 * ```
 */
pub record Uuid {

    // The 16 bytes of the identifier, most significant first
    let _bytes: [u8 ; 16];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          CTORS          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @params:
     *    - bytes: the 16 bytes of the identifier, most significant first
     */
    pub self (bytes: [u8 ; 16])
        with _bytes = bytes
    {}

    /**
     * @returns: the nil UUID, whose 128 bits are all zero
     * @example:
     * ```
     * use std::{conv, uuid};
     *
     * assert(Uuid::nil().isNil());
     * assert(Uuid::nil().to![c8] () == "00000000-0000-0000-0000-000000000000");
     * ```
     */
    pub self nil()
        with _bytes = [0u8 ; 16]
    {}

    /**
     * @returns: the max UUID, whose 128 bits are all one
     * @example:
     * ```
     * use std::{conv, uuid};
     *
     * assert(Uuid::max().to![c8] () == "ffffffff-ffff-ffff-ffff-ffffffffffff");
     * ```
     */
    pub self max()
        with _bytes = [0xffu8 ; 16]
    {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          GETTERS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the 16 bytes of the identifier, most significant first
     */
    @field
    pub fn bytes(self)-> [u8 ; 16] {
        self._bytes
    }

    /**
     * @returns: the version of the identifier, `4` and `7` being the ones generated by this module
     */
    @field
    pub fn version(self)-> u8 {
        self._bytes[6] >> 4u8
    }

    /**
     * @returns: the layout of the identifier, `UuidVariant::RFC9562` for the ones generated by
     * this module
     */
    @field
    pub fn variant(self)-> UuidVariant {
        let b = self._bytes[8];
        if (b & 0x80u8) == 0u8 { UuidVariant::NCS }
        else if (b & 0x40u8) == 0u8 { UuidVariant::RFC9562 }
        else if (b & 0x20u8) == 0u8 { UuidVariant::MICROSOFT }
        else { UuidVariant::FUTURE }
    }

    /**
     * @returns: true iif the 128 bits of the identifier are all zero
     */
    pub fn isNil(self)-> bool {
        for i in 0us .. 16us {
            if self._bytes[i] != 0u8 return false;
        }

        true
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ===================================          COMPARISON          ===================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Compare the two identifiers byte by byte, most significant first, so version 7 identifiers
     * sort by the instant they were generated
     * @example:
     * ```
     * use std::uuid;
     *
     * let a = v7();
     * let b = v7();
     *
     * assert(a < b);
     * assert(a == a);
     * ```
     */
    pub fn opCmp(self, o: Uuid)-> i32 {
        for i in 0us .. 16us {
            if self._bytes[i] > o._bytes[i] return 1;
            if self._bytes[i] < o._bytes[i] return -1;
        }

        0
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          MISC          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    impl Streamable {

        /**
         * Write the identifier in the canonical `8-4-4-4-12` lower case hexadecimal form
         */
        pub over toStream(self, dmut stream: &StringStream) {
            for i in 0us .. 16us {
                if i == 4us || i == 6us || i == 8us || i == 10us {
                    stream:.write('-'c8);
                }

                stream:.write(hexDigit(self._bytes[i] >> 4u8), hexDigit(self._bytes[i]));
            }
        }
    }

    impl core::types::Hashable;
}
