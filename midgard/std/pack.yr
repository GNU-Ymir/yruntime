/**
 * This module packs values into bytes, and rebuilds them from those bytes, in another thread, process or machine.
 * Classes and records opt in with the tag `#[packable]`, which implements the trait `Packable`; scalars, slices, static arrays, maps, tuples, options and enums of packable types are packable as they are.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * An object is rebuilt as an instance of its own class, which the packet names: `unpack!{&Shape}` rebuilds a `Square`, if `Square` is a subclass of `Shape` tagged `#[packable]`. A packet can only name such a class, and only where the type of the value it is read into allows it, so it never picks an arbitrary class of the program. The objects are allocated without calling a constructor and filled from the packet, and none of them is visible before the whole packet is read: on an error, they are dropped without their destructor ever running.
 * The sharing of the objects is kept: an object referenced twice is packed once and rebuilt once, and a cycle is rebuilt as a cycle. Slices, maps, tuples and records are values, packed in full wherever they appear, and rebuilt in fresh memory.
 * <br>
 * A packet can be authenticated, by a `Signer` holding a key the receiver holds too: its `Verifier` checks the tag of the packet, and that it was not received already, before any byte of its payload is read. A packet that is not authenticated is only read by `unpack` without a verifier, or by a verifier built to accept it, never because the packet says so.
 * <br>
 * The format of a packet is, in little-endian, a varint being an unsigned LEB128 in its shortest form:
 * ```text
 * Packet      := Header Value(T) Tag
 * Header      := "YPK" 0x02 auth-alg (u8) key-id (u32) sequence (u64) payload-len (u64),
 *                key-id and sequence being 0 if auth-alg is 0, payload-len the number of bytes of Value(T)
 * Tag         := nothing if auth-alg is 0, the 32 bytes of HMAC-SHA-256 (every byte before the tag, then the context) if it is 1
 * Value(T)    := bool: 0x00 | 0x01      integers, chars, f32, f64: their bytes      isize, usize: 8 bytes
 *              | slice, map: varint length, then its elements, or its keys each followed by its value
 *              | static array, tuple, record: their elements, or fields, in order
 *              | option: 0x00 (empty, its error is not packed) | 0x01 Value(U)
 *              | enum: the value of its member
 *              | class: ObjRef
 * ObjRef      := varint k: the k-th object of the packet, or a new one if k is the number of objects so far,
 *                followed by TypeRef and the fields of the object, those of its ancestors first
 * TypeRef     := varint t: the t-th type entry of the packet, or a new one if t is the number of entries so far,
 *                followed by the class name (varint length, bytes) and the fingerprint of its fields (u64)
 * ```
 * Sender and receiver must be built from the same definitions of their classes: a class whose fields differ is refused, as is a class the receiver does not know. A packet whose content does not follow the format is refused with an `UnpackError` telling why, never read out of its bounds.
 * @example:
 * ```
 * use std::pack::_;
 *
 * #[packable]
 * class Node {
 *     pub let value: i32;
 *     pub let mut next: (&Node)? = none;
 *     pub self (value: i32) with value = value {}
 * }
 *
 * let dmut a = copy Node(1);
 * let dmut b = copy Node(2);
 * a.next = (alias b)?;
 * b.next = (alias a)?;
 *
 * let back = unpack!{&Node} (pack(a));
 * if let Ok(n) = back.next {
 *     assert(n.value == 2);
 * }
 *
 * let (s, l) = unpack!{([c8], [i32])} (pack(("hi", copy [1, 2])));
 * assert(s == "hi" && l == [1, 2]);
 * ```
 */

in pack;

pub mod ::auth;
pub mod ::envelope;
pub mod ::errors;
pub mod ::packable_;
pub mod ::packer;
pub mod ::unpacker;

mod ::utils;

use std::pack::{auth, envelope, errors, packer, unpacker, utils};

/**
 * @returns: a packet holding `value`
 * @warning: panics if `value` holds an object whose class is not tagged `#[packable]`, a subclass of a tagged class that is not tagged itself
 * @example:
 * ```
 * use std::pack;
 *
 * let bytes = pack([1, 2, 3]);
 * assert(bytes[0us .. 4us] == [0x59u8, 0x50u8, 0x4Bu8, 0x02u8]);
 * ```
 */
pub fn pack {T} (value: T)-> [u8] {
    cte assert(isPackable!{T}, T::typeid ~ " cannot be packed");
    let dmut p = copy Packer();
    p:.write(value);
    p:.seal()
}

/**
 * Append a packet holding `value` to `into`
 * @warning: panics if `value` holds an object whose class is not tagged `#[packable]`, a subclass of a tagged class that is not tagged itself
 * @example:
 * ```
 * use std::pack;
 *
 * let dmut buffer: [u8] = [];
 * pack(1, ref buffer);
 * pack("two", ref buffer);
 * assert(buffer.len == 58us);
 * ```
 */
pub fn pack {T} (value: T, ref dmut into: [u8]) {
    cte assert(isPackable!{T}, T::typeid ~ " cannot be packed");
    let dmut p = copy Packer(into-> alias into);
    p:.write(value);
    into = p:.seal();
}

/**
 * @params:
 *    - value: the value to pack
 *    - signer: the signer authenticating the packet, whose next sequence number it takes
 *    - context: the context the packet is sent in, which is not packed: the receiver has to give the same to accept it
 * @returns: a packet holding `value`, authenticated by `signer`
 * @warning: panics if `value` holds an object whose class is not tagged `#[packable]`, a subclass of a tagged class that is not tagged itself
 * @example:
 * ```
 * use std::conv;
 * use std::pack::_;
 *
 * let dmut signer = copy Signer(7u32, "secret".to![u8] ());
 * let bytes = pack(12, alias signer);
 * assert(bytes.len == 61us);
 * ```
 */
pub fn pack {T} (value: T, dmut signer: &Signer, context: [u8] = [])-> [u8] {
    cte assert(isPackable!{T}, T::typeid ~ " cannot be packed");
    let dmut p = copy Packer();
    p:.write(value);
    p:.seal(alias signer, context-> context)
}

/**
 * Rebuild a value of type `T` from the packet `bytes`, every byte of which it has to use. The packet must not be authenticated, see the version taking a `Verifier` for those that are
 * @params:
 *    - bytes: the packet
 *    - maxDepth: the number of objects that can be nested inside one another, as each one costs a frame on the stack; whatever its value, an object is refused when less than `STACK_MARGIN` bytes of stack are left
 * @returns: the value, an object being an instance of `T` or one of its subclasses tagged `#[packable]`
 * @throws:
 *    - &UnpackError: if the packet does not hold a value of type `T`, or is authenticated (UNSUPPORTED_AUTH), see `UnpackErrorCode`
 * @example:
 * ```
 * use std::pack::_;
 *
 * #[packable]
 * record Point {
 *     pub let x: i32;
 *     pub let y: i32;
 *     pub self (x: i32, y: i32) with x = x, y = y {}
 * }
 *
 * let p = unpack!{Point} (pack(Point(1, 2)));
 * assert(p.x == 1 && p.y == 2);
 *
 * let refused = {
 *     unpack!{i32} (pack(1u8));
 *     false
 * } catch {
 *     err: &UnpackError => {
 *         err.code == UnpackErrorCode::TRUNCATED
 *     }
 * };
 *
 * assert(refused);
 * ```
 */
pub fn unpack {T} (bytes: [u8], maxDepth: usize = 1024us)-> dmut T
    throws UnpackError
{
    cte assert(isPackable!{T}, T::typeid ~ " cannot be packed");
    let h = readHeader(bytes);
    if (h.alg != AuthAlgorithm::NONE) {
        tagSize(h.alg);
        throw copy UnpackError(UnpackErrorCode::UNSUPPORTED_AUTH, ALG_OFFSET, "an authenticated packet is unpacked with a Verifier");
    }

    checkFrame(h, bytes.len);
    readPayload!{T} (bytes, maxDepth)
}

/**
 * Rebuild a value of type `T` from the packet `bytes`, once `verifier` has checked it: none of its payload is read before
 * @params:
 *    - bytes: the packet
 *    - verifier: the verifier, recording the sequence number of the packet as received
 *    - context: the context the packet was sent in, see `pack`
 *    - sender: the sender of the packet, the verifier remembering the sequence numbers received for each sender
 *    - maxDepth: the number of objects that can be nested inside one another, see the other version of `unpack`
 * @returns: the value, an object being an instance of `T` or one of its subclasses tagged `#[packable]`
 * @throws:
 *    - &UnpackError: if the verifier refuses the packet (see `Verifier::verify`), or it does not hold a value of type `T`, see `UnpackErrorCode`
 * @example:
 * ```
 * use std::conv;
 * use std::pack::_;
 *
 * let key = "secret".to![u8] ();
 * let dmut signer = copy Signer(7u32, key);
 * let dmut verifier = copy Verifier();
 * verifier:.addKey(7u32, key);
 *
 * assert(unpack!{i32} (pack(12, alias signer), alias verifier) == 12);
 *
 * let refused = {
 *     unpack!{i32} (pack(12), alias verifier);
 *     false
 * } catch {
 *     err: &UnpackError => {
 *         err.code == UnpackErrorCode::UNAUTHENTICATED
 *     }
 * };
 *
 * assert(refused);
 * ```
 */
pub fn unpack {T} (bytes: [u8], dmut verifier: &Verifier, context: [u8] = [], sender: [c8] = "", maxDepth: usize = 1024us)-> dmut T
    throws UnpackError
{
    cte assert(isPackable!{T}, T::typeid ~ " cannot be packed");
    verifier:.verify(bytes, context-> context, sender-> sender);
    readPayload!{T} (bytes, maxDepth)
}

/**
 * Read the payload of the packet `bytes`, whose envelope was checked
 */
fn readPayload {T} (bytes: [u8], maxDepth: usize)-> dmut T
    throws UnpackError
{
    let h = readHeader(bytes);
    let dmut u = copy Unpacker(bytes, HEADER_SIZE, HEADER_SIZE + cast!usize(h.payloadLen), maxDepth-> maxDepth);
    let dmut res = u:.read!{T} ();
    u:.finish();
    utils::keep!{T} (ref res)
}
