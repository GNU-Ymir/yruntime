/**
 * This module declares classes and functions to manage IPv4 and IPv6 addresses.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * @example:
 * ```
 * use std::net;
 *
 * let localhost_v4 = copy Ipv4Addr([127u8, 0u8, 0u8, 1u8]);
 * let localhost_v6 = copy Ipv6Addr([0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 1u16]);
 *
 * let ip_v4 = ("127.0.0.1"s8).to!{&IpAddr} ();
 * assert(ip_v4 == localhost_v4);
 *
 * let ip_v6 = ("::1"s8).to!{&IpAddr} ();
 * assert(ip_v6 == localhost_v6);
 *
 * // an address can be associated to a port
 * let ip_port_v6 = SockAddr(ip_v6, 8080u16);
 * assert(ip_port_v6.ip == localhost_v6);
 * assert(ip_port_v6.port == 8080u16);
 * ```
 */

in net;

pub mod ::tcp;

mod ::ip_addr;
mod ::ipv4_addr;
mod ::ipv6_addr;
mod ::ipv4;
mod ::ipv6;
mod ::sock_addr;
mod ::utils;

pub def IpAddr: ip_addr::IpAddr;
pub def Ipv4Addr: ipv4_addr::Ipv4Addr;
pub def Ipv6Addr: ipv6_addr::Ipv6Addr;
pub def Ipv4: ipv4::Ipv4;
pub def Ipv6: ipv6::Ipv6;
pub def SockAddr: sock_addr::SockAddr;

pub def to = utils::to;
