/**
 * This module implements the record `DateTime`, a date and a time of day read in a given time zone,
 * and the functions rendering one as a text and reading one back.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * A layout is written the way `strftime` writes one, each `%` directive naming a field of the date
 * (`formatter::format` lists them all), and the layouts that matter are named: `DateFormat::ISO8601`,
 * `DateFormat::ISO8601_MICROS`, `DateFormat::RFC1123`, `DateFormat::DATE_ONLY` and `DateFormat::TIME_ONLY`.
 * @example:
 * ```
 * use std::io;
 * use std::time::_;
 * use std::time::date::conv;
 *
 * let today = DateTime(Instant::now());
 * println("Today is: ", today.format(fmt-> DateFormat::DATE_ONLY));
 *
 * // a date knows the zone it is written in, and renders it
 * println("Now is: ", DateTime(Instant::now(), gmt-> true).format(fmt-> DateFormat::ISO8601));
 *
 * // and a date is read back from any layout it can be rendered with
 * let d = ("2026-08-26T14:03:11Z").to!{DateTime} ();
 * assert(d.format(fmt-> DateFormat::RFC1123) == "Wed, 26 Aug 2026 14:03:11 GMT");
 *
 * // dates are points in time, so durations move them, and two dates subtract to one
 * assert((d + (1).days()) - d == (24).hours());
 * ```
 */

in date;

mod ::date_;
mod ::days;
mod ::months;
mod ::formats;
mod ::formatter;
mod ::parser;
mod ::utils;

pub mod ::errors;
pub mod ::conv;

pub def DateTime: date_::DateTime;
pub def Days: days::Days;
pub def Months: months::Months;
pub def DateFormat: formats::DateFormat;
