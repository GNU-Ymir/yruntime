in formats;

/** The layouts a date is commonly written in */
pub enum DateFormat
/** `2026-08-26T14:03:11Z`, the date format of RFC 3339, json, toml and most log lines */
| ISO8601        = "%Y-%m-%dT%H:%M:%S%:z"s8
/** ISO 8601 with the microseconds written after the seconds */
| ISO8601_MICROS = "%Y-%m-%dT%H:%M:%S.%f%:z"s8
/** `Wed, 26 Aug 2026 14:03:11 GMT`, the format of the `Date` header of HTTP, in utc only */
| RFC1123        = "%a, %d %b %Y %H:%M:%S GMT"s8
/** `2026-08-26` */
| DATE_ONLY      = "%Y-%m-%d"s8
/** `14:03:11` */
| TIME_ONLY      = "%H:%M:%S"s8;
