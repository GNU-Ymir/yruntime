in months;


/** The abbreviated english name of a month of the year */
pub enum Months
| JANUARY   = "Jan"s8
| FEBRUARY  = "Feb"s8
| MARCH     = "Mar"s8
| APRIL     = "Apr"s8
| MAY       = "May"s8
| JUNE      = "Jun"s8
| JULY      = "Jul"s8
| AUGUST    = "Aug"s8
| SEPTEMBER = "Sep"s8
| OCTOBER   = "Oct"s8
| NOVEMBER  = "Nov"s8
| DECEMBER  = "Dec"s8;
