in some_;

use std::any::implem;

/**
 * Immutable container
 * */
@final
pub class Some {T} over ISome!{T, false} {
    pub self (val: T)
        with super (val)
    {}
}

/**
 * Mutable container
 * */
@final
pub class Some {T of dmut J, class J} over ISome!{T, true} {
    pub self (dmut val: T)
        with super (alias val)
    {}
}
