in record_;

use std::time::instant;

/**
 * A message emitted by a logger, as it is handed to the sinks
 */
pub record LogRecord {

    /** The instant the message was emitted */
    pub let time: Instant;

    /** The level of the message */
    pub let level: Level;

    /** The name of the logger that emitted the message */
    pub let name: [c8];

    /** The content of the message */
    pub let msg: [c8];

    /** An identifier of the message, written on each of its lines when the format asks for it */
    pub let uid: u64;

    pub self (time: Instant, level: Level, name: [c8], msg: [c8], uid: u64)
        with time = time, level = level, name = name, msg = msg, uid = uid
    {}
}
