in sink;


/**
 * Ancestor of the destinations of the log records
 * @info: a sink can be used by several threads at once, `emit` has to be synchronized
 */
@abstract
pub class LogSink {

    prot self () {}

    /**
     * Write a log record
     */
    pub fn emit(mut self, rec: LogRecord);
}
