in utils;

use std::conv::utf;
use std::syntax::errors;
use std::syntax::regex::{compiler, matcher, node, parser, program};

pub def MAX_REPEAT = 1000us;
pub def MAX_PROGRAM = 100000us;

pub def LOOK_BEHIND = 1us;
pub def LOOK_NEGATE = 2us;
pub def LOOK_GROUPS = 4us;

pub def FRAME_BRANCH = 0us;
pub def FRAME_SLOT = 1us;
pub def FRAME_REG = 2us;
pub def FRAME_SAVED = 3us;

def MAX_CODE = 0x10FFFFu32;

/**
 * Parse and compile a regular expression
 * @throws:
 *    - SyntaxError: if the pattern is malformed
 */
pub fn compile(pattern: [c8], flags: u32)-> Program
    throws SyntaxError
{
    let dmut p = copy Parser(pattern, flags);
    let root = p:.parse();

    let dmut c = copy Compiler();
    c:.compile(root, p.nbGroups, p.names)
}

/**
 * @returns: every non overlapping match of `prog` in `text`, the search resuming one code point
 * further after an empty match
 */
pub yield matches(prog: Program, text: [c8])-> Match {
    let dmut m = copy Matcher(prog, text);
    let mut from = 0us;
    while from <= text.len && m:.search(from) {
        let slots = copy m.slots;
        yield Match(text, slots, prog.names);

        if slots[1] == slots[0] {
            if slots[1] >= text.len { break; }
            from = slots[1] + codeSize(text, slots[1]);
        } else {
            from = slots[1];
        }
    }
}

/**
 * @returns: the parts of `text` between the matches of `prog`, as `matches` iterates them
 */
pub yield split(prog: Program, text: [c8])-> [c8] {
    let mut last = 0us;
    for m in matches(prog, text) {
        yield text[last .. m.start];
        last = m.end;
    }

    yield text[last .. $];
}

/**
 * @returns: the replacement template `by` expanded for the match `m`
 */
pub fn substitute(by: [c8], m: Match)-> [c8] {
    let dmut res: [c8] = [];
    let mut i = 0us;
    while i < by.len {
        if by[i] != '$' || i + 1us >= by.len {
            res ~= [by[i]];
            i += 1us;
            continue;
        }

        let c = by[i + 1us];
        if c == '$' {
            res ~= ['$'];
            i += 2us;
        } else if c >= '0' && c <= '9' {
            let mut j = i + 1us;
            while j < by.len && by[j] >= '0' && by[j] <= '9' { j += 1us; }

            res ~= m.group(toIndex(by[i + 1us .. j])) ?? "";
            i = j;
        } else if c == '{' {
            let mut j = i + 2us;
            while j < by.len && by[j] != '}' { j += 1us; }

            if j >= by.len {
                res ~= ['$'];
                i += 1us;
            } else {
                let name = by[i + 2us .. j];
                if name.len != 0us && name[0] >= '0' && name[0] <= '9' {
                    res ~= m.group(toIndex(name)) ?? "";
                } else {
                    res ~= m.group(name) ?? "";
                }
                i = j + 1us;
            }
        } else {
            res ~= ['$'];
            i += 1us;
        }
    }

    res
}

/**
 * @returns: the group index written in `digits`, `usize::max` if it is not a number or too large
 */
fn toIndex(digits: [c8])-> usize {
    let mut n = 0us;
    for d in digits {
        if d < '0' || d > '9' || n > MAX_PROGRAM { return usize::max; }
        n = n * 10us + cast!usize(cast!u8(d) - cast!u8('0'));
    }

    n
}

/**
 * @returns: the number of bytes of the code point at the byte offset `pos`, 1 for an invalid sequence
 */
pub fn codeSize(text: [c8], pos: usize)-> usize {
    let (_, n) = toUtf32(text[pos .. $]);
    if n == 0u32 { 1us } else { cast!usize(n) }
}

/**
 * @returns: the byte offset of the code point preceding the byte offset `pos`
 */
pub fn prevCode(text: [c8], pos: usize)-> usize {
    let mut i = pos - 1us;
    while i > 0us && pos - i < 4us && (cast!u8(text[i]) & 0xC0u8) == 0x80u8 {
        i -= 1us;
    }

    if codeSize(text, i) == pos - i { i } else { pos - 1us }
}

/**
 * @returns: the byte offset `nb` code points before `pos`, none if the text starts before
 */
pub fn stepBack(text: [c8], pos: usize, nb: usize)-> (usize)? {
    let mut i = pos;
    for _ in 0us .. nb {
        if i == 0us { return none; }
        i = prevCode(text, i);
    }

    (i)?
}

/**
 * @returns: true if the bytes [s, e) of `text` are found again at the byte offset `pos`
 */
pub fn sameText(text: [c8], s: usize, e: usize, pos: usize, icase: bool)-> bool {
    if pos + (e - s) > text.len { return false; }
    for i in 0us .. e - s {
        let a = text[s + i], b = text[pos + i];
        if a != b && (!icase || lowerAscii(a) != lowerAscii(b)) {
            return false;
        }
    }

    true
}

/**
 * @returns: the lowercase of the ASCII letter `c`, `c` itself if it is not one
 */
fn lowerAscii(c: c8)-> c8 {
    if c >= 'A' && c <= 'Z' { cast!c8(cast!u8(c) + 32u8) } else { c }
}

/**
 * @returns: true if the assertion `kind`(an AssertKind) holds at the byte offset `pos`
 */
pub fn checkAssert(text: [c8], pos: usize, kind: usize)-> bool {
    let k = cast!u8(kind);
    if k == cast!u8(AssertKind::TEXT_START) {
        pos == 0us
    } else if k == cast!u8(AssertKind::TEXT_END) {
        pos == text.len
    } else if k == cast!u8(AssertKind::LINE_START) {
        pos == 0us || text[pos - 1us] == '\n'
    } else if k == cast!u8(AssertKind::LINE_END) {
        pos == text.len || text[pos] == '\n'
    } else {
        let before = pos > 0us && isWordByte(text[pos - 1us]);
        let after = pos < text.len && isWordByte(text[pos]);
        (before != after) == (k == cast!u8(AssertKind::WORD))
    }
}

/**
 * @returns: true if `c` is an ASCII letter, digit or underscore
 */
pub fn isWordByte(c: c8)-> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

/**
 * @returns: the value of the hexadecimal digit `c`, `u32::max` if it is not one
 */
pub fn hexDigit(c: c8)-> u32 {
    if c >= '0' && c <= '9' { cast!u32(cast!u8(c) - cast!u8('0')) }
    else if c >= 'a' && c <= 'f' { cast!u32(cast!u8(c) - cast!u8('a')) + 10u32 }
    else if c >= 'A' && c <= 'F' { cast!u32(cast!u8(c) - cast!u8('A')) + 10u32 }
    else { u32::max }
}

/**
 * @returns: true if `code` is in one of the inclusive `ranges`
 */
pub fn inRanges(ranges: [(u32, u32)], code: u32)-> bool {
    for r in ranges {
        if code >= r._0 && code <= r._1 { return true; }
    }

    false
}

/**
 * @returns: the ranges of the shorthand class `\c`, none if `c` does not name one
 */
pub fn shorthand(c: c8)-> ([(u32, u32)])? {
    match c {
        'd' | 'D' => { (copy [(0x30u32, 0x39u32)])? }
        'w' | 'W' => { (copy [(0x30u32, 0x39u32), (0x41u32, 0x5Au32), (0x5Fu32, 0x5Fu32), (0x61u32, 0x7Au32)])? }
        's' | 'S' => { (copy [(0x09u32, 0x0Du32), (0x20u32, 0x20u32)])? }
        _ => { none }
    }
}

/**
 * @returns: the ranges of the POSIX class `[:name:]`, none if `name` does not name one
 */
pub fn posixClass(name: [c8])-> ([(u32, u32)])? {
    if name == "alpha" { return (copy [(0x41u32, 0x5Au32), (0x61u32, 0x7Au32)])?; }
    if name == "digit" { return (copy [(0x30u32, 0x39u32)])?; }
    if name == "alnum" { return (copy [(0x30u32, 0x39u32), (0x41u32, 0x5Au32), (0x61u32, 0x7Au32)])?; }
    if name == "upper" { return (copy [(0x41u32, 0x5Au32)])?; }
    if name == "lower" { return (copy [(0x61u32, 0x7Au32)])?; }
    if name == "space" { return (copy [(0x09u32, 0x0Du32), (0x20u32, 0x20u32)])?; }
    if name == "blank" { return (copy [(0x09u32, 0x09u32), (0x20u32, 0x20u32)])?; }
    if name == "punct" { return (copy [(0x21u32, 0x2Fu32), (0x3Au32, 0x40u32), (0x5Bu32, 0x60u32), (0x7Bu32, 0x7Eu32)])?; }
    if name == "xdigit" { return (copy [(0x30u32, 0x39u32), (0x41u32, 0x46u32), (0x61u32, 0x66u32)])?; }
    if name == "cntrl" { return (copy [(0x00u32, 0x1Fu32), (0x7Fu32, 0x7Fu32)])?; }
    if name == "print" { return (copy [(0x20u32, 0x7Eu32)])?; }
    if name == "graph" { return (copy [(0x21u32, 0x7Eu32)])?; }
    if name == "word" { return shorthand('w'); }

    none
}

/**
 * @returns: the code points outside of the sorted, disjoint `ranges`
 */
pub fn complement(ranges: [(u32, u32)])-> [(u32, u32)] {
    let dmut res: [(u32, u32)] = [];
    let mut next = 0u32;
    for r in ranges {
        if r._0 > next { res ~= [(next, r._0 - 1u32)]; }
        next = r._1 + 1u32;
    }

    if next <= MAX_CODE { res ~= [(next, MAX_CODE)]; }
    res
}

/**
 * @returns: `ranges` extended with the other case of the ASCII letters they contain
 */
pub fn foldCase(ranges: [(u32, u32)])-> [(u32, u32)] {
    let dmut res: [(u32, u32)] = copy ranges;
    for r in ranges {
        let ulo = if r._0 > 0x41u32 { r._0 } else { 0x41u32 };
        let uhi = if r._1 < 0x5Au32 { r._1 } else { 0x5Au32 };
        if ulo <= uhi { res ~= [(ulo + 32u32, uhi + 32u32)]; }

        let llo = if r._0 > 0x61u32 { r._0 } else { 0x61u32 };
        let lhi = if r._1 < 0x7Au32 { r._1 } else { 0x7Au32 };
        if llo <= lhi { res ~= [(llo - 32u32, lhi - 32u32)]; }
    }

    res
}
