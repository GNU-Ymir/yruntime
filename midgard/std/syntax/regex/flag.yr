in flag;

/**
 * The options of a `Regex`, combined with `|`. Each of them can also be set inside the pattern, by
 * the letter in parentheses: `(?i)` from there to the end of the enclosing group, `(?i:...)` inside
 * the group only, and `(?-i)` turns it off.
 * - ICASE(i): letters match regardless of their case, only the ASCII letters are folded
 * - MULTILINE(m): `^` and `$` also match at the beginning and end of each line
 * - DOTALL(s): `.` also matches `\n`
 * - EXTENDED(x): the white spaces of the pattern are ignored outside of a class, and `#` starts a
 *   comment running to the end of the line
 * @example:
 * ```
 * use std::syntax::regex;
 *
 * let r = copy Regex("^hello$", flags-> RegexFlag::ICASE | RegexFlag::MULTILINE);
 * assert(r.isMatch("first line\nHeLLo\nlast line"));
 * ```
 */
pub enum RegexFlag: u32
| ICASE     = 1u32
| MULTILINE = 2u32
| DOTALL    = 4u32
| EXTENDED  = 8u32;
