in program;

use std::syntax::regex::inst;

/**
 * A compiled regular expression, run by a `Matcher`
 */
pub record Program {

    pub let code: [Inst];

    // The ranges of the classes referenced by the CLASS instructions
    pub let classes: [[(u32, u32)]];

    // Two capture slots per group, the whole match being the group 0
    pub let nbSlots: usize;

    // The number of registers of the MARK/CHECK instructions
    pub let nbRegs: usize;

    // The name and index of each named group
    pub let names: [([c8], usize)];

    // The program can only match at the beginning of the text
    pub let anchored: bool;

    pub self (code: [Inst], classes: [[(u32, u32)]], nbSlots: usize, nbRegs: usize, names: [([c8], usize)], anchored: bool)
        with code = code
        , classes = classes
        , nbSlots = nbSlots
        , nbRegs = nbRegs
        , names = names
        , anchored = anchored
    {}
}
