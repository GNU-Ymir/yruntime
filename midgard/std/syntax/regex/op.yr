in op;

pub enum Op: u8
| CHAR     = 0u8
| ANY      = 1u8
| ANY_NL   = 2u8
| CLASS    = 3u8
| SPLIT    = 4u8
| JMP      = 5u8
| SAVE     = 6u8
| ASSERT   = 7u8
| LOOK     = 8u8
| LOOK_END = 9u8
| BACKREF  = 10u8
| MARK     = 11u8
| CHECK    = 12u8
| MATCH    = 13u8;
