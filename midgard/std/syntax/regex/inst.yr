in inst;

use std::syntax::regex::op;

/**
 * An instruction of a compiled regular expression, whose operands depend on the operation:
 * - CHAR: x the code point
 * - CLASS: x the index of the class, y 1 if it is negated
 * - SPLIT: x the preferred branch, y the alternative one
 * - JMP: x the target
 * - SAVE: x the capture slot receiving the position
 * - ASSERT: x the AssertKind
 * - LOOK: x the instruction following the looked program, y its `utils::LOOK_*` flags, z and w the min and max
 *   number of code points a look behind consumes
 * - BACKREF: x the group, y 1 if the ASCII case is ignored
 * - MARK/CHECK: x the register storing the position a loop iteration started at
 */
@data
pub record Inst {

    let op: Op;
    let mut x: usize = 0us;
    let mut y: usize = 0us;
    let z: usize = 0us;
    let w: usize = 0us;
}
