/**
 * This module implements regular expressions, matched by a backtracking engine written in Ymir. A
 * pattern is compiled once into a `Regex`, which searches, matches, replaces and splits texts. The
 * texts and patterns are utf8 encoded, the engine matches code points, and every offset it
 * reports is a byte offset.
 *
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 *
 * @example:
 * ```
 * use std::algorithm::iteration;
 * use std::syntax::regex;
 *
 * let r = copy Regex("(?<user>\\w+)@(?<host>[\\w.]+)");
 * if let Ok(m) = r.find("contact: alice@example.com") {
 *     assert(m.text == "alice@example.com");
 *     assert(m.group("host") == ("example.com")?);
 * }
 *
 * assert(r.replaceAll("alice@a.org, bob@b.org", "${user}") == "alice, bob");
 * assert((copy Regex("\\s*;\\s*")).split("a; b ;c").collect() == ["a", "b", "c"]);
 * ```
 *
 * The syntax is close to the one of Perl and PCRE:
 * ```text
 * x          the code point x, the chars .^$|?*+()[]{}\ have to be escaped with \ to be matched literally
 * .          any code point but \n (any code point with the flag DOTALL)
 * [abc]      a class: any of a, b, c; [a-z] a range; [^abc] any code point but a, b, c
 *            a ] first in the class is literal, as is a - first or last
 * [[:alpha:]] a POSIX class inside a class: alpha digit alnum upper lower space blank punct xdigit
 *            cntrl print graph word
 * \d \w \s   an ASCII digit, word char [0-9A-Za-z_], white space [ \t\n\v\f\r]; \D \W \S their complement
 * \n \t \r \f \v \e \0   the usual control chars
 * \xHH \x{H...}          the code point of hexadecimal value H
 *
 * xy         x followed by y
 * x|y        x, or y if x fails
 * x* x+ x?   0 or more, 1 or more, 0 or 1 x
 * x{n} x{n,} x{n,m} x{,m}   exactly n, n or more, n to m, at most m x (counts up to 1000)
 * x*? x+? x?? x{n,m}?       the lazy versions, matching as few x as possible
 *
 * (x)        a capturing group, numbered from 1 in the order of their opening parenthesis
 * (?<name>x) (?P<name>x)    a named capturing group, that also has a number
 * (?:x)      a non capturing group
 * \1 \k<name>               the text a previous group matched
 * (?=x) (?!x)               x does (resp. does not) match at this position, without consuming it
 * (?<=x) (?<!x)             x does (resp. does not) match text ending at this position
 * (?imsx-imsx)  (?imsx-imsx:x)   set or unset flags, see RegexFlag
 *
 * ^ $        the beginning and end of the text (of a line with the flag MULTILINE)
 * \A \z      the beginning and end of the text
 * \b \B      a boundary (resp. not a boundary) between an ASCII word char and a non word char
 * ```
 * @warning: like every backtracking engine, a pattern nesting ambiguous repetitions(e.g. `(a+)+b`)
 * can take a time exponential in the length of the text it fails to match.
 */
in regex;

mod ::flag;
mod ::node;
mod ::parser;
mod ::inst;
mod ::program;
mod ::compiler;
mod ::matcher;
mod ::match_;
mod ::regex_;
mod ::utils;

pub def RegexFlag: flag::RegexFlag;
pub def Match: match_::Match;
pub def Regex: regex_::Regex;
