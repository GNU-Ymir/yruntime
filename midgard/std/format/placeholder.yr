in placeholder;

/**
 * A formatter, as parsed from a format string
 * */
pub record Placeholder {

    // True if the formatter has a ':' specification
    pub let spec: bool = false;

    // The char used to pad the value up to 'width'
    pub let fill: c8 = '\u{0}';

    // '<', '^' or '>', or '\u{0}' when the value is not aligned
    pub let align: c8 = '\u{0}';

    // Write a '+' in front of positive values
    pub let sign: bool = false;

    // 'o', 'x', 'X', 'b' or 'e', or '\u{0}' for the default representation
    pub let type: c8 = '\u{0}';

    // The width of the alignment (meaningless if paramWidth)
    pub let width: u32 = 0u32;

    // The width is the argument at 'index - 1' ('index - 2' if paramPrec)
    pub let paramWidth: bool = false;

    // The number of decimals to write (meaningless if paramPrec)
    pub let prec: u32 = 0u32;

    // The precision is the argument at 'index - 1'
    pub let paramPrec: bool = false;

    // The index of the argument to write
    pub let index: usize = 0us;

    // The value of the implicit argument counter after this formatter
    pub let next: usize = 0us;

    pub self (spec: bool = false, fill: c8 = '\u{0}', align: c8 = '\u{0}', sign: bool = false,
              type: c8 = '\u{0}', width: u32 = 0u32, paramWidth: bool = false, prec: u32 = 0u32,
              paramPrec: bool = false, index: usize = 0us, next: usize = 0us)
        with spec = spec
        , fill = fill
        , align = align
        , sign = sign
        , type = type
        , width = width
        , paramWidth = paramWidth
        , prec = prec
        , paramPrec = paramPrec
        , index = index
        , next = next
    {}

}
