in implem;

use std::{traits, stream};
use std::format::errors;
use core::exception::_;

/**
 * A formatter, as parsed from a format string
 * */
record Placeholder {

    // True if the formatter has a ':' specification
    pub let spec: bool = false;

    // The char used to pad the value up to 'width'
    pub let fill: c8 = '\u{0}';

    // '<', '^' or '>', or '\u{0}' when the value is not aligned
    pub let align: c8 = '\u{0}';

    // Write a '+' in front of positive values
    pub let sign: bool = false;

    // 'o', 'x', 'X', 'b' or 'e', or '\u{0}' for the default representation
    pub let type: c8 = '\u{0}';

    // The width of the alignment (meaningless if paramWidth)
    pub let width: u32 = 0u32;

    // The width is the argument at 'index - 1' ('index - 2' if paramPrec)
    pub let paramWidth: bool = false;

    // The number of decimals to write (meaningless if paramPrec)
    pub let prec: u32 = 0u32;

    // The precision is the argument at 'index - 1'
    pub let paramPrec: bool = false;

    // The index of the argument to write
    pub let index: usize = 0us;

    // The value of the implicit argument counter after this formatter
    pub let next: usize = 0us;

    pub self (spec: bool = false, fill: c8 = '\u{0}', align: c8 = '\u{0}', sign: bool = false,
              type: c8 = '\u{0}', width: u32 = 0u32, paramWidth: bool = false, prec: u32 = 0u32,
              paramPrec: bool = false, index: usize = 0us, next: usize = 0us)
        with spec = spec
        , fill = fill
        , align = align
        , sign = sign
        , type = type
        , width = width
        , paramWidth = paramWidth
        , prec = prec
        , paramPrec = paramPrec
        , index = index
        , next = next
    {}

}

/**
 * Format a tuple into the stream
 * @params:
 *    - str: the format
 *    - a: the tuple containing the values to format
 *    - stream: the stream to fill
 * @throws:
 *    - FormatError: if a formatter is invalid, or does not apply to the value it designates
 * */
pub fn if isTuple!{T} format {T} (str: [c8], ref a: T, dmut stream: &StringStream)
    throws FormatError
{
    let mut i = 0us, mut current = 0us;
    while i < str.len {
        if str[i] == '{' && i + 1us < str.len && str[i + 1us] == '{' {
            stream:.write('{');
            i += 2us;
        }

        else if str[i] == '{' {
            let (ph, len) = parsePlaceholder(str[i .. $], current, i);
            renderPlaceholder!{T} (ph, a, alias stream, i);
            current = ph.next;
            i += len;
        }

        else {
            stream:.write(str[i]);
            i += 1us;
        }
    }
}

/**
 * Parse the formatter starting at str[0], which must be a '{'
 * @params:
 *    - str: the format, starting at the opening '{'
 *    - current: the value of the implicit argument counter
 *    - globalIndex: the index of the formatter in the whole format
 * @returns:
 *    - .0: the parsed formatter
 *    - .1: the number of chars of the formatter, closing '}' included
 * @throws:
 *    - FormatError: if the formatter is malformed
 * */
fn parsePlaceholder(str: [c8], current: usize, globalIndex: usize)-> (Placeholder, usize)
    throws FormatError
{
    let (index, explicit, i) = if (str.len > 1us && str[1us] >= '0' && str[1us] <= '9') {
        let (arg, end) = getInt(str[1us .. $]);
        (cast!usize(arg), true, end + 1us)
    } else {
        (current, false, 1us)
    };

    if (i >= str.len) throw copy FormatError(globalIndex, "Unterminated formatter");

    if (str[i] == '}') {
        return (Placeholder(index-> index, next-> if explicit { current } else { index + 1us }), i + 1us);
    }

    if (str[i] != ':') throw copy FormatError(globalIndex, "Expected '}' or ':', not " ~ str[i .. i + 1us]);
    if (i + 1us >= str.len) throw copy FormatError(globalIndex, "Unterminated formatter");

    let spec = str[i + 1us .. $];
    let (fill, align, paramWidth, width, i_) = extractAlign(spec);
    let (sign, j_) = if (i_ < spec.len && spec[i_] == '+') { (true, i_ + 1us) } else { (false, i_) };
    let (type, k_) = if (spec[j_ .. $].len > 1us && isType(spec[j_])) {
        (spec[j_], j_ + 1us)
    } else {
        ('\u{0}', j_)
    };

    let (prec, paramPrec, l_) = if (spec[k_ .. $].len > 2us && spec[k_] == '.') {
        if (spec[k_ + 1us] == '*') {
            (0u32, true, k_ + 2us)
        } else {
            let (w, z_) = getInt(spec[k_ + 1us .. $]);
            (w, false, k_ + 1us + z_)
        }
    } else {
        (0u32, false, k_)
    };

    let end = i + 1us + l_;
    if (end >= str.len) throw copy FormatError(globalIndex, "Unterminated formatter");
    if (str[end] != '}') throw copy FormatError(globalIndex, "Expected '}', not " ~ str[end .. end + 1us]);

    // A '*' width or precision reads the arguments placed just before the value, unless the
    // index of the value was given explicitly
    let used = if explicit { 0us
    } else if (paramWidth && paramPrec) { 2us
    } else if (paramWidth || paramPrec) { 1us
    } else { 0us };

    let value = index + used;
    (Placeholder(spec-> true,
                 fill-> fill,
                 align-> align,
                 sign-> sign,
                 type-> type,
                 width-> width,
                 paramWidth-> paramWidth,
                 prec-> prec,
                 paramPrec-> paramPrec,
                 index-> value,
                 next-> if explicit { current } else { value + 1us }),
     end + 1us)
} catch {
    x: &FormatError => throw x;
    err => throw copy FormatError(globalIndex, "", subError-> err?);
}

/**
 * Extract the alignement of the format
 * @params:
 *    - str: the string format
 * @returns:
 *    - .0: the filling char
 *    - .1: the align char
 *    - .2: true if using an index element for the width
 *    - .3: the size of the alignement(applicable only iif .2 == false)
 *    - .4: the number of chars read
 * */
fn extractAlign(str: [c8])-> (c8, c8, bool, u32, usize)
    throws std::conv::errors::CastFailure
{
    if str.len > 1 && (str[0] == '<' || str[0] == '^' || str[0] == '>') {
        if str.len > 2 && str[1] >= '0' && str[1] <= '9' {
            let (len, end) = getInt(str[1 .. $]);
            return (' ', str[0], false, len, end + 1us);
        } else if str.len > 2 && str[1] == '*' {
            return (' ', str[0], true, 0, 2);
        }

        return (' ', str[0], false, 0, 1);
    }

    if str.len > 2 && (str[1] == '<' || str[1] == '^' || str[1] == '>') {
        if str.len > 3 && (str[2] >= '0' && str[2] <= '9') {
            let (len, end) = getInt(str[2 .. $]);
            return (str[0], str[1], false, len, end + 2us);
        } else if str.len > 3 && str[2] == '*' {
            return (str[0], str[1], true, 0, 3);
        }

        return (str[0], str[1], false, 0, 2);
    }

    ('\u{0}', '\u{0}', false, 0, 0)
}

/**
 * @returns: true if the char is a type defining char
 * */
fn isType(c: c8)-> bool {
    match c {
        'o' => { true }
        'x' => { true }
        'b' => { true }
        'e' => { true }
        'X' => { true }
        _ => { false }
    }
}

/**
 * Write a value from the tuple in the stream, with its default representation
 * @params:
 *    - a: the tuple containing the values to format
 *    - stream: the stream
 *    - index: the index in the tuple
 *    - globalIndex: the index of the formatter
 * */
fn if isTuple!{T} formatValue {T} (ref a: T, dmut stream: &StringStream, index: usize, globalIndex: usize)
    throws FormatError
{
    if (index >= T::arity) throw copy FormatError(globalIndex, "No argument " ~ std::conv::to!{[c8]} (index));
    for i, j in a {
        if i == index {
            stream:.write(j);
            return;
        }
    }
}

/**
 * Write the value designated by a formatter in the stream, following that formatter
 * @params:
 *    - ph: the formatter
 *    - a: the tuple containing the values to format
 *    - stream: the stream
 *    - globalIndex: the index of the formatter
 * @throws:
 *    - FormatError: if the formatter designates no value, or does not apply to it
 * */
fn if isTuple!{T} renderPlaceholder {T} (ph: Placeholder, ref a: T, dmut stream: &StringStream, globalIndex: usize)
    throws FormatError
{
    if (!ph.spec) {
        formatValue!{T} (a, alias stream, ph.index, globalIndex);
        return;
    }

    if (ph.index >= T::arity) throw copy FormatError(globalIndex, "No argument " ~ std::conv::to!{[c8]} (ph.index));

    // '*' reads the width from the argument just before the value, and the precision from the
    // one in between when both are given by an argument
    let widthAt = if (ph.paramPrec) { 2us } else { 1us };
    let mut gotWidth = false, mut gotPrec = false, mut resWidth = ph.width, mut resPrec = ph.prec;

    for j, x in a {
        if ph.paramWidth && ph.index >= widthAt && j == ph.index - widthAt {
            cte if !isIntegral!{typeof(x)} throw copy FormatError(globalIndex, "Alignment width (at position " ~ std::conv::to!{[c8]} (j) ~ " must be an integer");
            else {
                resWidth = cast!u32(x);
                gotWidth = true;
            }
        }

        else if ph.paramPrec && ph.index >= 1us && j == ph.index - 1us {
            cte if !isIntegral!{typeof(x)} throw copy FormatError(globalIndex, "Precision (at position " ~ std::conv::to!{[c8]} (j) ~ " must be an integer");
            else {
                resPrec = cast!u32(x);
                gotPrec = true;
            }
        }

        else if j == ph.index {
            if ph.paramWidth && !gotWidth throw copy FormatError(globalIndex, "Undefined alignment width for argument at position " ~ std::conv::to!{[c8]} (ph.index));
            if ph.paramPrec && !gotPrec throw copy FormatError(globalIndex, "Undefined precision for argument at position " ~ std::conv::to!{[c8]} (ph.index));

            let elem = {
                convertValue(x, ph.sign, ph.type, resPrec)
            } catch {
                err => throw copy FormatError(globalIndex, "", subError-> err?);
            };

            if elem.len < resWidth {
                formatAlign(alias stream, elem, ph.align, cast!usize(resWidth), ph.fill);
            } else {
                stream:.write(elem);
            }

            return;
        }
    }
}

/**
 * Write the element following a given alignement
 * @params:
 *    - stream: the stream to fill
 *    - elem: the content to write
 *    - align: the char defining the kind of alignement
 *    - width: the width of the alignement
 *    - fill: the char used to align
 * */
fn formatAlign(dmut stream: &StringStream, elem: [c8], align: c8, width: usize, fill: c8) {
    if align == '<' {
        stream:.write(elem);
        for _ in elem.len .. width {
            stream:.write(fill);
        }
    }

    else if align == '>' {
        for _ in 0 .. (width - elem.len) {
            stream:.write(fill);
        }
        stream:.write(elem);
    }

    else {
        let toAdd = width - elem.len;
        for _ in 0 .. toAdd / 2 {
            stream:.write(fill);
        }
        stream:.write(elem);
        for _ in 0 .. toAdd - (toAdd / 2) {
            stream:.write(fill);
        }
    }
}


/**
 * Convert a float value according to a formatter
 * @params:
 *    - value: the value to convert
 * */
fn if isFloating!{T} convertValue {T} (value: T, sign: bool, type: c8, prec: u32)-> [c8]
    throws AssertError
{
    let m_prec = if (prec == 0) { 5u32 } else { prec };
    let mut res = "";
    match type {
        '\u{0}' => { res = std::conv::to!{[c8]} (value, prec-> m_prec); }
        'e' => { res = std::conv::to!{[c8], "e"} (value, prec-> m_prec); }
        _ => {
            throw copy AssertError("Invalid type format " ~ copy [type] ~ " for type " ~ T::typeid);
        }
    }

    if sign && value > cast!{T} (0.0) { return "+" ~ res; }
    else {
        res
    }
}

/**
 * Convert a unsigned int value according to a formatter
 * @params:
 *    - value: the value to convert
 * */
fn if isIntegral!{T} convertValue {T} (value: T, sign: bool, type: c8, prec: u32)-> [c8]
    throws AssertError
{
    if prec > 0u32 { throw copy AssertError("Precision only applies on floating types"); }
    let mut res = "";
    match type {
        '\u{0}' => { res = std::conv::to!{[c8]} (value); }
        'b' => { res = std::conv::to!{[c8], "b"} (value); }
        'o' => { res = std::conv::to!{[c8], "o"} (value); }
        'x' => { res = std::conv::to!{[c8], "x"} (value); }
        'X' => {
            res = std::conv::to!{[c8], "x"} (value, upper-> true);
        }
        _ => {
            throw copy AssertError("Invalid type format " ~ copy [type] ~ " for type " ~ T::typeid);
        }
    }

    if sign && value > cast!{T} (0) { return copy "+" ~ res; }
    else {
        res
    }
}

/**
 * Convert a string according to a formatter
 * @params:
 *    - value: the value to convert
 * */
fn convertValue {T} (value: T, sign: bool, type: c8, prec: u32)-> [c8]
    throws AssertError
{
    if prec > 0u32     throw copy AssertError("Precision only applies on floating types");
    if type != '\u{0}' throw copy AssertError("Invalid type format " ~ copy [type] ~ " for type " ~ T::typeid);
    if sign            throw copy AssertError("Sign only applies on floating and int types");

    cte if __pragma!compile(std::conv::to!{[c8]} (value)) {
        return std::conv::to!{[c8]} (value);
    } else {
        let dmut str = copy std::stream::StringStream();
        str:.write(value);
        return str[];
    }
}


/**
 * Read an int the beginning of the string
 * */
fn getInt(str: [c8])-> (u32, usize)
    throws std::conv::errors::CastFailure
{
    for i in 0 .. str.len {
        if str[i] < '0' || str[i] > '9' { return (std::conv::to!{u32} (str[0 .. i]), i); }
    }

    return (std::conv::to!{u32} (str), str.len);
}
