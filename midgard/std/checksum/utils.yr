in utils;

use std::checksum::crc32_;
use std::traits;

/**
 * @returns: the CRC-32 of `data`, a string being checksummed as its UTF-8 bytes
 * @example:
 * ```
 * use std::checksum;
 *
 * println(crc32("The quick brown fox jumps over the lazy dog")); // 1095738169
 * ```
 */
pub fn if isBytes!{T} crc32 {T} (data: T)-> u32 {
    let dmut c = copy Crc32();
    c:.update(data);
    c.value()
}
