in time;

pub mod ::date;

mod ::instant;
mod ::dur;
mod ::utils;

pub def Instant: instant::Instant;
pub def Duration: dur::Duration;

pub def weeks = utils::weeks;
pub def days = utils::days;
pub def hours = utils::hours;
pub def minutes = utils::minutes;
pub def seconds = utils::seconds;
pub def millis = utils::millis;
pub def micros = utils::micros;
pub def sleep = utils::sleep;
