/**
 * The two argument arc tangent: the angle in radians between the positive x axis
 * and the ray to the point `(x, y)`, i.e. `atan(y / x)` with the correct quadrant.
 * Argument order matches C's `atan2`: the numerator `y` comes first.
 * @returns: the angle, in radians, in the range `]-PI; PI]`.
 */
pub fn if isFloating!{T} atan2 {T} (y: T, x: T)-> T {
    cte if template!{T}{U of f32} { internal::atan2f(y, x) }
    else cte if template!{T}{U of f64} { internal::atan2(y, x) }
    else cte if template!{T}{U of f80} { internal::atan2l(y, x) }
    else { internal::atan2l(y, x) }
}

/**
 * @returns: e raised to the power `x`.
 * @example:
 * ```
 * assert(exp(0.0) == 1.0);
 * ```
 */
pub fn if isFloating!{T} exp {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::expf(x) }
    else cte if template!{T}{U of f64} { internal::exp(x) }
    else cte if template!{T}{U of f80} { internal::expl(x) }
    else { internal::expl(x) }
}

/**
 * @returns: 2 raised to the power `x`.
 * @example:
 * ```
 * assert(exp2(3.0) == 8.0);
 * ```
 */
pub fn if isFloating!{T} exp2 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::exp2f(x) }
    else cte if template!{T}{U of f64} { internal::exp2(x) }
    else cte if template!{T}{U of f80} { internal::exp2l(x) }
    else { internal::exp2l(x) }
}

/**
 * @returns: `exp(x) - 1`, accurate even when `x` is close to zero.
 * @example:
 * ```
 * assert(expm1(0.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} expm1 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::expm1f(x) }
    else cte if template!{T}{U of f64} { internal::expm1(x) }
    else cte if template!{T}{U of f80} { internal::expm1l(x) }
    else { internal::expm1l(x) }
}

