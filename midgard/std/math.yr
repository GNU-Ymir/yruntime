 */
pub fn if isFloating!{T} cosh {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::coshf(x) }
    else cte if template!{T}{U of f64} { internal::cosh(x) }
    else cte if template!{T}{U of f80} { internal::coshl(x) }
    else { internal::coshl(x) }
}

/**
 * @returns: the hyperbolic tangent of `x`.
 * @example:
 * ```
