in math;

use std::traits;

/**
 * τ = 2 * π.
 */
pub def TAU =        6.28318530717958647692l;

/**
 * π
 */
pub def PI =         3.14159265358979323846l;

/**
 * π / 2.
 */
pub def PI_2 =       1.57079632679489661923l;

/**
 * π / 4.
 */
pub def PI_4 =       0.785398163397448309616l;

/**
 * 1 / π.
 */
pub def M_1_PI =     0.318309886183790671538l;

/**
 * 2 / π.
 */
pub def M_2_PI =     2.0l*M_1_PI;

/**
 * e, the base of the natural logarithm.
 */
pub def E =          2.71828182845904523536l;

/**
 * ln(2).
 */
pub def LN2 =        0.693147180559945309417l;

/**
 * ln(10).
 */
pub def LN10 =       2.30258509299404568402l;

/**
 * log2(e).
 */
pub def LOG2E =      1.44269504088896340736l;

/**
 * log10(e).
 */
pub def LOG10E =     0.434294481903251827651l;

/**
 * √2.
 */
pub def SQRT2 =      1.41421356237309504880l;

/**
 * 1 / √2.
 */
pub def SQRT1_2 =    0.707106781186547524401l;


mod internal {
    pub extern (C) fn roundf(x: f32)-> f32;
    pub extern (C) fn round(x: f64)-> f64;
    pub extern (C) fn roundl(x: f80)-> f80;
    pub extern (C) fn roundl(x: fsize)-> fsize;

    pub extern (C) fn asinf(x: f32)-> f32;
    pub extern (C) fn sinf(x: f32)-> f32;
    pub extern (C) fn asin(x: f64)-> f64;
    pub extern (C) fn sin(x: f64)-> f64;
    pub extern (C) fn asinl(x: f80)-> f80;
    pub extern (C) fn sinl(x: f80)-> f80;
    pub extern (C) fn asinl(x: fsize)-> fsize;
    pub extern (C) fn sinl(x: fsize)-> fsize;


    pub extern (C) fn acosf(x: f32)-> f32;
    pub extern (C) fn cosf(x: f32)-> f32;
    pub extern (C) fn acos(x: f64)-> f64;
    pub extern (C) fn cos(x: f64)-> f64;
    pub extern (C) fn acosl(x: f80)-> f80;
    pub extern (C) fn cosl(x: f80)-> f80;
    pub extern (C) fn acosl(x: fsize)-> fsize;
    pub extern (C) fn cosl(x: fsize)-> fsize;

    pub extern (C) fn atanf(x: f32)-> f32;
    pub extern (C) fn atan2f(x: f32, y: f32)-> f32;
    pub extern (C) fn tanf(x: f32)-> f32;
    pub extern (C) fn atan(x: f64)-> f64;
    pub extern (C) fn atan2(x: f64, y: f64)-> f64;
    pub extern (C) fn tan(x: f64)-> f64;
    pub extern (C) fn atanl(x: f80)-> f80;
    pub extern (C) fn atan2l(x: f80, y: f80)-> f80;
    pub extern (C) fn tanl(x: f80)-> f80;
    pub extern (C) fn atanl(x: fsize)-> fsize;
    pub extern (C) fn atan2l(x: fsize, y: fsize)-> fsize;
    pub extern (C) fn tanl(x: fsize)-> fsize;

    pub extern (C) fn expf(x: f32)-> f32;
    pub extern (C) fn exp2f(x: f32)-> f32;
    pub extern (C) fn expm1f(x: f32)-> f32;
    pub extern (C) fn exp(x: f64)-> f64;
    pub extern (C) fn exp2(x: f64)-> f64;
    pub extern (C) fn expm1(x: f64)-> f64;
    pub extern (C) fn expl(x: f80)-> f80;
    pub extern (C) fn exp2l(x: f80)-> f80;
    pub extern (C) fn expm1l(x: f80)-> f80;
    pub extern (C) fn expl(x: fsize)-> fsize;
    pub extern (C) fn exp2l(x: fsize)-> fsize;
    pub extern (C) fn expm1l(x: fsize)-> fsize;

    pub extern (C) fn logf(x: f32)-> f32;
    pub extern (C) fn log2f(x: f32)-> f32;
    pub extern (C) fn log10f(x: f32)-> f32;
    pub extern (C) fn log1pf(x: f32)-> f32;
    pub extern (C) fn log(x: f64)-> f64;
    pub extern (C) fn log2(x: f64)-> f64;
    pub extern (C) fn log10(x: f64)-> f64;
    pub extern (C) fn log1p(x: f64)-> f64;
    pub extern (C) fn logl(x: f80)-> f80;
    pub extern (C) fn log2l(x: f80)-> f80;
    pub extern (C) fn log10l(x: f80)-> f80;
    pub extern (C) fn log1pl(x: f80)-> f80;
    pub extern (C) fn logl(x: fsize)-> fsize;
    pub extern (C) fn log2l(x: fsize)-> fsize;
    pub extern (C) fn log10l(x: fsize)-> fsize;
    pub extern (C) fn log1pl(x: fsize)-> fsize;

    pub extern (C) fn powf(x: f32, y: f32)-> f32;
    pub extern (C) fn cbrtf(x: f32)-> f32;
    pub extern (C) fn hypotf(x: f32, y: f32)-> f32;
    pub extern (C) fn pow(x: f64, y: f64)-> f64;
    pub extern (C) fn cbrt(x: f64)-> f64;
    pub extern (C) fn hypot(x: f64, y: f64)-> f64;
    pub extern (C) fn powl(x: f80, y: f80)-> f80;
    pub extern (C) fn cbrtl(x: f80)-> f80;
    pub extern (C) fn hypotl(x: f80, y: f80)-> f80;
    pub extern (C) fn powl(x: fsize, y: fsize)-> fsize;
    pub extern (C) fn cbrtl(x: fsize)-> fsize;
    pub extern (C) fn hypotl(x: fsize, y: fsize)-> fsize;
}

/**
 * @returns: `x` rounded to `nb` numbers after the decimal point.
 */
pub fn if isFloating!{T} round {T} (x: T, nb: u32)-> T {
    let p: __pragma!unproxied(T) = cast!{__pragma!unproxied(T)} (10.0) ^^ cast!i32(nb);

    cte if template!{T}{U of f32} { internal::roundf(x * p) / p }
    else cte if template!{T}{U of f64} { internal::round(x * p) / p }
    else cte if template!{T}{U of f80} { internal::roundl(x * p) / p }
    else { internal::roundl(x * p) / p }
}

/**
 * @returns: arc sin value of `x` expressed in radians.
 */
pub fn if isFloating!{T} asin {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::asinf(x) }
    else cte if template!{T}{U of f64} { internal::asin(x) }
    else cte if template!{T}{U of f80} { internal::asinl(x) }
    else { internal::asinl(x) }
}

/**
 * @returns: sin value of `x` expressed in radians.
 */
pub fn if isFloating!{T} sin {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::sinf(x) }
    else cte if template!{T}{U of f64} { internal::sin(x) }
    else cte if template!{T}{U of f80} { internal::sinl(x) }
    else { internal::sinl(x) }
}

/**
 * @returns: arc cos value of `x` expressed in radians.
 */
pub fn if isFloating!{T} acos {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::acosf(x) }
    else cte if template!{T}{U of f64} { internal::acos(x) }
    else cte if template!{T}{U of f80} { internal::acosl(x) }
    else { internal::acosl(x) }
}

/**
 * @returns: cos value of `x` expressed in radians.
 */
pub fn if isFloating!{T} cos {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::cosf(x) }
    else cte if template!{T}{U of f64} { internal::cos(x) }
    else cte if template!{T}{U of f80} { internal::cosl(x) }
    else { internal::cosl(x) }
}

/**
 * @returns: arc tan value of `x` expressed in radians.
 */
pub fn if isFloating!{T} atan {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::atanf(x) }
    else cte if template!{T}{U of f64} { internal::atan(x) }
    else cte if template!{T}{U of f80} { internal::atanl(x) }
    else { internal::atanl(x) }
}

/**
 * @returns: tan value of `x` expressed in radians.
 */
pub fn if isFloating!{T} tan {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::tanf(x) }
    else cte if template!{T}{U of f64} { internal::tan(x) }
    else cte if template!{T}{U of f80} { internal::tanl(x) }
    else { internal::tanl(x) }
}

/**
 * The two argument arc tangent: the angle in radians between the positive x axis
 * and the ray to the point `(x, y)`, i.e. `atan(y / x)` with the correct quadrant.
 * Argument order matches C's `atan2`: the numerator `y` comes first.
 * @returns: the angle, in radians, in the range `]-PI; PI]`.
 */
pub fn if isFloating!{T} atan2 {T} (y: T, x: T)-> T {
    cte if template!{T}{U of f32} { internal::atan2f(y, x) }
    else cte if template!{T}{U of f64} { internal::atan2(y, x) }
    else cte if template!{T}{U of f80} { internal::atan2l(y, x) }
    else { internal::atan2l(y, x) }
}

/**
 * @returns: e raised to the power `x`.
 * @example:
 * ```
 * assert(exp(0.0) == 1.0);
 * ```
 */
pub fn if isFloating!{T} exp {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::expf(x) }
    else cte if template!{T}{U of f64} { internal::exp(x) }
    else cte if template!{T}{U of f80} { internal::expl(x) }
    else { internal::expl(x) }
}

/**
 * @returns: 2 raised to the power `x`.
 * @example:
 * ```
 * assert(exp2(3.0) == 8.0);
 * ```
 */
pub fn if isFloating!{T} exp2 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::exp2f(x) }
    else cte if template!{T}{U of f64} { internal::exp2(x) }
    else cte if template!{T}{U of f80} { internal::exp2l(x) }
    else { internal::exp2l(x) }
}

/**
 * @returns: `exp(x) - 1`, accurate even when `x` is close to zero.
 * @example:
 * ```
 * assert(expm1(0.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} expm1 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::expm1f(x) }
    else cte if template!{T}{U of f64} { internal::expm1(x) }
    else cte if template!{T}{U of f80} { internal::expm1l(x) }
    else { internal::expm1l(x) }
}

/**
 * @returns: the natural logarithm of `x`.
 * @example:
 * ```
 * assert(log(1.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} log {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::logf(x) }
    else cte if template!{T}{U of f64} { internal::log(x) }
    else cte if template!{T}{U of f80} { internal::logl(x) }
    else { internal::logl(x) }
}

/**
 * @returns: the base 2 logarithm of `x`.
 * @example:
 * ```
 * assert(log2(8.0) == 3.0);
 * ```
 */
pub fn if isFloating!{T} log2 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::log2f(x) }
    else cte if template!{T}{U of f64} { internal::log2(x) }
    else cte if template!{T}{U of f80} { internal::log2l(x) }
    else { internal::log2l(x) }
}

/**
 * @returns: the base 10 logarithm of `x`.
 * @example:
 * ```
 * assert(log10(1000.0) == 3.0);
 * ```
 */
pub fn if isFloating!{T} log10 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::log10f(x) }
    else cte if template!{T}{U of f64} { internal::log10(x) }
    else cte if template!{T}{U of f80} { internal::log10l(x) }
    else { internal::log10l(x) }
}

/**
 * @returns: `log(1 + x)`, accurate even when `x` is close to zero.
 * @example:
 * ```
 * assert(log1p(0.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} log1p {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::log1pf(x) }
    else cte if template!{T}{U of f64} { internal::log1p(x) }
    else cte if template!{T}{U of f80} { internal::log1pl(x) }
    else { internal::log1pl(x) }
}

/**
 * @returns: `x` raised to the power `y`.
 * @info: this calls the C library, where `^^` on two floating point values is an iterative
 *  approximation bounded by `core::math::ffpow`'s precision.
 * @example:
 * ```
 * assert(pow(2.0, 10.0) == 1024.0);
 * ```
 */
pub fn if isFloating!{T} pow {T} (x: T, y: T)-> T {
    cte if template!{T}{U of f32} { internal::powf(x, y) }
    else cte if template!{T}{U of f64} { internal::pow(x, y) }
    else cte if template!{T}{U of f80} { internal::powl(x, y) }
    else { internal::powl(x, y) }
}

/**
 * @returns: the cube root of `x`, negative values included.
 * @example:
 * ```
 * assert(cbrt(-27.0) == -3.0);
 * ```
 */
pub fn if isFloating!{T} cbrt {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::cbrtf(x) }
    else cte if template!{T}{U of f64} { internal::cbrt(x) }
    else cte if template!{T}{U of f80} { internal::cbrtl(x) }
    else { internal::cbrtl(x) }
}

/**
 * @returns: `sqrt(x * x + y * y)`, without overflowing or underflowing in between.
 * @example:
 * ```
 * assert(hypot(3.0, 4.0) == 5.0);
 * ```
 */
pub fn if isFloating!{T} hypot {T} (x: T, y: T)-> T {
    cte if template!{T}{U of f32} { internal::hypotf(x, y) }
    else cte if template!{T}{U of f64} { internal::hypot(x, y) }
    else cte if template!{T}{U of f80} { internal::hypotl(x, y) }
    else { internal::hypotl(x, y) }
}
