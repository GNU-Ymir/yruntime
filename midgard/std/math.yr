 */
pub fn if isFloating!{T} sinh {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::sinhf(x) }
    else cte if template!{T}{U of f64} { internal::sinh(x) }
    else cte if template!{T}{U of f80} { internal::sinhl(x) }
    else { internal::sinhl(x) }
}

