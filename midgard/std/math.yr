in math;

use std::traits;

/**
 * τ = 2 * π.
 */
pub def TAU =        6.28318530717958647692l;

/**
 * π
 */
pub def PI =         3.14159265358979323846l;

/**
 * π / 2.
 */
pub def PI_2 =       1.57079632679489661923l;

/**
 * π / 4.
 */
pub def PI_4 =       0.785398163397448309616l;

/**
 * 1 / π.
 */
pub def M_1_PI =     0.318309886183790671538l;

/**
 * 2 / π.
 */
pub def M_2_PI =     2.0l*M_1_PI;

/**
 * e, the base of the natural logarithm.
 */
pub def E =          2.71828182845904523536l;

/**
 * ln(2).
 */
pub def LN2 =        0.693147180559945309417l;

/**
 * ln(10).
 */
pub def LN10 =       2.30258509299404568402l;

/**
 * log2(e).
 */
pub def LOG2E =      1.44269504088896340736l;

/**
 * log10(e).
 */
pub def LOG10E =     0.434294481903251827651l;

/**
 * √2.
 */
pub def SQRT2 =      1.41421356237309504880l;

/**
 * 1 / √2.
 */
pub def SQRT1_2 =    0.707106781186547524401l;


