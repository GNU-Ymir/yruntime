pub fn if isFloating!{T} log2 {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::log2f(x) }
    else cte if template!{T}{U of f64} { internal::log2(x) }
    else cte if template!{T}{U of f80} { internal::log2l(x) }
    else { internal::log2l(x) }
}

