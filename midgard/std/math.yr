/**
 * @returns: the integral value nearest to `x`, halfway cases rounded away from zero.
 * @example:
 * ```
 * assert(round(2.5) == 3.0);
 * assert(round(-2.5) == -3.0);
 * ```
 */
pub fn if isFloating!{T} round {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::roundf(x) }
    else cte if template!{T}{U of f64} { internal::round(x) }
    else cte if template!{T}{U of f80} { internal::roundl(x) }
    else { internal::roundl(x) }
}

/**
 * @returns: `x` rounded to `nb` numbers after the decimal point.
 * @info: `x` is returned unchanged when `nb` is beyond what `T` can represent.
 * @example:
 * ```
 * assert(round(1.236, 2u32) == 1.24);
 * ```
 */
pub fn if isFloating!{T} round {T} (x: T, nb: u32)-> T {
    if (nb > 5000u32) return x;

    let p: __pragma!unproxied(T) = cast!{__pragma!unproxied(T)} (10.0) ^^ cast!i32(nb);
    let scaled = x * p;
    if (core::math::isInf (scaled)) return x;

    round!{T} (scaled) / p
}

/**
 * @returns: arc sin value of `x` expressed in radians.
 */
pub fn if isFloating!{T} asin {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::asinf(x) }
    else cte if template!{T}{U of f64} { internal::asin(x) }
    else cte if template!{T}{U of f80} { internal::asinl(x) }
    else { internal::asinl(x) }
}

