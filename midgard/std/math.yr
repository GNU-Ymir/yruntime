 */
pub fn if isFloating!{T} tanh {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::tanhf(x) }
    else cte if template!{T}{U of f64} { internal::tanh(x) }
    else cte if template!{T}{U of f80} { internal::tanhl(x) }
    else { internal::tanhl(x) }
}

/**
 * @returns: the inverse hyperbolic sine of `x`.
 * @example:
 * ```
 * assert(asinh(0.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} asinh {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::asinhf(x) }
    else cte if template!{T}{U of f64} { internal::asinh(x) }
    else cte if template!{T}{U of f80} { internal::asinhl(x) }
    else { internal::asinhl(x) }
}

/**
 * @returns: the inverse hyperbolic cosine of `x`, NaN when `x < 1`.
 * @example:
 * ```
 * assert(acosh(1.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} acosh {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::acoshf(x) }
    else cte if template!{T}{U of f64} { internal::acosh(x) }
    else cte if template!{T}{U of f80} { internal::acoshl(x) }
    else { internal::acoshl(x) }
}

/**
 * @returns: the inverse hyperbolic tangent of `x`, NaN outside of `[-1; 1]`.
 * @example:
 * ```
 * assert(atanh(0.0) == 0.0);
 * ```
 */
pub fn if isFloating!{T} atanh {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::atanhf(x) }
    else cte if template!{T}{U of f64} { internal::atanh(x) }
    else cte if template!{T}{U of f80} { internal::atanhl(x) }
    else { internal::atanhl(x) }
}

/**
 * @returns: a value with the magnitude of `x` and the sign of `y`, the sign of a zero or a NaN included.
 * @example:
 * ```
 * assert(copysign(2.0, -0.0) == -2.0);
 * ```
 */
pub fn if isFloating!{T} copysign {T} (x: T, y: T)-> T {
    cte if template!{T}{U of f32} { internal::copysignf(x, y) }
    else cte if template!{T}{U of f64} { internal::copysign(x, y) }
    else cte if template!{T}{U of f80} { internal::copysignl(x, y) }
    else { internal::copysignl(x, y) }
}

/**
 * @returns: the angle `x`, expressed in radians, converted to degrees.
 * @example:
 * ```
 * assert(degrees(PI_2) <=> 90.0l);
 * ```
 */
pub fn if isFloating!{T} degrees {T} (x: T)-> T {
    x * cast!{T} (180.0l / PI)
}

/**
 * @returns: the angle `x`, expressed in degrees, converted to radians.
 * @example:
 * ```
 * assert(radians(90.0l) <=> PI_2);
 * ```
 */
pub fn if isFloating!{T} radians {T} (x: T)-> T {
    x * cast!{T} (PI / 180.0l)
}

/**
 * @returns: true iif `x` is neither an infinity nor a NaN.
 * @example:
 * ```
 * assert(isFinite(1.0));
 * assert(!isFinite(f64::inf));
 * assert(!isFinite(f64::nan));
 * ```
 */
pub fn if isFloating!{T} isFinite {T} (x: T)-> bool {
    !core::math::isNaN (x) && !core::math::isInf (x)
}

/**
 * @returns: `1` when `x` is positive, `-1` when it is negative, and `x` itself when it is a
 *  zero (keeping its sign) or a NaN.
 * @example:
 * ```
 * assert(signum(-12.5) == -1.0);
 * assert(signum(12) == 1);
 * ```
 */
pub fn if (isFloating!{T} || isSigned!{T}) signum {T} (x: T)-> T {
    if (x > cast!{T} (0)) {
        cast!{T} (1)
    } else if (x < cast!{T} (0)) {
        cast!{T} (-1)
    } else {
        x
    }
}

/**
 * @returns: the square root of `x`, the same as `core::math::sqrt`.
 * @example:
 * ```
 * assert(sqrt(16.0) == 4.0);
 * ```
 */
pub fn if isFloating!{T} sqrt {T} (x: T)-> T {
    core::math::sqrt!{T} (x)
}

/**
 * @returns: `x` without its fractional part, the same as `core::math::trunc`.
 * @example:
 * ```
 * assert(trunc(-12.9) == -12.0);
 * ```
 */
pub fn if isFloating!{T} trunc {T} (x: T)-> T {
    core::math::trunc!{T} (x)
}

/**
 * @returns: the absolute value of `x`, the same as `core::math::abs`.
 * @example:
 * ```
 * assert(abs(-10) == 10);
 * assert(abs(-10.5) == 10.5);
 * ```
 */
pub fn if (isFloating!{T} || isSigned!{T}) abs {T} (x: T)-> T {
    core::math::abs!{T} (x)
}

/**
 * @returns: true iif `x` is a NaN value, the same as `core::math::isNaN`.
 * @example:
 * ```
 * assert(isNaN(f64::nan));
 * ```
 */
pub fn if isFloating!{T} isNaN {T} (x: T)-> bool {
    core::math::isNaN!{T} (x)
}

/**
 * @returns: true iif `x` is an infinity, the same as `core::math::isInf`.
 * @example:
 * ```
 * assert(isInf(-f64::inf));
 * ```
 */
pub fn if isFloating!{T} isInf {T} (x: T)-> bool {
    core::math::isInf!{T} (x)
}

/**
 * @returns: true iif `a` and `b` are at most one rounding step apart, the same as `a <=> b`
 *  and `core::math::fcmp`.
 * @example:
 * ```
 * assert(fcmp(0.1 + 0.2, 0.3));
 * ```
 */
pub fn if isFloating!{T} fcmp {T} (a: T, b: T)-> bool {
    core::math::fcmp!{T} (a, b)
}
