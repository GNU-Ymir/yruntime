    else cte if template!{T}{U of f64} { internal::ceil(x) }
    else cte if template!{T}{U of f80} { internal::ceill(x) }
    else { internal::ceill(x) }
}

/**
 * @returns: the hyperbolic sine of `x`.
 * @example:
 * ```
 * assert(sinh(0.0) == 0.0);
