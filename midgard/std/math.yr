pub fn if isFloating!{T} log {T} (x: T)-> T {
    cte if template!{T}{U of f32} { internal::logf(x) }
    else cte if template!{T}{U of f64} { internal::log(x) }
    else cte if template!{T}{U of f80} { internal::logl(x) }
    else { internal::logl(x) }
}

