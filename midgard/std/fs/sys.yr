/**
 * This module implements basic function to manipulate local filesystem, such as creating directories, deleting files, etc.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in sys;

use etc::c::dirent;
use etc::runtime::{env, errno, files};

use std::conv;
use std::unit;
use std::fs::{errors, iteration, path};
use std::time::instant;

/**
 * Create the directory at path
 * @params:
 *   - path: the path of the new directory, absolute or relative to cwd
 *   - recursive: if true, create the parent directories if they don't exists
 *   - permission: set the permission of the created directory(default: 0o775)
 * @throws:
 *   - FsError: if there was an error in the creation of the directory, cf FsErrorCode
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * createDir(Path("./some/dir"));
 * assert(isDir(Path("./some/dir")));
 *
 * // Creation of directory can be recursive
 * createDir(Path("./some/dir/and/some/sub/directories/"), recursive-> true);
 * assert(isDir(Path("./some/dir/and/some/sub/directories/")));
 *
 * // Permission of created directory can be defined
 * createDir(Path("./some/dir/small_permissions"), permission-> 0o600);
 * assert(isDir(Path("./some/dir/small_permissions")));
 * ```
 */
pub fn createDir(path: Path, recursive: bool = false, permission: i32 = 0o775)
    throws FsError
{
    let parent = path.parent();
    if (isDir(parent)) {
        let code = etc::c::dirent::mkdir(path.toStr().toStringZ(), permission);
        if (code == -1) {
            throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
        }
    } else if (recursive) {
        {
            if (!parent.isEmpty()) {
                createDir(parent, recursive-> true, permission-> permission);
            }
        } catch {
            FsError(code-> code) => {
                throw copy FsError(code, path.toStr());
            }
        }
        etc::c::dirent::mkdir(path.toStr().toStringZ(), permission);
    } else {
        throw copy FsError(FsErrorCode::PARENT_DONT_EXIST, path.parent().toStr());
    }
}


/**
 * Check for the existence of an entry of the filesystem, whatever its kind.
 * @params:
 *    - path: the path of the entry, absolute or relative to cwd
 *    - followLink: if path is a link, check the existence of the entry it points to instead of the link itself
 * @returns:
 *    - true if the entry exists
 *    - false if it does not exist, or the current user does not have permission to access it
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * if exists(Path("./some/dir/file.txt")) {
 *     println("Entry exists");
 * }
 *
 * // A dangling link exists, but the entry it points to does not
 * if exists(Path("./some/dir/file.lnk"), followLink-> false) && !exists(Path("./some/dir/file.lnk")) {
 *     println("Dangling link");
 * }
 * ```
 */
pub fn exists(path: Path, followLink: bool = true)-> bool {
    _yrt_exists(path.toStr().toStringZ(), followLink)
}

/**
 * Check for the existence of a directory
 * @params:
 *    - path: the path to the directory to access, absolute or relative to cwd
 *    - followLink: if path is a link follow it and check wether the path pointed by it is a directory
 * @returns:
 *     - true if the directory exists and is accessible
 *     - false if it does not exists or if it not a directory or current user does not have permission to access it
 * @example:
 * ```
 * use std::fs::sys;
 * use std::fs::path; // for Path
 *
 * if isDir(Path("./some/dir")) {
 *    println("Directory exists");
 * } else {
 *    println("Directory does not exists");
 * }
 * ```
 */
pub fn isDir(path: Path, followLink: bool = true)-> bool {
    _yrt_is_dir(path.toStr().toStringZ(), followLink)
}

/**
 * Remove a directory at a given path location
 * @params:
 *   - path: the path of the directory to remove
 *   - recursive: if true, remove the directory after removing all its content
 * @Warning: recursive deletion must be used very carefully
 * @throws:
 *    - FsError:
 *          + the directory is not empty, (and the removing is not recursive)
 *          + the user lacks the permission
 *          + the path does not exists
 *          + the path is not a directory
 *          + other reasons
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * removeDir(Path("./some/dir"));
 * assert(!isDir(Path("./some/dir")));
 * assert(isDir(Path("./some")));
 * ```
 */
pub fn removeDir(path: Path, recursive: bool = false)
    throws FsError
{
    if (isDir(path)) {
        if (recursive) {
            for i in readDir(path) match i {
                FsEntry(kind-> FsEntryKind::FILE, path-> p) => {
                    removeFile(p);
                }
                FsEntry(kind-> FsEntryKind::DIR, path-> p) => {
                    removeDir(p, recursive-> true);
                }
                FsEntry(path-> p) => {
                    removeFsEntry(p);
                }
            }
        }

        if (etc::c::dirent::rmdir(path.toStr().toStringZ()) == -1) {
            throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
        }
    } else {
        throw copy FsError(FsErrorCode::PARENT_DONT_EXIST, path.toStr());
    }
}


/**
 * Copy the content of a directory into another location
 * @params:
 *    - src: the directory to copy
 *    - dst: the destination location
 *    - recursive: copy sub directories of srcrecursively
 *    - create: create the destination directory ? (if true, the creation is recursive)
 * @throws:
 *   - FsError:
 *      + The source directory does not exist
 *      + The destination directory does not exist, and `create` was set to false
 *      + Permission denied(either reading or writing)
 *      + other reasons
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * copyDir(Path("./some/dir"), Path("/tmp/some/other/dir"), recursive-> true, create-> true);
 * assert(isDir(Path("/tmp/some/other/dir")));
 * ```
 */
pub fn copyDir(src: Path, dst: Path, recursive: bool = false, create: bool = false)
    throws FsError
{
    if isDir(src) {
        if (create && !isDir(dst)) { createDir(dst, recursive-> true); }
        else if !isDir(dst) { throw copy FsError(FsErrorCode::PARENT_DONT_EXIST, dst.toStr()); }
        for i in readDir(src) match i {
            FsEntry(kind-> FsEntryKind::FILE, path-> p) => { copyFile(p, dst.push(p.removePrefix(src))); }
            FsEntry(kind-> FsEntryKind::DIR, path-> p) => {
                createDir(dst.push(p.removePrefix(src)));
                if (recursive) copyDir(p, dst.push(p.removePrefix(src)), recursive-> true, create-> create);
            }
            FsEntry(path-> p) => {
                copyFsEntry(p, dst.push(p.removePrefix(src)));
            }
        }
    } else {
        throw copy FsError(FsErrorCode::PARENT_DONT_EXIST, src.toStr());
    }
}

/**
 * @returns: an iterator over the entries of a directory
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * // List entries of a directory
 * for entry in readDir(Path("./some/dir")) {
 *     println(entry);
 * }
 * ```
 */
pub fn readDir(path: Path)-> FsEntry
    throws FsError
{
    if (isDir(path)) {
        return FsEntry(path, FsEntryKind::DIR);
    }

    throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
}

/**
 * Iterate over the entries of a directory and of all its sub directories.
 * @params:
 *    - path: the path of the directory to walk, absolute or relative to cwd
 *    - contentFirst: if true, the entries of a sub directory are yielded before the sub directory itself, otherwise after it
 * @returns: a generator yielding every entry below path (path itself excluded)
 * @info:
 *    - links are yielded, but never followed, so a link to one of its parent directories does not make the walk loop.
 *    - a sub directory that cannot be read is yielded, but its content is skipped.
 *    - the entries of a directory are read when the walk enters it, the ones created or removed after that may or may not be yielded.
 * @throws:
 *   - FsError: if path is not a directory
 * @example:
 * ```
 * use std::fs::{sys, path, iteration};
 *
 * // List every file of a tree
 * for entry in walkDir(Path("./some/dir")) {
 *     if entry.kind == FsEntryKind::FILE {
 *         println(entry.path);
 *     }
 * }
 *
 * // Remove every file older than a date, then every directory left empty
 * let date = fileDate(Path("./some/dir/file.txt"));
 * for entry in walkDir(Path("./some/dir"), contentFirst-> true) {
 *     match entry.kind {
 *         FsEntryKind::FILE => { if fileDate(entry.path) < date { removeFile(entry.path); } }
 *         FsEntryKind::DIR => { removeDir(entry.path)?; } // fails if the directory is not empty
 *         _ => {}
 *     }
 * }
 * ```
 */
pub fn walkDir(path: Path, contentFirst: bool = false)-> (yield-> FsEntry)
    throws FsError
{
    readDir(path);
    walk(path, contentFirst-> contentFirst)
}

/**
 * Generator of walkDir, reading the entries of each directory up front, so a single directory is open at a time.
 */
yield walk(path: Path, contentFirst: bool)-> FsEntry {
    for e in entries(path) {
        if !contentFirst { yield e; }
        if e.kind == FsEntryKind::DIR {
            for sub in walk(e.path, contentFirst-> contentFirst) { yield sub; }
        }

        if contentFirst { yield e; }
    }
}

/**
 * @returns: the entries of a directory, none if it cannot be read
 */
fn entries(path: Path)-> [FsEntry] {
    copy [e for e in FsEntry(path, FsEntryKind::DIR)]
}

/**
 * Create a temporary directory, and return its path
 * @params:
 *    - root: the path of the parent temporary directory in which the directory will be created
 *    - prefix: prefix to add at the beginning of the name of the temp directory
 * @returns: the path of the created temporary directory
 */
pub fn tempDirectory(root: Path = Path("/tmp"), prefix: [c8] = "")-> Path
    throws FsError
{
    let template_ = root.push(prefix ~ "XXXXXX").toStr();
    let res = etc::c::files::mkdtemp(template_.toStringZ());
    if (res != null) {
        unsafe {
            Path(res.fromStringZ())
        }
    } else throw copy FsError(errors::to!{FsErrorCode} (errno()), root.toStr());
}

/**
 * Make a path absolute, by resolving it against the current working directory.
 * @params:
 *    - path: the path to make absolute
 * @returns: the absolute path, normalized (cf. Path::normalize)
 * @info: the filesystem is not accessed, the path does not have to exist, and `..` components are resolved lexically,
 *        so the result may differ from the one resolved by the filesystem when a link is followed by `..` (cf. canonicalize).
 * @throws:
 *   - FsError: if the path is relative and the current working directory cannot be resolved (it was removed, or permission denied)
 * @example:
 * ```
 * use std::fs::{sys, path};
 * use std::env;
 *
 * setCurrentDir(Path("/tmp"));
 * assert(Path("./some/../dir").absolute() == Path("/tmp/dir"));
 * assert(Path("/usr/./lib").absolute() == Path("/usr/lib"));
 * ```
 */
pub fn absolute(path: Path)-> Path
    throws FsError
{
    if path.isAbsolute() { return path.normalize(); }

    let cwd = _yrt_get_current_dir();
    if cwd.len == 0us {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }

    Path(cwd).push(path).normalize()
}

/**
 * Resolve a path to the canonical absolute path of the entry it designates, following every symbolic link.
 * @params:
 *    - path: the path of an existing entry, absolute or relative to cwd
 * @returns: an absolute path without `.`, `..` or link components
 * @throws:
 *   - FsError:
 *      + the entry, or one of the directories of the path, does not exist
 *      + permission denied
 *      + links form a loop
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * symlink(Path("dir"), Path("./some/link"));
 *
 * // Both paths designate the same entry
 * assert(Path("./some/link/file.txt").canonicalize() == Path("./some/dir/file.txt").canonicalize());
 * ```
 */
pub fn canonicalize(path: Path)-> Path
    throws FsError
{
    let resolved = _yrt_real_path(path.toStr().toStringZ());
    if resolved.len == 0us {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }

    Path(resolved)
}

/**
 * Create a new empty file without openning it, if the file already exists its content is erased.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 *    - permission: the permission of the created file (default: 0o664), masked by the umask of the process.
 *                  The permission of a file that already existed is left unchanged.
 * @throws:
 *   - FsError:
 *         + the parent directory does not exist
 *         + permission denied
 *         + path is a directory
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * createFile(Path("./some/dir/file.txt"));
 * assert(isFile(Path("./some/dir/file.txt")));
 *
 * // A file only its owner can read and write
 * createFile(Path("./some/dir/secret.txt"), permission-> 0o600);
 * ```
 */
pub fn createFile(path: Path, permission: i32 = 0o664)
    throws FsError
{
    if !_yrt_create_file(path.toStr().toStringZ(), permission) {
        throw copy FsError(errors::to!(FsErrorCode) (errno()), path.toStr());
    }
}

/**
 * @returns: the permission bits of an entry of the filesystem (e.g. 0o644), including the setuid, setgid and sticky bits
 * @params:
 *    - path: the path of the entry, absolute or relative to cwd
 *    - followLink: if path is a link, return the permission of the entry it points to instead of the permission of the link itself
 * @throws:
 *   - FsError:
 *      + the entry does not exist
 *      + permission denied
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * if permissions(Path("./some/dir/file.txt")) & 0o111 != 0 {
 *     println("Executable by someone");
 * }
 * ```
 */
pub fn permissions(path: Path, followLink: bool = true)-> i32
    throws FsError
{
    let mut mode = 0u32;
    if !_yrt_file_mode(path.toStr().toStringZ(), followLink, &mode) {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }

    cast!i32(mode)
}

/**
 * Change the permission of an entry of the filesystem, the entry pointed to if path is a link.
 * @params:
 *    - path: the path of the entry, absolute or relative to cwd
 *    - permission: the new permission bits (e.g. 0o644), the umask of the process does not apply
 * @throws:
 *   - FsError:
 *      + the entry does not exist
 *      + the current user does not own the entry
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * let script = Path("./some/dir/script.sh");
 * setPermissions(script, permissions(script) | 0o100);
 * assert(isExecutable(script));
 * ```
 */
pub fn setPermissions(path: Path, permission: i32)
    throws FsError
{
    if etc::c::files::chmod(path.toStr().toStringZ(), cast!u32(permission)) == -1 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }
}


/**
 * Read the whole content of a file.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 * @returns: the content of the file
 * @throws:
 *   - FsError:
 *       + the file does not exist
 *       + permission denied
 *       + this is not a file
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * let content = readFile(Path("./some/dir/file.txt"));
 * println(content);
 * ```
 */
pub fn readFile(path: Path)-> dmut [c8]
    throws FsError
{
    let dmut file = fs::file::File::open(path);
    return file:.readAll();
}

/**
 * Write a whole content to a file, the file is created if it does not exist.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 *    - content: the content to write
 *    - append: if true, content is written at the end of the file, otherwise it replaces the content of the file
 * @throws:
 *   - FsError:
 *       + the parent directory does not exist
 *       + permission denied
 *       + this is not a file
 *       + the content could not be entirely written (e.g. the device is full)
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * writeFile(Path("./some/dir/file.txt"), "Hello");
 * writeFile(Path("./some/dir/file.txt"), " World!", append-> true);
 *
 * assert(readFile(Path("./some/dir/file.txt")) == "Hello World!");
 * ```
 */
pub fn writeFile(path: Path, content: [c8], append: bool = false)
    throws FsError
{
    let mode = if append { "a" } else { "w" };
    let dmut handle = etc::c::files::fopen(path.toStr().toStringZ(), mode.ptr);
    if handle == null {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }

    let written = etc::c::files::fwrite(cast!{*void} (content.ptr), 1us, content.len, alias handle);
    let closed = etc::c::files::fclose(alias handle);
    if written != content.len || closed != 0 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }
}

/**
 * @returns: the instant of last modification of a file
 * @throws: FsError, if the path does not refer to a file
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * let path1 = Path("./some/dir/file.txt");
 * let path2 = Path("./some/dir/file2.txt");
 *
 * if (fileDate(path1) > fileDate(path2)) {
 *     println("Path ", path2, " is older than ", path1);
 * }
 * ```
 */
pub fn fileDate(path: Path)-> std::time::instant::Instant
    throws FsError
{
    let mut sec: i64 = 0, mut nsec: u64 = 0;
    if (!_yrt_file_date(path.toStr().toStringZ(), &sec, &nsec)) {
        throw copy FsError(FsErrorCode::NOT_FOUND, path.toStr());
    }

    Instant(cast!u64(sec), nsec)
}

/**
 * @returns: the size of a file, the file being the one pointed to if path is a link
 * @throws:
 *   - FsError:
 *       + the file does not exist
 *       + permission denied
 *       + this is not a file
 * @example:
 * ```
 * use std::fs::{sys, path};
 * use std::unit;
 *
 * let size = fileSize(Path("./some/dir/file.txt"));
 * println("The file is ", size, " long, ", size.bytes, " bytes");
 *
 * if size > MemorySize::MB(10us) {
 *     println("That's a big file");
 * }
 * ```
 */
pub fn fileSize(path: Path)-> MemorySize
    throws FsError
{
    let mut size = 0u64;
    let res = _yrt_file_size(path.toStr().toStringZ(), &size);
    if res == -1 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    } else if res == 0 {
        throw copy FsError(FsErrorCode::NOT_A_FILE, path.toStr());
    }

    MemorySize::B(cast!usize(size))
}

/**
 * Check the existence of a file.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 *    - followLink: if path is a link follow it and check wether the path pointed by it is a file
 * @returns:
 *    - true if the file exists and is a file
 *    - false if the file does not exists or is not a file, or the current user does not have permission to access it
 * @example:
 * ```
 * use std::fs::_;
 *
 * if (isFile(Path("./some/dir/file.txt"))) {
 *     println("File exists");
 * }
 * ```
 */
pub fn isFile(path: Path, followLink: bool = true)-> bool {
    _yrt_is_file(path.toStr().toStringZ(), followLink)
}

/**
 * Check the existence of a link
 * @params:
 *    - path: the path of the link, absolute or relative to cwd
 * @returns:
 *    - true if the link exists and is a link
 *    - false if the link does not exists or is not a link, or the current user does not have permission to access it
 * @example:
 * ```
 * use std::fs::_;
 *
 * if (isLink(Path("./some/dir/file.lnk"))) {
 *     println("Link exists");
 * }
 * ```
 */
pub fn isLink(path: Path)-> bool {
    _yrt_is_link(path.toStr().toStringZ())
}

/**
 * Check wether a file exists and is writable by the current user.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 * @returns: true if the file exists and is writable
 * @example:
 * ```
 * use std::fs::_;
 *
 * if (isWritable(Path("./some/dir/file.txt")) {
 *     println("File is writable");
 * }
 * ```
 */
pub fn isWritable(path: Path)-> bool {
    _yrt_is_writable(path.toStr().toStringZ())
}

/**
 * Check wether a file exists and is readable by the current user.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 * @returns: true if the file exists and is readable
 * @example:
 * ```
 * use std::fs::_;
 *
 * if (isReadable(Path("./some/dir/file.txt")) {
 *     println("File is readable");
 * }
 * ```
 */
pub fn isReadable(path: Path)-> bool {
    _yrt_is_readable(path.toStr().toStringZ())
}

/**
 * Check wether a file exists and is executable by the current user.
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 * @returns: true if the file exists and is executable
 * @example:
 * ```
 * use std::fs::_;
 *
 * if (isExecutable(Path("./some/dir/file.txt")) {
 *     println("File is readable");
 * }
 * ```
 */
pub fn isExecutable(path: Path)-> bool {
    _yrt_is_executable(path.toStr().toStringZ())
}

/**
 * Remove a file from the file system
 * @params:
 *    - path: the path of the file, absolute or relative to cwd
 * @throws:
 *   - FsError:
 *       + the file does not exists
 *       + permission denied
 *       + this is not a file
 */
pub fn removeFile(path: Path)
    throws FsError
{
    if (isFile(path)) {
        if unlink(path.toStr().toStringZ()) == -1 {
            throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
        }
    } else {
        throw copy FsError(FsErrorCode::PERMISSION_DENIED, path.toStr());
    }
}

/**
 * Copy a file to another file location.
 * @params:
 *    - src: the path of the file to copy
 *    - dst: the path of the file created by the copy (path of the file, not of the parent directory)
 * @throws:
 *   - FsError:
 *      + the src file does not exists
 *      + the dst file already exists
 *      + permission denied
 *      + this is not a file
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * assert(isFile(Path("./some/dir/file.txt")));
 * assert(isDir(Path("./some/other/dir")));
 *
 * copyFile(Path("./some/dir/file.txt"), Path("./some/other/dir/copy.txt"));
 * assert(isFile(Path("./some/other/dir/copy.txt")));
 * ```
 */
pub fn copyFile(src: Path, dst: Path)
    throws FsError
{
    let dmut srcF = fs::file::File::open(src);
    let dmut dstF = fs::file::File::create(dst, write-> true);
    dstF:.write(srcF:.readAll());
}

/**
 * Rename an entry of the filesystem, or move it to another directory of the same filesystem.
 * @params:
 *    - src: the path of the entry to rename
 *    - dst: the new path of the entry (path of the entry, not of its new parent directory)
 * @info:
 *    - the renaming is atomic, if dst exists it is replaced, and there is no instant at which dst does not exist.
 *      Writing a file under a temporary name and renaming it is thus the way to publish a whole file at once.
 *    - a file can replace a file, and a directory an empty directory. If src is a link, the link is renamed, not the entry it points to.
 * @throws:
 *   - FsError:
 *      + the src entry does not exist, or the parent directory of dst does not exist
 *      + permission denied
 *      + dst is a non empty directory, or src and dst are not both directories
 *      + src and dst are on different filesystems (CROSS_DEVICE), use a copy followed by a removal in that case
 *      + other reasons
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * let tmp = Path("./some/dir/.file.txt.tmp");
 * writeFile(tmp, "new content");
 *
 * // Readers of file.txt see either the old content or the new one, never a partially written file
 * rename(tmp, Path("./some/dir/file.txt"));
 * assert(!exists(tmp));
 * ```
 */
pub fn rename(src: Path, dst: Path)
    throws FsError
{
    if etc::c::files::rename(src.toStr().toStringZ(), dst.toStr().toStringZ()) == -1 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), src.toStr());
    }
}

/**
 * Remove an entry from the file system that is neither a directory nor a file(e.g. a symbolic link).
 * @params:
 *    - path: the path of the fs entry to remove
 * @throws:
 *   - FsError:
 *       + the entry does not exists
 *       + permission denied
 *       + this is a file, or a dir
 */
pub fn removeFsEntry(path: Path)
    throws FsError
{
    if remove(path.toStr().toStringZ()) == -1 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), path.toStr());
    }
}


/**
 * Copy a filesystem entry that is neither a directory nor a file(e.g. a symbolic link).
 * @params:
 *    - src: the path of the filesystem entry to copy
 *    - dst: the path of where to create the copy of the filesystem entry
 * @throws:
 *    - FsError:
 *       + the src does not exists
 *       + the dst already exists
 *       + permission denied
 *       + this is not a symbolic link
 *       + others
 */
pub fn copyFsEntry(src: Path, dst: Path)
    throws FsError
{
    if exists(dst, followLink-> false) { throw copy FsError(FsErrorCode::ALREADY_EXISTS, dst.toStr()); }
    if isLink(src) {
        symlink(readLink(src), dst);
    }
}

/**
 * Create a symbolic link.
 * @params:
 *    - target: the path the link points to, if relative it is resolved from the directory of the link, not from cwd
 *    - link: the path of the link to create
 * @info: target does not have to exist, the link is dangling until it does.
 * @throws:
 *   - FsError:
 *      + link already exists
 *      + the parent directory of link does not exist
 *      + permission denied
 *      + other reasons
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * symlink(Path("file.txt"), Path("./some/dir/file.lnk"));
 * assert(isLink(Path("./some/dir/file.lnk")));
 * assert(readLink(Path("./some/dir/file.lnk")) == Path("file.txt"));
 * ```
 */
pub fn symlink(target: Path, link: Path)
    throws FsError
{
    if etc::c::dirent::symlink(target.toStr().toStringZ(), link.toStr().toStringZ()) == -1 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), link.toStr());
    }
}

/**
 * Create a hard link, a new name for an existing file, both names sharing the same content.
 * @params:
 *    - target: the path of the existing file
 *    - link: the new path of the file
 * @info: the content of the file is kept until every name of the file is removed.
 * @throws:
 *   - FsError:
 *      + target does not exist, or is a directory
 *      + link already exists
 *      + target and link are on different filesystems (CROSS_DEVICE)
 *      + permission denied
 *      + other reasons
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * hardLink(Path("./some/dir/file.txt"), Path("./some/dir/other.txt"));
 * removeFile(Path("./some/dir/file.txt"));
 * assert(isFile(Path("./some/dir/other.txt")));
 * ```
 */
pub fn hardLink(target: Path, link: Path)
    throws FsError
{
    if etc::c::dirent::link(target.toStr().toStringZ(), link.toStr().toStringZ()) == -1 {
        throw copy FsError(errors::to!{FsErrorCode} (errno()), link.toStr());
    }
}

/**
 * Read the path a symbolic link points to.
 * @params:
 *    - path: the path of the link
 * @returns: the target of the link, as it was given when the link was created (a relative target is relative to the directory of the link)
 * @throws:
 *   - FsError:
 *      + the link does not exist
 *      + this is not a link
 *      + permission denied
 * @example:
 * ```
 * use std::fs::{sys, path};
 *
 * let link = Path("./some/dir/file.lnk");
 * let target = readLink(link);
 *
 * // The file pointed by the link, relative to cwd
 * let file = if target.isAbsolute() { target } else { link.parent().push(target) };
 * println(file);
 * ```
 */
pub fn readLink(path: Path)-> Path
    throws FsError
{
    let target = _yrt_read_link(path.toStr().toStringZ());
    if target.len == 0us {
        let code = errors::to!{FsErrorCode} (errno());
        if exists(path, followLink-> false) && !isLink(path) {
            throw copy FsError(FsErrorCode::NOT_A_LINK, path.toStr());
        }

        throw copy FsError(code, path.toStr());
    }

    Path(target)
}
