in fs_error_code;

/**
 * Error code used to identify a specific filesystem error
 */
pub enum FsErrorCode: u8
| FILE_CLOSED       = 1u8
| NOT_READABLE      = 2u8
| NOT_WRITABLE      = 3u8
| PERMISSION_DENIED = 4u8
| PARENT_DONT_EXIST = 5u8
| NOT_FOUND         = 6u8
| ALREADY_EXISTS    = 7u8
| IO_ERROR          = 8u8
| LINK_LOOP         = 9u8
| PATH_TOO_LONG     = 10u8
| DIR_NOT_EMPTY     = 11u8
| NOT_A_FILE        = 12u8
| CROSS_DEVICE      = 13u8
| NOT_A_LINK        = 14u8;
