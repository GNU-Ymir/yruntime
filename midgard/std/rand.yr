/**
 * This module implements functions to randomly select numbers.
 * <br>
 * The free functions of this module draw from a generator owned by the calling thread, seeded
 * from the entropy of the system when the thread first uses it, so threads never race on a shared
 * state. `seed` makes the sequence of the calling thread reproducible, and `Random` is a generator
 * that can be held, seeded and passed around explicitly.
 * @warning: these numbers are predictable, never use them to generate a secret, use
 * `secureBytes`, `secureBits` or `secureUniform` instead.
 * @authors: Emile Cadorel
 * @License: GPLv3
 */

in rand;

mod ::errors;
mod ::generator;
mod ::secure;
mod ::utils;

use std::traits;

pub def Random: generator::Random;
pub def RandomError: errors::RandomError;

pub def threadRandom = utils::threadRandom;
pub def seed = utils::seed;
pub def randBits = utils::randBits;
pub def uniform = utils::uniform;
pub def fillBytes = utils::fillBytes;
pub def randBytes = utils::randBytes;
pub def bernoulli = utils::bernoulli;
pub def normal = utils::normal;
pub def exponential = utils::exponential;
pub def poisson = utils::poisson;
pub def shuffle = utils::shuffle;
pub def choice = utils::choice;
pub def sample = utils::sample;

pub def fillSecureBytes = secure::fillSecureBytes;
pub def secureBytes = secure::secureBytes;
pub def secureBits = secure::secureBits;
pub def secureUniform = secure::secureUniform;

/**
 * @returns: a random number uniformly selected in `[0, 1[`
 * @example:
 * ```
 * // Select a number between 0 and 1 with uniform probability
 * let f = rand!f32();
 *
 * assert(f >= 0.0f && f < 1.0f);
 * ```
 */
pub fn if isFloating!{T} rand {T} ()-> T {
    threadRandom():.rand!{T}()
}
