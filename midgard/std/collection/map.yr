/**
 * Functions over the builtin hashmap `[K => V]`, a set being a map to `()`.
 * <br>
 * A builtin map has no order: its keys come out in an order that changes with its content, use an
 * `OrderedMap` or an `OrderedSet` of `std::collection` for one sorted by key.
 * @example:
 * ```
 * let dmut seen: [i32 => ()] = copy [];
 * for x in [3, 1, 3] {
 *     seen [x] = ();
 * }
 *
 * assert (seen.len == 2us && 3 in seen);
 * ```
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in map;

/**
 * @returns: a generator yielding the keys of `m`
 * @example:
 * ```
 * let m = copy [1 => "one"s8, 2 => "two"s8];
 * let mut sum = 0;
 * for k in m.keys () {
 *     sum += k;
 * }
 *
 * assert (sum == 3);
 * ```
 * @complexity: O(m.len) to exhaust the generator
 */
pub yield keys {K, V} (m: [K => V])-> K {
    for k, _ in m {
        yield k;
    }
}

/**
 * @returns: a generator yielding the values of `m`
 * @example:
 * ```
 * let m = copy ["one"s8 => 1, "two"s8 => 2];
 * let mut sum = 0;
 * for v in m.values () {
 *     sum += v;
 * }
 *
 * assert (sum == 3);
 * ```
 * @complexity: O(m.len) to exhaust the generator
 */
pub yield values {K, V} (m: [K => V])-> V {
    for _, v in m {
        yield v;
    }
}
