in unpack_error_code;

/**
 * Error code telling why a packet was refused
 */
pub enum UnpackErrorCode: u8
| TRUNCATED           = 1u8   // the packet ends before the value does
| BAD_MAGIC           = 2u8   // the packet does not start with the magic bytes "YPK"
| UNSUPPORTED_VERSION = 3u8   // the packet is written in a version of the format this program does not read
| BAD_TAG             = 4u8   // a bool or an option is written with a byte other than 0 or 1
| OVERFLOW            = 5u8   // a number does not fit its type, or a varint is not written in its shortest form
| BAD_LENGTH          = 6u8   // a length is greater than what the rest of the packet can hold
| UNKNOWN_TYPE        = 7u8   // the packet names a class that is not packable in this program
| SCHEMA_MISMATCH     = 8u8   // the packet names a class whose fields are not the same in this program
| TYPE_MISMATCH       = 9u8   // an object is not of the class, or a subclass of the class, it has to be
| BAD_REFERENCE       = 10u8  // an object or a type entry refers to one the packet has not defined
| DUPLICATE_KEY       = 11u8  // a map holds the same key twice
| NOT_A_MEMBER        = 12u8  // the value of an enum is none of its members
| TOO_DEEP            = 13u8  // objects are nested deeper than the unpacker allows, or than the stack can hold
| TRAILING            = 14u8  // bytes are left once the value is read
| INVALID             = 15u8  // the `unpacked` hook of a class refused the object it was given
| UNAUTHENTICATED     = 16u8  // the packet is not authenticated, and the receiver requires it to be
| UNSUPPORTED_AUTH    = 17u8  // the packet is authenticated with an algorithm the receiver does not implement or does not accept
| UNKNOWN_KEY         = 18u8  // the packet names a key the receiver does not hold
| BAD_SIGNATURE       = 19u8  // the tag of the packet is not the one of its bytes, its key and its context
| REPLAYED            = 20u8  // the sequence number of the packet was received already, or falls below the window the receiver remembers
| TOO_LARGE           = 21u8  // the payload is larger than the receiver accepts
;
