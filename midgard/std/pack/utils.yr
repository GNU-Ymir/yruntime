/**
 * Compile-time classification of the packable types, and the helpers shared by the packer and the unpacker.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in utils;

use core::types::info;
use etc::c::memory;
use std::conv;
use std::digest;
use std::pack::{auth_algorithm, header, packable_, unpack_error, unpack_error_code};
use std::stream;
use std::traits;

/**
 * Slice growing, used to write a sequence of bytes straight at the end of a buffer
 */
pub mod Grow {C} {

    /**
     * Extend `res` by `len` elements, and set `appended` to a view of them
     * */
    pub extern (C) fn _yrt_grow_slice(ref dmut res: [C], ref dmut appended: [C], len: usize, size: usize);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          SKIPPED FIELDS          =================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * The index of the comma ending the entry of `list` that contains the index `i`, or `list.len` for the last entry
 */
pub def if (i >= list.len) entryEnd {list: [c8], i: usize} = list.len;
pub def if (i < list.len) entryEnd {list: [c8], i: usize} = entryEndAt!{list, i, list[i]};

def if (c == ',') entryEndAt {list: [c8], i: usize, c: c8} = i;
def if (c != ',') entryEndAt {list: [c8], i: usize, c: c8} = entryEnd!{list, i + 1us};

/**
 * True if `name` is one of the entries of the comma-separated `list`, from the entry starting at `start`
 * @info: an expression evaluated at compile time does not short-circuit, so every branch selects an overload instead of reading out of the list
 */
pub def if (start > list.len) inList {list: [c8], name: [c8], start: usize} = false;
pub def if (start <= list.len) inList {list: [c8], name: [c8], start: usize} = cte (
    list[start .. entryEnd!{list, start}] == name || inList!{list, name, entryEnd!{list, start} + 1us}
);

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ================================          PACKABLE TYPES          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * True for the types written as a fixed number of bytes: bool, integers, chars, f32 and f64
 */
pub def isScalarWire {T} = cte (template!{T}{X of bool} || isIntegral!{T} || isChar!{T} || template!{T}{X of f32} || template!{T}{X of f64});

/**
 * The number of bytes a scalar takes on the wire, `isize` and `usize` taking 8 whatever the host
 */
pub def if (template!{T}{X of usize} || template!{T}{X of isize}) wireSize {T} = 8us;
pub def if !(template!{T}{X of usize} || template!{T}{X of isize}) wireSize {T} = T::size;

/**
 * True if `T` can be packed: a scalar but `f80`, a slice, a static array, a map, a tuple or an option of packable types, an enum whose values are packable, or a class or a record tagged `#[packable]`
 * The tag is read rather than the trait it implements, which is not known yet while a class whose field refers to it is validated
 */
pub def if template!{T}{enum E} isPackable {T} = isPackableEnum!{T, __pragma!unproxied(T)};
pub def if !template!{T}{enum E} isPackable {T} = isPackableType!{T};

def isPackableEnum {T, U} = cte (isPackable!{U} && !template!{U}{class C} && __pragma!compile({ let a = T::members[0]; let b: U = a; let _c_ = (b == b); }));

def isPackableType {T} = isScalarWire!{T};
def isPackableType {T of [U], U} = cte (isPackable!{U} && !isZeroWire!{U});
def isPackableType {T of [U ; N], U, N: usize} = isPackable!{U};
def isPackableType {T of [K => V], K, V} = cte (isPackable!{K} && isPackable!{V} && !(isZeroWire!{K} && isZeroWire!{V}));
def isPackableType {T of (U)?, U} = isPackable!{U};
def isPackableType {T of R, record R} = __pragma!has_tag(R, std::pack::packable_::packable);
def isPackableType {T of C, class C} = __pragma!has_tag(C, std::pack::packable_::packable);
def isPackableType {T of (U,), U...} = isPackableTuple!{T, 0us};
def isPackableType {T of ()} = true;

def if (i >= T::arity) isPackableTuple {T, i: usize} = true;
def if (i < T::arity) isPackableTuple {T, i: usize} = cte (isPackable!{__pragma!field_type(T, i)} && isPackableTuple!{T, i + 1us});

/**
 * True if the class `C` derives from a class tagged `#[packable]`
 */
pub def if __pragma!has_super(C) hasPackableSuper {C} = __pragma!has_tag(__pragma!super(C), std::pack::packable_::packable);
pub def if !__pragma!has_super(C) hasPackableSuper {C} = false;

/**
 * True if every value of `T` is written in zero bytes, the empty tuple and the arrays of zero elements
 * A slice of such elements is rejected: its length could not be bounded by the size of the packet.
 */
pub def isZeroWire {T} = false;
pub def isZeroWire {T of ()} = true;
pub def isZeroWire {T of [U ; N], U, N: usize} = cte (N == 0us || isZeroWire!{U});
pub def isZeroWire {T of (U,), U...} = isZeroWireTuple!{T, 0us};

def if (i >= T::arity) isZeroWireTuple {T, i: usize} = true;
def if (i < T::arity) isZeroWireTuple {T, i: usize} = cte (isZeroWire!{__pragma!field_type(T, i)} && isZeroWireTuple!{T, i + 1us});

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =================================          MINIMAL SIZE          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the least number of bytes a value of `T` takes on the wire
 */
pub fn minWire {T} ()-> usize {
    cte if (template!{T}{enum E}) {
        utils::minWireOf!{__pragma!unproxied(T)} ()
    } else {
        utils::minWireOf!{T} ()
    }
}

fn if isScalarWire!{T} minWireOf {T} ()-> usize {
    wireSize!{T}
}

fn minWireOf {T of [U], U} ()-> usize {
    1us
}

fn minWireOf {T of [U ; N], U, N: usize} ()-> usize {
    N * minWire!{U} ()
}

fn minWireOf {T of [K => V], K, V} ()-> usize {
    1us
}

fn minWireOf {T of (U)?, U} ()-> usize {
    1us
}

fn minWireOf {T of (U,), U...} ()-> usize {
    let mut res = 0us;
    cte for i in 0us .. T::arity {
        res += minWire!{__pragma!field_type(T, i)} ();
    }

    res
}

fn minWireOf {T of ()} ()-> usize {
    0us
}

fn minWireOf {T of R, record R} ()-> usize {
    utils::zeroed!{R} ().__pack__minWire()
}

fn minWireOf {T of C, class C} ()-> usize {
    1us
}

/**
 * @returns: a value of the record `R` whose bytes are all zero, on which the methods `#[packable]` declares are called, none of them reading a field
 */
pub fn zeroed {R} ()-> R {
    let buffer: [u8 ; R::size] = [0u8 ; R::size];
    unsafe {
        *(etc::runtime::memory::Runtime!{*u8, *R}::_yrt_unsafe_cast(buffer.ptr))
    }
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          SCHEMA          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Write the spelling of the type `T` in the schema of a class, from which its fingerprint is computed
 * A record is spelled with its fields, as its layout is not checked anywhere else, a class by its name, as it is checked by its own type entry.
 */
pub fn schema {T} (dmut s: &StringStream) {
    cte if (template!{T}{enum E}) {
        s:.write(T::typeid, ":");
        utils::schemaOf!{__pragma!unproxied(T)} (alias s);
    } else {
        utils::schemaOf!{T} (alias s);
    }
}

fn if isScalarWire!{T} schemaOf {T} (dmut s: &StringStream) {
    cte if (template!{T}{X of bool}) {
        s:.write("bool");
    } else {
        s:.write(T::typeinfo.name);
    }
}

fn schemaOf {T of [U], U} (dmut s: &StringStream) {
    s:.write("[");
    utils::schema!{U} (alias s);
    s:.write("]");
}

fn schemaOf {T of [U ; N], U, N: usize} (dmut s: &StringStream) {
    s:.write("[");
    utils::schema!{U} (alias s);
    s:.write(";", N, "]");
}

fn schemaOf {T of [K => V], K, V} (dmut s: &StringStream) {
    s:.write("[");
    utils::schema!{K} (alias s);
    s:.write("=>");
    utils::schema!{V} (alias s);
    s:.write("]");
}

fn schemaOf {T of (U)?, U} (dmut s: &StringStream) {
    s:.write("(");
    utils::schema!{U} (alias s);
    s:.write(")?");
}

fn schemaOf {T of (U,), U...} (dmut s: &StringStream) {
    s:.write("(");
    cte for i in 0us .. T::arity {
        cte if (i != 0us) {
            s:.write(",");
        }

        utils::schema!{__pragma!field_type(T, i)} (alias s);
    }

    s:.write(")");
}

fn schemaOf {T of ()} (dmut s: &StringStream) {
    s:.write("()");
}

fn schemaOf {T of R, record R} (dmut s: &StringStream) {
    utils::zeroed!{R} ().__pack__schema(alias s);
}

fn schemaOf {T of C, class C} (dmut s: &StringStream) {
    s:.write("&", C::typeinfo.inner[0].name);
}

/**
 * @returns: the 64-bit FNV-1a hash of `schema`
 */
pub fn fingerprint(schema: [c8])-> u64 {
    let mut h = 0xcbf29ce484222325u64;
    for c in schema {
        h = (h ^ cast!u64(cast!u8(c))) * 0x100000001b3u64;
    }

    h
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ===================================          CLASSES          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * @returns: the type info of the class of the object at `obj`, stored in the first slot of its vtable
 */
pub fn classOf(obj: *void)-> TypeInfo {
    unsafe {
        *(*(*(cast!{*(*(*TypeInfo))} (obj))))
    }
}

/**
 * @returns: true if the class of `ti` is named `ancestor`, or one of its ancestors is
 */
pub fn inherits(ti: TypeInfo, ancestor: [c8])-> bool {
    let mut current = ti;
    while current.name != ancestor {
        if current.inner.len == 0us return false;
        current = current.inner[0];
    }

    true
}

/**
 * @returns: true if `a` equals `b`
 */
pub fn equals {U} (a: U, b: U)-> bool {
    a == b
}

/**
 * @returns: the value at `p`, borrowing its memory when it holds borrowed data, a value without any being copied
 */
pub fn load {T} (dmut p: *T)-> dmut T {
    cte if (__pragma!compile({ unsafe { let dmut _b_: T = alias *p; } })) {
        unsafe {
            return alias *p;
        }
    } else {
        unsafe {
            return *p;
        }
    }
}

/**
 * @returns: `v`, borrowing its memory when it holds borrowed data, a value without any being copied
 */
pub fn keep {T} (ref dmut v: T)-> dmut T {
    cte if (__pragma!compile({ let dmut _b_: T = alias v; })) {
        alias v
    } else {
        v
    }
}

/**
 * @returns: the HMAC-SHA-256 with `key` of `frame` followed by `context`
 */
pub fn tagOf(key: [u8], frame: [u8], context: [u8])-> [u8 ; 32us] {
    let dmut h = copy Hmac!{&Sha256} (key);
    h:.update(frame);
    h:.update(context);
    h:.finish()
}

/**
 * Read the header at the start of `bytes`
 * @throws:
 *    - &UnpackError: if `bytes` is shorter than a header (TRUNCATED), does not start with the magic bytes (BAD_MAGIC), or is written in another version of the format (UNSUPPORTED_VERSION)
 */
pub fn readHeader(bytes: [u8])-> Header
    throws UnpackError
{
    for i, m in MAGIC {
        if (i >= bytes.len) throw copy UnpackError(UnpackErrorCode::TRUNCATED, i, "the packet ends");
        if (bytes[i] != m) throw copy UnpackError(UnpackErrorCode::BAD_MAGIC, i, "not a packet");
    }

    if (bytes.len > 3us && bytes[3us] != VERSION) {
        throw copy UnpackError(UnpackErrorCode::UNSUPPORTED_VERSION, 3us, "version " ~ bytes[3us].to![c8] () ~ " of the format");
    }

    if (bytes.len < HEADER_SIZE) {
        throw copy UnpackError(UnpackErrorCode::TRUNCATED, bytes.len, "the packet ends");
    }

    let mut keyId = 0u32;
    let mut sequence = 0u64;
    let mut len = 0u64;
    memcpy(cast!{*void} (&keyId), cast!{*void} (bytes.ptr + KEY_OFFSET), 4us);
    memcpy(cast!{*void} (&sequence), cast!{*void} (bytes.ptr + SEQUENCE_OFFSET), 8us);
    memcpy(cast!{*void} (&len), cast!{*void} (bytes.ptr + LENGTH_OFFSET), 8us);

    Header(bytes[ALG_OFFSET], keyId, sequence, len)
}

/**
 * Write `header` over the header starting at `at` in `bytes`
 */
pub fn writeHeader(dmut bytes: [u8], at: usize, header: Header) {
    for i, m in MAGIC {
        bytes[at + i] = m;
    }

    bytes[at + 3us] = VERSION;
    bytes[at + ALG_OFFSET] = header.alg;
    memcpy(cast!{*void} (bytes.ptr + at + KEY_OFFSET), cast!{*void} (&header.keyId), 4us);
    memcpy(cast!{*void} (bytes.ptr + at + SEQUENCE_OFFSET), cast!{*void} (&header.sequence), 8us);
    memcpy(cast!{*void} (bytes.ptr + at + LENGTH_OFFSET), cast!{*void} (&header.payloadLen), 8us);
}

/**
 * @returns: the number of bytes of the tag following the payload of a packet authenticated with `alg`
 * @throws:
 *    - &UnpackError: if `alg` is not an algorithm this program implements (UNSUPPORTED_AUTH)
 */
pub fn tagSize(alg: u8)-> usize
    throws UnpackError
{
    if (alg == AuthAlgorithm::NONE) return 0us;
    if (alg == AuthAlgorithm::HMAC_SHA256) return HMAC_TAG_SIZE;

    throw copy UnpackError(UnpackErrorCode::UNSUPPORTED_AUTH, ALG_OFFSET, "authentication algorithm " ~ alg.to![c8] () ~ " is not implemented");
}

/**
 * Check that `len` bytes hold the whole frame of the packet whose header is `header`, and nothing else
 * @returns: the number of bytes of the tag
 * @throws:
 *    - &UnpackError: if the bytes end before the frame does (TRUNCATED), or go on after it (TRAILING)
 */
pub fn checkFrame(header: Header, len: usize)-> usize
    throws UnpackError
{
    let tag = tagSize(header.alg);
    let room = if (len < HEADER_SIZE + tag) { 0u64 } else { cast!u64(len - HEADER_SIZE - tag) };
    if (header.payloadLen > room) {
        throw copy UnpackError(UnpackErrorCode::TRUNCATED, len, "the packet ends");
    }

    if (header.payloadLen < room) {
        let end = HEADER_SIZE + cast!usize(header.payloadLen) + tag;
        throw copy UnpackError(UnpackErrorCode::TRAILING, end, (len - end).to![c8] () ~ " bytes left");
    }

    tag
}
