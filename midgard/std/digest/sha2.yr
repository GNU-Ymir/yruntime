/**
 * This module implements the SHA-2 digests of FIPS 180-4: SHA-224 and SHA-256, computed on 32
 * bits words, and SHA-384 and SHA-512, computed on 64 bits words.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * @example:
 * ```
 * use std::digest::sha2;
 * use std::encoding::hex;
 *
 * assert(hex::encode(sha256("abc")) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
 *
 * let dmut h = copy Sha512();
 * h:.update("a");
 * h:.update("bc");
 * assert(h:.finish() == sha512("abc"));
 * ```
 */

in sha2;

use std::digest::block;
use std::traits;

def INIT224 = [0xc1059ed8u32, 0x367cd507u32, 0x3070dd17u32, 0xf70e5939u32, 0xffc00b31u32, 0x68581511u32, 0x64f98fa7u32, 0xbefa4fa4u32];

def INIT256 = [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32];

def INIT384 = [0xcbbb9d5dc1059ed8u64, 0x629a292a367cd507u64, 0x9159015a3070dd17u64, 0x152fecd8f70e5939u64,
               0x67332667ffc00b31u64, 0x8eb44a8768581511u64, 0xdb0c2e0d64f98fa7u64, 0x47b5481dbefa4fa4u64];

def INIT512 = [0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64, 0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
               0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64, 0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64];

lazy __SHA256_K__: [u32 ; 64] = [0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
            0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
            0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
            0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
            0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
            0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
            0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
            0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32];

lazy __SHA512_K__: [u64 ; 80] = [0x428a2f98d728ae22u64, 0x7137449123ef65cdu64, 0xb5c0fbcfec4d3b2fu64, 0xe9b5dba58189dbbcu64, 0x3956c25bf348b538u64,
            0x59f111f1b605d019u64, 0x923f82a4af194f9bu64, 0xab1c5ed5da6d8118u64, 0xd807aa98a3030242u64, 0x12835b0145706fbeu64,
            0x243185be4ee4b28cu64, 0x550c7dc3d5ffb4e2u64, 0x72be5d74f27b896fu64, 0x80deb1fe3b1696b1u64, 0x9bdc06a725c71235u64,
            0xc19bf174cf692694u64, 0xe49b69c19ef14ad2u64, 0xefbe4786384f25e3u64, 0x0fc19dc68b8cd5b5u64, 0x240ca1cc77ac9c65u64,
            0x2de92c6f592b0275u64, 0x4a7484aa6ea6e483u64, 0x5cb0a9dcbd41fbd4u64, 0x76f988da831153b5u64, 0x983e5152ee66dfabu64,
            0xa831c66d2db43210u64, 0xb00327c898fb213fu64, 0xbf597fc7beef0ee4u64, 0xc6e00bf33da88fc2u64, 0xd5a79147930aa725u64,
            0x06ca6351e003826fu64, 0x142929670a0e6e70u64, 0x27b70a8546d22ffcu64, 0x2e1b21385c26c926u64, 0x4d2c6dfc5ac42aedu64,
            0x53380d139d95b3dfu64, 0x650a73548baf63deu64, 0x766a0abb3c77b2a8u64, 0x81c2c92e47edaee6u64, 0x92722c851482353bu64,
            0xa2bfe8a14cf10364u64, 0xa81a664bbc423001u64, 0xc24b8b70d0f89791u64, 0xc76c51a30654be30u64, 0xd192e819d6ef5218u64,
            0xd69906245565a910u64, 0xf40e35855771202au64, 0x106aa07032bbd1b8u64, 0x19a4c116b8d2d0c8u64, 0x1e376c085141ab53u64,
            0x2748774cdf8eeb99u64, 0x34b0bcb5e19b48a8u64, 0x391c0cb3c5c95a63u64, 0x4ed8aa4ae3418acbu64, 0x5b9cca4f7763e373u64,
            0x682e6ff3d6b2b8a3u64, 0x748f82ee5defb2fcu64, 0x78a5636f43172f60u64, 0x84c87814a1f0ab72u64, 0x8cc702081a6439ecu64,
            0x90befffa23631e28u64, 0xa4506cebde82bde9u64, 0xbef9a3f7b2c67915u64, 0xc67178f2e372532bu64, 0xca273eceea26619cu64,
            0xd186b8c721c0c207u64, 0xeada7dd6cde0eb1eu64, 0xf57d4f7fee6ed178u64, 0x06f067aa72176fbau64, 0x0a637dc5a2c898a6u64,
            0x113f9804bef90daeu64, 0x1b710b35131c471bu64, 0x28db77f523047d84u64, 0x32caab7b40c72493u64, 0x3c9ebe0a15c9bebcu64,
            0x431d67c49c100d4cu64, 0x4cc5d4becb3e42b6u64, 0x597f299cfc657e2au64, 0x5fcb6fab3ad6faecu64, 0x6c44198c4a475817u64];

/**
 * The SHA-224 digest of a message absorbed piece by piece.
 * @example:
 * ```
 * use std::digest::sha2;
 *
 * let dmut h = copy Sha224();
 * h:.update("a");
 * h:.update("bc");
 *
 * assert(h:.finish() == sha224("abc"));
 * ```
 */
@final
pub class Sha224 over BlockDigest!{64us} {

    let mut _h: [mut u32 ; 8];

    pub self ()
        with super ()
        , _h = INIT224
    {}

    /**
     * @returns: the digest of the message absorbed so far, the hasher starting a new message
     */
    pub fn finish(mut self)-> [u8 ; 28] {
        self:.pad(true);

        let dmut res = [0u8 ; 28];
        store32be(self._h, ref res);

        self._h = INIT224;
        res
    }

    /**
     * Discard the message absorbed so far.
     */
    pub fn reset(mut self) {
        self:.clear();
        self._h = INIT224;
    }

    prot over compress(mut self, block: [u8 ; 64us]) {
        compress256(ref self._h, block);
    }
}

/**
 * The SHA-256 digest of a message absorbed piece by piece.
 * @example:
 * ```
 * use std::digest::sha2;
 *
 * let dmut h = copy Sha256();
 * h:.update("a");
 * h:.update("bc");
 *
 * assert(h:.finish() == sha256("abc"));
 * ```
 */
@final
pub class Sha256 over BlockDigest!{64us} {

    let mut _h: [mut u32 ; 8];

    pub self ()
        with super ()
        , _h = INIT256
    {}

    /**
     * @returns: the digest of the message absorbed so far, the hasher starting a new message
     */
    pub fn finish(mut self)-> [u8 ; 32] {
        self:.pad(true);

        let dmut res = [0u8 ; 32];
        store32be(self._h, ref res);

        self._h = INIT256;
        res
    }

    /**
     * Discard the message absorbed so far.
     */
    pub fn reset(mut self) {
        self:.clear();
        self._h = INIT256;
    }

    prot over compress(mut self, block: [u8 ; 64us]) {
        compress256(ref self._h, block);
    }
}

/**
 * The SHA-384 digest of a message absorbed piece by piece.
 * @example:
 * ```
 * use std::digest::sha2;
 *
 * let dmut h = copy Sha384();
 * h:.update("a");
 * h:.update("bc");
 *
 * assert(h:.finish() == sha384("abc"));
 * ```
 */
@final
pub class Sha384 over BlockDigest!{128us} {

    let mut _h: [mut u64 ; 8];

    pub self ()
        with super ()
        , _h = INIT384
    {}

    /**
     * @returns: the digest of the message absorbed so far, the hasher starting a new message
     */
    pub fn finish(mut self)-> [u8 ; 48] {
        self:.pad(true);

        let dmut res = [0u8 ; 48];
        store64be(self._h, ref res);

        self._h = INIT384;
        res
    }

    /**
     * Discard the message absorbed so far.
     */
    pub fn reset(mut self) {
        self:.clear();
        self._h = INIT384;
    }

    prot over compress(mut self, block: [u8 ; 128us]) {
        compress512(ref self._h, block);
    }
}

/**
 * The SHA-512 digest of a message absorbed piece by piece.
 * @example:
 * ```
 * use std::digest::sha2;
 *
 * let dmut h = copy Sha512();
 * h:.update("a");
 * h:.update("bc");
 *
 * assert(h:.finish() == sha512("abc"));
 * ```
 */
@final
pub class Sha512 over BlockDigest!{128us} {

    let mut _h: [mut u64 ; 8];

    pub self ()
        with super ()
        , _h = INIT512
    {}

    /**
     * @returns: the digest of the message absorbed so far, the hasher starting a new message
     */
    pub fn finish(mut self)-> [u8 ; 64] {
        self:.pad(true);

        let dmut res = [0u8 ; 64];
        store64be(self._h, ref res);

        self._h = INIT512;
        res
    }

    /**
     * Discard the message absorbed so far.
     */
    pub fn reset(mut self) {
        self:.clear();
        self._h = INIT512;
    }

    prot over compress(mut self, block: [u8 ; 128us]) {
        compress512(ref self._h, block);
    }
}

/**
 * @returns: the SHA-224 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest::sha2;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha224(""))); // d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
 * ```
 */
pub fn if isBytes!{T} sha224 {T} (data: T)-> [u8 ; 28] {
    let dmut h = copy Sha224();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-256 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest::sha2;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha256(""))); // e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
 * ```
 */
pub fn if isBytes!{T} sha256 {T} (data: T)-> [u8 ; 32] {
    let dmut h = copy Sha256();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-384 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest::sha2;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha384("abc"))); // cb00753f45a35e8b...
 * ```
 */
pub fn if isBytes!{T} sha384 {T} (data: T)-> [u8 ; 48] {
    let dmut h = copy Sha384();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-512 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest::sha2;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha512("abc"))); // ddaf35a193617aba...
 * ```
 */
pub fn if isBytes!{T} sha512 {T} (data: T)-> [u8 ; 64] {
    let dmut h = copy Sha512();
    h:.update(data);
    h:.finish()
}

/**
 * Update the state `h` of a SHA-224 or SHA-256 digest with a block of the message.
 */
fn compress256(ref mut h: [mut u32 ; 8], block: [u8 ; 64us]) {
    let dmut w = [0u32 ; 64];
    for i in 0us .. 16us {
        w[i] = load32be(block, i * 4us);
    }

    for i in 16us .. 64us {
        let s0 = rotr32(w[i - 15us], 7u32) ^ rotr32(w[i - 15us], 18u32) ^ (w[i - 15us] >> 3u32);
        let s1 = rotr32(w[i - 2us], 17u32) ^ rotr32(w[i - 2us], 19u32) ^ (w[i - 2us] >> 10u32);
        w[i] = w[i - 16us] + s0 + w[i - 7us] + s1;
    }

    let mut a = h[0], mut b = h[1], mut c = h[2], mut d = h[3];
    let mut e = h[4], mut f = h[5], mut g = h[6], mut k = h[7];
    for i in 0us .. 64us {
        let s1 = rotr32(e, 6u32) ^ rotr32(e, 11u32) ^ rotr32(e, 25u32);
        let ch = (e & f) ^ ((e ^ 0xffffffffu32) & g);
        let t1 = k + s1 + ch + __SHA256_K__[i] + w[i];
        let s0 = rotr32(a, 2u32) ^ rotr32(a, 13u32) ^ rotr32(a, 22u32);
        let t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));

        k = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += k;
}

/**
 * Update the state `h` of a SHA-384 or SHA-512 digest with a block of the message.
 */
fn compress512(ref mut h: [mut u64 ; 8], block: [u8 ; 128us]) {
    let dmut w = [0u64 ; 80];
    for i in 0us .. 16us {
        w[i] = load64be(block, i * 8us);
    }

    for i in 16us .. 80us {
        let s0 = rotr64(w[i - 15us], 1u64) ^ rotr64(w[i - 15us], 8u64) ^ (w[i - 15us] >> 7u64);
        let s1 = rotr64(w[i - 2us], 19u64) ^ rotr64(w[i - 2us], 61u64) ^ (w[i - 2us] >> 6u64);
        w[i] = w[i - 16us] + s0 + w[i - 7us] + s1;
    }

    let mut a = h[0], mut b = h[1], mut c = h[2], mut d = h[3];
    let mut e = h[4], mut f = h[5], mut g = h[6], mut k = h[7];
    for i in 0us .. 80us {
        let s1 = rotr64(e, 14u64) ^ rotr64(e, 18u64) ^ rotr64(e, 41u64);
        let ch = (e & f) ^ ((e ^ 0xffffffffffffffffu64) & g);
        let t1 = k + s1 + ch + __SHA512_K__[i] + w[i];
        let s0 = rotr64(a, 28u64) ^ rotr64(a, 34u64) ^ rotr64(a, 39u64);
        let t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));

        k = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += k;
}
