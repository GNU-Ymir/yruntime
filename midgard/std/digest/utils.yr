/**
 * @returns: the SHA-224 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha224(""))); // d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
 * ```
 */
pub fn if isBytes!{T} sha224 {T} (data: T)-> [u8 ; 28] {
    let dmut h = copy Sha224();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-256 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha256(""))); // e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
 * ```
 */
pub fn if isBytes!{T} sha256 {T} (data: T)-> [u8 ; 32] {
    let dmut h = copy Sha256();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-384 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha384("abc"))); // cb00753f45a35e8b...
 * ```
 */
pub fn if isBytes!{T} sha384 {T} (data: T)-> [u8 ; 48] {
    let dmut h = copy Sha384();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-512 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha512("abc"))); // ddaf35a193617aba...
 * ```
 */
pub fn if isBytes!{T} sha512 {T} (data: T)-> [u8 ; 64] {
    let dmut h = copy Sha512();
    h:.update(data);
    h:.finish()
}

/**
 * Update the state `h` of a SHA-224 or SHA-256 digest with a block of the message.
 */
pub fn compress256(ref mut h: [mut u32 ; 8], block: [u8 ; 64us]) {
    let dmut w = [0u32 ; 64];
    for i in 0us .. 16us {
        w[i] = load32be(block, i * 4us);
    }

    for i in 16us .. 64us {
        let s0 = rotr32(w[i - 15us], 7u32) ^ rotr32(w[i - 15us], 18u32) ^ (w[i - 15us] >> 3u32);
        let s1 = rotr32(w[i - 2us], 17u32) ^ rotr32(w[i - 2us], 19u32) ^ (w[i - 2us] >> 10u32);
        w[i] = w[i - 16us] + s0 + w[i - 7us] + s1;
    }

    let mut a = h[0], mut b = h[1], mut c = h[2], mut d = h[3];
    let mut e = h[4], mut f = h[5], mut g = h[6], mut k = h[7];
    for i in 0us .. 64us {
        let s1 = rotr32(e, 6u32) ^ rotr32(e, 11u32) ^ rotr32(e, 25u32);
        let ch = (e & f) ^ ((e ^ 0xffffffffu32) & g);
        let t1 = k + s1 + ch + __SHA256_K__[i] + w[i];
        let s0 = rotr32(a, 2u32) ^ rotr32(a, 13u32) ^ rotr32(a, 22u32);
        let t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));

        k = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += k;
}

/**
 * Update the state `h` of a SHA-384 or SHA-512 digest with a block of the message.
 */
pub fn compress512(ref mut h: [mut u64 ; 8], block: [u8 ; 128us]) {
    let dmut w = [0u64 ; 80];
    for i in 0us .. 16us {
        w[i] = load64be(block, i * 8us);
    }

    for i in 16us .. 80us {
        let s0 = rotr64(w[i - 15us], 1u64) ^ rotr64(w[i - 15us], 8u64) ^ (w[i - 15us] >> 7u64);
        let s1 = rotr64(w[i - 2us], 19u64) ^ rotr64(w[i - 2us], 61u64) ^ (w[i - 2us] >> 6u64);
        w[i] = w[i - 16us] + s0 + w[i - 7us] + s1;
    }

    let mut a = h[0], mut b = h[1], mut c = h[2], mut d = h[3];
    let mut e = h[4], mut f = h[5], mut g = h[6], mut k = h[7];
    for i in 0us .. 80us {
        let s1 = rotr64(e, 14u64) ^ rotr64(e, 18u64) ^ rotr64(e, 41u64);
        let ch = (e & f) ^ ((e ^ 0xffffffffffffffffu64) & g);
        let t1 = k + s1 + ch + __SHA512_K__[i] + w[i];
        let s0 = rotr64(a, 28u64) ^ rotr64(a, 34u64) ^ rotr64(a, 39u64);
        let t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));

        k = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += k;
}

/**
 * @returns: the 32 bits word stored most significant byte first at index `i` of `block`
 */
pub fn load32be {N: usize} (block: [u8 ; N], i: usize)-> u32 {
    (cast!u32(block[i]) << 24u32) | (cast!u32(block[i + 1us]) << 16u32)
        | (cast!u32(block[i + 2us]) << 8u32) | cast!u32(block[i + 3us])
}

/**
 * @returns: the 32 bits word stored least significant byte first at index `i` of `block`
 */
pub fn load32le {N: usize} (block: [u8 ; N], i: usize)-> u32 {
    (cast!u32(block[i + 3us]) << 24u32) | (cast!u32(block[i + 2us]) << 16u32)
        | (cast!u32(block[i + 1us]) << 8u32) | cast!u32(block[i])
}

/**
 * @returns: the 64 bits word stored most significant byte first at index `i` of `block`
 */
pub fn load64be {N: usize} (block: [u8 ; N], i: usize)-> u64 {
    let mut res = 0u64;
    for j in 0us .. 8us {
        res = (res << 8u64) | cast!u64(block[i + j]);
    }

    res
}

/**
 * Write the words of `words`, each most significant byte first, to the first bytes of `res`.
 */
pub fn store32be {N: usize, M: usize} (words: [u32 ; M], ref mut res: [mut u8 ; N]) {
    for i in 0us .. N {
        res[i] = cast!u8(words[i / 4us] >> cast!u32((3us - i % 4us) * 8us));
    }
}

/**
 * Write the words of `words`, each most significant byte first, to the first bytes of `res`.
 */
pub fn store64be {N: usize, M: usize} (words: [u64 ; M], ref mut res: [mut u8 ; N]) {
    for i in 0us .. N {
        res[i] = cast!u8(words[i / 8us] >> cast!u64((7us - i % 8us) * 8us));
    }
}

/**
 * @returns: `x` rotated by `n` bits to the left
 */
pub fn rotl32(x: u32, n: u32)-> u32 {
    (x << n) | (x >> (32u32 - n))
}

/**
 * @returns: `x` rotated by `n` bits to the right
 */
pub fn rotr32(x: u32, n: u32)-> u32 {
    (x >> n) | (x << (32u32 - n))
}

/**
 * @returns: `x` rotated by `n` bits to the right
 */
pub fn rotr64(x: u64, n: u64)-> u64 {
    (x >> n) | (x << (64u64 - n))
}

/**
 * @returns: the MD5 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(md5(""))); // d41d8cd98f00b204e9800998ecf8427e
 * ```
 */
pub fn if isBytes!{T} md5 {T} (data: T)-> [u8 ; 16] {
    let dmut h = copy Md5();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the SHA-1 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha1(""))); // da39a3ee5e6b4b0d3255bfef95601890afd80709
 * ```
 */
pub fn if isBytes!{T} sha1 {T} (data: T)-> [u8 ; 20] {
    let dmut h = copy Sha1();
    h:.update(data);
    h:.finish()
}

/**
 * @returns: the HMAC of `data` with the key `key`, computed with the digest `H`; strings being used
 * as their UTF-8 bytes
 * @example:
 * ```
 * use std::digest;
 * use std::encoding::hex;
 *
 * println(hex::encode(hmac!{&Sha512} ("key", "message")));
 * ```
 */
pub fn if (isBytes!{K} && isBytes!{T}) hmac {class H, K, T} (key: K, data: T)-> typeof((copy H ()):.finish()) {
    let dmut h = copy Hmac!{H} (key);
    h:.update(data);
    h:.finish()
}

/**
 * Compare two codes in a time that depends on their length only, not on the position of the first
 * byte that differs, so the time of the comparison tells nothing about the expected code.
 * @returns: true iif `a` and `b` hold the same bytes
 * @example:
 * ```
 * use std::digest;
 *
 * let expected = hmac!{&Sha256} ("key", "message");
 * assert(equals(expected, hmac!{&Sha256} ("key", "message")));
 * assert(!equals(expected, hmac!{&Sha256} ("key", "massage")));
 * ```
 */
pub fn if (isBytes!{A} && isBytes!{B}) equals {A, B} (a: A, b: B)-> bool {
    let mut diff = a.len ^ b.len;
    if diff != 0us return false;

    for i in 0us .. a.len {
        diff = diff | cast!usize(cast!u8(a[i]) ^ cast!u8(b[i]));
    }

    diff == 0us
}
