/**
 * This module implements the SHA-1 digest of FIPS 180-4, 20 bytes long.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * @warning: SHA-1 is broken, colliding messages have been computed. Use it to interoperate with
 * a protocol that requires it, the handshake of a WebSocket for instance, never to authenticate
 * data, prefer `std::digest::sha2`.
 * @example:
 * ```
 * use std::digest::sha1;
 * use std::encoding::hex;
 *
 * assert(hex::encode(sha1("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d");
 * ```
 */

in sha1;

use std::digest::block;
use std::traits;

def INIT = [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32, 0xc3d2e1f0u32];

/**
 * The SHA-1 digest of a message absorbed piece by piece.
 * @example:
 * ```
 * use std::digest::sha1;
 * use std::encoding::hex;
 *
 * let dmut h = copy Sha1();
 * h:.update("a");
 * h:.update("bc");
 *
 * assert(hex::encode(h:.finish()) == "a9993e364706816aba3e25717850c26c9cd0d89d");
 * ```
 */
@final
pub class Sha1 over BlockDigest!{64us} {

    let mut _h: [mut u32 ; 5];

    pub self ()
        with super ()
        , _h = INIT
    {}

    /**
     * @returns: the digest of the message absorbed so far, the hasher starting a new message
     */
    pub fn finish(mut self)-> [u8 ; 20] {
        self:.pad(true);

        let dmut res = [0u8 ; 20];
        store32be(self._h, ref res);

        self._h = INIT;
        res
    }

    /**
     * Discard the message absorbed so far.
     */
    pub fn reset(mut self) {
        self:.clear();
        self._h = INIT;
    }

    prot over compress(mut self, block: [u8 ; 64us]) {
        let dmut w = [0u32 ; 80];
        for i in 0us .. 16us {
            w[i] = load32be(block, i * 4us);
        }

        for i in 16us .. 80us {
            w[i] = rotl32(w[i - 3us] ^ w[i - 8us] ^ w[i - 14us] ^ w[i - 16us], 1u32);
        }

        let mut a = self._h[0], mut b = self._h[1], mut c = self._h[2], mut d = self._h[3], mut e = self._h[4];
        for i in 0us .. 80us {
            let mut f = 0u32, mut k = 0u32;
            if i < 20us {
                f = (b & c) | ((b ^ 0xffffffffu32) & d);
                k = 0x5a827999u32;
            } else if i < 40us {
                f = b ^ c ^ d;
                k = 0x6ed9eba1u32;
            } else if i < 60us {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8f1bbcdcu32;
            } else {
                f = b ^ c ^ d;
                k = 0xca62c1d6u32;
            }

            let t = rotl32(a, 5u32) + f + e + k + w[i];
            e = d;
            d = c;
            c = rotl32(b, 30u32);
            b = a;
            a = t;
        }

        self._h[0] += a;
        self._h[1] += b;
        self._h[2] += c;
        self._h[3] += d;
        self._h[4] += e;
    }
}

/**
 * @returns: the SHA-1 digest of `data`, a string being digested as its UTF-8 bytes
 * @example:
 * ```
 * use std::digest::sha1;
 * use std::encoding::hex;
 *
 * println(hex::encode(sha1(""))); // da39a3ee5e6b4b0d3255bfef95601890afd80709
 * ```
 */
pub fn if isBytes!{T} sha1 {T} (data: T)-> [u8 ; 20] {
    let dmut h = copy Sha1();
    h:.update(data);
    h:.finish()
}
