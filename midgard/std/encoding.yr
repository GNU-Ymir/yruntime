/**
 * This module implements the textual encodings of binary data: base64 (RFC 4648), hexadecimal and
 * the percent-encoding of URIs (RFC 3986).
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * Every encoder accepts a sequence of bytes, a slice or a static array of `u8`, or a string, whose
 * `c8` are its UTF-8 bytes. Decoding base64 or hexadecimal throws a `DecodeError` on a malformed
 * text, while decoding percent-escapes never fails, a `%` that does not start an escape being kept
 * as it is.
 * @example:
 * ```
 * use std::conv;
 * use std::encoding::{base64, hex, percent};
 *
 * let data = ("hello").to![u8] ();
 *
 * assert(base64::encode(data) == "aGVsbG8=");
 * assert(hex::encode(data) == "68656c6c6f");
 * assert(percent::encode("a b/c") == "a%20b%2Fc");
 *
 * assert(base64::decode("aGVsbG8=") == data);
 * ```
 */

in encoding;

pub mod ::base64;
pub mod ::errors;
pub mod ::hex;
pub mod ::percent;
