in implem;

use std::stream;
use std::concurrency::ring;

/**
 * A FIFO of messages shared between threads, every operation taking its lock
 * */
@abstract
pub class IMailBox {T, mutable: bool} {

    cte if mutable {
        let dmut _mails: &Ring!{dmut T} = copy Ring!{dmut T} ();
    } else {
        let dmut _mails: &Ring!{T} = copy Ring!{T} ();
    }

    /**
     * Create a new empty mailbox
     * */
    pub self () {}


    cte if !mutable {
        /**
         * Post a message in the mailbox
         * @params:
         *   - value: the value to post
         * */
        pub fn send(mut self, value: T) {
            atomic self {
                self._mails:.push (value);
            }
        }

        /**
         * @returns: the first value found in the box if any
         * */
        pub fn receive(mut self)-> (T)? {
            atomic self {
                return self._mails:.pop ();
            }
        }

        /**
         * @returns: all the messages in the mailbox
         * */
        pub fn opIndex(mut self)-> [T] {
            atomic self {
                return self._mails:.drain ();
            }
        }

    } else {
        /**
         * Post a message in the mailbox
         * @params:
         *   - value: the value to post
         * */
        pub fn send(mut self, dmut value: T) {
            atomic self {
                self._mails:.push (alias value);
            }
        }

        /**
         * @returns: the first value found in the box if any
         * */
        pub fn receive(mut self)-> dmut(T)? {
            atomic self {
                return alias self._mails:.pop ();
            }
        }

        /**
         * @returns: all the messages in the mailbox
         * */
        pub fn opIndex(mut self)-> dmut[T] {
            atomic self {
                return alias self._mails:.drain ();
            }
        }

    }


    /**
     * Clear everything that can be found in the mailbox
     * */
    pub fn clear(mut self) {
        atomic self {
            self._mails:.clear ();
        }
    }

    /**
     * @returns: the number of element in the box
     * */
    @field
    pub fn len(self)-> usize {
        self._mails.len
    }

    impl Streamable {
        pub over toStream(self, dmut stream: &StringStream) {
            stream:.write("MailBox {");
            atomic self {
                for i in 0us .. self._mails.len {
                    if let Ok (m) = self._mails[i] {
                        cte if __pragma!compile({ stream:.write(m); }) {
                            if i != 0us { stream:.write(", "); }
                            stream:.write(m);
                        } else {
                            m;
                        }
                    }
                }
            }
            stream:.write("}");
        }
    }

}
