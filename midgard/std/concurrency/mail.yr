in mail;

mod ::implem;
mod ::asyncbox;
use mail::implem;

pub def AsyncMailBox = asyncbox::AsyncMailBox;
pub def MailReceive = asyncbox::MailReceive;

pub class MailBox {T} over IMailBox!{T, false} {
    pub self () {}
}

pub class MailBox {T of dmut J, class J} over IMailBox!{T, true} {
    pub self () {}
}
