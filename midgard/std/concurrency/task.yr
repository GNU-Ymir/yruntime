/**
 * This module implements the class TaskPool, that encapsulate a task queue and a set of worker thread to execute the tasks.
 * The task queue is a FIFO queue.
 * It also implements the class Task, the scheduling state of an async value, that its waker puts back in a ready queue.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * @example:
 * ```
 * use std::io; // for 'println'
 * use std::concurrency;
 *
 * fn computePi(prec: i32)-> f64 {
 *    let mut res = 0.0;
 *    let n = cast!f64(prec);
 *    for i in 0 .. prec {
 *        res += (4.0 / n) / ( 1.0 + (( cast!f64(i) - 0.5 ) * (1.0 / n)) * (( cast!f64(i) - 0.5 ) * (1.0 / n)));
 *    }
 *    res
 * }
 *
 * fn main() {
 *     let dmut pool = copy TaskPool(nbThreads-> 2u64); // Creating a task pool with two threads
 *
 *     // Only two threads are spawned to perform 1_000_000 jobs
 *     for _ in 0 .. 1_000_000 {
 *         pool:.submit(|| => {
 *             println(computePi(i32::max / 1000));
 *         });
 *     }
 *
 *     pool:.join();
 * }
 * ```
 */
in task;

use core::concurrency;

/**
 * The scheduling state of a `Task`
 */
pub enum TaskState: u8
| IDLE      = 0u8 // pending, polled again only once its waker is called
| SCHEDULED = 1u8 // in a ready queue, its next poll is due
| RUNNING   = 2u8 // being polled
| NOTIFIED  = 3u8 // being polled, and woken since the poll started
| DONE      = 4u8; // completed, never polled again

/**
 * An async value and its scheduling state, polled by `run` and put back in a ready queue by its waker `wake`.
 * Where a woken task goes is up to the `enqueue` function it is created with, so it is independent of any pool.
 * A newly created task is `SCHEDULED`, because its first poll is due: its creator enqueues it.
 * @example:
 * ```
 * use std::concurrency;
 *
 * async yielding () {
 *     await; // calls the waker during the poll, the task is requeued
 * }
 *
 * fn main () {
 *     let dmut ready = copy MailBox!{dmut &Task} ();
 *     let dmut task = copy Task (yielding (), copy |dmut t| => ready:.send (alias t));
 *     ready:.send (alias task);
 *
 *     let mut done = false;
 *     while !done {
 *         if let Ok (dmut t) = alias ready:.receive () {
 *             done = t:.run (); // false at the first run, true at the second
 *         }
 *     }
 * }
 * ```
 */
@final
pub class Task {

    let _value: async-> void;

    let _enqueue: dg (dmut &Task)-> void;

    let mut _state: TaskState = TaskState::SCHEDULED;

    /**
     * @params:
     *    - value: the async value the task polls
     *    - enqueue: called with the task whenever it becomes `SCHEDULED` again
     */
    pub self (value: async-> void, enqueue: dg (dmut &Task)-> void)
        with _value = value, _enqueue = enqueue
    {}

    /**
     * The waker of the task: an `IDLE` task becomes `SCHEDULED` and is enqueued, a `RUNNING` one `NOTIFIED`.
     * It does nothing in any other state, so it can be called from any thread, any number of times.
     */
    pub fn wake (mut self) {
        let mut push = false;
        atomic self {
            match self._state {
                TaskState::IDLE => {
                    self._state = TaskState::SCHEDULED;
                    push = true;
                }
                TaskState::RUNNING => {
                    self._state = TaskState::NOTIFIED;
                }
                _ => {}
            }
        }

        if push self._enqueue (alias self);
    }

    /**
     * Polls a `SCHEDULED` task once, with `wake` as waker. A completed task becomes `DONE`, a pending one `IDLE`,
     * or `SCHEDULED` and enqueued again if it was woken during the poll. A task in any other state is not polled.
     * @returns: true iif the task is `DONE`
     */
    pub fn run (mut self)-> bool {
        atomic self {
            if self._state != TaskState::SCHEDULED return self._state == TaskState::DONE;
            self._state = TaskState::RUNNING;
        }

        let mut done = false;
        if let Ok () = self._value.poll (&self:.wake) {
            done = true;
        }

        let mut push = false;
        atomic self {
            if done {
                self._state = TaskState::DONE;
            } else if self._state == TaskState::NOTIFIED {
                self._state = TaskState::SCHEDULED;
                push = true;
            } else {
                self._state = TaskState::IDLE;
            }
        }

        if push self._enqueue (alias self);
        done
    }

    /**
     * @returns: the current state of the task
     */
    @field
    pub fn state (self)-> TaskState {
        atomic self {
            return self._state;
        }
    }

}

@final
pub class TaskPool {

    // The list of task submitted in the task pool
    let dmut _mails: &mail::MailBox!{dg()-> void} = copy mail::MailBox!{dg ()-> void} ();

    // the number of thread to manage in the pool
    let _nbThreads: u32;

    // The threads spawned by the pool
    let mut _threads: [mut future-> void] = [];

    // The semaphore used to trigger the workers
    let dmut _ready: &Semaphore = copy Semaphore();

    // The semaphore used
    let dmut _waitTask: &Semaphore = copy Semaphore();

    // Set to true when the task pool is disposed
    let mut _terminated: bool = false;

    // The number of finished tasks
    let mut _finished: usize = 0;

    // The number of submitted tasks
    let mut _submitted: usize = 0;

    /**
     * Create a task pool
     * */
    pub self (nbThreads: u32 = 0u32)
        with _nbThreads = (if (nbThreads == 0u32) etc::runtime::threads::_yrt_get_nprocs() else nbThreads)
    {
        // Spawn the threads of the pool
        self._threads = copy [spawn { self:.workerMain(i); } for i in 0 .. self._nbThreads];
        for _ in 0 .. self._nbThreads {
            self._ready:.wait();
        }
    }

    /**
     * Submit a task to the task pool
     * @limitation: submitted tasks cannot have blocking treatment, for complex and dependant tasks normal threads have to be used
     * */
    pub fn submit(mut self, task: dg ()-> void) {
        atomic self {
            self._submitted += 1;
            self._mails:.send(task);
        }

        self._waitTask:.post();
    }

    /**
     * Wait for the task pool to complete all submitted tasks
     * */
    pub fn join(mut self) {
        loop {
            atomic self {
                // an empty mailbox is not enough, a task that was already dequeued by a
                // worker is no longer in the mailbox but is still running
                if (self._terminated || self._finished == self._submitted) return;
            }

            // _ready may hold posts emitted while tasks were still being submitted, in
            // which case the loop simply checks the counters again
            if (!self._ready:.wait()) return; // the semaphore was disposed, the pool is dead
        }
    }

    /**
     * Clear the tasks that have been submitted
     * */
    pub fn clear(mut self) {
        atomic self {
            let len = self._mails.len;
            self._mails:.clear();
            self._finished += len;
            if (self._finished == self._submitted) self._ready:.post();
        }
    }

    /**
     * Stop all running threads in the task pool without waiting for all tasks to be completed
     * */
    pub fn dispose(mut self) {
        if (!self._terminated) {
            self._terminated = true;
            self._mails:.clear();

            // a post wakes any idle worker, not a given one: wake them all before joining
            for _ in 0us .. self._threads.len {
                self._waitTask:.post();
            }

            for i in 0us .. self._threads.len {
                self._threads[i].value;
            }

            // Every worker has been joined, so none of them can be blocked on the
            // semaphores anymore, they are safe to destroy here. Doing it now rather
            // than leaving it to their own destructors is what makes this class
            // independent of the order the gc finalizes the pool and its fields in.
            self._ready:.dispose();
            self._waitTask:.dispose();
        }
    }

    __dtor(mut self) {
        self:.dispose();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Worker threads waiting for tasks to be submitted and execute them one after the other
     * */
    fn workerMain(mut self, _: u32) {
        self._ready:.post();
        loop {
            self._waitTask:.wait();
            if (self._terminated) break;

            if let Ok(j) = self._mails:.receive() {
                j();
                atomic self {
                    self._finished += 1;
                    if (self._finished == self._submitted) self._ready:.post();
                }
            }
        }
    }

}
