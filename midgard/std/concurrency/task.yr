/**
 * This module implements the class TaskPool, a set of worker threads polling async values, and the class Task,
 * the scheduling state of an async value, that its waker puts back in a ready queue.
 * A worker polls a ready task once: a pending task frees its worker, and is polled again only once woken.
 * Submitting an async returns a `TaskHandle` of its result, that an async awaits and a thread waits on.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 * <hr>
 * @example:
 * ```
 * use std::io; // for 'println'
 * use std::concurrency;
 * use std::time;
 *
 * async fetch (id: i32) {
 *     await delay (millis (10u64)); // parked, its worker polls the other tasks meanwhile
 *     println ("fetched ", id);
 * }
 *
 * fn slow (id: i32)-> i32 {
 *     sleep (millis (10u64));
 *     id * 2
 * }
 *
 * async compute (id: i32) {
 *     let f = spawn slow (id); // blocking work moves to a thread of its own
 *     let r = await f;
 *     println ("computed ", r);
 * }
 *
 * fn main () {
 *     let dmut pool = copy TaskPool (nbThreads-> 2u64);
 *     for i in 0 .. 100 {
 *         pool:.submit (fetch (i));
 *         pool:.submit (compute (i));
 *     }
 *
 *     pool:.join ();
 *     pool:.dispose ();
 * }
 * ```
 */
in task;

use core::concurrency;

/**
 * The scheduling state of a `Task`
 */
pub enum TaskState: u32
| IDLE      = 0u32 // pending, polled again only once its waker is called
| SCHEDULED = 1u32 // in a ready queue, its next poll is due
| RUNNING   = 2u32 // being polled
| NOTIFIED  = 3u32 // being polled, and woken since the poll started
| DONE      = 4u32; // completed, never polled again

/**
 * An async value and its scheduling state, polled by `run` and put back in a ready queue by its waker `wake`.
 * Where a woken task goes is up to the `enqueue` function it is created with, so it is independent of any pool.
 * A newly created task is `SCHEDULED`, because its first poll is due: its creator enqueues it.
 * The state is a lock-free word: each transition is a compare-and-swap, and only the thread polling the task leaves
 * `RUNNING` or `NOTIFIED`.
 * @example:
 * ```
 * use std::concurrency;
 *
 * async yielding () {
 *     await; // calls the waker during the poll, the task is requeued
 * }
 *
 * fn main () {
 *     let dmut ready = copy MailBox!{dmut &Task} ();
 *     let dmut task = copy Task (yielding (), copy |dmut t| => ready:.send (alias t));
 *     ready:.send (alias task);
 *
 *     let mut done = false;
 *     while !done {
 *         if let Ok (dmut t) = alias ready:.receive () {
 *             done = t:.run (); // false at the first run, true at the second
 *         }
 *     }
 * }
 * ```
 */
@final
pub class Task {

    let _value: async-> void;

    let _enqueue: dg (dmut &Task)-> void;

    let mut _state: Atomic!{u32} = Atomic!{u32} (TaskState::SCHEDULED);

    /**
     * @params:
     *    - value: the async value the task polls
     *    - enqueue: called with the task whenever it becomes `SCHEDULED` again
     */
    pub self (value: async-> void, enqueue: dg (dmut &Task)-> void)
        with _value = value, _enqueue = enqueue
    {}

    /**
     * The waker of the task: an `IDLE` task becomes `SCHEDULED` and is enqueued, a `RUNNING` one `NOTIFIED`.
     * It does nothing in any other state, so it can be called from any thread, any number of times.
     */
    pub fn wake (mut self) {
        let mut current: u32 = TaskState::IDLE;
        loop {
            if current == TaskState::IDLE {
                if self._state:.compareExchange (ref current, TaskState::SCHEDULED) {
                    self._enqueue (alias self);
                    return;
                }
            } else if current == TaskState::RUNNING {
                if self._state:.compareExchange (ref current, TaskState::NOTIFIED) return;
            } else {
                return;
            }
        }
    }

    /**
     * Polls a `SCHEDULED` task once, with `wake` as waker. A completed task becomes `DONE`, a pending one `IDLE`,
     * or `SCHEDULED` and enqueued again if it was woken during the poll. A task in any other state is not polled.
     * @returns: true iif the task is `DONE`
     */
    pub fn run (mut self)-> bool {
        let mut current: u32 = TaskState::SCHEDULED;
        if !self._state:.compareExchange (ref current, TaskState::RUNNING) return current == TaskState::DONE;

        if let Ok () = self._value.poll (&self:.wake) {
            self._state:.store (TaskState::DONE);
            return true;
        }

        current = TaskState::RUNNING;
        if !self._state:.compareExchange (ref current, TaskState::IDLE) {
            self._state:.store (TaskState::SCHEDULED); // it is NOTIFIED, a state only the polling thread leaves
            self._enqueue (alias self);
        }

        false
    }

    /**
     * Marks an `IDLE` or `SCHEDULED` task `DONE` without polling it, so that its waker does nothing from then on.
     * @returns: false if the task was being polled or already `DONE`, its state being left unchanged
     */
    pub fn cancel (mut self)-> bool {
        let mut current: u32 = TaskState::IDLE;
        while current == TaskState::IDLE || current == TaskState::SCHEDULED {
            if self._state:.compareExchange (ref current, TaskState::DONE) return true;
        }

        false
    }

    /**
     * @returns: the current state of the task
     */
    @field
    pub fn state (self)-> TaskState {
        match self._state.load () {
            TaskState::IDLE      => TaskState::IDLE
            TaskState::SCHEDULED => TaskState::SCHEDULED
            TaskState::RUNNING   => TaskState::RUNNING
            TaskState::NOTIFIED  => TaskState::NOTIFIED
            _                    => TaskState::DONE
        }
    }

}

/**
 * The handle of the value an async completes with, a leaf that any number of asyncs can await, and threads wait on.
 * `TaskPool::submit` returns one, the task it submits being `drive`.
 * Awaiting a handle never throws, as the async it is the result of cannot throw: an error travels in the value.
 * @example:
 * ```
 * use std::io;
 * use std::concurrency;
 *
 * async square (x: i32)-> i32 {
 *     x * x
 * }
 *
 * async sum (dmut pool: &TaskPool, n: i32)-> i32 {
 *     let dmut handles = copy [pool:.submit (square (i)) for i in 0 .. n];
 *     let mut total = 0;
 *     for i in 0us .. handles.len {
 *         total += await alias handles[i]; // parks this task, its worker polls the children meanwhile
 *     }
 *     total
 * }
 *
 * fn main () {
 *     let dmut pool = copy TaskPool (nbThreads-> 2u32);
 *     let dmut h = pool:.submit (sum (alias pool, 10));
 *     println (h:.wait ()); // 285
 *     pool:.dispose ();
 * }
 * ```
 */
@final
pub class TaskHandle {T} {

    let mut _source: (async-> T)? = none;

    let mut _value: T? = none;

    let mut _waker: (dg ()-> void)? = none;

    let mut _wakers: [dg ()-> void] = [];

    /**
     * @params:
     *    - source: the async value whose result the handle holds, once `drive` completed it
     */
    pub self (source: async-> T)
        with _source = source?
    {}

    /**
     * @returns: the value of the async if it completed, none otherwise, calling `waker` once it completes
     * @info: the wakers are a set of delegates, so an awaiter polling with the same waker is registered once
     */
    pub fn poll (mut self, waker: dg ()-> void)-> T? {
        atomic self {
            if self._value.hasValue return self._value;
            if let Ok (first) = self._waker {
                if first == waker return none;
                for w in self._wakers {
                    if w == waker return none;
                }

                self._wakers ~= [waker];
            } else {
                self._waker = waker?;
            }
        }

        none
    }

    /**
     * Block the calling thread until the async completed
     * @returns: the value of the async
     * @warning: waiting from a worker holds it, and never returns once the pool is disposed before completion
     */
    pub fn wait (mut self)-> T {
        awaitHandle!{T} (alias self).run ()
    }

    /**
     * Await the source to completion, then store its value and call the wakers.
     * Only the first `drive` awaits the source, any other one completing at once.
     */
    pub async drive (mut self) {
        let mut source: (async-> T)? = none;
        atomic self {
            source = self._source;
            self._source = none;
        }

        if let Ok (s) = source {
            let value = (await s)?;
            let mut first: (dg ()-> void)? = none;
            let mut wakers: [dg ()-> void] = [];
            atomic self {
                self._value = value;
                first = self._waker;
                wakers = self._wakers;
                self._waker = none;
                self._wakers = [];
            }

            if let Ok (w) = first {
                w ();
            }

            for w in wakers {
                w ();
            }
        }
    }

}

async awaitHandle {T} (dmut handle: &TaskHandle!{T})-> T {
    await alias handle
}

/**
 * The worker of a `TaskPool` running on the calling thread, none on a thread that is not a worker
 */
@thread
lazy dmut __TASK_WORKER__ : (&Worker)? = none;

// the polls between two in which a worker looks at the queue of the pool before its own
def INJECT_EVERY = 61u32;

// the most tasks a worker takes from the queue of the pool at once
def INJECT_BATCH = 32us;

/**
 * The ready tasks of a worker of a `TaskPool`: a FIFO the other workers steal from.
 * The queue is guarded by the lock of the worker, the rest is used by its own thread alone.
 */
@final
class Worker {

    let _index: usize;

    let dmut _queue: &ring::Ring!{dmut &Task} = copy ring::Ring!{dmut &Task} ();

    // the tasks taken from another queue, until `adopt` moves them to this one
    let dmut _taken: &ring::Ring!{dmut &Task} = copy ring::Ring!{dmut &Task} ();

    let mut _seed: u32;

    // posted by the schedule that takes the worker out of the sleepers, or by the disposal of the pool
    let dmut _wakeup: &Semaphore = copy Semaphore ();

    pub self (index: usize)
        with _index = index, _seed = cast!u32 (index) * 2654435761u32 + 1u32
    {}

    /**
     * @returns: the index of the worker in its pool
     */
    @field
    pub fn index (self)-> usize {
        self._index
    }

    /**
     * Append a task at the back of the queue
     */
    pub fn push (mut self, dmut task: &Task) {
        atomic self {
            self._queue:.push (alias task);
        }
    }

    /**
     * @returns: the task at the front of the queue, removed from it, none if the queue is empty
     */
    pub fn next (mut self)-> dmut (&Task)? {
        atomic self {
            return alias self._queue:.pop ();
        }
    }

    /**
     * Take a task from another queue, polled once `adopt` returns it
     */
    pub fn take (mut self, dmut task: &Task) {
        self._taken:.push (alias task);
    }

    /**
     * Take the front half of the queue of `victim`, rounded up
     * @returns: the number of tasks taken
     */
    pub fn steal (mut self, dmut victim: &Worker)-> usize {
        atomic victim {
            let n = victim._queue.len - victim._queue.len / 2us;
            for _ in 0us .. n {
                if let Ok (dmut t) = alias victim._queue:.pop () {
                    self._taken:.push (alias t);
                }
            }

            return n;
        }
    }

    /**
     * @returns: the first of the tasks taken, the others going to the back of the queue
     */
    pub fn adopt (mut self)-> dmut (&Task)? {
        let dmut first = alias self._taken:.pop ();
        if self._taken.len != 0us {
            atomic self {
                while let Ok (dmut t) = alias self._taken:.pop () {
                    self._queue:.push (alias t);
                }
            }
        }

        alias first
    }

    /**
     * Mark the tasks of the queue `DONE`, and remove them
     * @returns: the number of tasks removed
     */
    pub fn cancelAll (mut self)-> u64 {
        let mut nb = 0u64;
        atomic self {
            while let Ok (dmut t) = alias self._queue:.pop () {
                t:.cancel ();
                nb += 1u64;
            }
        }

        nb
    }

    /**
     * Remove the tasks of the queue, and destroy the semaphore the worker sleeps on
     */
    pub fn dispose (mut self) {
        atomic self {
            self._queue:.clear ();
        }

        self._taken:.clear ();
        self._wakeup:.dispose ();
    }

    /**
     * Block the thread of the worker until `wake` is called
     */
    pub fn sleep (mut self) {
        self._wakeup:.wait ();
    }

    /**
     * Wake the thread of the worker, or let its next `sleep` return at once
     */
    pub fn wake (mut self) {
        self._wakeup:.post ();
    }

    /**
     * @returns: a pseudo-random number lower than `nb`
     */
    pub fn random (mut self, nb: usize)-> usize {
        self._seed = self._seed ^ (self._seed << 13u32);
        self._seed = self._seed ^ (self._seed >> 17u32);
        self._seed = self._seed ^ (self._seed << 5u32);
        cast!usize (self._seed) % nb
    }

}

/**
 * The sleeping workers of a `TaskPool`, by index, in the order they fell asleep
 */
@final
class Sleepers {

    let mut _asleep: [mut bool] = [];

    let dmut _order: &ring::Ring!{usize} = copy ring::Ring!{usize} ();

    // written under the lock of the sleepers, read without it
    let mut _count: Atomic!{u32} = Atomic!{u32} (0u32);

    /**
     * @params:
     *    - nb: the number of workers of the pool
     */
    pub self (nb: usize) {
        self._asleep = copy [false for _ in 0us .. nb];
    }

    /**
     * Count the worker `i` asleep
     */
    pub fn add (mut self, i: usize) {
        atomic self {
            self._asleep[i] = true;
            self._order:.push (i);
            self._count:.store (self._count.load () + 1u32);
        }
    }

    /**
     * Uncount the worker `i`, that found a task before sleeping
     * @returns: false if `pop` already uncounted it, its semaphore being posted
     */
    pub fn remove (mut self, i: usize)-> bool {
        atomic self {
            if !self._asleep[i] return false;
            self._asleep[i] = false;
            let mut at = 0us;
            for j in 0us .. self._order.len {
                if self._order[j] == (i)? at = j;
            }

            self._order:.removeAt (at);
            self._count:.store (self._count.load () - 1u32);
        }

        true
    }

    /**
     * @returns: the worker asleep the longest, uncounted, none if no worker is asleep
     */
    pub fn pop (mut self)-> usize? {
        atomic self {
            if let Ok (i) = self._order:.pop () {
                self._asleep[i] = false;
                self._count:.store (self._count.load () - 1u32);
                return i?;
            }
        }

        none
    }

    /**
     * @returns: the number of workers asleep
     */
    @field
    pub fn count (self)-> u32 {
        self._count.load ()
    }

}

/**
 * A pool of worker threads polling the async values submitted to it.
 * A worker polls a ready task once (see `Task::run`). A pending task frees its worker: it is held only by what keeps
 * its waker, and is put back in a ready queue once woken.
 *
 * Each worker has a queue of its own. A task submitted or woken by a worker goes to the back of the queue of that
 * worker, a task submitted or woken from any other thread to the queue of the pool. A worker takes its tasks from
 * its queue, then from the queue of the pool, then steals half of the queue of another worker, and sleeps when they
 * are all empty. It looks at the queue of the pool first every `INJECT_EVERY` polls, so that the tasks submitted
 * from outside are never starved.
 *
 * @warning: blocking inside an async (a subprocess, `h.run ()`, `pool.join ()`, `sleep`) holds its worker until
 *           it returns, awaiting a `spawn` moves such work to a thread of its own, `await delay (d)` is the
 *           sleep that frees the worker
 */
@final
pub class TaskPool {

    // the tasks scheduled from a thread that is not a worker, guarded by the lock of the pool
    let dmut _inject: &ring::Ring!{dmut &Task} = copy ring::Ring!{dmut &Task} ();

    let dmut _workers: [&Worker] = [];

    let _nbThreads: u32;

    let mut _threads: [mut future-> void] = [];

    // posted once by each worker when it starts, then whenever every submitted task is finished
    let dmut _ready: &Semaphore = copy Semaphore ();

    let dmut _sleepers: &Sleepers = copy Sleepers (0us);

    let mut _terminated: Atomic!{u32} = Atomic!{u32} (0u32);

    let mut _finished: Atomic!{u64} = Atomic!{u64} (0u64);

    let mut _submitted: Atomic!{u64} = Atomic!{u64} (0u64);

    /**
     * Create a task pool
     * @params:
     *    - nbThreads: the number of workers, the number of processors if 0
     */
    pub self (nbThreads: u32 = 0u32)
        with _nbThreads = (if (nbThreads == 0u32) etc::runtime::threads::_yrt_get_nprocs () else nbThreads)
    {
        let nb = cast!usize (self._nbThreads);
        self._workers = copy [copy Worker (i) for i in 0us .. nb];
        self._sleepers = copy Sleepers (nb);
        self._threads = copy [spawn { self:.workerMain (i); } for i in 0us .. nb];
        for _ in 0us .. nb {
            self._ready:.wait ();
        }
    }

    /**
     * Submit an async value to the pool, its first poll being due
     * @returns: the handle of the value the async completes with, awaited from an async or waited on from a thread
     */
    pub fn submit {T} (mut self, value: async-> T)-> dmut &TaskHandle!{T} {
        let dmut handle = copy TaskHandle!{T} (value);
        let dmut task = copy Task (handle:.drive (), &self:.schedule);
        self._submitted:.add (1u64);
        self:.schedule (alias task);
        alias handle
    }

    /**
     * Wait for every submitted task to complete
     * @warning: a task whose waker is never called never completes, and keeps this waiting forever
     */
    pub fn join (mut self) {
        loop {
            if (self._terminated.load () != 0u32) return;
            if (self.allFinished ()) return;

            // _ready may hold posts emitted while tasks were still being submitted, the counters are checked again
            if (!self._ready:.wait ()) return;
        }
    }

    /**
     * Drop the tasks waiting in the ready queues, counting them as finished. They are marked `DONE`, so a late
     * wake does nothing. A pending task is not in a queue, it completes or is woken normally.
     */
    pub fn clear (mut self) {
        let mut dropped = 0u64;
        atomic self {
            while let Ok (dmut t) = alias self._inject:.pop () {
                t:.cancel ();
                dropped += 1u64;
            }
        }

        for i in 0us .. self._workers.len {
            dropped += self._workers[i]:.cancelAll ();
        }

        if (dropped != 0u64) self:.finish (dropped);
    }

    /**
     * Stop the workers once their current poll returns, without waiting for the tasks to complete.
     * The tasks left pending are collected with their frame, and a later wake of them does nothing.
     */
    pub fn dispose (mut self) {
        atomic self {
            if (self._terminated.load () != 0u32) return;
            self._terminated:.store (1u32);
            self._inject:.clear ();
        }

        for i in 0us .. self._workers.len {
            self._workers[i]:.wake ();
        }

        for i in 0us .. self._threads.len {
            self._threads[i].value;
        }

        // the workers are joined, so none of them waits on the semaphores anymore: they are destroyed now,
        // independently of the order the gc finalizes the pool and its fields in
        for i in 0us .. self._workers.len {
            self._workers[i]:.dispose ();
        }

        self._ready:.dispose ();
    }

    __dtor (mut self) {
        self:.dispose ();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Enqueue a task whose poll is due, the enqueue function of the tasks of the pool: at the back of the queue of
     * the calling worker, or in the queue of the pool if the caller is not one of its workers
     */
    fn schedule (mut self, dmut task: &Task) {
        if let Ok (dmut w) = alias __TASK_WORKER__ {
            if self.owns (w) {
                if (self._terminated.load () != 0u32) return;
                w:.push (alias task);
                self:.notify ();
                return;
            }
        }

        atomic self {
            if (self._terminated.load () != 0u32) return;
            self._inject:.push (alias task);
        }

        self:.notify ();
    }

    /**
     * @returns: true iif `w` is a worker of this pool
     */
    fn owns (self, w: &Worker)-> bool {
        w.index < self._workers.len && (self._workers[w.index] is w)
    }

    /**
     * Wake the worker asleep the longest, if one is
     */
    fn notify (mut self) {
        if (self._sleepers.count == 0u32) return;
        if let Ok (i) = self._sleepers:.pop () {
            self._workers[i]:.wake ();
        }
    }

    /**
     * Count `nb` more tasks finished, posting `_ready` if every submitted task is
     */
    fn finish (mut self, nb: u64) {
        let finished = self._finished:.add (nb);
        if (finished == self._submitted.load ()) self._ready:.post ();
    }

    /**
     * @returns: true iif every submitted task is finished
     * @info: `_finished` is read first, a task submitting another being counted finished only after the submit
     */
    fn allFinished (self)-> bool {
        let finished = self._finished.load ();
        finished == self._submitted.load ()
    }

    /**
     * Move at most `max` tasks from the front of the queue of the pool to the tasks `w` took, its share of the
     * queue rounded up
     * @returns: the number of tasks moved
     */
    fn inject (mut self, dmut w: &Worker, max: usize)-> usize {
        atomic self {
            let len = self._inject.len;
            if len == 0us return 0us;

            let share = len / self._workers.len + 1us;
            let n = if share > max { max } else if share > len { len } else { share };
            for _ in 0us .. n {
                if let Ok (dmut t) = alias self._inject:.pop () {
                    w:.take (alias t);
                }
            }

            return n;
        }
    }

    /**
     * Steal the front half of the queue of another worker for `w`, trying each one from a random first
     * @returns: the number of tasks stolen
     */
    fn steal (mut self, dmut w: &Worker)-> usize {
        let nb = self._workers.len;
        if nb < 2us return 0us;

        let start = w:.random (nb);
        for k in 0us .. nb {
            let i = (start + k) % nb;
            if i != w.index {
                let n = w:.steal (alias self._workers[i]);
                if n != 0us return n;
            }
        }

        0us
    }

    /**
     * @returns: the first of the `nb` tasks `w` took, notifying an idle worker if some of them went to its queue
     */
    fn adopt (mut self, dmut w: &Worker, nb: usize)-> dmut (&Task)? {
        let dmut t = alias w:.adopt ();
        if nb > 1us self:.notify ();
        alias t
    }

    /**
     * @returns: the next task for `w` to poll, none if every queue it looks at is empty
     */
    fn find (mut self, dmut w: &Worker, fair: bool)-> dmut (&Task)? {
        if fair {
            let n = self:.inject (alias w, 1us);
            if n != 0us return alias self:.adopt (alias w, n);
        }

        let dmut local = alias w:.next ();
        if local.hasValue return alias local;

        let n = self:.inject (alias w, INJECT_BATCH);
        if n != 0us return alias self:.adopt (alias w, n);

        let s = self:.steal (alias w);
        if s != 0us return alias self:.adopt (alias w, s);

        none
    }

    /**
     * Count `w` asleep, then look for a task once more before sleeping, so that a task scheduled meanwhile either is
     * found or wakes it
     * @returns: the task found, none if the worker slept
     */
    fn park (mut self, dmut w: &Worker)-> dmut (&Task)? {
        self._sleepers:.add (w.index);
        let dmut found = alias self:.find (alias w, false);
        if found.hasValue {
            // a schedule took it out of the sleepers, and posts it right after: the post is consumed here
            if !self._sleepers:.remove (w.index) w:.sleep ();
            return alias found;
        }

        w:.sleep ();
        none
    }

    /**
     * Poll `t`, counting it finished if it completed
     */
    fn poll (mut self, dmut t: &Task) {
        if t:.run () {
            self:.finish (1u64);
        }
    }

    /**
     * Poll the tasks of the worker `index` one after the other, waiting for one when every queue is empty
     */
    fn workerMain (mut self, index: usize) {
        let dmut w = alias self._workers[index];
        __TASK_WORKER__ = (alias w)?;
        self._ready:.post ();

        let mut ticks = 0u32;
        while self._terminated.load () == 0u32 {
            ticks += 1u32;
            if let Ok (dmut t) = alias self:.find (alias w, ticks % INJECT_EVERY == 0u32) {
                self:.poll (alias t);
            } else if let Ok (dmut t) = alias self:.park (alias w) {
                self:.poll (alias t);
            }
        }

        __TASK_WORKER__ = none;
    }

}
