in utils;

/**
 * @returns: the exit code a status of waitpid holds, `128 + n` if the signal `n` killed the process
 */
pub fn exitCode(status: i32)-> i32 {
    let signal = status & 0x7f;
    if (signal != 0) return 128 + signal;

    (status >> 8) & 0xff
}
