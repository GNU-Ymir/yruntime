in threads;

/**
 * @returns: the number of processors available on the system
 * */
pub extern (C) fn _yrt_get_nprocs()-> u32;

/**
 * @returns: the uniq id of the current thread
 * */
pub extern (C) fn _yrt_thread_self_id()-> usize;

/**
 * fork() the calling process, the locks of the allocations of the collector held around the call
 * so that a fork() racing an allocation in a sibling thread cannot leave one held in the child.
 * @returns: 0 in the child, the child's pid in the parent -- same semantics as libc fork()
 * */
pub extern (C) fn _yrt_fork()-> u32;

/**
 * @returns: the number of bytes left on the stack of the calling thread, or `u64::max` when its bounds are unknown
 * */
pub extern (C) fn _yrt_stack_left()-> u64;
