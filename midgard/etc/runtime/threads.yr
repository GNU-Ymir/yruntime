in threads;

/**
 * @returns: the number of processors available on the system
 * */
pub extern (C) fn _yrt_get_nprocs()-> u32;

/**
 * @returns: the uniq id of the current thread
 * */
pub extern (C) fn _yrt_thread_self_id()-> usize;

/**
 * fork() the calling process, quiescing the GC around the call so that a fork() racing a
 * concurrent GC_malloc() in a sibling thread cannot corrupt the allocator's internal state.
 * @returns: 0 in the child, the child's pid in the parent -- same semantics as libc fork()
 * */
pub extern (C) fn _yrt_fork()-> u32;
