in exception;

/**
 * Make the program panic without resolving stacktrace
 * @info: should only be used to panic on internal runtime error only
 * */
pub extern (C) fn _yrt_exc_panic_no_trace();

/**
 * Throw the exception `data`, as the compiled `throw` statement does
 * @params:
 *    - file, func, line: where it is thrown from, as null-terminated strings
 * */
pub extern (C) fn _yrt_exc_throw (file: *c8, func: *c8, line: u32, data: &core::exception::Exception)
    throws core::exception::Exception;
