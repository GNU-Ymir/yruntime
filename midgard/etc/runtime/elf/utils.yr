in utils;

use etc::runtime::elf::bit_64;

/**
 * Create an new ELF loader
 * */
pub fn createLoader()-> dmut &ELFLoader {
    cte if __version!x86_64 {
        copy ELF64Loader()
    } else { // other elf loaders are not implemented
        copy EmptyELFLoader()
    }
}
