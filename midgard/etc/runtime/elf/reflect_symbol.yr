in reflect_symbol;

pub record ReflectSymbol {
    pub let type: ReflectSymbolType;
    pub let ptr: usize;
    pub let size: usize;
    pub let name: [c8];

    pub self (type: ReflectSymbolType, ptr: usize, size: usize, name: [c8])
        with type = type
        , ptr = ptr
        , size = size
        , name = name
    {}
}
