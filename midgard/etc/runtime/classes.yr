in classes;

pub mod Classes {T} {

    /**
     * Allocate the class whose vtable is `vtable`, zeroed but for its vtable, without registering its destructor
     * */
    pub extern (C) fn _yrt_alloc_class_pending(vtable: *void)-> dmut T;
}

/**
 * Register the destructor of a class allocated by `_yrt_alloc_class_pending`, once every one of its fields is written
 * */
pub extern (C) fn _yrt_commit_class(cl: *void);
