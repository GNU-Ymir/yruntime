in gc;

pub extern (C) fn _yrt_disable_GC();
pub extern (C) fn _yrt_enable_GC();
pub extern (C) fn _yrt_is_GC_enabled()-> bool;

/**
 * Run a whole cycle of the collector, and wait until it is over
 */
pub extern (C) fn _yrt_gc_collect();

/**
 * Wait until the finalizers the collector queued have run
 */
pub extern (C) fn _yrt_gc_wait_finalizers();
