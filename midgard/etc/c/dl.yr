in dl;

pub extern (C) fn dlopen(path: *c8, flags: i32)-> *void;
pub extern (C) fn dlsym(handle: *void, name: *c8)-> *void;
pub extern (C) fn dlclose(handle: *void)-> i32;
pub extern (C) fn dlerror()-> *c8;

/**
 * Resolve every undefined symbol when the library is opened
 * */
pub def RTLD_NOW = 2;

/**
 * Make the symbols of the library available to the libraries opened after it
 * */
pub def RTLD_GLOBAL = 256;
