/**
 * This module defines C binding functions to read the entropy pool of the kernel.
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in random;

pub enum GetRandomFlags: u32
| NONE          = 0u32
| GRND_NONBLOCK = 1u32
| GRND_RANDOM   = 2u32;

/**
 * Fill `buf` with up to `buflen` bytes read from the kernel CSPRNG.
 * @returns: the number of bytes written, or -1 with errno set.
 */
pub extern (C) fn getrandom(dmut buf: *void, buflen: usize, flags: u32)-> isize;
