/**
 * This module defines C binding functions to resolve host names (netdb.h).
 * @Authors: Emile Cadorel
 * @License: GPLv3
 */

in netdb;

use etc::c::socket;

@data
pub record addrinfo {
    let mut ai_flags: i32 = 0;
    let mut ai_family: i32 = 0;
    let mut ai_socktype: i32 = 0;
    let mut ai_protocol: i32 = 0;
    let mut ai_addrlen: u32 = 0;
    let mut ai_addr: *sockaddr = null;
    let mut ai_canonname: *c8 = null;
    let mut ai_next: *addrinfo = null;
}

/**
 * The error codes of `getaddrinfo` (glibc values)
 */
pub enum AddrInfoError: i32
| NONE           = 0
| EAI_BADFLAGS   = -1
| EAI_NONAME     = -2
| EAI_AGAIN      = -3
| EAI_FAIL       = -4
| EAI_NODATA     = -5
| EAI_FAMILY     = -6
| EAI_SOCKTYPE   = -7
| EAI_SERVICE    = -8
| EAI_ADDRFAMILY = -9
| EAI_MEMORY     = -10
| EAI_SYSTEM     = -11
| EAI_OVERFLOW   = -12;

pub extern (C) fn getaddrinfo(node: *c8, service: *c8, hints: *addrinfo, res: *(*addrinfo))-> AddrInfoError;
pub extern (C) fn freeaddrinfo(res: *addrinfo);
pub extern (C) fn gai_strerror(err: AddrInfoError)-> *c8;
