mod .utils;


use utils::_;

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          COVERAGE          ====================================
 * ====================================================================================================
 * ====================================================================================================
 */


extern (C) fn _yrt_unittest_coverage_hit_branch(func: *void, ref frameInfo: CoverageInfo, id: u32) {
    coverage::tree::threadTree():.hitBranch(func, frameInfo, id);
}

extern (C) fn _yrt_unittest_coverage_hit_enter(func: *void, ref frameInfo: CoverageInfo) {
    coverage::tree::threadTree():.hitEnter(func, frameInfo);
}

extern (C) fn _yrt_unittest_coverage_hit_exit(func: *void, ref frameInfo: CoverageInfo) {
    coverage::tree::threadTree():.hitExit(func, frameInfo);
}


/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          LAUNCH          =====================================
 * ====================================================================================================
 * ====================================================================================================
 */

lazy dmut __LAUNCHER__ = copy runner::UnittestLauncher();

extern (C) fn _yrt_register_unittest_impl(name: [c8], func: fn ()-> void) {
    __LAUNCHER__:.register(name, func);
}

/**
 * Register a parameterized `__test`: `provider` returns a generator yielding a pointer to each
 * of its parameter sets, `func` is called once per yielded pointer.
 *
 * @info: the generator is opaque here, it is only resumed by `_yrt_resume_parameter_sets`
 * */
extern (C) fn _yrt_register_parameterized_unittest_impl(name: [c8], provider: fn ()-> (*void, *void), func: fn (*void)-> void) {
    __LAUNCHER__:.registerParameterized(name, provider, func);
}


extern (C) fn _yrt_run_unittests_impl(args: [[c8]])-> i32 {
    if __LAUNCHER__:.run(args) {
        return 0;
    }

    return 1;
}
