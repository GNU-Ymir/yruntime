in worker;

use etc::c::process;
use etc::runtime::threads;
use std::conv;

// `std::io::utils` (where this is declared) is a private submodule of `std::io`, not importable
// from here; redeclaring the extern binding directly is the same pattern other modules use for
// C bindings (e.g. `etc::c::process::getpid`).
extern (C) fn _yrt_fflush_stdout();

/**
 * Fork/waitpid based mechanism to run a subset of the registered unittests in a dedicated OS
 * subprocess, reusing this process's already fully-populated in-memory test registry via
 * fork()'s copy-on-write semantics. Unlike `std::concurrency::process::SubProcess`, the forked
 * child here never execs: it keeps running Ymir code, and keeps its GC enabled.
 * */
pub mod TestWorker {

    // Passed to `waitpid` to reap whichever child exits first: the C side takes a signed
    // `pid_t`, where that is spelled -1(see `TestWorker::waitAny`).
    def ANY_CHILD = 0xFFFFFFFFu32;

    // Passed to `signal` to ignore a signal: the C side spells it `SIG_IGN`, a function pointer
    // whose value is 1(see `TestWorker::ignoreSigPipe`).
    def SIG_IGN = 1us;

    /**
     * Fork the calling process.
     * @returns:
     *    - in the parent: the pid of the spawned child(see `TestWorker::waitAny`)
     *    - in the child: none -- from this point on the caller IS the forked child, and MUST
     *      terminate via `TestWorker::exit` and never return normally(otherwise it would keep
     *      running the rest of the parent's flow, e.g. forking further siblings of its own)
     * @info: flushes stdout right before forking, so buffered-but-not-yet-flushed output is not
     *        printed a second time, independently, by both processes
     * */
    pub fn fork()-> (u32)? {
        _yrt_fflush_stdout();
        let pid = threads::_yrt_fork();
        if pid == 0 {
            return none;
        }

        return pid?;
    }

    /**
     * Wait for *whichever* child of the calling process terminates first, rather than for one
     * designated pid -- so a caller watching several workers learns about a failure as soon as
     * it happens, instead of only when the pid it happens to be blocked on exits
     *
     * @returns: the pid of the child that terminated, the exit code it passed to
     *           `TestWorker::exit`(-1 if it did not exit normally), and the signal that killed
     *           it(0 if it exited normally); `(0, -1, 0)` if there is no child left to wait for
     * */
    pub fn waitAny()-> (u32, i32, i32) {
        let mut status: i32 = 0;
        let pid = process::waitpid(ANY_CHILD, &status, 0);
        if pid <= 0 {
            return (0u32, -1, 0);
        }

        return (cast!u32(pid), decodeExitCode(status), decodeSignal(status));
    }

    /**
     * Set SIGPIPE to be ignored for the calling process
     *
     * The dispatcher writes an assignment to a worker right after that worker reported an
     * outcome, so it can hit a pipe whose reader died in between. The default SIGPIPE
     * disposition would take the *runner* down with it; ignored, the write simply fails with
     * EPIPE and the worker is reported as gone.
     * */
    pub fn ignoreSigPipe() {
        process::signal(cast!u32(SignalCodes::SIGPIPE), SIG_IGN);
    }

    /**
     * Terminate the calling process with `code` -- must be called by a forked child once its
     * work is done(see `TestWorker::fork`)
     * */
    pub fn exit(code: i32) {
        process::_yrt_exit(code);
    }

    /**
     * @returns: the exit code encoded in a `waitpid` status, decoded the same way as the
     *           standard `WIFEXITED`/`WEXITSTATUS` macros(-1 if the process did not exit
     *           normally, e.g. it was killed by a signal)
     * */
    fn decodeExitCode(status: i32)-> i32 {
        if (status & 0x7F) != 0 {
            return -1;
        }

        return (status >> 8) & 0xFF;
    }

    /**
     * @returns: the number of the signal that killed the process whose `waitpid` status is
     *           `status`, decoded the same way as the standard `WTERMSIG` macro(0 if it exited
     *           normally) -- what lets a worker that died inside a test be reported as, say,
     *           `SIGSEGV` rather than just "gone"
     * */
    pub fn decodeSignal(status: i32)-> i32 {
        return status & 0x7F;
    }

    /**
     * @returns: the human readable name of the signal `sig`(see `strsignal`)
     * */
    pub fn signalName(sig: i32)-> [c8] {
        unsafe {
            return std::conv::fromStringZ(process::strsignal(cast!u32(sig)));
        }
    }
}
