in coverage;

use std::io;
use std::format::_;
use list;
use utils::colors;
use std::{syntax::tokenizer, stream};

pub record CoverageInfo {
    pub let file: [c8];
    pub let func: [c8];
    pub let locations: [(u32, u32)];
}

@final
pub class CoverageTree {

    // The stack of the function being monitored
    let mut _stack: FuncStack = FuncStack();

    // The calling tree
    // func => [func => nbTimes]
    let dmut _callTree: [*void => [*void => usize]] = copy [];

    // Resolve function pointers to their metadata(file/name/locations) for reporting.
    let dmut _funcInfos: [*void => CoverageInfo] = copy [];

    // The code coverage of the function being entered
    let dmut _frames: [*CoverageInfo => [u32]] = copy [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Function called when a specific branch is entered
     * */
    pub fn hitBranch(mut self, func: *void,  ref _: CoverageInfo, id: u32) {
        let topFunc = self._stack:.topFunc();
        if topFunc == func {
            let dmut lst = self._stack:.top();
            lst[id] += 1;
        }
    }


    /**
     * Function called when a function is entered
     * */
    pub fn hitEnter(mut self, func: *void, ref frameInfo: CoverageInfo) {
        // Update call-tree edge: the previous frame on the stack is the caller.
        let caller = self._stack:.topFunc();
        if caller != null {
            let dmut inner = if let Ok(dmut inner) = alias self._callTree[caller] {
                alias inner
            } else {
                let dmut inner: [*void => usize] = copy [];
                self._callTree[caller] = alias inner;
                alias inner
            };

            if let Ok(nb) = inner[func] {
                inner[func] = nb + 1us;
            } else {
                inner[func] = 1us;
            }
        }

        // Remember metadata for this function pointer.
        // (The key is the `func` pointer passed by the instrumentation.)
        self._funcInfos[func] = frameInfo;

        let dmut lst = if let Ok(dmut lst) = alias self._frames[&frameInfo] {
            alias lst
        } else {
            let dmut lst = copy [0u32 ; frameInfo.locations.len];
            self._frames[&frameInfo] = alias lst;
            alias lst
        };

        self._stack:.push(alias lst, func);
    }

    /**
     * Function called when a function is exited
     * */
    pub fn hitExit(mut self, _: *void, ref _: CoverageInfo) {
        self._stack:.pop();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          REPORT          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub fn report(self, withCov: bool, withCallTree: bool) {
        if withCov {
            self.reportCoverage();
        }
        if withCallTree {
            self.reportCallTree();
        }
    }

    fn reportCoverage(self) {
        let dmut stream = copy StringStream();
        let mut totalLocations: usize = 0us;
        let mut coveredLocations: usize = 0us;

        for framePtr, metrics in self._frames {
            let info = unsafe {*framePtr};
            let total = info.locations.len;
            totalLocations += total;

            let mut covered: usize = 0us;
            let mut missing: [(u32, u32)] = [];

            for i, hit in metrics if i < total {
                if hit > 0u32 {
                    covered += 1us;
                } else {
                    missing ~= [info.locations[i]];
                }
            }

            coveredLocations += covered;
            self.formatSingleReport(alias stream, covered, missing, info);
        }

        let overallPercent: usize = if totalLocations == 0us { 0us } else { coveredLocations * 100us / totalLocations };
        let overallColor = if overallPercent == 100us { Colors::GREEN } else if overallPercent >= 80us { Colors::YELLOW } else { Colors::RED };
        stream:.writeln('[', overallColor, overallPercent, "%", Colors::RESET, ']', ' ', "TOTAL:", coveredLocations, '/', totalLocations);

        self.printReport("COVERAGE", stream[]);
    }

    fn formatSingleReport(self, dmut stream: &StringStream, covered: usize, missing: [(u32, u32)], info: CoverageInfo) {
        let total = info.locations.len;
        let percent: usize = if total == 0us { 100us } else { covered * 100us / total };
        if percent == 100 return;

        let statusColor = if percent == 100us {
            Colors::GREEN
        } else if percent >= 80us {
            Colors::YELLOW
        } else {
            Colors::RED
        };

        stream:.writeln('[', statusColor, percent, "%", Colors::RESET, ']', " ", info.file, "::", info.func);
        if (total != 0) {
            stream:.write("  ", covered, " / ", total, " locations");
        }

        if missing.len > 0us {
            stream:.write(Colors::BOLD, " | missing: ", Colors::RESET);
            // Avoid too much output: show only the first few missing ranges.
            let maxShown = if missing.len < 10us { missing.len } else { 10us };
            for j in 0us .. maxShown {
                let (startLine, _) = missing[j];
                if j != 0 stream:.write(", ");
                stream:.write(startLine);
            }
            if missing.len > maxShown {
                stream:.write("   ... (", missing.len - maxShown, " more)");
            }
        }

        if (total != 0) {
            stream:.writeln();
        }
    }

    fn reportCallTree(self) {
        let dmut stream = copy StringStream();

        let maxShown: usize = 10us;
        for callerPtr, callees in self._callTree {
            if let Ok(infoPtr) = self._funcInfos[callerPtr] {
                let info = infoPtr;
                stream:.write(Colors::BOLD, " ", info.file, "::", info.func, Colors::RESET);
            } else {
                stream:.write(Colors::BOLD, " <unknown>", Colors::RESET);
            }

            let mut printed: usize = 0us;
            let mut skipped: usize = 0us;
            for calleePtr, nb in callees if nb != 0us {
                if printed < maxShown {
                    if let Ok(calleeInfoPtr) = self._funcInfos[calleePtr] {
                        let calleeInfo = calleeInfoPtr;
                        stream:.write("\n  - ", calleeInfo.file, "::", calleeInfo.func, " : ", nb);
                    } else {
                        stream:.write("\n  - <unknown> : ", nb);
                    }
                    printed += 1us;
                } else {
                    skipped += 1us;
                }
            }

            if skipped > 0us {
                stream:.write("\n   ... (", skipped, " more)");
            }
            stream:.writeln();
        }

        self.printReport("CALL TREE", stream[]);
    }

    fn printReport(self, head: [c8], report: [c8]) {
        let lines = Tokenizer!{c8}(tokens-> copy ["\n"]).tokenize(report);
        let mut maxLen = 0us;
        for l in lines if l.len > maxLen {
            maxLen = l.len;
        }

        {
            let delim = format("{1:=^*}"s8, maxLen, "");
            let headline = format("{1:^*}"s8, maxLen, head);
            println(delim);
            println(Colors::BOLD, headline, Colors::RESET);
            println(delim);
            print(report);
            println(delim);
        } catch {
            _ => {
                println("====================");
                println(Colors::BOLD, head, Colors::RESET);
                println("====================");
                print(report);
                println("====================");
            }
        }
    }
}
