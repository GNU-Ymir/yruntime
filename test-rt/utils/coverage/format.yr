in format;

use std::io;
use std::format::_;
use std::{syntax::tokenizer, stream, fs::_, char};
use utils::colors;
use utils::coverage::conv;

/**
 * Formats a `CoverageReport`(see `CoverageConv`) into a human readable report, and prints it to
 * the console.
 * */
pub mod CoverageFormat {

    /**
     * Print the coverage and/or call-tree report described by `rep` to the console
     * */
    pub fn report(rep: CoverageReport, withCov: bool, withCallTree: bool) {
        if withCov {
            reportCoverage(rep);
        }
        if withCallTree {
            reportCallTree(rep);
        }
    }

    /**
     * Print the per-file coverage report(functions grouped by their file) and the overall total,
     * skipping frames whose name is a lambda(see `isLambdaName`)
     * */
    fn reportCoverage(rep: CoverageReport) {
        let dmut stream = copy StringStream();
        let (fileOrder, fileEntries) = groupFunctionsByFile(rep);

        for file in fileOrder {
            if let Ok(entries) = fileEntries[file] {
                formatFileReport(alias stream, file, entries);
            }
        }

        let (totalCovered, totalLocations) = sumEntryMap(fileOrder, fileEntries);
        writeTotalLine(alias stream, totalCovered, totalLocations);

        printReport("COVERAGE", stream[]);
    }

    /**
     * Group the(non-lambda, instrumented) functions of `rep` by file
     * @returns: the files in first-seen order, and for each file the list of(func, covered, total, missing) of its functions
     * */
    fn groupFunctionsByFile(rep: CoverageReport)-> ([[c8]], [[c8] => [([c8], usize, usize, [(u32, u32)])]]) {
        let dmut fileOrder: [[c8]] = [];
        let dmut fileEntries: [[c8] => [([c8], usize, usize, [(u32, u32)])]] = copy [];

        for fnEntry in rep.functions {
            let (keep, file, func, covered, total, missing) = parseFunctionEntry(fnEntry);
            if keep {
                let dmut entries: [([c8], usize, usize, [(u32, u32)])] = if let Ok(dmut e) = alias fileEntries[file] {
                    alias e
                } else {
                    fileOrder ~= [file];
                    let dmut e: [([c8], usize, usize, [(u32, u32)])] = [];
                    alias e
                };

                entries ~= [(func, covered, total, missing)];
                fileEntries[file] = alias entries;
            }
        }

        return (fileOrder, fileEntries);
    }

    /**
     * Parse a single entry of `rep.functions`
     * @returns: (keep, file, func, covered, total, missing), where `keep` is false for lambdas
     *           and functions without any instrumented location(and the rest of the tuple is then meaningless)
     * */
    fn parseFunctionEntry(fnEntry: CoverageFunctionEntry)-> (bool, [c8], [c8], usize, usize, [(u32, u32)]) {
        if isLambdaName(fnEntry.func) || fnEntry.locations.len == 0us {
            return (false, "", "", 0us, 0us, []);
        }

        let (covered, missing) = coverageOf(fnEntry.locations, fnEntry.hits);

        return (true, fnEntry.file, fnEntry.func, covered, fnEntry.locations.len, missing);
    }

    /**
     * @returns: the number of covered locations, and the locations that are not, given the hit count of each of them
     * */
    fn coverageOf(locations: [(u32, u32)], hits: [u32])-> (usize, [(u32, u32)]) {
        let mut covered: usize = 0us;
        let mut missing: [(u32, u32)] = [];

        for i, hit in hits if i < locations.len {
            if hit > 0u32 {
                covered += 1us;
            } else {
                missing ~= [locations[i]];
            }
        }

        return (covered, missing);
    }

    /**
     * @returns: the total covered/total locations, summed over every function of every file
     * */
    fn sumEntryMap(fileOrder: [[c8]], fileEntries: [[c8] => [([c8], usize, usize, [(u32, u32)])]])-> (usize, usize) {
        let mut covered: usize = 0us;
        let mut total: usize = 0us;

        for file in fileOrder {
            if let Ok(entries) = fileEntries[file] {
                let (fileCovered, fileTotal) = sumEntries(entries);
                covered += fileCovered;
                total += fileTotal;
            }
        }

        return (covered, total);
    }

    /**
     * Append a file's coverage header(with its own percentage and totals) and the
     * coverage line of each of its functions to `stream`
     * */
    fn formatFileReport(dmut stream: &StringStream, file: [c8], entries: [([c8], usize, usize, [(u32, u32)])]) {
        let (fileCovered, fileTotal) = sumEntries(entries);
        let percent = percentOf(fileCovered, fileTotal);

        stream:.writeln('[', colorFor(percent), percent, "%", Colors::RESET, ']', " ", file, " ", fileCovered, " / ", fileTotal, " :");

        for entry in entries {
            formatFunctionLine(alias stream, entry._0, entry._1, entry._2, entry._3);
        }
    }

    /**
     * @returns: the covered/total locations, summed over every function of `entries`
     * */
    fn sumEntries(entries: [([c8], usize, usize, [(u32, u32)])])-> (usize, usize) {
        let mut covered: usize = 0us;
        let mut total: usize = 0us;

        for entry in entries {
            covered += entry._1;
            total += entry._2;
        }

        return (covered, total);
    }

    /**
     * Append a single function's coverage line(and its missing locations) to `stream`,
     * skipping functions that are fully covered
     * */
    fn formatFunctionLine(dmut stream: &StringStream, func: [c8], covered: usize, total: usize, missing: [(u32, u32)]) {
        if missing.len == 0us return;

        stream:.write("  - fn ", func, " - ", covered, " / ", total, " locations");
        stream:.write(Colors::BOLD, " | missing: ", Colors::RESET);
        writeMissingList(alias stream, missing);
        stream:.writeln();
    }

    /**
     * Append the(possibly truncated) list of missing locations to `stream`
     * */
    fn writeMissingList(dmut stream: &StringStream, missing: [(u32, u32)]) {
        // Avoid too much output: show only the first few missing ranges.
        let maxShown = if missing.len < 10us { missing.len } else { 10us };
        for j in 0us .. maxShown {
            let (startLine, _) = missing[j];
            if j != 0 stream:.write(", ");
            stream:.write(startLine);
        }
        if missing.len > maxShown {
            stream:.write("   ... (", missing.len - maxShown, " more)");
        }
    }

    /**
     * Append the overall "TOTAL" coverage line to `stream`
     * */
    fn writeTotalLine(dmut stream: &StringStream, covered: usize, total: usize) {
        let percent = percentOf(covered, total);
        stream:.writeln('[', colorFor(percent), percent, "%", Colors::RESET, ']', ' ', "TOTAL:", covered, '/', total);
    }

    /**
     * @returns: `covered` out of `total`, as a percentage(0 if `total` is 0)
     * */
    fn percentOf(covered: usize, total: usize)-> usize {
        if total == 0us { 0us } else { covered * 100us / total }
    }

    /**
     * @returns: the color associated to a coverage percentage
     * */
    fn colorFor(percent: usize)-> [c8] {
        if percent == 100us {
            Colors::GREEN
        } else if percent >= 80us {
            Colors::YELLOW
        } else {
            Colors::RED
        }
    }

    /**
     * Print, for each caller function, the list of callees and how many times each was called
     * */
    fn reportCallTree(rep: CoverageReport) {
        let dmut stream = copy StringStream();

        for entry in rep.callTree {
            formatCallTreeEntry(alias stream, entry);
        }

        printReport("CALL TREE", stream[]);
    }

    /**
     * Append a single caller's line(and its list of callees) to `stream`
     * */
    fn formatCallTreeEntry(dmut stream: &StringStream, entry: CoverageCaller) {
        writeFuncName(alias stream, entry.file, entry.func);
        writeCallees(alias stream, entry.callees);
        stream:.writeln();
    }

    /**
     * Append " file::func"(bold), or " <unknown>" if both are empty, to `stream`
     * */
    fn writeFuncName(dmut stream: &StringStream, file: [c8], func: [c8]) {
        if file.len > 0us || func.len > 0us {
            stream:.write(Colors::BOLD, " ", file, "::", func, Colors::RESET);
        } else {
            stream:.write(Colors::BOLD, " <unknown>", Colors::RESET);
        }
    }

    /**
     * Append the(possibly truncated) "callees" list of `callees` to `stream`
     * */
    fn writeCallees(dmut stream: &StringStream, callees: [CoverageCallee]) {
        let maxShown: usize = 10us;
        let mut printed: usize = 0us;
        let mut skipped: usize = 0us;

        for callee in callees {
            if callee.count != 0us {
                if printed < maxShown {
                    writeCalleeLine(alias stream, callee);
                    printed += 1us;
                } else {
                    skipped += 1us;
                }
            }
        }

        if skipped > 0us {
            stream:.write("\n   ... (", skipped, " more)");
        }
    }

    /**
     * Append a single "\n  - file::func : count" callee line to `stream`
     * */
    fn writeCalleeLine(dmut stream: &StringStream, callee: CoverageCallee) {
        if callee.file.len > 0us || callee.func.len > 0us {
            stream:.write("\n  - ", callee.file, "::", callee.func, " : ", callee.count);
        } else {
            stream:.write("\n  - <unknown> : ", callee.count);
        }
    }

    /**
     * Print `report` framed with a title header(`head`) and delimiter lines
     * sized to the longest line in the report
     * */
    fn printReport(head: [c8], report: [c8]) {
        let lines = Tokenizer!{c8}(tokens-> copy ["\n"]).tokenize(report);
        let mut maxLen = 0us;
        for l in lines if l.len > maxLen {
            maxLen = l.len;
        }

        {
            let delim = format("{1:=^*}"s8, maxLen, "");
            let headline = format("{1:^*}"s8, maxLen, head);
            println(delim);
            println(Colors::BOLD, headline, Colors::RESET);
            println(delim);
            print(report);
            println(delim);
        } catch {
            _ => {
                println("====================");
                println(Colors::BOLD, head, Colors::RESET);
                println("====================");
                print(report);
                println("====================");
            }
        }
    }

    /**
     * Compilers name anonymous lambdas after their source position(e.g. `::_12_9`).
     * Such names only ever contain digits and underscores, so this is used to
     * filter them out of coverage reports.
     *
     * @returns: true iff the last "::"-separated segment of `name` contains only '_' and digits
     */
    fn isLambdaName(name: [c8])-> bool {
        let last = Path(name, sep-> "::").file();
        if last.len == 0us {
            return false;
        }

        for c in last {
            if !isDigit(c) && c != '_' {
                return false;
            }
        }

        return true;
    }
}
