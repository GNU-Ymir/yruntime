in coverage_report;

/**
 * The full content of a coverage json configuration(see `CoverageStore`/`CoverageLoad`), as plain
 * data that `CoverageFormat` can print without depending on `&Config`
 * */
pub record CoverageReport {
    pub let functions: [CoverageFunctionEntry];
    pub let callTree: [CoverageCaller];

    pub self (functions: [CoverageFunctionEntry], callTree: [CoverageCaller])
        with functions = functions
        , callTree = callTree
    {}
}
