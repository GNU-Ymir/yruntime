in coverage_function_entry;

/**
 * A single "functions" entry of a coverage json configuration(see `CoverageStore`), as plain data
 * */
pub record CoverageFunctionEntry {
    pub let file: [c8];
    pub let func: [c8];

    // (line, column, kind) of each coverable location, parallel to `hits`
    pub let locations: [(u32, u32, u32)];
    pub let hits: [u32];

    pub self (file: [c8], func: [c8], locations: [(u32, u32, u32)], hits: [u32])
        with file = file
        , func = func
        , locations = locations
        , hits = hits
    {}
}
