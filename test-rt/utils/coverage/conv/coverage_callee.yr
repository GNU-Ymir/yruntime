in coverage_callee;

/**
 * A single "callees" entry of a "callTree" entry, as plain data
 * */
pub record CoverageCallee {
    pub let file: [c8];
    pub let func: [c8];
    pub let count: usize;

    pub self (file: [c8], func: [c8], count: usize)
        with file = file
        , func = func
        , count = count
    {}
}
