in conv;

mod ::call_tree_merger;
mod ::coverage_callee;
mod ::coverage_caller;
mod ::coverage_file_entry;
mod ::coverage_function_entry;
mod ::coverage_report;
mod ::function_merger;
mod ::helpers;

pub def CoverageFileEntry: coverage_file_entry::CoverageFileEntry;
pub def CoverageFunctionEntry: coverage_function_entry::CoverageFunctionEntry;
pub def CoverageCallee: coverage_callee::CoverageCallee;
pub def CoverageCaller: coverage_caller::CoverageCaller;
pub def CoverageReport: coverage_report::CoverageReport;

use utils::coverage::conv::{call_tree_merger, coverage_callee, coverage_caller, coverage_file_entry, coverage_function_entry, coverage_report, function_merger};

use std::config;
use etc::runtime::elf;
use utils::coverage::tree;

/**
 * Converts a coverage json configuration(see `CoverageStore`/`CoverageLoad`) into a `CoverageReport`
 * */
pub mod CoverageConv {

    /**
     * @returns: the content of every config of `cfgs`, converted and merged into a single
     *           `CoverageReport`(see `merge`), seeded with a zero-hit entry for every
     *           coverage-instrumented function(see `rootReport`) so that functions never
     *           entered by any run still appear in the final report instead of being silently
     *           absent from it
     * */
    pub fn fromConfigs(cfgs: [&Config])-> CoverageReport {
        let mut reports: [CoverageReport] = copy [rootReport()];
        for cfg in cfgs {
            reports ~= [fromConfig(cfg)];
        }

        return merge(reports);
    }

    /**
     * @returns: the content of `cfg`, converted into a `CoverageReport`
     * */
    fn fromConfig(cfg: &Config)-> CoverageReport {
        return CoverageReport(readFunctions(cfg), readCallTree(cfg));
    }

    /**
     * Builds a baseline `CoverageReport` listing every coverage-instrumented function in the
     * running binary(read from the ELF `COVERAGE` symbols, see `ELFLoader::getCoverageSymbols`),
     * each with all of its locations set to 0 hits.
     *
     * Actual runs(`fromConfig`) only ever mention functions that were entered at least once, so
     * merging this baseline in first(see `fromConfigs`) is what surfaces entirely-uncovered
     * functions/files in the report, rather than just under-reporting hit counts on functions
     * that were partially covered.
     *
     * @returns: the zero-hit report of every coverage block known to the program
     */
    fn rootReport()-> CoverageReport {
        __ELF_LOADER__:.update();
        let covSymbols = __ELF_LOADER__.getCoverageSymbols();
        let mut functions: [CoverageFunctionEntry] = [];
        for _, sym in covSymbols {
            let info = unsafe {
                *(etc::runtime::memory::Runtime!{usize, *CoverageInfo}::_yrt_unsafe_cast(sym.ptr))
            };

            functions ~= [CoverageFunctionEntry(info.file,
                                                info.func,
                                                info.locations,
                                                copy [0 ; info.locations.len])];
        }

        return CoverageReport(functions, []);
    }

    /**
     * Merge several `CoverageReport`(e.g. one per `.ymir_coverage_<pid>.json` file) into a single
     * one, combining the coverage of every function/call edge that appears in more than one of them
     * */
    pub fn merge(reports: [CoverageReport])-> CoverageReport {
        let dmut functions = copy FunctionMerger();
        let dmut callTree = copy CallTreeMerger();

        for rep in reports {
            for fnEntry in rep.functions {
                functions:.add(fnEntry);
            }
            for caller in rep.callTree {
                callTree:.add(caller);
            }
        }

        return CoverageReport(functions.build(), callTree.build());
    }

    /**
     * Merge the function reports into a file report list
     */
    pub fn extractFiles(report: CoverageReport)-> [([c8], &CoverageFileEntry)] {
        let dmut res: [[c8] => &CoverageFileEntry] = copy [];
        for func in report.functions {
            if let Ok(dmut file) = alias res[func.file] {
                file:.addFunction(func);
            } else {
                let dmut newFile = copy CoverageFileEntry(func.file);
                newFile:.addFunction(func);
                res[func.file] = alias newFile;
            }
        }

        let mut result: [mut([c8], &CoverageFileEntry)] = copy [(n, e) for n, e in res];
        std::algorithm::sorting::sort(alias result, |x, y| => { x._0 < y._0 });

        return result;
    }

    /**
     * @returns: the "functions" array of `cfg`, converted into a list of `CoverageFunctionEntry`
     * */
    fn readFunctions(cfg: &Config)-> [CoverageFunctionEntry] {
        let mut result: [CoverageFunctionEntry] = [];

        if let Ok(functionsCfg) = cfg["functions"]? {
            if let arr: &Array = functionsCfg {
                for fnCfg in arr[] {
                    result ~= [CoverageFunctionEntry(readStr(fnCfg, "file"), readStr(fnCfg, "func"), readLocations(fnCfg), readHits(fnCfg))];
                }
            }
        }

        return result;
    }

    /**
     * @returns: the "callTree" array of `cfg`, converted into a list of `CoverageCaller`
     * */
    fn readCallTree(cfg: &Config)-> [CoverageCaller] {
        let mut result: [CoverageCaller] = [];

        if let Ok(callTreeCfg) = cfg["callTree"]? {
            if let arr: &Array = callTreeCfg {
                for entryCfg in arr[] {
                    result ~= [CoverageCaller(readStr(entryCfg, "file"), readStr(entryCfg, "func"), readCallees(entryCfg))];
                }
            }
        }

        return result;
    }

    /**
     * @returns: the "callees" array of a "callTree" entry `entryCfg`, converted into a list of `CoverageCallee`
     * */
    fn readCallees(entryCfg: &Config)-> [CoverageCallee] {
        let mut result: [CoverageCallee] = [];

        if let Ok(calleesCfg) = entryCfg["callees"]? {
            if let arr: &Array = calleesCfg {
                for calleeCfg in arr[] {
                    result ~= [CoverageCallee(readStr(calleeCfg, "file"), readStr(calleeCfg, "func"), cast!usize(readInt(calleeCfg, "count")))];
                }
            }
        }

        return result;
    }

    /**
     * @returns: the "locations" array of `cfg`, converted into a list of(line, column, kind)
     *           triples. A file written by an older build only has(line, column) pairs, and its
     *           locations are read back as lines(`--resume` can pick such a file up).
     * */
    fn readLocations(cfg: &Config)-> [(u32, u32, u32)] {
        let mut result: [(u32, u32, u32)] = [];

        if let Ok(locsCfg) = cfg["locations"]? {
            if let arr: &Array = locsCfg {
                for tupleCfg in arr[] {
                    if let tupleArr: &Array = tupleCfg {
                        let slc = tupleArr[];
                        if slc.len >= 3us {
                            result ~= [(cast!u32(readIntCfg(slc[0])),
                                        cast!u32(readIntCfg(slc[1])),
                                        cast!u32(readIntCfg(slc[2])))];
                        } else if slc.len >= 2us {
                            result ~= [(cast!u32(readIntCfg(slc[0])),
                                        cast!u32(readIntCfg(slc[1])),
                                        CoverageLocKind::LINE)];
                        }
                    }
                }
            }
        }

        return result;
    }

    /**
     * @returns: the "hits" array of `cfg`, converted into a list of hit counts
     * */
    fn readHits(cfg: &Config)-> [u32] {
        let mut result: [u32] = [];

        if let Ok(hitsCfg) = cfg["hits"]? {
            if let arr: &Array = hitsCfg {
                for h in arr[] {
                    result ~= [cast!u32(readIntCfg(h))];
                }
            }
        }

        return result;
    }

    fn readStr(cfg: &Config, key: [c8])-> [c8] {
        if let Ok(Str(value-> v)) = cfg[key]? {
            return v;
        }

        return "";
    }

    fn readInt(cfg: &Config, key: [c8])-> i64 {
        if let Ok(Int(value-> v)) = cfg[key]? {
            return v;
        }

        return 0i64;
    }

    fn readIntCfg(cfg: &Config)-> i64 {
        if let Int(value-> v) = cfg {
            return v;
        }

        return 0i64;
    }
}
