in tree;

use utils::list;
use core::types::array;

pub record CoverageInfo {
    pub let file: [c8];
    pub let func: [c8];
    pub let locations: [(u32, u32)];
}

@final
pub class CoverageTree {

    // The stack of the function being monitored
    let mut _stack: FuncStack = FuncStack();

    // The calling tree
    // func => [func => nbTimes]
    let dmut _callTree: [*void => [*void => usize]] = copy [];

    // Resolve function pointers to their metadata(file/name/locations) for reporting.
    let dmut _funcInfos: [*void => CoverageInfo] = copy [];

    // The code coverage of the function being entered
    let dmut _frames: [*CoverageInfo => [u32]] = copy [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Function called when a specific branch is entered
     * */
    pub fn hitBranch(mut self, func: *void,  ref _: CoverageInfo, id: u32) {
        let topFunc = self._stack:.topFunc();
        if topFunc == func {
            let dmut lst = self._stack:.top();
            lst[id] += 1;
        }
    }


    /**
     * Function called when a function is entered
     * */
    pub fn hitEnter(mut self, func: *void, ref frameInfo: CoverageInfo) {
        // Update call-tree edge: the previous frame on the stack is the caller.
        let caller = self._stack:.topFunc();
        if caller != null {
            let dmut inner = if let Ok(dmut inner) = alias self._callTree[caller] {
                alias inner
            } else {
                let dmut inner: [*void => usize] = copy [];
                self._callTree[caller] = alias inner;
                alias inner
            };

            if let Ok(nb) = inner[func] {
                inner[func] = nb + 1us;
            } else {
                inner[func] = 1us;
            }
        }

        // Remember metadata for this function pointer.
        // (The key is the `func` pointer passed by the instrumentation.)
        self._funcInfos[func] = frameInfo;

        let dmut lst = if let Ok(dmut lst) = alias self._frames[&frameInfo] {
            alias lst
        } else {
            let dmut lst = copy [0u32 ; frameInfo.locations.len];
            self._frames[&frameInfo] = alias lst;
            alias lst
        };

        self._stack:.push(alias lst, func);
    }

    /**
     * Function called when a function is exited
     * */
    pub fn hitExit(mut self, _: *void, ref _: CoverageInfo) {
        self._stack:.pop();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ACCESS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the hit count of each location, for every monitored function
     * */
    pub fn frames(self)-> [*CoverageInfo => [u32]] {
        self._frames
    }

    /**
     * @returns: the metadata(file/name/locations) associated to each monitored function pointer
     * */
    pub fn funcInfos(self)-> [*void => CoverageInfo] {
        self._funcInfos
    }

    /**
     * @returns: the calling tree, func => [func => nbTimes]
     * */
    pub fn callTree(self)-> [*void => [*void => usize]] {
        self._callTree
    }

}
