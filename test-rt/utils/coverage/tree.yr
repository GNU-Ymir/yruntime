in tree;

use utils::coverage::list;

/**
 * The kind of a coverage location, the third member of every entry of a `CoverageInfo`.
 *
 * LINE answers "was this source line reached", and a function has exactly one LINE entry per
 * source line. BRANCH_TRUE/BRANCH_FALSE answer "were both outcomes of this conditional
 * exercised": both members of a pair carry the location of the conditional itself, so they can
 * be paired back together.
 *
 * These values are ABI: they mirror `CoverageLocKinds` in the compiler
 * (`ymirc/lexing/keys.yr`), and any change here must be made there too.
 * */
pub enum CoverageLocKind: u32
| LINE         = 0u32
| BRANCH_TRUE  = 1u32
| BRANCH_FALSE = 2u32;

/**
 * The static description of one instrumented function, emitted by the compiler as a `__COI__`
 * symbol and passed by reference to every `_yrt_unittest_coverage_hit_*` call.
 *
 * @warning: the layout is an ABI contract with `GlobalExpander::finalizeCoverageLocTable`.
 * */
pub record CoverageInfo {
    pub let file: [c8];
    pub let func: [c8];

    // (line, column, kind) of every coverable location of the function, the index of an entry
    // being the id passed to `hitBranch`
    pub let locations: [(u32, u32, u32)];
}

@final
pub class CoverageTree {

    // The stack of the function being monitored
    let mut _stack: FuncStack = FuncStack();

    // The calling tree
    // func => [func => nbTimes]
    let dmut _callTree: [*void => [*void => usize]] = copy [];

    // Resolve function pointers to their metadata(file/name/locations) for reporting.
    let dmut _funcInfos: [*void => CoverageInfo] = copy [];

    // The code coverage of the function being entered
    let dmut _frames: [*CoverageInfo => [u32]] = copy [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Function called when a specific branch is entered
     * */
    pub fn hitBranch(mut self, func: *void,  ref _: CoverageInfo, id: u32) {
        let topFunc = self._stack:.topFunc();
        if topFunc == func {
            let dmut lst = self._stack:.top();
            lst[id] += 1;
        }
    }


    /**
     * Function called when a function is entered
     * */
    pub fn hitEnter(mut self, func: *void, ref frameInfo: CoverageInfo) {
        // Update call-tree edge: the previous frame on the stack is the caller.
        let caller = self._stack:.topFunc();
        if caller != null {
            let dmut inner = if let Ok(dmut inner) = alias self._callTree[caller] {
                alias inner
            } else {
                let dmut inner: [*void => usize] = copy [];
                self._callTree[caller] = alias inner;
                alias inner
            };

            if let Ok(nb) = inner[func] {
                inner[func] = nb + 1us;
            } else {
                inner[func] = 1us;
            }
        }

        // Remember metadata for this function pointer.
        // (The key is the `func` pointer passed by the instrumentation.)
        self._funcInfos[func] = frameInfo;

        let dmut lst = if let Ok(dmut lst) = alias self._frames[&frameInfo] {
            alias lst
        } else {
            let dmut lst = copy [0u32 ; frameInfo.locations.len];
            self._frames[&frameInfo] = alias lst;
            alias lst
        };

        self._stack:.push(alias lst, func);
    }

    /**
     * Function called when a function is exited
     * */
    pub fn hitExit(mut self, _: *void, ref _: CoverageInfo) {
        self._stack:.pop();
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          ACCESS          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * @returns: the hit count of each location, for every monitored function
     * */
    pub fn frames(self)-> [*CoverageInfo => [u32]] {
        self._frames
    }

    /**
     * @returns: the metadata(file/name/locations) associated to each monitored function pointer
     * */
    pub fn funcInfos(self)-> [*void => CoverageInfo] {
        self._funcInfos
    }

    /**
     * @returns: the calling tree, func => [func => nbTimes]
     * */
    pub fn callTree(self)-> [*void => [*void => usize]] {
        self._callTree
    }

    /**
     * Fold the content of `other` into this tree, summing the hit count of every location and
     * every call-tree edge the two have in common
     * */
    pub fn merge(mut self, other: &CoverageTree) {
        for framePtr, hits in other.frames() {
            if let Ok(dmut mine) = alias self._frames[framePtr] {
                for i, h in hits {
                    if i < mine.len { mine[i] += h; }
                }
            } else {
                self._frames[framePtr] = copy hits;
            }
        }

        for func, info in other.funcInfos() {
            self._funcInfos[func] = info;
        }

        for caller, callees in other.callTree() {
            let dmut mine = if let Ok(dmut m) = alias self._callTree[caller] {
                alias m
            } else {
                let dmut m: [*void => usize] = copy [];
                self._callTree[caller] = alias m;
                alias m
            };

            for callee, nb in callees {
                if let Ok(prev) = mine[callee] {
                    mine[callee] = prev + nb;
                } else {
                    mine[callee] = nb;
                }
            }
        }
    }

}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ==================================          THREAD TREES          ==================================
 * ====================================================================================================
 * ====================================================================================================
 */

// Every tree ever handed out by `threadTree`. A tree cannot be shared between threads -- the
// enter/exit stack it maintains is the call stack of one thread -- so each thread fills its own,
// and they are all kept here to be folded together by `mergedTree` once the tests are over.
// Without that, everything running on a spawned thread(a `TaskPool` worker, an actor loop) would
// be reported as never executed.
@final
class TreeRegistry {

    let dmut _trees: [&CoverageTree] = [];

    pub self () {}

    pub fn register(mut self)-> dmut &CoverageTree {
        let dmut res = copy CoverageTree();
        self._trees ~= [alias res];

        alias res
    }

    pub fn trees(self)-> [&CoverageTree] {
        self._trees
    }
}

lazy dmut __ALL_TREES__: &TreeRegistry = copy TreeRegistry();

@thread
lazy dmut __THREAD_TREE__: &CoverageTree = registerTree();

/**
 * @returns: a fresh tree, recorded in `__ALL_TREES__`
 * */
fn registerTree()-> dmut &CoverageTree {
    atomic {
        return __ALL_TREES__:.register();
    }
}

/**
 * @returns: the coverage tree of the calling thread
 * */
pub fn threadTree()-> dmut &CoverageTree {
    alias __THREAD_TREE__
}

/**
 * @returns: the coverage of every thread of this process, folded into a single tree
 * */
pub fn mergedTree()-> &CoverageTree {
    let dmut res = copy CoverageTree();
    atomic {
        for t in __ALL_TREES__.trees() {
            res:.merge(t);
        }
    }

    res
}
