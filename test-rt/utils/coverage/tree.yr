in tree;

mod ::coverage_info;
mod ::coverage_loc_kind;
mod ::coverage_tree;
mod ::tree_registry;
mod ::helpers;

pub def CoverageLocKind: coverage_loc_kind::CoverageLocKind;
pub def CoverageInfo: coverage_info::CoverageInfo;
pub def CoverageTree: coverage_tree::CoverageTree;

pub def threadTree = helpers::threadTree;
pub def mergedTree = helpers::mergedTree;

use utils::coverage::tree::{tree_registry, helpers};

lazy dmut __ALL_TREES__: &TreeRegistry = copy TreeRegistry();

@thread
lazy dmut __THREAD_TREE__: &CoverageTree = registerTree();
