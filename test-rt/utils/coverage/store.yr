in store;

use std::config::data;
use std::config::json;
use std::conv;
use std::fs::_;
use utils::coverage::tree;
use etc::c::process;

// Every process-local coverage file is named "{PID_FILE_PREFIX}{pid}{PID_FILE_SUFFIX}", so that
// concurrent/successive runs of the test binary(e.g. across `--resume` sessions) each get their
// own file instead of clobbering one another.
pub def PID_FILE_PREFIX = ".ymir_coverage_";
pub def PID_FILE_SUFFIX = ".json";

/**
 * Exports a `CoverageTree` into a json configuration(see `CoverageConv` to convert it for `CoverageFormat`, `CoverageLoad` to read it back)
 * */
pub mod CoverageStore {

    /**
     * @returns: the content of `tree`, encoded as a json configuration
     * */
    pub fn toConfig(tree: &CoverageTree)-> &Config {
        let dmut root = copy Dict();
        let dmut functions = copy Array();

        for framePtr, hits in tree.frames() {
            let info = unsafe {*framePtr};
            let dmut fnEntry = copy Dict();
            fnEntry:["file"] = copy Str(info.file);
            fnEntry:["func"] = copy Str(info.func);

            let dmut locs = copy Array();
            for loc in info.locations {
                let (line, col, kind) = loc;
                let dmut triple = copy Array();
                triple:.push(copy Int(cast!i64(line)));
                triple:.push(copy Int(cast!i64(col)));
                triple:.push(copy Int(cast!i64(kind)));
                locs:.push(triple);
            }
            fnEntry:["locations"] = locs;

            let dmut hitsArr = copy Array();
            for h in hits {
                hitsArr:.push(copy Int(cast!i64(h)));
            }
            fnEntry:["hits"] = hitsArr;

            functions:.push(fnEntry);
        }
        root:["functions"] = functions;
        root:["callTree"] = callTreeToConfig(tree);

        return root;
    }

    /**
     * Export `tree` to a json file at `path`(created, or erased if it already existed)
     * @throws:
     *    - FsError: if the file could not be created/written
     * */
    pub fn store(tree: &CoverageTree, path: [c8])
        throws FsError
    {
        let dmut file = File::create(Path(path), write-> true);
        file:.write(dump(toConfig(tree)));
    }

    /**
     * @returns: the path of the per-process coverage file of the running process(see `PID_FILE_PREFIX`)
     * */
    pub fn pidPath()-> [c8] {
        return PID_FILE_PREFIX ~ std::conv::to!{[c8]} (getpid()) ~ PID_FILE_SUFFIX;
    }

    /**
     * Export `tree` to this process's own coverage file(see `pidPath`), so that it can later be
     * merged with the coverage of other(e.g. previous `--resume`) runs by `CoverageLoad::loadAll`
     * @throws:
     *    - FsError: if the file could not be created/written
     * */
    pub fn storePid(tree: &CoverageTree)
        throws FsError
    {
        store(tree, pidPath());
    }

    /**
     * Delete every per-process coverage file found by `CoverageLoad::listPidFiles`,
     * ignoring the ones that fail to be removed
     * */
    pub fn removePidFiles(paths: [Path]) {
        for path in paths {
            {
                removeFile(path);
            } catch {
                _ => {}
            }
        }
    }

    /**
     * @returns: the calling tree of `tree`, encoded as a json array of
     *           `{"file", "func", "callees": [{"file", "func", "count"}]}`
     * */
    fn callTreeToConfig(tree: &CoverageTree)-> &Config {
        let dmut callTreeArr = copy Array();

        for callerPtr, callees in tree.callTree() {
            let dmut entry = copy Dict();
            if let Ok(cinfo) = tree.funcInfos()[callerPtr] {
                entry:["file"] = copy Str(cinfo.file);
                entry:["func"] = copy Str(cinfo.func);
            }

            let dmut calleesArr = copy Array();
            for calleePtr, nb in callees {
                let dmut c = copy Dict();
                if let Ok(cinfo) = tree.funcInfos()[calleePtr] {
                    c:["file"] = copy Str(cinfo.file);
                    c:["func"] = copy Str(cinfo.func);
                }
                c:["count"] = copy Int(cast!i64(nb));
                calleesArr:.push(c);
            }

            entry:["callees"] = calleesArr;
            callTreeArr:.push(entry);
        }

        return callTreeArr;
    }
}
