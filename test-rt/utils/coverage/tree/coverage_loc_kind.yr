in coverage_loc_kind;

/**
 * The kind of a coverage location, the third member of every entry of a `CoverageInfo`.
 *
 * LINE answers "was this source line reached", and a function has exactly one LINE entry per
 * source line. BRANCH_TRUE/BRANCH_FALSE answer "were both outcomes of this conditional
 * exercised": both members of a pair carry the location of the conditional itself, so they can
 * be paired back together.
 *
 * These values are ABI: they mirror `CoverageLocKinds` in the compiler
 * (`ymirc/lexing/keys.yr`), and any change here must be made there too.
 * */
pub enum CoverageLocKind: u32
| LINE         = 0u32
| BRANCH_TRUE  = 1u32
| BRANCH_FALSE = 2u32;
