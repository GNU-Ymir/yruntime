in test_duration;

/**
 * How long one test took, as listed by the `--durations` report
 * */
pub record TestDuration {

    // The name of the test
    pub let mut name: [c8];

    // How long it took, in microseconds
    pub let mut micros: u64;

    pub self (name: [c8] = "", micros: u64 = 0u64)
        with name = name
        , micros = micros
    {}
}
