in runner;

use std::{io, config::_, algorithm::searching, algorithm::sorting, fs::_};
use std::time::{instant, dur};

use core::exception::_;
use utils::{colors, filters, args, worker, mailbox};
use utils::coverage::{tree, store, load, format, conv};

// Number of tests listed by the `--durations` report, slowest first.
def SLOWEST_COUNT = 10us;

/**
 * @returns: `test` as it is shown to the user -- the registered name without the `__test`
 *           segment the compiler-generated glue inserts before the index, e.g. `io::10` for a
 *           test registered as `io::__test::10`
 *
 * @info: this is also the form `--filter` matches against(see `TestFilters::passFilter`), so
 *        every name the runner prints can be pasted straight back into a `-f`
 * */
fn displayName(test: [c8])-> [c8] {
    let testFile = Path(test, sep-> "::").file();
    let testName = Path(test, sep-> "::").parent().parent().push(testFile);

    return testName.toStr(sep-> "::");
}

/**
 * How long one test took, as listed by the `--durations` report
 * */
record TestDuration {

    // The name of the test
    pub let mut name: [c8];

    // How long it took, in microseconds
    pub let mut micros: u64;

    pub self (name: [c8] = "", micros: u64 = 0u64)
        with name = name
        , micros = micros
    {}
}

extern (C) fn _yrt_force_debug()-> void;

@{final}
pub class UnittestLauncher {

    // The list of test registered in the launcher This function pointers are
    // cheated by the compiler as they don't respect the non throwing
    // convention, as they throw when they fail. It is the standard accepted
    // way, as it is only for internal usage.
    //
    let dmut _tests: [[c8] => fn ()-> void] = copy [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          REGISTRATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register a test in the unittest map
     * @params:
     *    - name: the name of the test to register
     *    - func: the function to execute for the test
     *
     * */
    pub fn register(mut self, name: [c8], func: fn ()-> void) {
        let realName = if name.len > 0 && name[$-1] == '\u{0}' {
            name[0 .. $-1]
        } else {
            name
        };

        self._tests[realName] = func;
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Run the tests

     * @params:
     *    - args: the list of parameters passed to the program
     *    - covTree: the code coverage tree that is being filled when branch of code are hit
     *
     * @returns:
     *     true iff all test successfully passed
     * */
    pub fn run(self, args: [[c8]], covTree: &CoverageTree)-> bool {
        let testArgs = {
            self.parseArguments(args)
        } catch {
            _ => { return false; } // parsing failed
        };

        self.resetCoverageUnlessResuming(testArgs.hasResume);

        _yrt_force_debug();
        let dmut already: [[c8] => bool] = copy [];
        let dmut durations: [[c8] => u64] = copy [];

        let toLaunch = TestFilters::filterList(copy [name for name, _ in self._tests],
                                               hasFilters-> testArgs.hasFilter,
                                               filter-> testArgs.filter,
                                               resume-> testArgs.hasResume,
                                               already-> ref already);

        let failed = if testArgs.jobs <= 1 || toLaunch.len <= 1us {
            self.runList(toLaunch, testArgs.hasStopFirst, ref already, ref durations)
        } else {
            self.runParallel(toLaunch, testArgs, covTree, ref already, ref durations)
        };

        TestFilters::dumpSuccessFile(already);
        self.storeCoverage(covTree);

        if testArgs.hasDurations {
            self.reportDurations(durations);
        }

        // only when a report was actually asked for: `reportCoverage` parses and merges every
        // coverage file on disk, and `CoverageFormat::report` then prints nothing without one of
        // these two flags -- the whole merge is dead work on a plain run
        if !failed && (testArgs.hasCoverage || testArgs.hasCallTree) {
            self.reportCoverage(testArgs);
        }

        return !failed;
    }

    /**
     * Run every test of `tests` sequentially, in this process, recording each one's outcome
     * into `already` and how long it took into `durations`
     *
     * @params:
     *    - tests: the names of the tests to run
     *    - hasStopFirst: true iff execution must stop at the first failure
     *    - already: the map to record each test's success/failure into
     *    - durations: the map to record each test's execution time(in microseconds) into
     *
     * @returns: true iff at least one test of `tests` failed
     * */
    fn runList(self, tests: [[c8]], hasStopFirst: bool, ref dmut already: [[c8] => bool], ref dmut durations: [[c8] => u64])-> bool {
        let mut failed = false;
        for test in tests {
            let start = Instant::now();
            let ok = self.runOne(test);

            durations[test] = (Instant::now() - start).allMicros;
            already[test] = ok;

            if (!ok) {
                failed = true;
                if (hasStopFirst) break;
            }
        }

        return failed;
    }

    /**
     * Run a single registered test, in this process
     *
     * This is the one place a test is actually executed: the sequential path calls it in a loop
     * (see `runList`), a worker calls it once per assignment(see `runWorkerLoop`).
     *
     * @params:
     *    - test: the name of the test to run
     *
     * @returns: true iff the test passed(or is not registered, in which case there is nothing
     *           to run)
     * */
    fn runOne(self, test: [c8])-> bool {
        let mut ok = true;
        if let Ok(f) = self._tests[test] {
            let name = displayName(test);

            {
                self.runTest(name, f);
            } catch {
                err: &Exception => {
                    self.exposeError(name, err);
                    ok = false;
                }
            }
        }

        return ok;
    }

    /**
     * Fork `testArgs.jobs` `TestWorker` subprocesses and hand `toLaunch` out to them one test at
     * a time, over a pipe-backed mailbox(see `TestMailbox`)
     *
     * Handing tests out on demand rather than splitting the list up front makes the balance
     * exact by construction: a worker is idle only when there is nothing left to give it. There
     * is no cost model and no history file, so a cold run is already balanced, and the run
     * self-corrects when a test's cost changes.
     *
     * @info: worker stdout/stderr is inherited and unpiped, so it freely interleaves across
     *        workers -- this is the accepted, expected behaviour of a parallel test runner
     *
     * @params:
     *    - toLaunch: the names of the tests to run, indexed by the assignments sent to workers
     *    - testArgs: the parsed arguments of this run
     *    - covTree: the code coverage tree that will be filled by each worker's own tests
     *    - already: the map to record each test's success/failure into
     *    - durations: the map to record each test's execution time(in microseconds) into
     *
     * @returns: true iff at least one test failed, or at least one worker died holding one
     * */
    fn runParallel(self, toLaunch: [[c8]], testArgs: TestRunnerArgument, covTree: &CoverageTree, ref dmut already: [[c8] => bool], ref dmut durations: [[c8] => u64])-> bool {        
        let jobs = normalizeJobs(testArgs.jobs, toLaunch.len);
        let dmut box = {
            copy TestMailbox(jobs)
        } catch {
            _ => {
                eprintln('[', Colors::RED, "ERROR", Colors::RESET, "] : could not create the worker pipes, aborting the run");
                return true;
            }
        };

        TestWorker::ignoreSigPipe();

        for k in 0us .. jobs {
            if let Ok(pid) = TestWorker::fork() {
                let dmut ch = alias box:.channel(k);
                ch:.setPid(pid);
            } else {
                self.runWorkerLoop(alias box, k, toLaunch, covTree); // never returns
            }
        }

        let dmut crashed: [u32 => [c8]] = copy [];
        let failed = {
            box:.adoptParent();
            self.dispatch(alias box, toLaunch, testArgs.hasStopFirst, ref already, ref durations, ref crashed)
        } catch {
            _ => {
                eprintln('[', Colors::RED, "ERROR", Colors::RESET, "] : could not poll the workers, aborting the run");
                true
            }
        };

        box:.dispose();
        self.reapWorkers(jobs, crashed);

        return failed;
    }

    /**
     * Hand `toLaunch` out to the workers, one test at a time, until every one of them is done
     *
     * A worker's message is always answered by an assignment(or by the stop sentinel once there
     * is nothing left to give), and its very first message reports no outcome -- so this loop
     * needs no priming step.
     *
     * @warning: **poll first, reap last**. Nothing here may block on `waitpid`: a worker could
     *           be blocked writing to a pipe nobody is draining. Reaping happens in
     *           `reapWorkers`, once this loop has returned.
     *
     * @params:
     *    - box: the mailbox multiplexing every worker
     *    - toLaunch: the names of the tests to run, indexed by the assignments sent to workers
     *    - hasStopFirst: true iff the first failure must stop handing out work
     *    - already: the map to record each test's success/failure into
     *    - durations: the map to record each test's execution time(in microseconds) into
     *    - crashed: the map to record, per worker pid, the test it died on
     *
     * @returns: true iff at least one test failed, or at least one worker died holding one
     * */
    fn dispatch(self, dmut box: &TestMailbox, toLaunch: [[c8]], hasStopFirst: bool,
                ref dmut already: [[c8] => bool], ref dmut durations: [[c8] => u64],
                ref dmut crashed: [u32 => [c8]])-> bool
    {
        let mut failed = false, mut stopped = false;
        let dmut queue = copy TestQueue(toLaunch.len, box.count);

        while box.liveCount > 0us {
            let event = box:.nextEvent();
            if (event.kind == MailboxEventKind::NONE) break;

            let dmut ch = alias box:.channel(event.worker);
            if (event.kind == MailboxEventKind::GONE) {
                // the worker will never speak again; if it was still holding a test, that test
                // is what killed it -- `already` already has it as false(see
                // `TestFilters::filterList`), so it simply runs again next time
                if (ch.holding >= 0i64) {
                    let name = toLaunch[cast!usize(ch.holding)];
                    crashed[ch.pid] = copy name;
                    self.exposeCrash(name);

                    failed = true;
                    if (hasStopFirst) { stopped = true; }
                }

                continue;
            }

            if (event.outcome.index >= 0i64) {
                let name = toLaunch[cast!usize(event.outcome.index)];
                already[name] = event.outcome.ok;
                durations[name] = event.outcome.micros;
                ch:.release();

                if (!event.outcome.ok) {
                    failed = true;
                    if (hasStopFirst) { stopped = true; }
                }
            }

            let index = if stopped { STOP } else { queue:.next(event.worker) };
            if (index < 0i64) {
                // graceful, unlike the SIGKILL this replaces: the worker finishes the test it
                // has in hand and persists its results before exiting
                box:.stop(event.worker);
            } else if (!box:.assign(event.worker, index)) {
                queue:.giveBack(index); // that worker had just died; the test still has to run
            }
        }

        // every worker is gone but the list was not exhausted, and no single test can be blamed
        // for it -- the run is incomplete, so it must not be reported as a pass(the tests that
        // never ran are still `false` in `already`, so `--resume` picks them up)
        if (!stopped && !queue.isEmpty) {
            eprintln('[', Colors::RED, "ERROR", Colors::RESET, "] : every worker ended before the test list was exhausted");
            failed = true;
        }

        return failed;
    }

    /**
     * The body of a forked worker: ask the parent for a test, run it, report the outcome, ask
     * again -- until the parent sends the stop sentinel or goes away. Never returns.
     *
     * @info: results travel back over the channel, so a worker writes no success file of its
     *        own; its coverage still goes to its own pid-named file, which is already
     *        multi-process safe(see `CoverageStore::storePid`)
     *
     * @params:
     *    - box: the mailbox; every fd this worker does not own is closed on entry
     *    - k: the index of the worker this process just became
     *    - toLaunch: the names of the tests, indexed by the assignments the parent sends
     *    - covTree: this(forked) process's own code coverage tree
     * */
    fn runWorkerLoop(self, dmut box: &TestMailbox, k: usize, toLaunch: [[c8]], covTree: &CoverageTree) {
        box:.adoptWorker(k);

        {
            let dmut ch = alias box:.channel(k);
            ch:.report(TestOutcome()); // "ready, nothing to report yet"

            let mut running = true;
            while running {
                let index = ch:.awaitAssignment();
                if (index < 0i64) {
                    running = false;
                } else {
                    let name = toLaunch[cast!usize(index)];
                    let start = Instant::now();
                    let ok = self.runOne(name);

                    ch:.report(TestOutcome(index-> index, ok-> ok, micros-> (Instant::now() - start).allMicros));
                }
            }
        } catch {
            _ => {} // the parent is gone: wind down like any other worker
        }

        self.storeCoverage(covTree);

        TestWorker::exit(0);
    }

    /**
     * Reap every worker, now that the dispatch loop has drained(see `dispatch`), naming the
     * signal that killed the ones that died holding a test
     *
     * @params:
     *    - jobs: the number of workers that were forked
     *    - crashed: the test each dead worker was holding, per pid(see `dispatch`)
     * */
    fn reapWorkers(self, jobs: usize, crashed: [u32 => [c8]]) {
        for _ in 0us .. jobs {
            let (pid, _, signal) = TestWorker::waitAny();
            if (pid == 0u32) break; // no child left to reap

            if let Ok(name) = crashed[pid] {
                println(" --> worker ", pid, " died on ", displayName(name), ": ", TestWorker::signalName(signal));
            }
        }
    }

    /**
     * Print the failure of a test whose worker died before reporting a result
     *
     * @params:
     *     - name: the name of the test the worker was holding when it died
     * */
    fn exposeCrash(self, name: [c8]) {
        println("====================================");
        println('[', Colors::RED, "CRASH", Colors::RESET, "] : ", displayName(name));

        println(" --> the worker running this test died before reporting a result");
    }

    /**
     * Print the slowest tests of the run(see `--durations`)
     *
     * @info: this is a report and nothing else -- durations are never fed back into the way work
     *        is distributed, which the mailbox makes unnecessary
     *
     * @params:
     *    - durations: how long each test took, in microseconds
     * */
    fn reportDurations(self, durations: [[c8] => u64]) {
        let dmut entries: [TestDuration] = [];
        for name, micros in durations {
            entries ~= [TestDuration(name-> name, micros-> micros)];
        }

        if (entries.len != 0us) {
            let slowest = sorting::sort(alias entries, |a, b| => { a.micros > b.micros });
            let count = if slowest.len < SLOWEST_COUNT { slowest.len } else { SLOWEST_COUNT };

            println("====================================");
            println('[', Colors::BLUE, "SLOWEST", Colors::RESET, "] : ", count, '/', slowest.len);

            for i in 0us .. count {
                println("  ", dur::micros(slowest[i].micros), " : ", displayName(slowest[i].name));
            }
        }
    }

    /**
     * Delete every coverage file left over from previous runs(see `CoverageStore::PID_FILE_PREFIX`),
     * unless `--resume` was passed, in which case this run's coverage must be merged with theirs
     *
     * @params:
     *    - hasResume: true iff the flag resume was found in argument parser
     * */
    fn resetCoverageUnlessResuming(self, hasResume: bool) {
        if !hasResume {
            CoverageStore::removePidFiles(CoverageLoad::listPidFiles());
        }
    }

    /**
     * Export this process's coverage tree to its own coverage file(see `CoverageStore::storePid`),
     * so it can be merged with the coverage of other runs when the report is printed
     *
     * @params:
     *    - covTree: the code coverage tree that was filled while running the tests
     * */
    fn storeCoverage(self, covTree: &CoverageTree) {
        {
            CoverageStore::storePid(covTree);
        } catch {
            err => { println("err ", err); }
        }
    }

    /**
     * Print the coverage/call-tree report, merged from every coverage file found on disk(this
     * run's, plus any left over from a previous `--resume` run)
     *
     * @params:
     *    - testArgs: the parsed arguments of this run
     * */
    fn reportCoverage(self, testArgs: TestRunnerArgument) {
        let report = CoverageConv::fromConfigs(CoverageLoad::loadAll(CoverageLoad::listPidFiles()));

        CoverageFormat::report(report, testArgs.hasCoverage, testArgs.hasCallTree, withMissing-> testArgs.hasMissing);
    }

    /**
     * Run a unittest
     *
     * @params:
     *     - name: the name of the test
     *     - func: the function of the unit test
     *
     * @throws:
     *    - the exception thrown by the test if it fails
     * */
    fn runTest(self, name: [c8], func: fn ()-> void)
        throws Exception
    {
        println('[', Colors::BLUE, "RUN", Colors::RESET, "] : ", name);
        println("====================================");
        self.fake_throw(true);
        func();
        println("====================================");
        println('[', Colors::GREEN, "SUCCESS", Colors::RESET, "] : ", name);
    }

    /**
     * Print the error of a test when it failed
     *
     * @params:
     *     - name: the name of the test that failed
     *     - err: the exception thrown by the test
     *
     * */
    fn exposeError(self, name: [c8], err: &Exception) {
        println("====================================");
        println('[', Colors::RED, "FAILURE", Colors::RESET, "] : ", name);

        println(" --> ", err);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Some cheating util, to make the compiler accept the try/catch block, when the actual throwing part is the unittes.
     *
     * */
    fn fake_throw(self, b: bool)
        throws AssertError
    {
        assert(b);
    }

    /**
     * Parse the arguments passed to the launcher
     *
     * */
    fn parseArguments(self, args: [[c8]])-> TestRunnerArgument
        throws AssertError
    {
        return TestRunnerArgument(args);
    }
}
