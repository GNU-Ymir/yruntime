in runner;

use core::exception::assertion;

use utils::{args, colors, filters};
use utils::coverage::{conv, format, load, store, tree};

use std::io;
use std::log;
use std::concurrency::{mail, task};
use std::algorithm::sorting;
use std::config::data;
use std::fs::path;
use std::time::{dur, instant};

lazy __LOG__ = Logger("test-rt::runner");

// Number of tests listed by the `--durations` report, slowest first.
def SLOWEST_COUNT = 10us;

/**
 * @returns: `test` as it is shown to the user -- the registered name without the `__test`
 *           segment the compiler-generated glue inserts before the name, e.g. `io::printChars` for a
 *           test registered as `io::__test::printChars`
 *
 * @info: this is also the form `--filter` matches against(see `TestFilters::passFilter`), so
 *        every name the runner prints can be pasted straight back into a `-f`
 * */
fn displayName(test: [c8])-> [c8] {
    let testFile = Path(test, sep-> "::").file();
    let testName = Path(test, sep-> "::").parent().parent().push(testFile);

    return testName.toStr(sep-> "::");
}

/**
 * How long one test took, as listed by the `--durations` report
 * */
record TestDuration {

    // The name of the test
    pub let mut name: [c8];

    // How long it took, in microseconds
    pub let mut micros: u64;

    pub self (name: [c8] = "", micros: u64 = 0u64)
        with name = name
        , micros = micros
    {}
}

/**
 * @returns: `jobs`(clamped to at least 1), further clamped so it never exceeds `total`
 * */
pub fn normalizeJobs(jobs: i64, total: usize)-> usize {
    let n = if jobs < 1 { 1us } else { cast!usize(jobs) };
    if n > total {
        return total;
    }

    return n;
}

/**
 * A parameterized `__test`, as it was registered(see `UnittestLauncher::registerParameterized`)
 * */
record ParameterizedTest {

    // The name the test was registered under, the per-case names derive from it
    pub let mut name: [c8];

    // The frame returning the generator of parameter sets, as a (closure, func) delegate
    pub let mut provider: fn ()-> (*void, *void);

    // The test itself, called with a pointer to one parameter set
    pub let mut test: fn (*void)-> void;

    pub self (name: [c8], provider: fn ()-> (*void, *void), test: fn (*void)-> void)
        with name = name
        , provider = provider
        , test = test
    {}
}

/**
 * @returns: `name` without the trailing '\u{0}' the C registration shim appends to it
 * */
fn stripNul(name: [c8])-> [c8] {
    if name.len > 0 && name[$-1] == '\u{0}' {
        name[0 .. $-1]
    } else {
        name
    }
}

extern (C) fn _yrt_force_debug()-> void;
extern (C) fn _yrt_next_parameter_set(closure: *void, func: *void, ref mut out: *void)-> bool;

@{final}
pub class UnittestLauncher {

    // The list of test registered in the launcher These delegates are cheated
    // by the compiler as they don't respect the non throwing convention, as
    // they throw when they fail. It is the standard accepted way, as it is only
    // for internal usage. A delegate, so a parameterized case carries its parameter set.
    let dmut _tests: [[c8] => dg ()-> void] = copy [];

    // The parameterized tests, by name, their cases are produced while the run goes on
    let dmut _paramTests: [[c8] => ParameterizedTest] = copy [];

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ======================================          CTOR          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    pub self () {}

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ==================================          REGISTRATION          ==================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Register a test in the unittest map
     * @params:
     *    - name: the name of the test to register
     *    - func: the function to execute for the test
     *
     * */
    pub fn register(mut self, name: [c8], func: fn ()-> void) {
        self._tests[stripNul(name)] = copy || => { func(); };
    }

    /**
     * Register a parameterized test in the launcher
     *
     * @warning: `provider` is stored, never called -- registration runs from a package
     *           constructor, before the runtime is initialised.
     *
     * @params:
     *    - name: the name of the test to register
     *    - provider: the frame returning the generator of parameter sets
     *    - test: the frame to execute once per parameter set
     * */
    pub fn registerParameterized(mut self, name: [c8], provider: fn ()-> (*void, *void), test: fn (*void)-> void) {
        let n = stripNul(name);
        self._paramTests[n] = ParameterizedTest(name-> n, provider-> provider, test-> test);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * =====================================          USAGE          ======================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Run the tests

     * @params:
     *    - args: the list of parameters passed to the program
     *
     * @returns:
     *     true iff all test successfully passed
     * */
    pub fn run(mut self, args: [[c8]])-> bool {
        let testArgs = TestRunnerArgument(args);

        _yrt_force_debug();
        setSink(copy StreamSink::stdout());
        setLevel("test-rt", Level::INFO);

        let dmut already: [[c8] => bool] = copy [];
        let dmut durations: [[c8] => u64] = copy [];

        let toLaunch = self.selectTests(testArgs, ref already);

        if testArgs.hasList {
            self.listTests(toLaunch);
            return true;
        }

        self.resetCoverageUnlessResuming(testArgs.hasResume);

        let failed = if testArgs.jobs <= 1 || self.caseBound(toLaunch) <= 1us {
            self.runList(toLaunch, testArgs, ref already, ref durations)
        } else {
            self.runParallel(toLaunch, testArgs, ref already, ref durations)
        };

        TestFilters::dumpSuccessFile(already);
        self.storeCoverage();

        if testArgs.hasDurations {
            self.reportDurations(durations);
        }

        // only when a report was actually asked for: `reportCoverage` parses and merges every
        // coverage file on disk, and `CoverageFormat::report` then prints nothing without one of
        // these two flags -- the whole merge is dead work on a plain run
        if !failed && (testArgs.hasCoverage || testArgs.hasCallTree) {
            self.reportCoverage(testArgs);
        }

        return !failed;
    }

    /**
     * @returns: the sorted names of the tests passing the filters of `testArgs`, a parameterized
     *           test being kept when any of its cases may pass them(see `forEachCase`)
     *
     * @params:
     *    - testArgs: the parsed arguments of this run
     *    - already: filled with the success/failure of the tests of the previous run
     * */
    fn selectTests(self, testArgs: TestRunnerArgument, ref dmut already: [[c8] => bool])-> [[c8]] {
        let dmut toLaunch: [[c8]] = [];
        toLaunch ~= TestFilters::filterList(copy [name for name, _ in self._tests],
                                            hasFilters-> testArgs.hasFilter,
                                            filter-> testArgs.filter,
                                            resume-> testArgs.hasResume,
                                            already-> ref already);

        for name, _ in self._paramTests {
            if !testArgs.hasFilter || TestFilters::mayPassCaseFilter(name, testArgs.filter) {
                toLaunch ~= [name];
            }
        }

        return sort(alias toLaunch);
    }

    /**
     * @returns: the number of cases `tests` may run, `usize::max` if one of them is parameterized
     * */
    fn caseBound(self, tests: [[c8]])-> usize {
        for test in tests {
            if test in self._paramTests {
                return usize::max;
            }
        }

        return tests.len;
    }

    /**
     * Print the name of every test of `tests`, one per line, as `-f` accepts it(see `displayName`),
     * a parameterized test as `<test>[*]` -- its cases are not known before it runs
     *
     * @params:
     *    - tests: the names of the tests that would be run
     * */
    fn listTests(self, tests: [[c8]]) {
        for test in tests {
            if test in self._paramTests {
                println(displayName(test), "[*]");
            } else {
                println(displayName(test));
            }
        }
    }

    /**
     * Call `launch` with the name and body of every case of `tests` to run, in order, until it
     * returns false
     *
     * A parameterized test is a case `<test>[<k>]` per parameter set its generator yields, the
     * k-th one, resumed as the cases are launched -- the filters and `--resume` are applied to
     * each case as it comes(see `TestFilters::select`). A generator must yield the same sets in
     * the same order on every run, or `[k]` filters and `--resume` select another case than the
     * one they named.
     *
     * @params:
     *    - tests: the names of the tests to run(see `selectTests`)
     *    - testArgs: the parsed arguments of this run
     *    - already: the success/failure of the tests, a selected case marked as not passed yet
     *    - launch: called with the name and body of each case
     * */
    fn forEachCase(self, tests: [[c8]], testArgs: TestRunnerArgument, ref dmut already: [[c8] => bool], launch: dg ([c8], dg ()-> void)-> bool) {
        for test in tests {
            if let Ok(p) = self._paramTests[test] {
                let (closure, func) = p.provider();
                let body = p.test;
                let mut set: *void = null;
                let mut k = 0us;

                while _yrt_next_parameter_set(closure, func, ref set) {
                    let name = test ~ "[" ~ conv::to![c8](k) ~ "]";
                    let s = set;
                    k += 1us;

                    if TestFilters::select(name, hasFilters-> testArgs.hasFilter, filter-> testArgs.filter,
                                           resume-> testArgs.hasResume, already-> ref already) {
                        if !launch(name, copy || => { body(s); }) return;
                    }
                }
            } else if let Ok(f) = self._tests[test] {
                if !launch(test, f) return;
            }
        }
    }

    /**
     * Run every case of `tests` sequentially, in this thread, recording each one's outcome
     * into `already` and how long it took into `durations`
     *
     * @params:
     *    - tests: the names of the tests to run
     *    - testArgs: the parsed arguments of this run
     *    - already: the map to record each test's success/failure into
     *    - durations: the map to record each test's execution time(in microseconds) into
     *
     * @returns: true iff at least one test of `tests` failed
     * */
    fn runList(self, tests: [[c8]], testArgs: TestRunnerArgument, ref dmut already: [[c8] => bool], ref dmut durations: [[c8] => u64])-> bool {
        let dmut outcomes = alias already;
        let dmut times = alias durations;
        let dmut failed = copy [false];
        let hasStopFirst = testArgs.hasStopFirst;

        self.forEachCase(tests, testArgs, ref already, copy |test: [c8], f: dg ()-> void|-> bool => {
            let (ok, micros) = self.runOne(test, f);

            times[test] = micros;
            outcomes[test] = ok;
            if (!ok) failed[0] = true;

            ok || !hasStopFirst
        });

        return failed[0];
    }

    /**
     * Run a single test, in the calling thread
     *
     * This is the one place a test is actually executed: the sequential path calls it in a loop
     * (see `runList`), the parallel path calls it once per task(see `runParallel`).
     *
     * @params:
     *    - test: the name of the test
     *    - func: the body of the test
     *
     * @returns: true iff the test passed, and how long it took, in microseconds
     * */
    fn runOne(self, test: [c8], func: dg ()-> void)-> (bool, u64) {
        let name = displayName(test);
        let start = Instant::now();
        let mut ok = true;

        {
            self.runTest(name, func);
        } catch {
            err: &Exception => {
                self.exposeError(name, err);
                ok = false;
            }
        }

        return (ok, (Instant::now() - start).allMicros);
    }

    /**
     * Run the cases of `toLaunch` on a `TaskPool` of `testArgs.jobs` threads, one task per case,
     * the generators of the parameterized tests being resumed on this thread as they are submitted
     *
     * @info: a test that crashes the process(e.g. a segfault) takes the whole run down with it,
     *        its trace naming the faulty thread
     *
     * @params:
     *    - toLaunch: the names of the tests to run
     *    - testArgs: the parsed arguments of this run
     *    - already: the map to record each test's success/failure into
     *    - durations: the map to record each test's execution time(in microseconds) into
     *
     * @returns: true iff at least one test failed
     * */
    fn runParallel(self, toLaunch: [[c8]], testArgs: TestRunnerArgument, ref dmut already: [[c8] => bool], ref dmut durations: [[c8] => u64])-> bool {
        let dmut pool = copy TaskPool(nbThreads-> cast!u32(normalizeJobs(testArgs.jobs, self.caseBound(toLaunch))));
        let dmut outcomes = copy MailBox!{([c8], bool, u64)} ();
        let dmut stopped = copy [false];
        let hasStopFirst = testArgs.hasStopFirst;

        self.forEachCase(toLaunch, testArgs, ref already, copy |test: [c8], f: dg ()-> void|-> bool => {
            self.submitOne(alias pool, alias outcomes, alias stopped, hasStopFirst, test, f);
            !stopped[0]
        });

        pool:.join();
        pool:.dispose();

        let mut failed = false;
        while let Ok((test, ok, micros)) = outcomes:.receive() {
            already[test] = ok;
            durations[test] = micros;
            if (!ok) failed = true;
        }

        return failed;
    }

    /**
     * Submit to `pool` a task running the test `test`(see `runOne`), unless `stopped[0]` is set
     * by the time it starts, and sending its outcome to `outcomes`
     *
     * @params:
     *    - pool: the pool running the tests
     *    - outcomes: receives the name, success and duration(in microseconds) of the test
     *    - stopped: set once a test failed if `hasStopFirst`
     *    - hasStopFirst: true iff execution must stop at the first failure
     *    - test: the name of the test
     *    - func: the body of the test
     * */
    fn submitOne(self, dmut pool: &TaskPool, dmut outcomes: &MailBox!{([c8], bool, u64)}, dmut stopped: [bool], hasStopFirst: bool, test: [c8], func: dg ()-> void) {
        pool:.submit(copy || => {
            if (stopped[0]) return;

            let (ok, micros) = self.runOne(test, func);
            outcomes:.send((test, ok, micros));
            if (!ok && hasStopFirst) stopped[0] = true;
        });
    }

    /**
     * Print the slowest tests of the run(see `--durations`)
     *
     * @info: this is a report and nothing else -- durations are never fed back into the way work
     *        is scheduled
     *
     * @params:
     *    - durations: how long each test took, in microseconds
     * */
    fn reportDurations(self, durations: [[c8] => u64]) {
        let dmut entries: [TestDuration] = [];
        for name, micros in durations {
            entries ~= [TestDuration(name-> name, micros-> micros)];
        }

        if (entries.len != 0us) {
            let slowest = sorting::sort(alias entries, |a, b| => { a.micros > b.micros });
            let count = if slowest.len < SLOWEST_COUNT { slowest.len } else { SLOWEST_COUNT };

            println("====================================");
            println('[', Colors::BLUE, "SLOWEST", Colors::RESET, "] : ", count, '/', slowest.len);

            for i in 0us .. count {
                println("  ", dur::micros(slowest[i].micros), " : ", displayName(slowest[i].name));
            }
        }
    }

    /**
     * Delete every coverage file left over from previous runs(see `CoverageStore::PID_FILE_PREFIX`),
     * unless `--resume` was passed, in which case this run's coverage must be merged with theirs
     *
     * @params:
     *    - hasResume: true iff the flag resume was found in argument parser
     * */
    fn resetCoverageUnlessResuming(self, hasResume: bool) {
        if !hasResume {
            CoverageStore::removePidFiles(CoverageLoad::listPidFiles());
        }
    }

    /**
     * Export this process's coverage tree to its own coverage file(see `CoverageStore::storePid`),
     * so it can be merged with the coverage of other runs when the report is printed
     *
     * @info: the coverage of every thread of this process is folded together here(see
     *        `tree::mergedTree`), so what a `TaskPool` worker or an actor loop executed is not
     *        lost with the thread that ran it
     * */
    fn storeCoverage(self) {
        {
            CoverageStore::storePid(tree::mergedTree());
        } catch {
            err => { __LOG__.error("failed to store the coverage\n", err); }
        }
    }

    /**
     * Print the coverage/call-tree report, merged from every coverage file found on disk(this
     * run's, plus any left over from a previous `--resume` run)
     *
     * @params:
     *    - testArgs: the parsed arguments of this run
     * */
    fn reportCoverage(self, testArgs: TestRunnerArgument) {
        let report = CoverageConv::fromConfigs(CoverageLoad::loadAll(CoverageLoad::listPidFiles()));

        CoverageFormat::report(report, testArgs.hasCoverage, testArgs.hasCallTree, withMissing-> testArgs.hasMissing);
    }

    /**
     * Run a unittest
     *
     * @params:
     *     - name: the name of the test
     *     - func: the function of the unit test
     *
     * @throws:
     *    - the exception thrown by the test if it fails
     * */
    fn runTest(self, name: [c8], func: dg ()-> void)
        throws Exception
    {
        __LOG__.info("run ", name);
        self.fake_throw(true);
        func();
        __LOG__.info("passed ", name);
    }

    /**
     * Print the error of a test when it failed
     *
     * @params:
     *     - name: the name of the test that failed
     *     - err: the exception thrown by the test
     *
     * */
    fn exposeError(self, name: [c8], err: &Exception) {
        __LOG__.error("failed ", name, "\n", err);
    }

    /*!
     * ====================================================================================================
     * ====================================================================================================
     * ====================================          PRIVATE          =====================================
     * ====================================================================================================
     * ====================================================================================================
     */

    /**
     * Some cheating util, to make the compiler accept the try/catch block, when the actual throwing part is the unittes.
     *
     * */
    fn fake_throw(self, b: bool)
        throws AssertError
    {
        assert(b);
    }
}
