in filters;

use std::fs::_;
use std::algorithm::sorting;
use std::syntax::tokenizer;
use std::log;

lazy __LOG__ = Logger("test-rt::filters");

// The canonical file written once, at the end of a run, by `TestFilters::dumpSuccessFile`.
//
// It is the *only* result file a run writes: worker threads report their outcomes to the runner,
// so there is no per-worker fragment to merge.
pub def SUCCESS_FILE = ".ymir_test_success";

/**
 * Module to apply filtering on tests names.
 *
 */
pub mod TestFilters {

    /**
     * Filter the list of tests
     * @params:
     *    - tests: the list of tests registered in the program
     *    - hasFilters: true iff the argument parser has filter
     *    - filter: the filter to apply if hasFilters
     *    - resume: true iff the flag resume was found in argument parser
     *
     * @returns:
     *    - already: the list of tests that have been executed in the previous iteration(associated to success failure, flags)
     *    - the list of tests to run
     */
    pub fn filterList(tests:            [[c8]],
                      hasFilters:       bool,
                      filter:           [c8],
                      resume:           bool,
                      ref dmut already: [[c8] => bool])-> [[c8]] {
        already = TestFilters::readSuccessFile();

        let dmut toLaunch: [[c8]] = [];
        for t in tests {
            if TestFilters::select(t, hasFilters-> hasFilters, filter-> filter, resume-> resume, already-> ref already) {
                toLaunch ~= [t];
            }
        }

        let list = sort(alias toLaunch);
        return list;
    }

    /**
     * Decide whether the test `name` runs, marking it as not passed yet in `already` if it does
     *
     * @params:
     *    - name: the name of the test
     *    - hasFilters: true iff the argument parser has filter
     *    - filter: the filter to apply if hasFilters
     *    - resume: true iff the flag resume was found in argument parser
     *    - already: the success/failure of the tests of the previous run
     *
     * @returns: true iff `name` passes the filter, and did not already pass when resuming
     * */
    pub fn select(name:             [c8],
                  hasFilters:       bool,
                  filter:           [c8],
                  resume:           bool,
                  ref dmut already: [[c8] => bool])-> bool {
        if hasFilters && !TestFilters::passFilter(name, filter) {
            return false;
        }

        if resume && (already[name] ?? false) {
            return false;
        }

        already[name] = false;
        return true;
    }

    /**
     * Write the file containing the success/failure of the tests execution
     * (where false can also mean it wasn't executed but was planned to)
     *
     * @params:
     *     - tests: the list of registered test and the flags defining the execution state
     *
     */
    pub fn dumpSuccessFile(tests: [[c8] => bool]) {
        writeSuccessMap(tests, SUCCESS_FILE);
    }

    /**
     * Read the resume file containing the execution flag for each tests that where registered during previous execution
     *
     * @returns: the list of test assocuiated to the successfuly executed flag
     */
    fn readSuccessFile()-> dmut[[c8] => bool] {
        return readSuccessMap(SUCCESS_FILE);
    }

    /**
     * Write `tests` to `path`(created, or erased if it already existed), one "name;true"/
     * "name;false" line per entry
     * */
    fn writeSuccessMap(tests: [[c8] => bool], path: [c8]) {
        {
            let dmut sfile = File::create(Path(path), write-> true);
            for test, success in tests {
                sfile:.write(test);
                sfile:.write(";");
                if success {
                    sfile:.write("true");
                } else {
                    sfile:.write("false");
                }
                sfile:.write("\n");
            }
        } catch {
            err => {
                __LOG__.error("failed to write the success file\n", err);
            }
        }
    }

    /**
     * Read a "name;true"/"name;false" per-line file previously written by `writeSuccessMap`
     * @returns: the parsed content of `path`, or an empty map if it does not exist/is unreadable
     * */
    fn readSuccessMap(path: [c8])-> dmut[[c8] => bool] {
        {
            let dmut sfile = File::open(Path(path), read-> true);
            let content = sfile:.readAll();

            let mut lineTzer = Tokenizer!{c8}();
            lineTzer:.insert(";", isSkip-> true);

            let mut globTzer = Tokenizer!{c8}();
            globTzer:.insert("\n", isSkip-> true);

            let dmut result: [[c8] => bool] = copy[];
            let lines = globTzer.tokenizeWithoutSkips(content);

            for line in lines {
                let test = lineTzer.tokenizeWithoutSkips(line);
                if (test.len == 2) {
                    result[test[0]] = (test[1] == "true");
                }
            }

            return alias result;
        } catch {
            _ => {
                return copy [];
            }
        }
    }

    /**
     * @returns: true if the test pass the filter and must be executed at this run
     *
     * `filter` is a "::"-separated path of glob segments(each segment matched independently,
     * '*' standing for "any characters" within that segment). The filter must have exactly as
     * many segments as the test name — use a literal "*" segment to match an arbitrary segment
     * at that depth, e.g. "algorithm::*" matches direct tests of `algorithm`, but not tests
     * nested one level deeper under a submodule such as `algorithm::sorting`(use
     * "algorithm::*::*" for that).
     *
     * */
    pub fn passFilter(name: [c8], filter: [c8])-> bool {
        let testFile = Path(name, sep-> "::").file();
        let testName = Path(name, sep-> "::").parent().parent().push(testFile);
        let nameParts = testName.parts();
        let filterParts = Path(filter, sep-> "::").parts();

        if nameParts.len != filterParts.len {
            return false;
        }

        for i in 0us .. filterParts.len {
            if !globMatch(filterParts[i], nameParts[i]) {
                return false;
            }
        }

        return true;
    }

    /**
     * @returns: false if no case `<name>[<k>]` of the parameterized test `name` can pass `filter`
     *
     * @info: an over-approximation, a true does not mean a case passes -- only `passFilter`
     *        on the name of the case tells
     * */
    pub fn mayPassCaseFilter(name: [c8], filter: [c8])-> bool {
        let testFile = Path(name, sep-> "::").file();
        let nameParts = Path(name, sep-> "::").parent().parent().push(testFile).parts();
        let filterParts = Path(filter, sep-> "::").parts();

        if nameParts.len != filterParts.len {
            return false;
        }

        for i in 0us .. filterParts.len - 1us {
            if !globMatch(filterParts[i], nameParts[i]) {
                return false;
            }
        }

        return globMatchPrefix(filterParts[$-1], nameParts[$-1] ~ "[");
    }

    /**
     * @returns: true if some text starting with `prefix` matches `pattern`(cf. `globMatch`)
     * */
    pub fn globMatchPrefix(pattern: [c8], prefix: [c8])-> bool {
        return globMatchImpl(pattern, prefix, wholeText-> false);
    }

    /**
     * @returns: true if `text` matches `pattern`, where '*' in `pattern` stands for "zero or
     * more of any character"(the only wildcard supported — no other character is special)
     * */
    pub fn globMatch(pattern: [c8], text: [c8])-> bool {
        return globMatchImpl(pattern, text, wholeText-> true);
    }

    /**
     * @returns: true if `pattern` matches `text` entirely if `wholeText`, or matches some text
     * starting with `text` otherwise
     * */
    fn globMatchImpl(pattern: [c8], text: [c8], wholeText: bool)-> bool {
        let mut pIdx = 0us;
        let mut tIdx = 0us;
        let mut starIdx: i64 = -1;
        let mut matchIdx = 0us;

        while tIdx < text.len {
            if pIdx < pattern.len && pattern[pIdx] == '*' {
                starIdx = cast!i64(pIdx);
                matchIdx = tIdx;
                pIdx += 1us;
            } else if pIdx < pattern.len && pattern[pIdx] == text[tIdx] {
                pIdx += 1us;
                tIdx += 1us;
            } else if starIdx != -1i64 {
                pIdx = cast!usize(starIdx) + 1us;
                matchIdx += 1us;
                tIdx = matchIdx;
            } else {
                return false;
            }
        }

        if !wholeText {
            return true;
        }

        while pIdx < pattern.len && pattern[pIdx] == '*' {
            pIdx += 1us;
        }

        return pIdx == pattern.len;
    }
}
