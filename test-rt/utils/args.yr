in args;

use core::exception::_;
use std::config::_;

pub record TestRunnerArgument {

    // The filter to exclude tests
    pub let mut filter: [c8] = "";

    // True iff a filter has been given
    pub let mut hasFilter: bool = false;

    // True iff the first test failure stops the execution
    pub let mut hasStopFirst: bool = false;

    // True iff a coverage report is expected
    pub let mut hasCoverage: bool = false;

    // True iff a call tree report is expected
    pub let mut hasCallTree: bool = false;

    // True iff the uncovered lines/branches are listed under each file of the coverage report
    pub let mut hasMissing: bool = false;

    // True iff only executing failed or not run tests
    pub let mut hasResume: bool = false;

    // True iff the slowest tests of the run are listed once it is over
    pub let mut hasDurations: bool = false;

    // The number of worker subprocesses to run tests in parallel(1 = sequential, in-process)
    pub let mut jobs: i64 = 1;

    /**
     * @params:
     *    - args: the list of argument passed to the command line
     */
    pub self(args: [[c8]])
        throws AssertError
    {
        let parser = (copy ArgumentParser())
            :.option!{[c8]} ("filter", short-> "f", comments-> "unittest filter")
            :.flag("stop-first", short-> "sf", comments-> "stop after first test failure")
            :.flag("coverage", short-> "cov", comments-> "print coverage report")
            :.flag("call-tree", short-> "ct", comments-> "print call tree report")
            :.flag("missing", short-> "m", comments-> "list the uncovered lines of each file (implies --coverage)")
            :.flag("resume", comments-> "re-run only failed tests")
            :.flag("durations", short-> "d", comments-> "list the slowest tests once the run is over")
            :.option!{i64} ("jobs", short-> "j", comments-> "number of worker subprocesses to run tests in parallel (default: 1, sequential)")
            :.help("help", short-> "h", comments-> "print this help and exit");

        {
            let ret = parser.parse(args);
            if let Ok(Str(value-> f)) = ret["filter"]? {
                self.filter = f;
                self.hasFilter = true;
            }

            if let Ok(Bool(value-> b)) = ret["stop-first"]? {
                self.hasStopFirst = b;
            }

            if let Ok(Bool(value-> b)) = ret["coverage"]? {
                self.hasCoverage = b;
            }

            if let Ok(Bool(value-> b)) = ret["call-tree"]? {
                self.hasCallTree = b;
            }

            if let Ok(Bool(value-> b)) = ret["missing"]? {
                self.hasMissing = b;
                // listing the uncovered lines is only meaningful within a coverage report
                if b { self.hasCoverage = true; }
            }

            if let Ok(Bool(value-> b)) = ret["resume"]? {
                self.hasResume = b;
            }

            if let Ok(Bool(value-> b)) = ret["durations"]? {
                self.hasDurations = b;
            }

            if let Ok(Int(value-> v)) = ret["jobs"]? {
                self.jobs = if v < 1i64 { 1i64 } else { v };
            }

        } catch {
            err => {
                std::io::eprintln(parser.explain(err));
                assert(false);
            }
        }
    }
}
