use std::io;
use std::stream;
use std::algorithm::searching;

/**
 * @returns: the text `print` would have written for `a`, captured in a string
 * rather than sent to the standard output.
 */
fn toStr {T} (a: T)-> [c8] {
    let dmut ss = copy StringStream ();
    ss:.write (a);

    ss []
}

__test printChars {
    println("Chars ");
    print('a');
    print('a'c16);
    print('a'c32);

    print("hello");
    print("hello"s16);
    print("hello"s32);
    println();
}

__test eprintChars {
    println("Chars ");
    eprint('a');
    eprint('a'c16);
    eprint('a'c32);

    eprint("hello");
    eprint("hello"s16);
    eprint("hello"s32);
    println();
}

__test flushOutput {
    print("flushed");
    flush();
    println();
}


__test printUnsigned {
    println("UINTS ");
    print(1u8);
    print(1u16);
    print(1u32);
    print(1u64);
    print(1us);

    eprint(1u8);
    eprint(1u16);
    eprint(1u32);
    eprint(1u64);
    eprint(1us);
    println();
}


__test printSigned {
    println("INTS ");
    print(1i8);
    print(1i16);
    print(1i32);
    print(1i64);
    print(1is);

    eprint(1i8);
    eprint(1i16);
