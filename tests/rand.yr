in rand;

use std::{conv, rand};
use std::rand::generator;

__test uniformCoversInterval {
    seed (42u64);

    let dmut seen = copy [false ; 10u64];
    for _ in 0 .. 10_000 {
        let v = uniform (1, 10);
        assert (v >= 1 && v <= 10, "out of bounds: " ~ v.to![c8] ());
        seen [v - 1] = true;
    }

    for i in 0 .. 10 {
        assert (seen [i], "never drawn: " ~ (i + 1).to![c8] ());
    }
}

__test uniformNotStepped {
    seed (7u64);

    // every value of the interval must be reachable, not only the multiples of its width
    let mut nbOdd = 0;
    for _ in 0 .. 1_000 {
        let v = uniform (0, 100);
        assert (v >= 0 && v <= 100, "out of bounds: " ~ v.to![c8] ());
        if v % 2 != 0 { nbOdd += 1; }
    }

    assert (nbOdd > 300 && nbOdd < 700, "unbalanced: " ~ nbOdd.to![c8] ());
}

__test degenerateIntervals {
    seed (1u64);

    // degenerated intervals
    assert (uniform (5, 5) == 5);
    assert (uniform (10, 1) == 10);

    // an interval of two values must draw both of them
    let mut low = false, mut high = false;
    for _ in 0 .. 100 {
        let v = uniform (0, 1);
        assert (v == 0 || v == 1);
        if v == 0 { low = true; } else { high = true; }
    }
    assert (low && high);
}

__test fullDomain {
    seed (3u64);

    // unsigned, and intervals spanning the whole domain of T
    let mut allSame = true;
    let first = uniform (i32::min, i32::max);
    for _ in 0 .. 100 {
        let v = uniform (200u8, 255u8);
        assert (v >= 200u8 && v <= 255u8);

        if uniform (i32::min, i32::max) != first { allSame = false; }
    }

    assert (!allSame);
    assert (uniform (u64::min, u64::max) != uniform (u64::min, u64::max));
}

__test floats {
    seed (11u64);

    for _ in 0 .. 1_000 {
        let f = uniform (1.0, 10.0);
        assert (f >= 1.0 && f <= 10.0);

        let g = uniform (-2.5f, 2.5f);
        assert (g >= -2.5f && g <= 2.5f);

        let h = rand!f64 ();
        assert (h >= 0.0 && h < 1.0);

        let i = rand!f32 ();
        assert (i >= 0.0f && i < 1.0f);
    }
}

__test xoshiroReferenceSequence {
    // reference values of xoshiro256** seeded through splitmix64
    let dmut r = copy Random (seed-> 0u64);
    assert (r:.bits () == 11091344671253066420u64);
    assert (r:.bits () == 13793997310169335082u64);
    assert (r:.bits () == 1900383378846508768u64);

    r:.reseed (42u64);
    assert (r:.bits () == 1546998764402558742u64);
    assert (r:.bits () == 6990951692964543102u64);
    assert (r:.bits () == 12544586762248559009u64);
}

__test seedIsReproducible {
    seed (1234u64);
    let a = [randBits (), randBits (), randBits ()];

    seed (1234u64);
    assert ([randBits (), randBits (), randBits ()] == a);

    seed (1235u64);
    assert ([randBits (), randBits (), randBits ()] != a);
}

fn seededDigest ()-> u64 {
    seed (99u64);
    let mut acc = 0u64;
    for _ in 0 .. 100_000 {
        acc = acc * 31u64 + randBits ();
    }

    acc
}

__test threadsOwnTheirGenerator {
    // interleaved draws on other threads never disturb the sequence of this one
    let dmut a = spawn seededDigest ();
    let dmut b = spawn seededDigest ();
    let expected = seededDigest ();

    assert (a.value == expected);
    assert (b.value == expected);

    let dmut c = spawn randBits ();
    let dmut d = spawn randBits ();
    assert (c.value != d.value);
}

__test deepCopyForks {
    let dmut a = copy Random (seed-> 5u64);
    a:.bits ();

    let dmut b = dcopy a;
    for _ in 0 .. 100 {
        assert (a:.bits () == b:.bits ());
    }

    b:.bits ();
    assert (a:.bits () != b:.bits ());
}

__test splitDoesNotOverlap {
    let dmut a = copy Random (seed-> 9u64);
    let dmut ref_ = copy Random (seed-> 9u64);
    let dmut b = a:.split ();

    let dmut jumped = dcopy a;
    assert (jumped:.bits () == 6433469579811067086u64);
    assert (jumped:.bits () == 7028240683198899737u64);

    // the split generator continues the original sequence, the source jumped away from it
    let dmut fromA: [u64] = [];
    for _ in 0 .. 1000 {
        let x = ref_:.bits ();
        assert (b:.bits () == x);
        fromA ~= [a:.bits ()];
    }

    let dmut c = copy Random (seed-> 9u64);
    for _ in 0 .. 1000 {
        let x = c:.bits ();
        for y in fromA { assert (x != y); }
    }
}

__test entropySeededGeneratorsDiffer {
    let dmut a = copy Random ();
    let dmut b = copy Random ();

    assert ([a:.bits (), a:.bits ()] != [b:.bits (), b:.bits ()]);
}
