in file;

use std::{fs::{file, path, errors}, io};

__test createWriteAppend {
    let path = Path("midgard_test_create_write_append.txt");

    // Create a file, and write something in it
    {
        let dmut file = File::create(path, write-> true);
        file:.write("Hello World!");
    } catch {
        err: &FsError => { // creation failed for some reason
            println(err);
            assert(false);
        }
    }

    {
        let content = {
            let dmut file = File::open(path);
            file:.readAll() // read the all the content of the file
        } catch {
            // File does not exist or permission denied
            FsError() => { "" } // return an empty string
        };

        assert(content == "Hello World!");
    }

    {
        let dmut file = File::open(path, append-> true);
        file:.write("\nAppending content");
        // files are entities, so automatically closed when scope is exited
    } catch {
        // File does not exist or permission denied
        err: &FsError => {
            println(err);
            assert(false);
        }
    }

    {
        let content = {
            let dmut file = File::open(path);
            file:.readAll() // read the all the content of the file
        } catch {
            // File does not exist or permission denied
            FsError() => { "" } // return an empty string
        };

        assert(content == "Hello World!\nAppending content");
    }

    // seek / tell / len are 64-bit offsets
    {
        let (fullLen, afterSeek, restLen, rest) = {
            let dmut file = File::open(path);
            let l = file.len();
            file:.seek(6u64);
            (l, file.tell(), file.len(), file:.readAll())
        } catch {
            err: &FsError => {
                println(err);
                (0u64, 0u64, 0u64, "")
            }
        };

        assert(fullLen == 30u64);
        assert(afterSeek == 6u64);
        assert(restLen == 30u64);
        assert(rest == "World!\nAppending content");
    }

    assert(sys::isFile(path));
    sys::removeFile(path);
    assert(!sys::isFile(path));

}
