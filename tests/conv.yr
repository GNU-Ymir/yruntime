in conv;

use core::exception::assertion;
use std::conv;
use std::conv::{errors, utf};
use std::traits;
use helpers;

__test unsignedToString {
    let x = to![c32] (12);
    let y = to!{[c8]} (879);

    let z = (12345).to!{[c8], "x"} ();
    let a = (12345).to!{[c8], "b"} ();
    let b = (12345).to!{[c8], "o"} ();
    let c = (12345).to!{[c8], 5us} ();

    assert(x == "12"s32, "Conversion error to c32");
    assert(y == "879", "Conversion error to c8");
    assert(z == "0x3039", "Conversion error z");
    assert(a == "0b11000000111001", "Conversion error a");
    assert(b == "0o30071", "Conversion error b");
    assert(c == "343340", "Conversion error c");
}


__test signedToString {
    let x = to![c32] (-12);
    let y = (-879).to![c8] ();

    let z = (-12345).to!{[c8], "x"} ();
    let a = (-12345).to!{[c8], "b"} ();
    let b = (-12345).to!{[c8], "o"} ();
    let c = (-12345).to!{[c8], 5us} ();

    assert(x == "-12"s32, "Conversion error to c32");
    assert(y == "-879", "Conversion error to c8");
    assert(z == "-0x3039", "Conversion error z");
    assert(a == "-0b11000000111001", "Conversion error a");
    assert(b == "-0o30071", "Conversion error b");
    assert(c == "-343340", "Conversion error c");
}

__test isizeToString {
    let x = to![c32] (-12is);
    let y = (-879is).to![c8] ();

    let z = (-12345is).to!{[c8], "x"} ();
    let a = (-12345is).to!{[c8], "b"} ();
    let b = (-12345is).to!{[c32], "o"} ();
    let c = (-12345is).to!{[c8], 5us} ();

    assert(x == "-12"s32, "Conversion error to c32");
    assert(y == "-879", "Conversion error to c8");
    assert(z == "-0x3039", "Conversion error z");
    assert(a == "-0b11000000111001", "Conversion error a");
    assert(b == "-0o30071", "Conversion error b");
    assert(c == "-343340", "Conversion error c");
}


__test utf32ToUtf8 {
    let x = "hello"s32.to!{[c8]} ();
    assert(x == "hello"s8, "1");

    let encoded = ("Hello world, Καλημέρα κόσμε, コンニチハ"s32).to![c8] ();
    assert(encoded.len == 59 && encoded == "Hello world, Καλημέρα κόσμε, コンニチハ"s8, "2");
}

__test utf8ToUtf32 {
    let x = "hello"s8.to!{[c32]} ();
    assert(x == "hello"s32, "1");

    let encoded = ("Hello world, Καλημέρα κόσμε, コンニチハ"s8).to![c32] ();
    assert(encoded.len == 34 && encoded == "Hello world, Καλημέρα κόσμε, コンニチハ"s32, "2");
}

__test bytesAndEmoji {
    let val = (copy [0xf0u8, 0x9fu8, 0x98u8, 0x89u8]).to![c8] ();
    assert(val == "😉", "3");

    let val2 = "😉".to![u8] ();
    assert(val2 == [0xf0u8, 0x9fu8, 0x98u8, 0x89u8], "4");

    let utf8 = ("😉"s32).to![c8] ();
    std::io::println(utf8, " ", utf8.len);
    assert(utf8 == "😉" && utf8.len == 4us, "5");

    let utf16 = ("😉"s32).to![c16] ();
    std::io::println(utf16, " ", utf16.len);
    assert(utf16 == "😉"s16 && utf16.len == 2us, "6");
}

/**
 * The minimum value of a signed int cannot be negated, the conversion has to
 * compute the magnitude on the unsigned side (cf. YMI-164).
 */
__test signedMinToString {
    assert(i8::min.to![c8] () == "-128", "Conversion error i8::min");
    assert(i16::min.to![c8] () == "-32768", "Conversion error i16::min");
    assert(i32::min.to![c8] () == "-2147483648", "Conversion error i32::min");
    assert(i64::min.to![c8] () == "-9223372036854775808", "Conversion error i64::min");
    assert(isize::min.to![c8] () == "-9223372036854775808", "Conversion error isize::min");

    assert(i32::min.to![c32] () == "-2147483648"s32, "Conversion error i32::min to c32");
}

__test signedMinToStringInBases {
    assert(i8::min.to!{[c8], "x"} () == "-0x80", "Conversion error i8::min hex");
    assert(i8::min.to!{[c8], "b"} () == "-0b10000000", "Conversion error i8::min bin");
    assert(i8::min.to!{[c8], "o"} () == "-0o200", "Conversion error i8::min oct");
    assert(i8::min.to!{[c8], 5us} () == "-1003", "Conversion error i8::min base 5");

    assert(i32::min.to!{[c8], "x"} () == "-0x80000000", "Conversion error i32::min hex");
    assert(i32::min.to!{[c8], "b"} () == "-0b10000000000000000000000000000000", "Conversion error i32::min bin");
    assert(i32::min.to!{[c8], "o"} () == "-0o20000000000", "Conversion error i32::min oct");

    assert(i64::min.to!{[c8], "x"} () == "-0x8000000000000000", "Conversion error i64::min hex");
    assert((-255).to!{[c8], "x"} (upper-> true) == "-0xFF", "Conversion error hex upper");
}

__test signedMaxToString {
    assert(i8::max.to![c8] () == "127", "Conversion error i8::max");
    assert(i16::max.to![c8] () == "32767", "Conversion error i16::max");
    assert(i32::max.to![c8] () == "2147483647", "Conversion error i32::max");
    assert(i64::max.to![c8] () == "9223372036854775807", "Conversion error i64::max");
    assert(i64::max.to!{[c8], "x"} () == "0x7fffffffffffffff", "Conversion error i64::max hex");
}

/**
 * The unsigned conversion has to cover the whole range as well, u64::max being
 * the value that does not fit in any signed type.
 */
__test unsignedBoundsToString {
    assert(u64::min.to![c8] () == "0", "Conversion error u64::min");
    assert(u8::min.to![c8] () == "0", "Conversion error u8::min");
    assert(usize::min.to![c8] () == "0", "Conversion error usize::min");
    assert(u64::min.to!{[c8], "x"} () == "0x0", "Conversion error u64::min hex");
    assert(u64::min.to!{[c8], 7us} () == "0", "Conversion error u64::min base 7");

    assert(u8::max.to![c8] () == "255", "Conversion error u8::max");
    assert(u16::max.to![c8] () == "65535", "Conversion error u16::max");
    assert(u32::max.to![c8] () == "4294967295", "Conversion error u32::max");
    assert(u64::max.to![c8] () == "18446744073709551615", "Conversion error u64::max");
    assert(usize::max.to![c8] () == "18446744073709551615", "Conversion error usize::max");

    assert(u64::max.to!{[c8], "x"} () == "0xffffffffffffffff", "Conversion error u64::max hex");
    assert(u64::max.to!{[c8], "o"} () == "0o1777777777777777777777", "Conversion error u64::max oct");
}

/**
 * String-to-integer parsing must reject digits outside the requested base,
 * empty / sign-only input, and values that overflow the target type (YMI-167).
 */
__test malformedIntLiterals {
    use std::conv::errors;

    let mut threw = 0;
    { let _ = ("0b12").to!{u32, "b"} (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("19").to!{u32, 2us} (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("0o99").to!{u32, "o"} (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("").to!u32 (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("-").to!i32 (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("999").to!u8 (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("99999999999999999999999").to!u64 (); } catch { CastFailure() => { threw += 1; } }
    { let _ = ("-12").to!u32 (); } catch { CastFailure() => { threw += 1; } }

    assert(threw == 8, "YMI-167: expected every malformed literal to throw");

    assert(("0b1001").to!{u32, "b"} () == 9u32);
    assert(("0o777").to!{u32, "o"} () == 511u32);
    assert(("255").to!u8 () == 255u8);
    assert(("-128").to!i8 () == -128i8);
    assert(("18446744073709551615").to!u64 () == u64::max);
    assert(("-42").to!{i32, 10us} () == -42);
}

/**
 * A float is converted to exactly the digits it is worth, with no trailing null char left inside
 * the slice
 * */
__test floatToString {
    assert(to!{[c8]} (3.5) == "3.500000", "YMI-186: expected the default precision, and nothing after it");
    assert(to!{[c8]} (314.0, prec-> 3u32) == "314.000");
    assert(to!{[c8]} (12.8, prec-> 1u32) == "12.8");
    assert(to!{[c32]} (12.8, prec-> 1u32) == "12.8"s32);
    assert(to!{[c8]} (12.8f, prec-> 1u32) == "12.8");
    assert(to!{[c8]} (0.125, prec-> 4u32) == "0.1250");

    assert(to!{[c8]} (3.5, prec-> 1u32).len == 3us, "YMI-186: the null char must not be part of the slice");
}

/**
 * Same, in scientific notation
 * */
__test floatToStringExp {
    assert(to!{[c8], "e"} (314.0, prec-> 3u32) == "3.140e+02", "YMI-186: expected no trailing null char");
    assert(to!{[c8], "e"} (81792.983, prec-> 1u32) == "8.2e+04");
    assert(to!{[c32], "e"} (12.9834982f, prec-> 4u32) == "1.2983e+01"s32);

    assert(to!{[c8], "e"} (1.0, prec-> 2u32).len == 8us, "YMI-186: the null char must not be part of the slice");
}

/**
 * The slice keeps growing in place once the null char has been dropped from its length
 * */
__test floatToStringAppend {
    let str = to!{[c8]} (3.5, prec-> 1u32) ~ "!";

    assert(str == "3.5!", "YMI-186: expected the append to land after the digits");
}

/**
 * std::conv::utf -- the concrete encoders/decoders behind the 'to' conversions above
 * */

__test utf8CodePointSize { // the length of a utf8 code point is read off its lead byte
    assert(utf::getUtf8CodePointSize(opaque('a')) == 1u32, "a");
    assert(utf::getUtf8CodePointSize(opaque(cast!c8(0xc3u8))) == 2u32, "b");
    assert(utf::getUtf8CodePointSize(opaque(cast!c8(0xe2u8))) == 3u32, "c");
    assert(utf::getUtf8CodePointSize(opaque(cast!c8(0xf0u8))) == 4u32, "d");

    // a continuation byte is not a lead byte, and is reported as the widest form
    assert(utf::getUtf8CodePointSize(opaque(cast!c8(0x80u8))) == 4u32, "e");
}

__test utf32ToUtf8Bytes { // a utf32 code point is written as one to four utf8 bytes
    let dmut ret = ['\u{0}' ; 4];

    assert(utf::toUtf8(opaque('a'c32), ref ret) == 1u32, "a");
    assert(ret[0] == 'a', "b");

    assert(utf::toUtf8(opaque('é'c32), ref ret) == 2u32, "c");
    assert(utf::toUtf8(opaque('コ'c32), ref ret) == 3u32, "d");
    assert(utf::toUtf8(opaque('😉'c32), ref ret) == 4u32, "e");

    // beyond the last legal code point, the replacement character is written instead
    assert(utf::toUtf8(opaque(cast!c32(0x110000u32)), ref ret) == 3u32, "f");
}

__test loneUtf16Surrogate { // a lone utf16 surrogate is not a code point of its own
    let dmut ret = ['\u{0}' ; 4];

    assert(utf::toUtf8(opaque('a'c16), ref ret) == 1u32, "a");
    assert(utf::toUtf8(opaque('コ'c16), ref ret) == 3u32, "b");

    // 0xD83D is the high half of a surrogate pair: alone it decodes to the replacement character
    assert(utf::toUtf8(opaque(cast!c16(0xD83Du16)), ref ret) == 3u32, "c");
    assert(ret[0 .. 3] == "\u{0xFFFD}", "d");
}

__test utf16SurrogatePair { // a utf16 surrogate pair decodes together, consuming both halves
    let dmut ret = ['\u{0}' ; 4];

    // a non-surrogate lead consumes one char only, whatever follows it
    let (read, written) = utf::toUtf8((opaque('a'c16), opaque('b'c16)), ref ret);
    assert(read == 1u32 && written == 1u32, "a");

    // U+1F609 is encoded as D83D DE09 in utf16, and as four bytes in utf8
    let (read2, written2) = utf::toUtf8((opaque(cast!c16(0xD83Du16)), opaque(cast!c16(0xDE09u16))), ref ret);
    assert(read2 == 2u32 && written2 == 4u32, "b");
    assert(ret[0 .. 4] == "😉", "c");
}

__test utfDecodeEncode { // decoding a utf32/utf16 string down to utf8, and encoding it back
    assert(utf::decode("héllo 😉"s32) == "héllo 😉", "a");
    assert(utf::decode("héllo"s16) == "héllo", "b");
    assert(utf::decode(""s32) == "", "c");
    assert(utf::decode(""s16) == "", "d");

    assert(utf::encode!{c32} ("héllo 😉") == "héllo 😉"s32, "e");
    assert(utf::encode!{c16} ("héllo") == "héllo"s16, "f");

    // a code point outside the BMP needs a surrogate pair in utf16, and survives the round trip
    assert(utf::decode(utf::encode!{c16} ("😉")) == "😉", "g");
    assert(utf::decode(utf::encode!{c32} ("😉")) == "😉", "h");
}

/**
 * Integer conversions, over every integer type: a matrix of boundary values rendered in every
 * base and parsed back, and of malformed literals that have to be rejected
 * */

/**
 * @returns: the boundary values of `T`: its bounds, the values around zero, and the values around
 *           every power of two it can hold
 * */
fn boundaries {T} ()-> [T] {
    let one = cast!T(1);
    let dmut res: [T] = copy [T::min, T::min + one, cast!T(0), one, T::max - one, T::max];

    let signed = isSigned!{T};
    cte if (isSigned!{T}) {
        res ~= [-one];
    }

    let bits = T::size * 8us - (if (signed) { 1us } else { 0us });
    for k in 1us .. bits {
        let p = one << cast!T(k);
        res ~= [p - one, p];
        if (k + 1us < bits) {
            res ~= [p + one];
        }

        cte if (isSigned!{T}) {
            res ~= [-p + one, -p, -p - one];
        }
    }

    alias res
}

/**
 * @returns: `lit` with its magnitude incremented by one in base `base`, its sign and prefix untouched
 * */
fn increment(lit: [c8], base: usize)-> dmut [c8] {
    let dmut res = copy lit;
    let top = if (base <= 10us) { cast!c8(cast!u8('0') + cast!u8(base - 1us)) } else { cast!c8(cast!u8('a') + cast!u8(base - 11us)) };

    let mut i = res.len;
    while i > 0us {
        let c = res[i - 1us];
        let isDigit = (c >= '0' && c <= '9' && cast!usize(cast!u8(c) - cast!u8('0')) < base)
            || (c >= 'a' && c <= 'z' && cast!usize(cast!u8(c) - cast!u8('a')) + 10us < base);

        if (!isDigit) { break; }
        if (c != top) {
            res[i - 1us] = if (c == '9') { 'a' } else { cast!c8(cast!u8(c) + 1u8) };
            return alias res;
        }

        res[i - 1us] = '0';
        i -= 1us;
    }

    res[0us .. i] ~ "1" ~ res[i .. $]
}

/**
 * Render `v` in every base and form, and assert each rendering parses back to `v`
 * */
fn roundTrip {T} (v: T)
    throws CastFailure, AssertError
{
    let dec = v.to![c8] ();
    assert(dec.to!{T} () == v, "base 10: " ~ dec);
    assert(v.to![c32] ().to!{T} () == v, "base 10, c32: " ~ dec);
    assert(v.to![c16] ().to!{T} () == v, "base 10, c16: " ~ dec);

    assert(v.to!{[c8], 2us} ().to!{T, 2us} () == v, "base 2: " ~ dec);
    assert(v.to!{[c8], 8us} ().to!{T, 8us} () == v, "base 8: " ~ dec);
    assert(v.to!{[c8], 10us} ().to!{T, 10us} () == v, "base 10: " ~ dec);
    assert(v.to!{[c8], 16us} ().to!{T, 16us} () == v, "base 16: " ~ dec);
    assert(v.to!{[c8], 16us} (upper-> true).to!{T, 16us} () == v, "base 16, upper: " ~ dec);
    assert(v.to!{[c8], 36us} ().to!{T, 36us} () == v, "base 36: " ~ dec);
    assert(v.to!{[c8], 36us} (upper-> true).to!{T, 36us} () == v, "base 36, upper: " ~ dec);

    assert(v.to!{[c8], "b"} ().to!{T, "b"} () == v, "binary: " ~ dec);
    assert(v.to!{[c8], "o"} ().to!{T, "o"} () == v, "octal: " ~ dec);
    assert(v.to!{[c8], "x"} ().to!{T, "x"} () == v, "hexadecimal: " ~ dec);
    assert(v.to!{[c8], "x"} (upper-> true).to!{T, "x"} () == v, "hexadecimal, upper: " ~ dec);
    assert(v.to!{[c32], "x"} ().to!{T, "x"} () == v, "hexadecimal, c32: " ~ dec);
}

fn rejects {T} (lit: [c8])-> bool {
    { let _ = lit.to!{T} (); } catch { _: &CastFailure => { return true; } }
    false
}

fn rejects {T, base: N, N} (lit: [c8])-> bool {
    { let _ = lit.to!{T, base} (); } catch { _: &CastFailure => { return true; } }
    false
}

fn rejectsBin {T} (lit: [c8])-> bool {
    { let _ = lit.to!{T, "b"} (); } catch { _: &CastFailure => { return true; } }
    false
}

fn rejectsOct {T} (lit: [c8])-> bool {
    { let _ = lit.to!{T, "o"} (); } catch { _: &CastFailure => { return true; } }
    false
}

fn rejectsHex {T} (lit: [c8])-> bool {
    { let _ = lit.to!{T, "x"} (); } catch { _: &CastFailure => { return true; } }
    false
}

/**
 * Assert every malformed literal, and every literal just out of the range of `T`, is rejected
 * */
fn rejection {T} ()
    throws AssertError
{
    for lit in ["", "-", "+", "+1", "--1", " 12", "12 ", "1_2", "1.0", "0x10", "12a"] {
        assert(rejects!{T} (lit), "base 10: '" ~ lit ~ "'");
    }

    assert(rejects!{T, 2us} ("2") && rejects!{T, 2us} ("") && rejects!{T, 2us} ("-"), "base 2");
    assert(rejects!{T, 8us} ("8") && rejects!{T, 8us} ("78"), "base 8");
    assert(rejects!{T, 10us} ("a"), "base 10");
    assert(rejects!{T, 16us} ("g") && rejects!{T, 16us} ("G") && rejects!{T, 16us} ("0x1"), "base 16");
    assert(rejects!{T, 36us} ("_") && rejects!{T, 36us} ("-") && rejects!{T, 36us} ("é"), "base 36");

    for lit in ["", "0", "0b", "b1", "0B1", "0b2", "0b 1", "00b1", "0b-1"] {
        assert(rejectsBin!{T} (lit), "binary: '" ~ lit ~ "'");
    }

    for lit in ["", "0", "0o", "o7", "0O7", "0o8", "0o-7"] {
        assert(rejectsOct!{T} (lit), "octal: '" ~ lit ~ "'");
    }

    for lit in ["", "ff", "0", "0x", "x10", "0X10", "0xg", "0x-1", "-0x", "0x1 "] {
        assert(rejectsHex!{T} (lit), "hexadecimal: '" ~ lit ~ "'");
    }

    let max = T::max;
    assert(rejects!{T} (increment(max.to![c8] (), 10us)), "one past max, base 10");
    assert(rejects!{T, 2us} (increment(max.to!{[c8], 2us} (), 2us)), "one past max, base 2");
    assert(rejects!{T, 8us} (increment(max.to!{[c8], 8us} (), 8us)), "one past max, base 8");
    assert(rejects!{T, 16us} (increment(max.to!{[c8], 16us} (), 16us)), "one past max, base 16");
    assert(rejects!{T, 36us} (increment(max.to!{[c8], 36us} (), 36us)), "one past max, base 36");
    assert(rejectsBin!{T} (increment(max.to!{[c8], "b"} (), 2us)), "one past max, binary");
    assert(rejectsOct!{T} (increment(max.to!{[c8], "o"} (), 8us)), "one past max, octal");
    assert(rejectsHex!{T} (increment(max.to!{[c8], "x"} (), 16us)), "one past max, hexadecimal");

    let min = T::min;
    cte if (isSigned!{T}) {
        assert(rejects!{T} (increment(min.to![c8] (), 10us)), "one past min, base 10");
        assert(rejects!{T, 2us} (increment(min.to!{[c8], 2us} (), 2us)), "one past min, base 2");
        assert(rejects!{T, 36us} (increment(min.to!{[c8], 36us} (), 36us)), "one past min, base 36");
        assert(rejectsBin!{T} (increment(min.to!{[c8], "b"} (), 2us)), "one past min, binary");
        assert(rejectsOct!{T} (increment(min.to!{[c8], "o"} (), 8us)), "one past min, octal");
        assert(rejectsHex!{T} (increment(min.to!{[c8], "x"} (), 16us)), "one past min, hexadecimal");
    } else {
        min;
        assert(rejects!{T} ("-1") && rejects!{T} ("-0"), "negative unsigned");
        assert(rejectsHex!{T} ("-0x1") && rejectsBin!{T} ("-0b1") && rejectsOct!{T} ("-0o1"), "negative unsigned, prefixed");
    }
}

fn matrix {T} ()
    throws CastFailure, AssertError
{
    for v in boundaries!{T} () {
        roundTrip!{T} (v);
    }

    rejection!{T} ();
}

__test incrementHelper { // the literal incremented by the test helper, so a broken helper does not hide a broken rejection
    assert(increment("127", 10us) == "128", "a");
    assert(increment("-128", 10us) == "-129", "b");
    assert(increment("0xff", 16us) == "0x100", "c");
    assert(increment("0b111", 2us) == "0b1000", "d");
    assert(increment("-0o177", 8us) == "-0o200", "e");
    assert(increment("3w5e11264sgsf", 36us) == "3w5e11264sgsg", "f");
    assert(increment("19", 36us) == "1a", "g");
    assert(increment("zz", 36us) == "100", "h");
}

__test matrixI8 { matrix!{i8} (); }
__test matrixI16 { matrix!{i16} (); }
__test matrixI32 { matrix!{i32} (); }
__test matrixI64 { matrix!{i64} (); }
__test matrixIsize { matrix!{isize} (); }
__test matrixU8 { matrix!{u8} (); }
__test matrixU16 { matrix!{u16} (); }
__test matrixU32 { matrix!{u32} (); }
__test matrixU64 { matrix!{u64} (); }
__test matrixUsize { matrix!{usize} (); }

__test hexCase { // hexadecimal digits are read in either case, and written in the case asked for
    assert(("0xff").to!{u32, "x"} () == 255u32, "a");
    assert(("0xFF").to!{u32, "x"} () == 255u32, "b");
    assert(("0xfF").to!{u32, "x"} () == 255u32, "c");
    assert(("-0xAbC").to!{i32, "x"} () == -2748, "d");
    assert(("Z").to!{u8, 36us} () == 35u8 && ("z").to!{u8, 36us} () == 35u8, "e");

    assert((255u8).to!{[c8], "x"} () == "0xff", "f");
    assert((255u8).to!{[c8], "x"} (upper-> true) == "0xFF", "g");
    assert((-2748).to!{[c8], "x"} (upper-> true) == "-0xABC", "h");
    assert((35u32).to!{[c8], 36us} () == "z" && (35u32).to!{[c8], 36us} (upper-> true) == "Z", "i");
    assert((u64::max).to!{[c32], 16us} (upper-> true) == "FFFFFFFFFFFFFFFF"s32, "j");
}

__test signedPrefixedForms { // the prefixed forms of a signed int carry the sign in front of the prefix
    assert(("-0x80").to!{i8, "x"} () == i8::min, "a");
    assert(("0x7f").to!{i8, "x"} () == i8::max, "b");
    assert(("-0b101"s32).to!{i32, "b"} () == -5, "c");
    assert(("-0o17"s16).to!{i64, "o"} () == -15i64, "d");
    assert(("-0").to!i32 () == 0 && ("-0x0").to!{i32, "x"} () == 0, "e");
}

/**
 * Utf round trips, over code points of every encoded width
 * */

/**
 * @returns: the code points at both ends of every utf8 width, and of every utf16 width
 * */
fn codePoints ()-> [c32] {
    let dmut res: [c32] = [];
    for cp in [0x1u32, 0x41u32, 0x7Fu32, 0x80u32, 0xE9u32, 0x7FFu32, 0x800u32, 0x30B3u32, 0xD7FFu32, 0xE000u32, 0xFFFDu32, 0xFFFFu32, 0x10000u32, 0x1F609u32, 0x10FFFFu32] {
        res ~= [cast!c32(cp)];
    }

    alias res
}

__test utfRoundTrips { // every code point survives every conversion, with the expected width in each encoding
    let widths8 = [1us, 1us, 1us, 2us, 2us, 2us, 3us, 3us, 3us, 3us, 3us, 3us, 4us, 4us, 4us];
    let widths16 = [1us, 1us, 1us, 1us, 1us, 1us, 1us, 1us, 1us, 1us, 1us, 1us, 2us, 2us, 2us];

    let points = codePoints();
    for i, cp in points {
        let s32 = copy [cp];
        let s8 = s32.to![c8] ();
        let s16 = s32.to![c16] ();
        let msg = "U+" ~ cast!u32(cp).to!{[c8], 16us} ();

        assert(s8.len == widths8[i], "utf8 width of " ~ msg);
        assert(s16.len == widths16[i], "utf16 width of " ~ msg);

        assert(s8.to![c32] () == s32, "c8 -> c32 of " ~ msg);
        assert(s8.to![c16] () == s16, "c8 -> c16 of " ~ msg);
        assert(s16.to![c8] () == s8, "c16 -> c8 of " ~ msg);
        assert(s16.to![c32] () == s32, "c16 -> c32 of " ~ msg);
    }

    let all32 = copy points;
    let all8 = all32.to![c8] ();
    assert(all8.len == 39us, "a");
    assert(all8.to![c16] ().to![c32] () == all32, "b");
    assert(all32.to![c16] ().to![c8] () == all8, "c");
}

/**
 * @returns: a string made of the code units `units`, built at runtime
 * */
fn units {C} (u: [u32])-> [C] {
    let dmut res: [C] = [];
    for x in u {
        cte if (C::size == 1us) {
            res ~= [cast!C(cast!u8(x))];
        } else cte if (C::size == 2us) {
            res ~= [cast!C(cast!u16(x))];
        } else {
            res ~= [cast!C(x)];
        }
    }

    alias res
}

__test unpairedUtf16Surrogates { // an unpaired utf16 surrogate decodes to U+FFFD, and never swallows the char after it
    let rep = "\u{0xFFFD}";

    assert(units!c16 (copy [0xD83Du32]).to![c8] () == rep, "a");
    assert(units!c16 (copy [0xDE09u32]).to![c8] () == rep, "b");
    assert(units!c16 (copy [0xD83Du32, 0x61u32]).to![c8] () == rep ~ "a", "c");
    assert(units!c16 (copy [0xDE09u32, 0x61u32]).to![c8] () == rep ~ "a", "d");
    assert(units!c16 (copy [0x61u32, 0xD83Du32]).to![c8] () == "a" ~ rep, "e");
    assert(units!c16 (copy [0xDE09u32, 0xD83Du32]).to![c8] () == rep ~ rep, "f");
    assert(units!c16 (copy [0xD83Du32, 0xD83Du32, 0xDE09u32]).to![c8] () == rep ~ "😉", "g");

    assert(units!c16 (copy [0xD83Du32, 0x61u32]).to![c32] () == units!c32 (copy [0xFFFDu32, 0x61u32]), "h");
    assert(units!c32 (copy [0xD800u32, 0x61u32]).to![c8] () == rep ~ "a", "i");
}

__test invalidUtf8Sequences { // an invalid or truncated utf8 sequence decodes to U+FFFD, one per byte that cannot start a code point
    let rep = units!c32 (copy [0xFFFDu32]);
    let a = units!c32 (copy [0x61u32]);

    assert(units!c8 (copy [0xC3u32]).to![c32] () == rep, "a");
    assert(units!c8 (copy [0xE2u32, 0x82u32]).to![c32] () == rep ~ rep, "b");
    assert(units!c8 (copy [0xF0u32, 0x9Fu32, 0x98u32]).to![c32] () == rep ~ rep ~ rep, "c");
    assert(units!c8 (copy [0xC3u32, 0x61u32]).to![c32] () == rep ~ a, "d");
    assert(units!c8 (copy [0x80u32, 0x61u32]).to![c32] () == rep ~ a, "e");
    assert(units!c8 (copy [0xFFu32, 0x61u32]).to![c32] () == rep ~ a, "f");
    assert(units!c8 (copy [0x61u32, 0xE2u32]).to![c32] () == a ~ rep, "g");

    assert(units!c8 (copy [0xC3u32]).to![c16] () == units!c16 (copy [0xFFFDu32]), "h");
    assert(units!c8 (copy [0xF0u32, 0x9Fu32, 0x61u32]).to![c16] () == units!c16 (copy [0xFFFDu32, 0xFFFDu32, 0x61u32]), "i");
}

/**
 * Float conversions
 * */

fn rejectsFloat {F} (lit: [c8])-> bool {
    { let _ = lit.to!{F} (); } catch { _: &CastFailure => { return true; } }
    false
}

__test floatSpecialValues { // special values are parsed, and a failed parse does not leak into the next one
    assert(("inf").to!f64 () == f64::inf, "a");
    assert(("-inf").to!f64 () == -f64::inf, "b");
    assert(("nan").to!f64 ().to![c8] () == "nan", "c");
    assert(("inf"s32).to!f32 () == f32::inf, "d");

    assert(rejectsFloat!f64 ("1e400"), "e");
    assert(("1.5").to!f64 () == 1.5, "f");
    assert(rejectsFloat!f32 ("1e40"), "g");
    assert(("1e40").to!f64 ().to!{[c8], "e"} (prec-> 0u32) == "1e+40", "h");
}

__test malformedFloatLiterals { // malformed literals are rejected
    for lit in ["", "1.2.3", " 1.5", "1.5 ", "1,5", "-", ".", "e3", "1e", "abc", "1.5f"] {
        assert(rejectsFloat!f64 (lit), "f64: '" ~ lit ~ "'");
        assert(rejectsFloat!f32 (lit), "f32: '" ~ lit ~ "'");
        assert(rejectsFloat!f80 (lit), "f80: '" ~ lit ~ "'");
    }
}

__test floatLiteralSlices { // a literal is read up to the end of its slice, not up to the next null char
    let s = copy "12.5e3";

    assert(s[0us .. 2us].to!f64 () == 12.0, "a");
    assert(s[0us .. 4us].to!f32 () == 12.5f, "b");
    assert(s[0us .. $].to!f64 () == 12500.0, "c");

    let long = copy ['1' ; 80us] ~ ".5";
    assert(long.to!f64 ().to!{[c8], "e"} (prec-> 3u32) == "1.111e+79", "d");
}

__test f80Precision { // f80 is parsed with its own precision, not through a f64
    assert(("0.1").to!f80 ().to![c8] (prec-> 20u32) == "0.10000000000000000000", "a");
    assert(("0.1").to!f64 ().to![c8] (prec-> 20u32) == "0.10000000000000000555", "b");
}

__test floatPrecisionBounds { // rendering at the precision bounds
    assert((2.0).to![c8] (prec-> 0u32) == "2", "a");
    assert((0.4).to![c8] (prec-> 0u32) == "0", "b");
    assert((-3.0).to![c8] (prec-> 0u32) == "-3", "c");
    assert((0.5).to!{[c8], "e"} (prec-> 0u32) == "5e-01", "d");

    let wide = (0.5).to![c8] (prec-> 60u32);
    assert(wide.len == 62us && wide == "0." ~ "5" ~ copy ['0' ; 59us], "e");
    assert((0.1).to![c32] (prec-> 30u32).len == 32us, "f");

    assert(f64::inf.to![c8] () == "inf" && (-f64::inf).to![c8] () == "-inf", "g");
    assert(f64::nan.to![c8] ().len == 3us, "h");
}
