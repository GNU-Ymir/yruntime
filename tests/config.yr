in config;

mod args;

use std::{io, config::_};
use std::config::json;
use std::config::toml;
use std::conv::errors;
use std::syntax::errors;

class A {
    pub let x: u32;

    pub self (cfg: &Config)
        with x = cfg["foo"].to!{u32} ()
        throws CastFailure, ConfigError
    {
        cfg;
    }

    pub self ()
        with x = 10
    {}
}

__test printDict {

    let dmut a = copy Dict();
    a["foo"] = copy Int(12);

    println(a);
}

__test arrayToClasses {
    let dmut z = copy Array();
    let dmut m = copy Dict();

    m["foo"] = copy Int(89);
    z:.push(m);

    let result = z.to!{[&A]} ();
    assert(result.len == 1 && result[0].x == 89);
}

__test jsonEscapeRoundTrip {
    // Strings containing '"', '\', or control chars must be escaped on dump, and correctly
    // recovered on parse, e.g. function names like `opBinary!{"^^"s8}` do produce quotes.
    let dmut d = copy Dict();
    d["func"] = copy Str("opBinary!{\"^^\"s8}::opBinary");
    d["other"] = copy Str("a\\b\nc\td\"e");

    let dumped = json::dump(d);
    let parsed = json::parse(dumped);

    if let Ok(Str(value-> v)) = parsed["func"]? {
        assert(v == "opBinary!{\"^^\"s8}::opBinary");
    } else assert(false);

    if let Ok(Str(value-> v)) = parsed["other"]? {
        assert(v == "a\\b\nc\td\"e");
    } else assert(false);
}

__test tomlEscapeRoundTrip {
    // Same as above, for the toml dumper/parser.
    let dmut d = copy Dict();
    d["func"] = copy Str("opBinary!{\"^^\"s8}::opBinary");
    d["other"] = copy Str("a\\b\nc\td\"e");

    let dumped = toml::dump(d);
    let parsed = toml::parse(dumped);

    if let Ok(Str(value-> v)) = parsed["func"]? {
        assert(v == "opBinary!{\"^^\"s8}::opBinary");
    } else assert(false);

    if let Ok(Str(value-> v)) = parsed["other"]? {
        assert(v == "a\\b\nc\td\"e");
    } else assert(false);
}


__test controlCharsEscapeRoundTrip {
    let raw = "a\u{1}b\u{0x1F}c" ~ [cast!c8(0x7Fu8)] ~ "d\u{0}e\bf\fg\u{0xe9}h";
    let dmut d = copy Dict();
    d["s"] = copy Str(raw);

    let dumpedJson = json::dump(d);
    assert(dumpedJson == "{\n   \"s\" : \"a\\u0001b\\u001Fc\\u007Fd\\u0000e\\bf\\fg\u{0xe9}h\"\n}");
    let parsedJson = json::parse(dumpedJson);
    if let Ok(Str(value-> v)) = parsedJson["s"]? {
        assert(v == raw);
    } else assert(false);

    let dumpedToml = toml::dump(d);
    assert(dumpedToml == "s = \"a\\u0001b\\u001Fc\\u007Fd\\u0000e\\bf\\fg\u{0xe9}h\"\n");
    let parsedToml = toml::parse(dumpedToml);
    if let Ok(Str(value-> v)) = parsedToml["s"]? {
        assert(v == raw);
    } else assert(false);
}

__test jsonStandardUnicodeEscapes {
    let parsed = json::parse("{\"a\": \"\\u00e9\\u00C9\", \"b\": \"\\uD83C\\uDFB5\", \"c\": \"\\u{0x1F3B5}\", \"d\": \"\\uD83Cx\"}");
    if let Ok(Str(value-> v)) = parsed["a"]? { assert(v == "\u{0xe9}\u{0xc9}"); } else assert(false);
    if let Ok(Str(value-> v)) = parsed["b"]? { assert(v == "\u{0x1F3B5}"); } else assert(false);
    if let Ok(Str(value-> v)) = parsed["c"]? { assert(v == "\u{0x1F3B5}"); } else assert(false);
    if let Ok(Str(value-> v)) = parsed["d"]? { assert(v == "\u{0xFFFD}x"); } else assert(false);

    for bad in ["{\"a\": \"\\u00\"}", "{\"a\": \"\\u00g0\"}", "{\"a\": \"\\u12"] {
        let failed = {
            let _ = json::parse(bad);
            false
        } catch {
            _: &SyntaxError => true
        };
        assert(failed);
    }
}

__test tomlStandardUnicodeEscapes {
    let parsed = toml::parse("a = \"\\u00e9\\u00C9\"\nb = \"\\U0001F3B5\"\nc = \"\\u{0x1F3B5}\"\n");
    if let Ok(Str(value-> v)) = parsed["a"]? { assert(v == "\u{0xe9}\u{0xc9}"); } else assert(false);
    if let Ok(Str(value-> v)) = parsed["b"]? { assert(v == "\u{0x1F3B5}"); } else assert(false);
    if let Ok(Str(value-> v)) = parsed["c"]? { assert(v == "\u{0x1F3B5}"); } else assert(false);

    for bad in ["a = \"\\u00\"\n", "a = \"\\U0001F3G5\"\n", "a = \"\\u12"] {
        let failed = {
            let _ = toml::parse(bad);
            false
        } catch {
            _: &SyntaxError => true
        };
        assert(failed);
    }
}

__test tomlQuotedKeys {
    // toml keys that are not valid bare keys are dumped quoted, and round trip
    let dmut inl = copy Dict();
    inl["a b"] = copy Int(1);

    let dmut arr = copy Array();
    arr:.push(copy Int(0));
    arr:.push(inl);

    let dmut tbl = copy Dict();
    tbl["x:y"] = copy Int(2);

    let dmut elem = copy Dict();
    elem["q\"k"] = copy Int(3);
    let dmut tables = copy Array();
    tables:.push(elem);

    let dmut d = copy Dict();
    d["a.b"] = copy Int(4);
    d["42"] = copy Int(5);
    d[""] = copy Int(6);
    d["bare_key-1"] = copy Int(7);
    d["mixed"] = arr;
    d["my table"] = tbl;
    d["pkg.list"] = tables;

    let dumped = toml::dump(d);
    assert(dumped == "\"\" = 6\n\"42\" = 5\n\"a.b\" = 4\nbare_key-1 = 7\nmixed = [0, {\"a b\" = 1}]\n\n[\"my table\"]\n\"x:y\" = 2\n\n[[\"pkg.list\"]]\n\"q\\\"k\" = 3\n");

    let parsed = toml::parse(dumped);
    {
        assert(parsed["a.b"] == 4);
        assert(parsed["42"] == 5);
        assert(parsed[""] == 6);
        assert(parsed["bare_key-1"] == 7);
        assert(parsed["mixed"][1u32]["a b"] == 1);
        assert(parsed["my table"]["x:y"] == 2);
        if let a: &Array = parsed["pkg.list"] {
            assert(a.len == 1us);
            assert(a[0u32]["q\"k"] == 3);
        } else assert(false);
    } catch {
        _ => assert(false);
    }

    assert(toml::dump(parsed) == dumped);
}

__test tomlHeaderPath {
    // a header path mixes bare and quoted parts, single quoted ones included
    let parsed = toml::parse("[a.'b.c'.\"d e\"]\nk = 1\n");
    {
        assert(parsed["a"]["b.c"]["d e"]["k"] == 1);
    } catch {
        _ => assert(false);
    }

    for bad in ["[]\nk = 1\n"s8, "[a.]\nk = 1\n", "[.a]\nk = 1\n", "[a..b]\nk = 1\n", "[a \"b\"]\nk = 1\n"] {
        let failed = {
            let _ = toml::parse(bad);
            false
        } catch {
            _: &SyntaxError => true
        };

        assert(failed);
    }
}

__test jsonMacroMutable {
    // json returns deeply mutable values
    let dmut d = json#{"foo": true};
    d["bar"] = copy Bool(false);
    if let Ok(Bool(value-> b)) = d["foo"]? {
        assert(b);
    } else {
        assert(false);
    }

    if let Ok(Bool(value-> b)) = d["bar"]? {
        assert(!b);
    } else {
        assert(false);
    }
}

/**
 * @returns: the number of times `sub` appears in `s`
 * */
fn countSub(s: [c8], sub: [c8])-> usize {
    let mut res = 0us;
    if (sub.len == 0us || s.len < sub.len) return res;

    for i in 0us .. (s.len - sub.len + 1us) {
        if (s[i .. i + sub.len] == sub) { res += 1us; }
    }

    res
}

__test tomlArrayOfTables {
    // toml array of tables: '[[x]]' declares a new element of the array stored at 'x'
    let parsed = toml::parse("[[x]]\na = 1\n[[x]]\na = 2\n");

    {
        if let a: &Array = parsed["x"] {
            assert(a.len == 2us);
            assert(a[0u32]["a"] == 1);
            assert(a[1u32]["a"] == 2);
        } else assert(false);
    } catch {
        _ => assert(false);
    }
}

__test tomlDumpArrayOfTables {
    // an array of dicts is dumped as repeated '[[x]]' headers, not as an inline array
    let dmut arr = copy Array();
    let dmut e0 = copy Dict();
    e0["name"] = copy Str("foo");
    e0["v"] = copy Int(1);

    let dmut e1 = copy Dict();
    e1["name"] = copy Str("bar");
    e1["v"] = copy Int(2);

    arr:.push(e0);
    arr:.push(e1);

    let dmut d = copy Dict();
    d["package"] = arr;

    let dumped = toml::dump(d);
    assert(countSub(dumped, "[[package]]") == 2us);

    let parsed = toml::parse(dumped);
    {
        if let a: &Array = parsed["package"] {
            assert(a.len == 2us);
            assert(a[0u32]["name"] == "foo");
            assert(a[0u32]["v"] == 1);
            assert(a[1u32]["name"] == "bar");
            assert(a[1u32]["v"] == 2);
        } else assert(false);
    } catch {
        _ => assert(false);
    }
}

__test tomlDottedArrayOfTables {
    // dotted path arrays of tables, under a global table that also holds plain values
    let content = "[deps]\nstrict = true\n\n[[deps.pkg]]\nname = \"a\"\n\n[[deps.pkg]]\nname = \"b\"\n";
    let parsed = toml::parse(content);

    {
        assert(parsed["deps"]["strict"] == true);
        if let a: &Array = parsed["deps"]["pkg"] {
            assert(a.len == 2us);
            assert(a[0u32]["name"] == "a");
            assert(a[1u32]["name"] == "b");
        } else assert(false);
    } catch {
        _ => assert(false);
    }

    // and it round trips through the dumper
    let dumped = toml::dump(parsed);
    assert(countSub(dumped, "[[deps.pkg]]") == 2us);

    let reparsed = toml::parse(dumped);
    {
        assert(reparsed["deps"]["strict"] == true);
        if let a: &Array = reparsed["deps"]["pkg"] {
            assert(a.len == 2us);
            assert(a[0u32]["name"] == "a");
            assert(a[1u32]["name"] == "b");
        } else assert(false);
    } catch {
        _ => assert(false);
    }
}

__test tomlSubTableOfArray {
    // a sub table of an array of tables applies to the last element read, and round trips
    let content = "[[srv]]\nport = 80\n\n[srv.tls]\nenabled = false\n\n[[srv]]\nport = 443\n\n[srv.tls]\nenabled = true\n";
    let parsed = toml::parse(content);
    let reparsed = toml::parse(toml::dump(parsed));

    {
        for cfg in [parsed, reparsed] {
            if let a: &Array = cfg["srv"] {
                assert(a.len == 2us);
                assert(a[0u32]["port"] == 80);
                assert(a[0u32]["tls"]["enabled"] == false);
                assert(a[1u32]["port"] == 443);
                assert(a[1u32]["tls"]["enabled"] == true);
            } else assert(false);
        }
    } catch {
        _ => assert(false);
    }
}

__test tomlInlineArrays {
    // an empty array, or an array that is not made only of dicts, stays an inline array
    let dmut mixed = copy Array();
    mixed:.push(copy Int(1));
    mixed:.push(copy Dict());

    let dmut d = copy Dict();
    d["empty"] = copy Array();
    d["mixed"] = mixed;

    let dumped = toml::dump(d);
    assert(countSub(dumped, "[[") == 0us);

    let parsed = toml::parse(dumped);
    {
        if let a: &Array = parsed["empty"] { assert(a.len == 0us); } else assert(false);
        if let a: &Array = parsed["mixed"] { assert(a.len == 2us); } else assert(false);
    } catch {
        _ => assert(false);
    }
}

__test sortedKeys {
    // keys are dumped sorted, whatever the insertion order, for both toml and json
    let dmut d = copy Dict();
    d["version"] = copy Int(1);
    d["name"] = copy Str("foo");
    d["about"] = copy Str("bar");

    assert(toml::dump(d) == "about = \"bar\"\nname = \"foo\"\nversion = 1\n");
    assert(json::dump(d) == "{\n   \"about\" : \"bar\",\n   \"name\" : \"foo\",\n   \"version\" : 1\n}");

    // and the same configuration always dumps to the same text
    assert(toml::dump(d) == toml::dump(toml::parse(toml::dump(d))));
    assert(json::dump(d) == json::dump(json::parse(json::dump(d))));
}

__test stableKeyOrder {
    // adding a key never reorders the keys already dumped, whatever the hash map does under it
    let names = ["a"s8, "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"];
    let dmut d = copy Dict();
    let mut previous: [c8] = "";

    for i in 0us .. names.len {
        d[names[i]] = copy Int(cast!i64(i));
        let dumped = toml::dump(d);

        // every line of the previous dump is still there, in the same order
        assert(dumped[0us .. previous.len] == previous);
        previous = dumped;
    }
}

__test tomlInlineDict {
    // an inline dict separates its entries, and thus round trips(the keys being sorted)
    let dmut inl = copy Dict();
    inl["b"] = copy Int(2);
    inl["a"] = copy Int(1);

    let dmut arr = copy Array();
    arr:.push(copy Int(0));
    arr:.push(inl); // not a table array, so it stays inline

    let dmut d = copy Dict();
    d["mixed"] = arr;

    assert(toml::dump(d) == "mixed = [0, {a = 1, b = 2}]\n");

    let parsed = toml::parse(toml::dump(d));
    {
        if let a: &Array = parsed["mixed"] {
            assert(a.len == 2us);
            assert(a[0u32] == 0);
            assert(a[1u32]["a"] == 1);
            assert(a[1u32]["b"] == 2);
        } else assert(false);
    } catch {
        _ => assert(false);
    }
}

__test arrayToTuple {
    // a config array converts to a tuple of the types of its elements
    let dmut a = copy Array();
    a:.push(copy Int(1));
    a:.push(copy Str("test"));

    assert(a.to!{(i32, [c8])} () == (1, "test"));
}

__test dictToMap {
    // a config dict converts to a map, either of a scalar type
    let dmut d = copy Dict();
    d["foo"] = copy Int(1);
    d["bar"] = copy Int(2);

    let m = d.to!{[[c8] => i32]} ();
    assert(m["foo"] == (1)? && m["bar"] == (2)?);

    // or of &Config, when the values are not all of the same type
    let dmut mixed = copy Dict();
    mixed["foo"] = copy Int(12);
    mixed["bar"] = copy Str("test");

    let partial = mixed.to!{[[c8] => &Config]} ();
    assert(partial.len == 2us);
    if let Ok(v) = partial["foo"] {
        assert(v of Int);
    } else assert(false);
}

__test getOr {
    // getOr returns the converted value of the key, or the default when it is absent
    let dmut d = copy Dict();
    d["foo"] = copy Str("foo");
    d["bar"] = copy Int(42);

    assert(d.getOr("bar", 56) == 42);
    assert(d.getOr("baz", 56) == 56);

    // and also when the value is of a type that does not convert
    assert(d.getOr("foo", 56) == 56);
}

__test dollarIndex {
    // '$' inside an index of a config array is the length of the array
    let dmut a = copy Array();
    a:.push(copy Int(1));
    a:.push(copy Int(2));

    {
        assert(a[$ - 1u32] == 2);
    } catch {
        _ => assert(false);
    }
}

__test jsonEmptyDict { // MID-64: the 'emptyDict' rule of the json macro was never reachable, so '{}' did not parse
  {
    let dmut nested = json#{"a": {}, "b": {"c": 1}};

    if let Ok(a: &Dict) = nested["a"]? {
        assert(a.len == 0us, "a");
    } else { assert(false, "b"); }

    assert(nested["b"]["c"].to!{i64} () == 1, "c");

    // and inside an array too
    let dmut inArray = json#{"a": [{}, {"c": 1}]};
    if let Ok(fst: &Dict) = inArray["a"][0u32]? {
        assert(fst.len == 0us, "d");
    } else { assert(false, "e"); }

    assert(inArray["a"][1u32]["c"].to!{i64} () == 1, "f");

    // an empty object survives a dump/parse round trip
    assert(json::dump(json::parse(json::dump(nested))) == json::dump(nested), "g");
  } catch {
    err => { println(err); assert(false, "threw"); }
  }
}

__test jsonNull { // MID-56: a null literal parses to a None node, and is dumped back as null
  {
    let parsed = json::parse("{\"a\": null, \"b\": [1, null]}");

    if let Ok(a) = parsed["a"]? {
        assert(a of None, "a");
    } else { assert(false, "b"); }

    if let Ok(b: &Array) = parsed["b"]? {
        assert(b[1u32] of None, "c");
    } else { assert(false, "d"); }

    assert(json::dump(parsed) == "{\n   \"a\" : null,\n   \"b\" : [1, null]\n}", "e");
    assert(json::dump(json::parse(json::dump(parsed))) == json::dump(parsed), "f");
  } catch {
    err => { println(err); assert(false, "threw"); }
  }
}

__test jsonMacroNull { // MID-56: the json macro accepts null as a value
  {
    let dmut d = json#{"a": null, "b": [1, null], "c": {"d": null}, "e": "null"};

    if let Ok(a) = d["a"]? {
        assert(a of None, "a");
    } else { assert(false, "b"); }

    if let Ok(b: &Array) = d["b"]? {
        assert(b[1u32] of None, "c");
    } else { assert(false, "d"); }

    assert(d["c"]["d"] of None, "e");
    assert(d["e"].to!{[c8]} () == "null", "f");
  } catch {
    err => { println(err); assert(false, "threw"); }
  }
}
