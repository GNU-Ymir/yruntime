in args;

use std::io;
use std::config::_;
use std::config::args::errors;
use std::conv::errors;
use std::format;
use std::algorithm::searching;
use helpers;

/**
 * A sub command parser taking a single '--foo' int option
 * */
fn subFoo(args: [[c8]])-> (&Config)? {
    return ((copy ArgumentParser()):.option!{i64} ("foo")).parse(args)?;
}

/**
 * A sub command parser taking nothing at all
 * */
fn subNothing(args: [[c8]])-> (&Config)? {
    return (copy ArgumentParser()).parse(args)?;
}

/**
 * @returns: a parser covering every kind of argument, reused by most of the tests below
 * */
fn fullParser()-> &ArgumentParser {
    (copy ArgumentParser())
        :.option!{i64} ("count", short-> "c", comments-> "how many")
        :.option!{f64} ("ratio", comments-> "a float")
        :.option!{[c8]} ("name", short-> "n", comments-> "a string")
        :.flag("verbose", short-> "v", comments-> "be loud")
        :.help("help", short-> "h", comments-> "print this help")
}

__test longAndShortName { // an option is readable through its long and its short name
    {
        let cfg = fullParser().parse(copy ["./a.out", "--count", "12", "--ratio", "1.5", "-n", "foo"]);
        assert(cfg["count"].to!{i64} () == 12, "a");
        assert(cfg["ratio"].to!{f64} () == 1.5, "b");
        assert(cfg["name"].to!{[c8]} () == "foo", "c");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test flagDefault { // a flag is true when set, and inserted as false when it is not
    {
        assert(fullParser().parse(copy ["./a.out", "-v"])["verbose"].to!{bool} (), "a");
        assert(!fullParser().parse(copy ["./a.out"])["verbose"].to!{bool} (), "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test singleHyphenLongName { // a single-hyphen long name is accepted too
    {
        assert(fullParser().parse(copy ["./a.out", "-count", "3"])["count"].to!{i64} () == 3, "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test positionalOrder { // positional arguments are filled in declaration order
    {
        let parser = (copy ArgumentParser())
            :.position!{i64} ("first", comments-> "an int")
            :.position!{[c8]} ("second", comments-> "a string");

        let cfg = parser.parse(copy ["./a.out", "42", "foo"]);
        assert(cfg["first"].to!{i64} () == 42, "a");
        assert(cfg["second"].to!{[c8]} () == "foo", "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test missingPositional { // a missing positional argument names itself
    let parser = (copy ArgumentParser())
        :.position!{i64} ("first")
        :.position!{i64} ("second");

    {
        parser.parse(copy ["./a.out", "1"]);
        assert(false, "should have thrown");
    } catch {
        m: &MissingArgument => { assert(m.key == "second", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test listOption { // 'list-> true' collects every occurrence of an option into an array
    {
        let parser = (copy ArgumentParser())
            :.option!{[c8]} ("inc", short-> "I", comments-> "include dir", list-> true);

        let cfg = parser.parse(copy ["./a.out", "-I", "a", "--inc", "b", "-I", "c"]);
        assert(cfg["inc"].to!{[[c8]]} () == ["a", "b", "c"], "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test arrayOptionStopsAtOption { // an array option eats every value it can, and stops at the next option
    {
        let parser = (copy ArgumentParser())
            :.option!{[i64]} ("nums", comments-> "some ints")
            :.flag("verbose", short-> "v");

        let cfg = parser.parse(copy ["./a.out", "--nums", "1", "2", "3", "-v"]);
        assert(cfg["nums"].to!{[i64]} () == [1i64, 2i64, 3i64], "a");
        assert(cfg["verbose"].to!{bool} (), "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test listPositional { // a list positional argument takes the rest of the line
    {
        let parser = (copy ArgumentParser())
            :.position!{[i64]} ("list", comments-> "list of int");

        assert(parser.parse(copy ["./a.out", "1", "2", "3"])["list"].to!{[i64]} () == [1i64, 2i64, 3i64], "a");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test duplicateOption { // setting a non-list option twice is an error
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "--count", "1", "--count", "2"]);
        assert(false, "should have thrown");
    } catch {
        d: &DuplicateArgument => { assert(d.key == "count", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test unknownOption { // an option the parser does not know names itself
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "--nope"]);
        assert(false, "should have thrown");
    } catch {
        u: &UnknownArgument => { assert(u.key == "nope", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test unknownBareWord { // so does a bare word when every positional is already filled
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "stray"]);
        assert(false, "should have thrown");
    } catch {
        u: &UnknownArgument => { assert(u.key == "stray", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test missingMandatoryOption { // a mandatory option that never appears is reported as missing
    let parser = (copy ArgumentParser()):.option!{i64} ("count", mandatory-> true);

    {
        parser.parse(copy ["./a.out"]);
        assert(false, "should have thrown");
    } catch {
        m: &MissingArgument => { assert(m.key == "count", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test malformedNumber { // an int value that does not convert, and one that is not there at all
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "--count", "abc"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "count", "a"); }
        err => { println(err); assert(false, "wrong error a"); }
    }

    {
        parser.parse(copy ["./a.out", "--count"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "count", "b"); }
        err => { println(err); assert(false, "wrong error b"); }
    }

    {
        parser.parse(copy ["./a.out", "--ratio", "abc"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "ratio", "c"); }
        err => { println(err); assert(false, "wrong error c"); }
    }
}

__test strOptionRejectsOption { // '--name --verbose' does not read '--verbose' as the value of name
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "--name", "--verbose"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "name", "a"); }
        err => { println(err); assert(false, "wrong error a"); }
    }

    {
        parser.parse(copy ["./a.out", "--name"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "name", "b"); }
        err => { println(err); assert(false, "wrong error b"); }
    }
}

__test malformedArrayOption { // an array option with nothing convertible behind it
    let parser = (copy ArgumentParser()):.option!{[i64]} ("nums");

    {
        parser.parse(copy ["./a.out", "--nums", "abc"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "nums", "a"); }
        err => { println(err); assert(false, "wrong error a"); }
    }

    {
        parser.parse(copy ["./a.out", "--nums"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "nums", "b"); }
        err => { println(err); assert(false, "wrong error b"); }
    }
}

__test helpRequest { // a help flag interrupts the parsing, whatever else is on the line
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "--count", "1", "-h"]);
        assert(false, "should have thrown");
    } catch {
        HelpRequestError() => {}
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test subCommand { // a sub command is handed the rest of the line, hyphenated or not
    {
        let parser = (copy ArgumentParser())
            :.sub("sub", &subFoo, short-> "s", comments-> "sub command", hyphenated-> false);

        assert(parser.parse(copy ["./a.out", "sub", "--foo", "78"])["sub"]["foo"].to!{i64} () == 78, "a");
        assert(parser.parse(copy ["./a.out", "--sub", "--foo", "78"])["sub"]["foo"].to!{i64} () == 78, "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test subCommandError { // a sub command that fails becomes a malformed argument carrying its error
    let parser = (copy ArgumentParser())
        :.sub("sub", &subFoo);

    {
        parser.parse(copy ["./a.out", "--sub", "--nope"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => {
            assert(m.key == "sub", "a");
            assert(contains(parser.explain(m), "error parsing argument 'sub'"), "b");
        }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test missingMandatorySubCommand { // a mandatory sub command that never appears is reported as missing
    let parser = (copy ArgumentParser())
        :.sub("sub", &subFoo, mandatory-> true);

    {
        parser.parse(copy ["./a.out"]);
        assert(false, "should have thrown");
    } catch {
        m: &MissingArgument => { assert(m.key == "sub", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test usageLine { // the usage line names every argument, with its type and whether it is optional
    let parser = (copy ArgumentParser())
        :.option!{i64} ("count", short-> "c", comments-> "how many")
        :.option!{[i64]} ("nums", comments-> "some ints")
        :.option!{[c8]} ("name", mandatory-> true, comments-> "a string")
        :.position!{f64} ("ratio", comments-> "a float")
        :.flag("verbose", short-> "v", comments-> "be loud")
        :.sub("run", &subNothing, comments-> "run it")
        :.help("help", short-> "h");

    assert(parser.getUsage() == "usage [-v,--verbose] [-h,--help] [-c,--count int] [--nums [int...]] --name str float(ratio) [--run(...)]",
           parser.getUsage());

    assert(parser.getUsage(usage-> "prog").startsWith("prog "), "b");
}

__test helpLayout { // the help groups the arguments and aligns their comments
    let parser = (copy ArgumentParser())
        :.option!{i64} ("count", short-> "c", comments-> "how many")
        :.option!{[c8]} ("name", mandatory-> true, comments-> "a string")
        :.position!{f64} ("ratio", comments-> "a float")
        :.flag("verbose", short-> "v", comments-> "be loud")
        :.help("help", short-> "h", comments-> "print this help");

    let help = parser.getHelp(usage-> "prog");
    assert(help.startsWith("prog "), "a");
    assert(contains(help, "positional arguments: "), "b");
    assert(contains(help, "mandatory arguments: "), "c");
    assert(contains(help, "optional arguments: "), "d");
    assert(contains(help, "-c,"), "e");
    assert(contains(help, "be loud"), "f");
}

__test explainErrors { // explain() turns each error kind into a message the caller can print
    let parser = fullParser();

    assert(parser.explain(copy HelpRequestError()) == parser.getHelp(), "a");

    let unknown = parser.explain(copy UnknownArgument("nope"), usage-> "prog");
    assert(unknown.startsWith("prog "), "b");
    assert(contains(unknown, "unknown argument 'nope'"), "c");

    assert(contains(parser.explain(copy MissingArgument("count"), usage-> "prog"), "missing argument 'count'"), "d");
    assert(contains(parser.explain(copy MalformedArgument("count", none), usage-> "prog"), "error parsing argument 'count'"), "e");
}

__test explainNestedErrors { // a malformed argument unwinds the chain of errors that produced it
    let parser = fullParser();

    let nested = parser.explain(copy MalformedArgument("outer", (copy MalformedArgument("inner", (copy MissingArgument("deep"))?))?));
    assert(contains(nested, "error parsing argument 'outer'"), "a");
    assert(contains(nested, "error parsing argument 'inner'"), "b");
    assert(contains(nested, "missing argument 'deep'"), "c");

    assert(contains(parser.explain(copy MalformedArgument("outer", (copy UnknownArgument("deep"))?)), "unknown argument 'deep'"), "d");
    assert(contains(parser.explain(copy MalformedArgument("outer", (copy CastFailure((&Int)::__typeinfo__, [c8]::typeinfo))?)),
                    "incompatible types: "), "e");
    assert(contains(parser.explain(copy MalformedArgument("outer", (copy InvalidCommandLine())?)), "error parsing argument 'outer'"), "f");
}

__test errorsToStream { // the errors carry their key into their own text
    assert(contains(format("{}", copy MissingArgument("count")), "MissingArgument (count)"), "a");
    assert(contains(format("{}", copy DuplicateArgument("count")), "DuplicateArgument (count)"), "b");
    assert(contains(format("{}", copy UnknownArgument("count")), "UnknownArgument (count)"), "c");
    assert(contains(format("{}", copy MalformedArgument("count", none)), "MalformedArgument (count)"), "d");
    assert(contains(format("{}", copy MalformedArgument("count", (copy MissingArgument("deep"))?)), "MissingArgument (deep)"), "e");
}

__test unsignedOption { // MID-64: an unsigned option is an int option, it used to be parsed as a float
    {
        let parser = (copy ArgumentParser())
            :.option!{u64} ("count")
            :.option!{[u32]} ("nums")
            :.position!{u64} ("pos");

        let cfg = parser.parse(copy ["./a.out", "7", "--count", "12", "--nums", "1", "2"]);
        assert(cfg["count"].to!{u64} () == 12u64, "a");
        assert(cfg["nums"].to!{[u32]} () == [1u32, 2u32], "b");
        assert(cfg["pos"].to!{u64} () == 7u64, "c");

        assert(parser.getUsage() == "usage [--count int] [--nums [int...]] int(pos)", parser.getUsage());
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test floatingOption { // a floating option is still a float option
    {
        let parser = (copy ArgumentParser()):.option!{f64} ("ratio"):.option!{[f64]} ("ratios");

        let cfg = parser.parse(copy ["./a.out", "--ratio", "1.5", "--ratios", "2.5", "3.5"]);
        assert(cfg["ratio"].to!{f64} () == 1.5, "a");
        assert(cfg["ratios"].to!{[f64]} () == [2.5, 3.5], "b");
        assert(parser.getUsage() == "usage [--ratio float] [--ratios [float...]]", parser.getUsage());
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test attachedValue { // an option value can be attached with '=' to its long or short name, or glued to its short name
    {
        let parser = fullParser();
        assert(parser.parse(copy ["./a.out", "--count=12"])["count"].to!{i64} () == 12, "a");
        assert(parser.parse(copy ["./a.out", "-c=12"])["count"].to!{i64} () == 12, "b");
        assert(parser.parse(copy ["./a.out", "-c12"])["count"].to!{i64} () == 12, "c");
        assert(parser.parse(copy ["./a.out", "--ratio=1.5"])["ratio"].to!{f64} () == 1.5, "d");
        assert(parser.parse(copy ["./a.out", "-nfoo"])["name"].to!{[c8]} () == "foo", "e");
        assert(parser.parse(copy ["./a.out", "--name=a=b"])["name"].to!{[c8]} () == "a=b", "f");
        assert(parser.parse(copy ["./a.out", "--name=--verbose"])["name"].to!{[c8]} () == "--verbose", "g");
        assert(parser.parse(copy ["./a.out", "-n-v"])["name"].to!{[c8]} () == "-v", "h");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test attachedValuePrecedence { // an exact name wins over a glued value, and the longest glued short name wins
    {
        let parser = (copy ArgumentParser())
            :.option!{[c8]} ("sort", short-> "s")
            :.option!{[c8]} ("sfx", short-> "sx")
            :.flag("stop-first", short-> "sf");

        let a = parser.parse(copy ["./a.out", "-sf"]);
        assert(a["stop-first"].to!{bool} (), "a");
        assert("sort" !in a, "b");

        let b = parser.parse(copy ["./a.out", "-sxy", "-sz"]);
        assert(b["sfx"].to!{[c8]} () == "y", "c");
        assert(b["sort"].to!{[c8]} () == "z", "d");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test attachedValueErrors { // an attached value goes through the same checks as a separate one
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "--count=abc"]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "count", "a"); }
        err => { println(err); assert(false, "wrong error a"); }
    }

    {
        parser.parse(copy ["./a.out", "--count="]);
        assert(false, "should have thrown");
    } catch {
        m: &MalformedArgument => { assert(m.key == "count", "b"); }
        err => { println(err); assert(false, "wrong error b"); }
    }

    {
        parser.parse(copy ["./a.out", "-c1", "--count=2"]);
        assert(false, "should have thrown");
    } catch {
        d: &DuplicateArgument => { assert(d.key == "count", "c"); }
        err => { println(err); assert(false, "wrong error c"); }
    }

    {
        parser.parse(copy ["./a.out", "--verbose=1"]);
        assert(false, "should have thrown");
    } catch {
        u: &UnknownArgument => { assert(u.key == "verbose=1", "d"); }
        err => { println(err); assert(false, "wrong error d"); }
    }

    {
        parser.parse(copy ["./a.out", "--count12"]);
        assert(false, "should have thrown");
    } catch {
        u: &UnknownArgument => { assert(u.key == "count12", "e"); }
        err => { println(err); assert(false, "wrong error e"); }
    }
}

__test attachedValueList { // an attached value is the first element of an array option, and of a list option
    {
        let parser = (copy ArgumentParser())
            :.option!{[i64]} ("nums", short-> "N")
            :.option!{[c8]} ("inc", short-> "I", list-> true);

        let cfg = parser.parse(copy ["./a.out", "--nums=1", "2", "-I/usr", "--inc=/opt"]);
        assert(cfg["nums"].to!{[i64]} () == [1i64, 2i64], "a");
        assert(cfg["inc"].to!{[[c8]]} () == ["/usr", "/opt"], "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test negativeNumberValue { // a negative number is a value, for an option as well as a positional argument
    {
        let parser = (copy ArgumentParser())
            :.option!{i64} ("count", short-> "c")
            :.option!{[c8]} ("name")
            :.option!{[f64]} ("ratios")
            :.position!{i64} ("first")
            :.position!{f64} ("second");

        let cfg = parser.parse(copy ["./a.out", "-5", "--count", "-3", "--name", "-7", "-.5", "--ratios", "-1.5", "-2e3"]);
        assert(cfg["first"].to!{i64} () == -5, "a");
        assert(cfg["count"].to!{i64} () == -3, "b");
        assert(cfg["name"].to!{[c8]} () == "-7", "c");
        assert(cfg["second"].to!{f64} () == -0.5, "d");
        assert(cfg["ratios"].to!{[f64]} () == [-1.5, -2000.0], "e");
        assert(parser.parse(copy ["./a.out", "-c-3", "1", "2"])["count"].to!{i64} () == -3, "f");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test negativeNumberName { // an argument named like a negative number is still an argument
    {
        let parser = (copy ArgumentParser())
            :.flag("one", short-> "1")
            :.position!{i64} ("value");

        let cfg = parser.parse(copy ["./a.out", "-1", "-2"]);
        assert(cfg["one"].to!{bool} (), "a");
        assert(cfg["value"].to!{i64} () == -2, "b");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test negativeNumberUnknown { // a negative number with no positional argument left is still unknown
    let parser = fullParser();

    {
        parser.parse(copy ["./a.out", "-5"]);
        assert(false, "should have thrown");
    } catch {
        u: &UnknownArgument => { assert(u.key == "-5", "a"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}

__test terminatorPositional { // '--' ends the options, what follows is positional whatever it looks like
    {
        let parser = (copy ArgumentParser())
            :.flag("verbose", short-> "v")
            :.sub("sub", &subNothing, hyphenated-> false)
            :.position!{[c8]} ("first")
            :.position!{[[c8]]} ("rest");

        let cfg = parser.parse(copy ["./a.out", "-v", "--", "-v", "--", "sub", "--name=x"]);
        assert(cfg["verbose"].to!{bool} (), "a");
        assert(cfg["first"].to!{[c8]} () == "-v", "b");
        assert(cfg["rest"].to!{[[c8]]} () == ["--", "sub", "--name=x"], "c");
        assert("sub" !in cfg, "d");

        assert(!parser.parse(copy ["./a.out", "--", "-v", "x"])["verbose"].to!{bool} (), "e");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test terminatorStopsArray { // '--' stops an array option, and does not fill a missing positional argument
    let parser = (copy ArgumentParser())
        :.option!{[[c8]]} ("names")
        :.option!{[i64]} ("nums")
        :.position!{[c8]} ("file");

    {
        let cfg = parser.parse(copy ["./a.out", "--names", "a", "b", "--", "--nums"]);
        assert(cfg["names"].to!{[[c8]]} () == ["a", "b"], "a");
        assert(cfg["file"].to!{[c8]} () == "--nums", "b");
        assert("nums" !in cfg, "c");

        let cfg2 = parser.parse(copy ["./a.out", "--nums", "1", "--", "x"]);
        assert(cfg2["nums"].to!{[i64]} () == [1i64], "d");
    } catch {
        err => { println(err); assert(false, "threw"); }
    }

    {
        parser.parse(copy ["./a.out", "--"]);
        assert(false, "should have thrown");
    } catch {
        m: &MissingArgument => { assert(m.key == "file", "e"); }
        err => { println(err); assert(false, "wrong error"); }
    }
}
