in map;

use std::collection::map;

__test keysAndValues {
    let m = copy [1 => 10, 2 => 20, 3 => 30];
    let mut ks = 0;
    let mut vs = 0;
    let mut n = 0us;
    for k in m.keys () { ks += k; n += 1us; }
    for v in m.values () { vs += v; }
    assert (ks == 6 && vs == 60 && n == 3us, "sums");
}

__test keysOfEmpty {
    let m: [i32 => i32] = copy [];
    for _ in m.keys () {
        assert (false, "a key");
    }
}

__test setOfUnit { // a set is a map to ()
    let dmut s: [i32 => ()] = copy [];
    for x in [1, 2, 1] {
        s[x] = ();
    }

    let mut n = 0;
    for x in s.keys () { n += x; }
    assert (s.len == 2us && n == 3, "set");
}
