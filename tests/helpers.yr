in helpers;

use std::algorithm::searching;

/**
 * @returns: true if `needle` appears somewhere in `hay`
 * @info: `std::algorithm::searching` looks for an element or a prefix, not for a sub-slice
 * */
pub fn contains(hay: [c8], needle: [c8])-> bool {
    if needle.len > hay.len { return false; }

    for i in 0us .. (hay.len - needle.len) + 1us {
        if hay[i .. $].startsWith(needle) { return true; }
    }

    false
}

/**
 * @returns: a value equal to `v`, but built in a way the compiler cannot constant fold, so that
 *           the tested functions are exercised at runtime and not by the CTE evaluator
 * */
pub fn opaque {T} (v: T)-> T {
    let dmut box = copy [v];

    box[0]
}
