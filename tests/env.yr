in env;

use std::env;

__test {
    setVar ("YMIR_TEST_ENV_KEY", "VALUE");
    assert (isVarSet ("YMIR_TEST_ENV_KEY"), "set variable reported as unset");

    removeVar ("YMIR_TEST_ENV_KEY");
    assert (!isVarSet ("YMIR_TEST_ENV_KEY"), "removed variable reported as set");
}

__test {
    assert (!isVarSet ("YMIR_TEST_ENV_NEVER_SET_KEY"), "unset variable reported as set");
}

__test {
    setVar ("YMIR_TEST_ENV_KEY", "VALUE");
    assert (unsafe { getVar ("YMIR_TEST_ENV_KEY") } == "VALUE");
    assert (isVarSet ("YMIR_TEST_ENV_KEY"));

    setVar ("YMIR_TEST_ENV_KEY", "OTHER");
    assert (unsafe { getVar ("YMIR_TEST_ENV_KEY") } == "OTHER");

    removeVar ("YMIR_TEST_ENV_KEY");
    assert (unsafe { getVar ("YMIR_TEST_ENV_KEY") } == "");
    assert (!isVarSet ("YMIR_TEST_ENV_KEY"));
}

__test {
    // an empty value is still a set variable
    setVar ("YMIR_TEST_ENV_EMPTY_KEY", "");
    assert (isVarSet ("YMIR_TEST_ENV_EMPTY_KEY"), "empty variable reported as unset");
    assert (unsafe { getVar ("YMIR_TEST_ENV_EMPTY_KEY") } == "");

    removeVar ("YMIR_TEST_ENV_EMPTY_KEY");
}
