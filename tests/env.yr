in env;

use std::env;

__test {
    env::setVar ("YMIR_TEST_ENV_KEY", "VALUE");
    assert (env::isVarSet ("YMIR_TEST_ENV_KEY"), "set variable reported as unset");

    env::removeVar ("YMIR_TEST_ENV_KEY");
    assert (!env::isVarSet ("YMIR_TEST_ENV_KEY"), "removed variable reported as set");
}

__test {
    assert (!env::isVarSet ("YMIR_TEST_ENV_NEVER_SET_KEY"), "unset variable reported as set");
}

__test {
    env::setVar ("YMIR_TEST_ENV_KEY", "VALUE");
    assert (unsafe { env::getVar ("YMIR_TEST_ENV_KEY") } == "VALUE");
    assert (env::isVarSet ("YMIR_TEST_ENV_KEY"));

    env::setVar ("YMIR_TEST_ENV_KEY", "OTHER");
    assert (unsafe { env::getVar ("YMIR_TEST_ENV_KEY") } == "OTHER");

    env::removeVar ("YMIR_TEST_ENV_KEY");
    assert (unsafe { env::getVar ("YMIR_TEST_ENV_KEY") } == "");
    assert (!env::isVarSet ("YMIR_TEST_ENV_KEY"));
}

__test {
    // an empty value is still a set variable
    env::setVar ("YMIR_TEST_ENV_EMPTY_KEY", "");
    assert (env::isVarSet ("YMIR_TEST_ENV_EMPTY_KEY"), "empty variable reported as unset");
    assert (unsafe { env::getVar ("YMIR_TEST_ENV_EMPTY_KEY") } == "");

    env::removeVar ("YMIR_TEST_ENV_EMPTY_KEY");
}
