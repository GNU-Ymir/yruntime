in pipes;

use core::concurrency::pipes::_;

use std::io;

use etc::c::files;
use etc::c::socket;

extern (C) fn _yrt_test_interrupt_then_write (fd: i32)-> *void;
extern (C) fn _yrt_test_interrupter_join (handle: *void)-> void;

/**
 * @returns: true if the O_NONBLOCK flag is set on `fd`
 * */
fn isNonBlocking(fd: i32)-> bool {
    let flags = files::fcntl(fd, files::FileFlags::F_GETFL, 0u32);

    (flags & SocketFlag::O_NONBLOCK) != 0u32
}

__test readingEndBlocking { // MID-64: setBlocking used '|' where it needed '&', so it set every other flag instead
    {
        let dmut p = copy IOPipe::new();
        let fd = p.ipipe.getHandle();

        assert(!isNonBlocking(fd), "a");

        p.ipipe:.setNonBlocking();
        assert(isNonBlocking(fd), "b");

        p.ipipe:.setBlocking();
        assert(!isNonBlocking(fd), "c");

        // the other flags of the descriptor are left alone: O_NONBLOCK is the only bit touched
        let before = files::fcntl(fd, files::FileFlags::F_GETFL, 0u32);
        p.ipipe:.setNonBlocking();
        p.ipipe:.setBlocking();
        assert(files::fcntl(fd, files::FileFlags::F_GETFL, 0u32) == before, "d");

        p:.dispose();
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test writingEndBlocking { // the same on the writing end
    {
        let dmut p = copy IOPipe::new();
        let fd = p.opipe.getHandle();

        p.opipe:.setNonBlocking();
        assert(isNonBlocking(fd), "a");

        p.opipe:.setBlocking();
        assert(!isNonBlocking(fd), "b");

        p:.dispose();
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test closedPipeBlocking { // a closed pipe ignores both, rather than calling fcntl on a dead descriptor
    let dmut p = copy IPipe();
    assert(!p.isOpen(), "a");

    p:.setNonBlocking();
    p:.setBlocking();
    assert(!p.isOpen(), "b");
}

__test readRetriesWhenInterrupted { // MID-143: an EINTR from read was taken for a broken pipe
    {
        let dmut p = copy IOPipe::new();

        let interrupter = _yrt_test_interrupt_then_write(p.opipe.getHandle());
        let byte = p.ipipe:.read!{u8} ();
        _yrt_test_interrupter_join(interrupter);

        assert(byte == 42u8, "a");
        p:.dispose();
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}
