in tasks;

use std::concurrency;
use core::concurrency;
use std::time;

fn computePi(prec: i32)-> f64 {
    let mut res = 0.0;
    let n: f64 = cast!f64(prec);
    for i in 0 .. prec {
        res += (4.0 / n) / ( 1.0 + (( cast!f64(i) - 0.5 ) * (1.0 / n)) * (( cast!f64(i) - 0.5 ) * (1.0 / n)));
    }
    res
}

/**
 * A leaf pending until it is fired, keeping the last waker it was polled with
 */
class Leaf {
    let mut _ready: bool = false;
    let mut _waker: (dg ()-> void)? = none;
    pub let mut polls: i32 = 0;

    pub self () {}

    /**
     * @returns: the number of times the leaf was polled so far
     */
    pub fn polled (self)-> i32 {
        atomic self {
            return self.polls;
        }
    }

    pub fn poll (mut self, waker: dg ()-> void)-> i32? {
        atomic self {
            self.polls += 1;
            if self._ready return (1)?;
            self._waker = waker?;
        }
        none
    }

    /**
     * Makes the leaf ready, and calls its waker
     */
    pub fn fire (mut self) {
        let mut waker: (dg ()-> void)? = none;
        atomic self {
            self._ready = true;
            waker = self._waker;
        }

        if let Ok (w) = waker {
            w ();
        }
    }
}

async awaitLeaf (dmut leaf: &Leaf) {
    let _ = await alias leaf;
}

async yielding () {
    await;
}

__test taskWokenFromThread {
    let dmut queue = copy MailBox!{dmut &Task} ();
    let dmut leaf = copy Leaf ();
    let dmut task = copy Task (awaitLeaf (alias leaf), copy |dmut t| => queue:.send (alias t));
    assert (task.state == TaskState::SCHEDULED);

    assert (!task:.run ());
    assert (task.state == TaskState::IDLE);
    assert (queue.len == 0us);

    let th = spawn leaf:.fire ();
    th.value;
    assert (queue.len == 1us);
    assert (task.state == TaskState::SCHEDULED);

    if let Ok (dmut t) = alias queue:.receive () {
        assert (t:.run ());
    }

    assert (task.state == TaskState::DONE);
    assert (queue.len == 0us);
    assert (leaf.polls == 2);
}

__test taskWokenDuringPoll {
    let dmut queue = copy MailBox!{dmut &Task} ();
    let dmut task = copy Task (yielding (), copy |dmut t| => queue:.send (alias t));

    assert (!task:.run ());
    assert (task.state == TaskState::SCHEDULED);
    assert (queue.len == 1us);

    if let Ok (dmut t) = alias queue:.receive () {
        assert (t:.run ());
    }

    assert (task.state == TaskState::DONE);
    assert (queue.len == 0us);
}

__test taskWokenThriceWhileIdle {
    let dmut queue = copy MailBox!{dmut &Task} ();
    let dmut leaf = copy Leaf ();
    let dmut task = copy Task (awaitLeaf (alias leaf), copy |dmut t| => queue:.send (alias t));

    assert (!task:.run ());
    for _ in 0 .. 3 {
        task:.wake ();
    }

    assert (queue.len == 1us);
    assert (task.state == TaskState::SCHEDULED);
    assert (leaf.polls == 1);
}

__test taskWokenWhenDone {
    let dmut queue = copy MailBox!{dmut &Task} ();
    let dmut leaf = copy Leaf ();
    let dmut task = copy Task (awaitLeaf (alias leaf), copy |dmut t| => queue:.send (alias t));

    assert (!task:.run ());
    leaf:.fire ();
    if let Ok (dmut t) = alias queue:.receive () {
        assert (t:.run ());
    }

    leaf:.fire ();
    task:.wake ();
    assert (queue.len == 0us);
    assert (task.state == TaskState::DONE);

    assert (task:.run ());
    assert (leaf.polls == 2);
}

/**
 * A leaf counting how many polls of it run at the same time, completed once every waking thread finished
 */
class Contended {
    let _wakers: i32;
    let mut _finished: i32 = 0;
    let mut _running: i32 = 0;
    pub let mut maxRunning: i32 = 0;
    pub let mut polls: i32 = 0;

    pub self (wakers: i32) with _wakers = wakers {}

    pub fn poll (mut self, _: dg ()-> void)-> i32? {
        let mut done = false;
        atomic self {
            self._running += 1;
            self.polls += 1;
            if self._running > self.maxRunning self.maxRunning = self._running;
            done = self._finished == self._wakers;
        }

        computePi (1000);
        atomic self {
            self._running -= 1;
        }

        if done return (0)?;
        none
    }

    pub fn finish (mut self) {
        atomic self {
            self._finished += 1;
        }
    }
}

async awaitContended (dmut leaf: &Contended) {
    let _ = await alias leaf;
}

/**
 * Wakes `task` `nb` times, marks this thread finished in `leaf`, then wakes it once more
 */
fn wakeMany (dmut task: &Task, dmut leaf: &Contended, nb: i32) {
    for _ in 0 .. nb {
        task:.wake ();
    }

    leaf:.finish ();
    task:.wake ();
}

/**
 * Runs the tasks of `queue` as `ready` is posted, until one of them is done, or nothing is posted for 5 seconds
 */
fn runLoop (dmut queue: &MailBox!{dmut &Task}, dmut ready: &Semaphore, dmut done: [bool], nbRunners: i32) {
    loop {
        if !ready:.wait (timeout-> seconds (5u64)) break;
        let mut stop = false;
        atomic {
            stop = done[0];
        }

        if stop break;
        if let Ok (dmut t) = alias queue:.receive () {
            if t:.run () {
                atomic {
                    done[0] = true;
                }

                for _ in 0 .. nbRunners {
                    ready:.post ();
                }
            }
        }
    }
}

__test taskWokenConcurrently {
    let nbWakers = 8;
    let nbRunners = 4;

    let dmut queue = copy MailBox!{dmut &Task} ();
    let dmut ready = copy Semaphore ();
    let dmut done = copy [false];
    let dmut leaf = copy Contended (nbWakers);
    let dmut task = copy Task (awaitContended (alias leaf), copy |dmut t| => {
        queue:.send (alias t);
        ready:.post ();
    });

    queue:.send (alias task);
    ready:.post ();

    let runners = copy [spawn runLoop (alias queue, alias ready, alias done, nbRunners) for _ in 0 .. nbRunners];
    let wakers = copy [spawn wakeMany (alias task, alias leaf, 1000) for _ in 0 .. nbWakers];

    for i in 0us .. runners.len {
        runners[i].value;
    }

    for i in 0us .. wakers.len {
        wakers[i].value;
    }

    ready:.dispose ();
    assert (task.state == TaskState::DONE);
    assert (leaf.maxRunning == 1);
    assert (leaf.polls >= 1);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          TASK POOL          ===================================
 * ====================================================================================================
 * ====================================================================================================
 */

/**
 * Waits up to 5 seconds for `leaf` to be polled `n` times
 * @returns: true if it was
 */
fn waitPolls (leaf: &Leaf, n: i32)-> bool {
    let deadline = Instant::now () + seconds (5u64);
    while leaf.polled () < n {
        if Instant::now () > deadline return false;
        sleep (millis (1u64));
    }

    true
}

async addTo (dmut res: [i32], i: i32) {
    computePi (i32::max / 10000);

    // res[0] += i is a read-modify-write, and the workers run it concurrently
    atomic {
        res[0] += i;
    }
}

__test poolSubmitAndJoin {
    let dmut pool = copy TaskPool (nbThreads-> 12u32);
    let dmut res = copy [0];
    for i in 0 .. 100 {
        pool:.submit (addTo (alias res, i));
    }

    pool:.join ();
    pool:.dispose ();
    assert (res[0] == 4950);
}

/**
 * The ids pushed by the tasks, in the order they pushed them
 */
class Log {
    let mut _ids: [i32] = [];

    pub self () {}

    pub fn push (mut self, id: i32) {
        atomic self {
            self._ids ~= [id];
        }
    }

    pub fn ids (self)-> [i32] {
        atomic self {
            return self._ids;
        }
    }
}

async stepping (dmut gate: &Leaf, dmut log: &Log, id: i32, steps: i32) {
    let _ = await alias gate;
    for _ in 0 .. steps {
        log:.push (id);
        await;
    }
}

async openGates (dmut a: &Leaf, dmut b: &Leaf) {
    a:.fire ();
    b:.fire ();
}

__test poolYieldIsFair { // on one worker, a task yielding goes behind the other ready ones
    let dmut pool = copy TaskPool (nbThreads-> 1u32);
    let dmut log = copy Log ();
    let dmut a = copy Leaf ();
    let dmut b = copy Leaf ();

    // the gates are opened from the worker itself, so both tasks are in the queue before either resumes
    pool:.submit (stepping (alias a, alias log, 1, 4));
    pool:.submit (stepping (alias b, alias log, 2, 4));
    pool:.submit (openGates (alias a, alias b));

    pool:.join ();
    pool:.dispose ();
    assert (log.ids () == [1, 2, 1, 2, 1, 2, 1, 2]);
}

async openAll (dmut gates: [&Leaf]) {
    for i in 0us .. gates.len {
        gates[i]:.fire ();
    }
}

__test poolYieldIsFairManyTasks { // the round robin holds with more ready tasks than the queue first has room for
    let dmut pool = copy TaskPool (nbThreads-> 1u32);
    let dmut log = copy Log ();
    let dmut gates = copy [copy Leaf () for _ in 0 .. 40];
    for i in 0us .. gates.len {
        pool:.submit (stepping (alias gates[i], alias log, cast!i32 (i), 3));
    }

    pool:.submit (openAll (alias gates));
    pool:.join ();
    pool:.dispose ();

    let ids = log.ids ();
    assert (ids.len == 120us);
    for i, id in ids {
        assert (id == cast!i32 (i % 40us));
    }
}

fn nap () {
    sleep (millis (250u64));
}

async awaitNap () {
    let f = spawn nap ();
    await f;
}

async awaitDelay () {
    await delay (millis (250u64));
}

__test poolParkedFreeWorker { // 8 tasks awaiting a sleeping thread, on 2 workers, take about one sleep, not four
    let dmut pool = copy TaskPool (nbThreads-> 2u32);
    let start = Instant::now ();
    for _ in 0 .. 8 {
        pool:.submit (awaitNap ());
    }

    pool:.join ();
    pool:.dispose ();
    let elapsed = Instant::now () - start;
    assert (elapsed >= millis (250u64) && elapsed < millis (750u64));
}

__test poolDelayFreesWorker { // 8 tasks awaiting a delay, on 1 worker, take about one delay, not eight
    let dmut pool = copy TaskPool (nbThreads-> 1u32);
    let start = Instant::now ();
    for _ in 0 .. 8 {
        pool:.submit (awaitDelay ());
    }

    pool:.join ();
    pool:.dispose ();
    let elapsed = Instant::now () - start;
    assert (elapsed >= millis (250u64) && elapsed < millis (750u64));
}

__test poolPollsOnceAfterWake { // a parked task is not polled until woken, then exactly once more
    let dmut pool = copy TaskPool (nbThreads-> 2u32);
    let dmut leaf = copy Leaf ();
    pool:.submit (awaitLeaf (alias leaf));
    assert (waitPolls (leaf, 1));

    sleep (millis (50u64));
    assert (leaf.polled () == 1);

    let th = spawn leaf:.fire ();
    th.value;
    pool:.join ();
    pool:.dispose ();
    assert (leaf.polled () == 2);
}

/**
 * A leaf holding the worker polling it until it is released
 */
class Blocker {
    let mut _entered: bool = false;
    let mut _released: bool = false;

    pub self () {}

    pub fn poll (mut self, _: dg ()-> void)-> i32? {
        atomic self {
            self._entered = true;
        }

        let mut released = false;
        while !released {
            sleep (millis (1u64));
            atomic self {
                released = self._released;
            }
        }

        (0)?
    }

    pub fn entered (self)-> bool {
        atomic self {
            return self._entered;
        }
    }

    pub fn release (mut self) {
        atomic self {
            self._released = true;
        }
    }
}

async awaitBlocker (dmut blocker: &Blocker) {
    let _ = await alias blocker;
}

__test poolClearWithParked { // clear drops the queued tasks, woken ones included, and leaves the parked ones be
    let dmut pool = copy TaskPool (nbThreads-> 1u32);
    let dmut parked = copy Leaf ();
    let dmut woken = copy Leaf ();
    let dmut queued = copy Leaf ();
    let dmut blocker = copy Blocker ();

    pool:.submit (awaitLeaf (alias parked));
    pool:.submit (awaitLeaf (alias woken));
    pool:.submit (awaitBlocker (alias blocker));

    let deadline = Instant::now () + seconds (5u64);
    while !blocker.entered () && Instant::now () < deadline {
        sleep (millis (1u64));
    }

    assert (blocker.entered ());

    // the only worker is held by the blocker, so these two wait in the queue
    pool:.submit (awaitLeaf (alias queued));
    woken:.fire ();
    pool:.clear ();

    woken:.fire ();
    blocker:.release ();
    parked:.fire ();
    pool:.join ();
    pool:.dispose ();

    assert (parked.polled () == 2);
    assert (woken.polled () == 1);
    assert (queued.polled () == 0);
}

__test poolDisposeWithParked { // the tasks still parked when the pool is disposed are never polled again
    let dmut pool = copy TaskPool (nbThreads-> 2u32);
    let dmut a = copy Leaf ();
    let dmut b = copy Leaf ();
    pool:.submit (awaitLeaf (alias a));
    pool:.submit (awaitLeaf (alias b));
    assert (waitPolls (a, 1) && waitPolls (b, 1));

    pool:.dispose ();
    a:.fire ();
    b:.fire ();
    pool:.join ();

    sleep (millis (20u64));
    assert (a.polled () == 1 && b.polled () == 1);
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * ====================================          TASK HANDLE          =================================
 * ====================================================================================================
 * ====================================================================================================
 */

async double (x: i32)-> i32 {
    await;
    x * 2
}

__test handleWait {
    let dmut pool = copy TaskPool (nbThreads-> 4u32);
    let dmut handles = copy [pool:.submit (double (i)) for i in 0 .. 100];
    let mut sum = 0;
    for i in 0us .. handles.len {
        sum += handles[i]:.wait ();
    }

    pool:.dispose ();
    assert (sum == 9900);
}

__test handleWaitVoid {
    let dmut pool = copy TaskPool (nbThreads-> 2u32);
    let dmut res = copy [0];
    let dmut h = pool:.submit (addTo (alias res, 7));
    h:.wait ();
    pool:.dispose ();
    assert (res[0] == 7);
}

async fanIn (dmut pool: &TaskPool, n: i32)-> i32 {
    let dmut handles = copy [pool:.submit (double (i)) for i in 0 .. n];
    let mut sum = 0;
    for i in 0us .. handles.len {
        sum += await alias handles[i];
    }

    sum
}

__test handleFanIn { // two parents awaiting their children on 2 workers, which a worker held by an await would deadlock
    let dmut pool = copy TaskPool (nbThreads-> 2u32);
    let dmut a = pool:.submit (fanIn (alias pool, 1000));
    let dmut b = pool:.submit (fanIn (alias pool, 1000));
    assert (a:.wait () == 999000);
    assert (b:.wait () == 999000);

    pool:.join ();
    pool:.dispose ();
}

async gated (dmut gate: &Leaf)-> i32 {
    let r = await alias gate;
    r + 41
}

async awaitInto (dmut h: &TaskHandle!{i32}, dmut log: &Log) {
    let r = await alias h;
    log:.push (r);
}

async openGate (dmut gate: &Leaf) {
    gate:.fire ();
}

__test handleTwoAwaiters { // on one worker, both awaiters are parked on the handle before the gate opens
    let dmut pool = copy TaskPool (nbThreads-> 1u32);
    let dmut log = copy Log ();
    let dmut gate = copy Leaf ();
    let dmut h = pool:.submit (gated (alias gate));
    pool:.submit (awaitInto (alias h, alias log));
    pool:.submit (awaitInto (alias h, alias log));
    pool:.submit (openGate (alias gate));

    pool:.join ();
    pool:.dispose ();
    assert (log.ids () == [42, 42]);
}

async awaitValue (dmut h: &TaskHandle!{i32})-> i32 {
    await alias h
}

__test handleAwaitCompleted { // awaiting a completed handle completes at the first poll, its waker never called
    let dmut pool = copy TaskPool (nbThreads-> 1u32);
    let dmut h = pool:.submit (double (21));
    assert (h:.wait () == 42);
    pool:.dispose ();

    let dmut log = copy Log ();
    let a = awaitValue (alias h);
    assert (a.poll (copy || => log:.push (0)) == (42)?);
    assert (log.ids () == []);
}
