in proc;

use std::io;
use std::concurrency;
use std::fs::path;

__test readOutput {
    // Spawn a sub process that run the ls command in the directory /path/to/print
    let dmut proc = copy SubProcess("ls"s8, copy ["-la"s8], cwd-> Path("."));

    // Start the subprocess
    proc:.start();

    // Wait the end of the proc
    proc:.wait();

    // Print the stdout of the subprocess
    let mut result: [c8] = [];
    while let Ok(c) = proc.stdout:.read!c8()? {
        result ~= [c];
    }

    println(result);
}

__test exitCode {
    let dmut proc = copy SubProcess("sh"s8, copy ["-c"s8, "exit 3"s8]);
    proc:.start(redirect-> false);
    assert(proc:.wait() == 3);
    assert(proc:.wait() == 3);
}

__test killedBySignal {
    let dmut proc = copy SubProcess("sh"s8, copy ["-c"s8, "kill -9 $$"s8]);
    proc:.start(redirect-> false);
    assert(proc:.wait() == 128 + 9);
}

__test finishedThenWaited {
    let dmut proc = copy SubProcess("sh"s8, copy ["-c"s8, "exit 5"s8]);
    proc:.start(redirect-> false);
    while !proc:.isFinished() {}
    assert(proc:.wait() == 5);
}

__test neverStarted {
    let dmut proc = copy SubProcess("true"s8, []);
    assert(proc:.isFinished());
    assert(proc:.wait() == -1);
}

