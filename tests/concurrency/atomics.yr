in atomics;

use core::concurrency;

class Counter {
    let mut _value: Atomic!{u32} = Atomic!{u32} (0u32);
    let mut _total: Atomic!{u64} = Atomic!{u64} (0u64);

    pub self () {}

    pub fn increment (mut self) {
        let mut current = self._value.load ();
        while !self._value:.compareExchange (ref current, current + 1u32) {}
        self._total:.add (3u64);
    }

    pub fn value (self)-> u32 {
        self._value.load ()
    }

    pub fn total (self)-> u64 {
        self._total.load ()
    }
}

fn incrementMany (dmut counter: &Counter, nb: i32) {
    for _ in 0 .. nb {
        counter:.increment ();
    }
}

__test atomicCompareExchange {
    let mut a = Atomic!{u32} (3u32);
    let mut expected = 3u32;
    assert (a:.compareExchange (ref expected, 7u32));
    assert (expected == 3u32 && a.load () == 7u32);

    assert (!a:.compareExchange (ref expected, 9u32));
    assert (expected == 7u32 && a.load () == 7u32);

    a:.store (1u32);
    assert (a.load () == 1u32);

    let mut b = Atomic!{u64} (u64::max);
    let mut big = u64::max;
    assert (b:.compareExchange (ref big, 0x1_0000_0000u64));
    assert (b:.add (1u64) == 0x1_0000_0001u64);
    b:.store (u64::max);
    assert (b:.add (2u64) == 1u64);
}

__test atomicConcurrentIncrements { // a lost update would leave the count short
    let dmut counter = copy Counter ();
    let threads = copy [spawn incrementMany (alias counter, 10000) for _ in 0 .. 8];
    for i in 0us .. threads.len {
        threads[i].value;
    }

    assert (counter.value () == 80000u32);
    assert (counter.total () == 240000u64);
}
