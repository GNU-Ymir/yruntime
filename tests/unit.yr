in unit;

use std::unit;
use std::format::_;

// YMI-169: the terabyte component was guarded on `terabytes` instead of
// `terabytes % 1024`, so any size >= 1PB emitted a spurious `0TB`.
__test {
    assert(format("{}", MemorySize::PB(1u64)) == "1PB", "a");
    assert(format("{}", MemorySize::GB(1u64)) == "1GB", "b");
    assert(format("{}", MemorySize::TB(1u64)) == "1TB", "c");
    assert(format("{}", MemorySize::PB(1u64) + MemorySize::TB(1u64)) == "1PB1TB", "d");
    assert(format("{}", MemorySize::B(0u64)) == "0B", "e");
}
