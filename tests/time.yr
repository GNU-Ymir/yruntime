in time;

use std::time::_;
use std::conv;
use std::conv::errors;
use std::time::date::conv;
use std::format;

__test durationFromComponents {
    let z = (1).seconds().to![c8] ();
    assert(z == "1s");

    let x = Duration(w-> 1, d-> 12);
    assert(x.weeks == 2 && x.days == 5);
}


__test sleepMillis {
    let start = Instant::now();
    sleep((10).millis());

    let end = Instant::now();
    let res = end - start;

    assert(res > (10).millis() && res < (200).millis());
}

__test dateTimeInstant {
    // YMI-163: DateTime::instant() used to lock __DATE_MUTEX__ twice, deadlocking on the first call
    let now = Instant::now();
    let d = DateTime(now);
    let i = d.instant();

    assert(i.sec == now.sec);
    assert(i.usec == now.usec);

    // and the mutex is still usable afterwards
    let d2 = DateTime(sec-> 30, min-> 15, hour-> 12, day-> 24, month-> 11, year-> 121);
    assert(d2.second == 30 && d2.minute == 15 && d2.hour == 12);
    // the ctor takes a 0-based month (tm_mon), the getter reports it 1-based
    assert(d2.day == 24 && d2.month == 12 && d2.year == 2021);

    assert(DateTime(d2.instant()).instant().sec == d2.instant().sec);
}

__test dateTimeNormalized {
    // january 33rd is normalized to february 2nd (cf. mktime)
    let d = DateTime(day-> 33, month-> 0, year-> 121);
    assert(d.month == 2 && d.day == 2);
}

__test dateTimeYearDay {
    // YMI-168: yearDay must return tm_yday, not the weekday, and toStream must print
    // a 1-based month and a two-digit (year % 100) year.
    let d = DateTime(usec-> 0u64, sec-> 0, min-> 0, hour-> 12, day-> 25, month-> 11, year-> 126);
    assert(d.month == 12);
    assert(d.yearDay == 358);
    assert(d.weekDay != d.yearDay);
    assert(d.to![c8] () == "25/12/26 12:00:00");
}

__test componentAccessors { // every component accessor, on a duration built from components
    let d = Duration(w-> 1u64, d-> 2u64, h-> 3u64, m-> 4u64, s-> 5u64, ms-> 6u64, us-> 7u64);

    assert(d.weeks == 1u64, "a");
    assert(d.days == 2u64, "b");
    assert(d.hours == 3u64, "c");
    assert(d.minutes == 4u64, "d");
    assert(d.seconds == 5u64, "e");
    assert(d.millis == 6u64, "f");
    assert(d.micros == 7u64, "g");

    assert(!d.isNegative(), "h");
    assert(d.getUSec() == 6_007u64, "i");
}

__test allAccessors { // the 'allX' accessors flatten the duration down to a single unit
    let d = Duration(d-> 1u64, h-> 2u64, m-> 3u64, s-> 4u64, ms-> 5u64, us-> 6u64);

    assert(d.allDays == 1u64, "a");
    assert(d.allHours == 26u64, "b");
    assert(d.allMinutes == (26u64 * 60u64) + 3u64, "c");
    assert(d.allSeconds == d.getSec(), "d");
    assert(d.allMillis == (d.getSec() * 1_000u64) + 5u64, "e");
    assert(d.allMicros == (d.getSec() * 1_000_000u64) + 5_006u64, "f");
}

__test durBuilders { // the builders of std::time::dur agree with the component constructor
    assert(weeks(2u64) == Duration(w-> 2u64), "a");
    assert(days(3u64) == Duration(d-> 3u64), "b");
    assert(hours(4u64) == Duration(h-> 4u64), "c");
    assert(minutes(5u64) == Duration(m-> 5u64), "d");
    assert(seconds(6u64) == Duration(s-> 6u64), "e");
    assert(millis(7u64) == Duration(ms-> 7u64), "f");
    assert(micros(8u64) == Duration(us-> 8u64), "g");
}

__test durationAdd { // adding durations carries the microseconds over into a second
    assert(seconds(1u64) + seconds(2u64) == seconds(3u64), "a");
    assert(millis(600u64) + millis(600u64) == Duration(s-> 1u64, ms-> 200u64), "b");

    // adding a negative duration is a subtraction, whichever side it is on
    assert(seconds(2u64) + (-seconds(1u64)) == seconds(1u64), "c");
    assert((-seconds(1u64)) + seconds(2u64) == seconds(1u64), "d");
}

__test durationSub { // subtracting durations borrows a second, and goes negative when it has to
    let x = seconds(2u64) - millis(300u64);
    assert(x.seconds == 1u64 && x.millis == 700u64, "a");
    assert(!x.isNegative(), "b");

    let y = millis(300u64) - seconds(2u64);
    assert(y.seconds == 1u64 && y.millis == 700u64, "c");
    assert(y.isNegative(), "d");

    // same second, smaller microseconds: the result is the negated difference
    let z = Duration(s-> 1u64, us-> 1u64) - Duration(s-> 1u64, us-> 2u64);
    assert(z.isNegative() && z.micros == 1u64, "e");

    // whole seconds apart, no microseconds to borrow
    assert(seconds(3u64) - seconds(1u64) == seconds(2u64), "f");

    // subtracting a negative duration adds it
    assert(seconds(1u64) - (-seconds(2u64)) == seconds(3u64), "g");

    // a negative left operand keeps the sign
    let w = (-seconds(1u64)) - seconds(2u64);
    assert(w.isNegative() && w.seconds == 3u64, "h");
}

__test durationDivNeg { // dividing a duration, and negating it
    assert(format("{}", seconds(1u64) / 60u64) == "16ms666µs", format("{}", seconds(1u64) / 60u64));
    assert(seconds(10u64) / 2u64 == seconds(5u64), "b");

    let n = -seconds(2u64);
    assert(n.isNegative(), "c");
    assert(!(-n).isNegative(), "d");
    assert((-n) == seconds(2u64), "e");
    assert((-seconds(2u64)) / 2u64 == -seconds(1u64), "f");
}

__test durationCompare { // comparing durations, including across the sign
    assert(seconds(2u64) > seconds(1u64), "a");
    assert(seconds(1u64) < seconds(2u64), "b");
    assert(seconds(1u64) == seconds(1u64), "c");
    assert(millis(2u64) > millis(1u64), "d");
    assert(millis(1u64) < millis(2u64), "e");

    // a negative duration is below a positive one, and the order flips between two negatives
    assert((-seconds(1u64)) < seconds(1u64), "f");
    assert(seconds(1u64) > (-seconds(1u64)), "g");
    assert((-seconds(1u64)) > (-seconds(2u64)), "h");
    assert((-seconds(0u64)) == seconds(0u64), "i");
}

__test durationFormat { // a duration writes only the components it has, and "0s" when it has none
    assert(format("{}", Duration(w-> 1u64, d-> 2u64, h-> 3u64, ms-> 89u64)) == "1w2d3h89ms", "a");
    assert(format("{}", seconds(0u64)) == "0s", "b");
    assert(format("{}", -seconds(2u64)) == "-2s", "c");
    assert(format("{}", Duration(m-> 1u64, s-> 1u64)) == "1m1s", "d");
    assert(format("{}", micros(1u64)) == "1µs", "e");

    // YMI-168 style overflow: 6d23h59m59s999ms999µs plus one microsecond is exactly a week
    assert(format("{}", Duration(d-> 6u64, h-> 23u64, m-> 59u64, s-> 59u64, ms-> 999u64, us-> 999u64) + micros(1u64)) == "1w", "f");
}

__test instantCompare { // an instant is a point on the clock, comparable and readable without calling now()
    let a = Instant(100u64, 500u64);
    assert(a.sec == 100u64 && a.usec == 500u64, "a");

    assert(a == Instant(100u64, 500u64), "b");
    assert(a > Instant(100u64, 499u64), "c");
    assert(a < Instant(100u64, 501u64), "d");
    assert(a > Instant(99u64, 999u64), "e");
    assert(a < Instant(101u64, 0u64), "f");

    assert(Instant::zero() == Instant(0u64, 0u64), "g");
}

__test instantDifference { // the duration between two instants, in both directions
    assert(Instant(10u64, 0u64) - Instant(4u64, 0u64) == seconds(6u64), "a");

    let back = Instant(4u64, 0u64) - Instant(10u64, 0u64);
    assert(back.isNegative() && back.seconds == 6u64, "b");

    // borrowing a second from the seconds counter
    let borrow = Instant(10u64, 100u64) - Instant(9u64, 500u64);
    assert(borrow.getSec() == 0u64 && borrow.allMicros == 999_600u64, "c");

    // same second, smaller microseconds
    let same = Instant(10u64, 100u64) - Instant(10u64, 500u64);
    assert(same.isNegative() && same.micros == 400u64, "d");

    // exactly equal instants
    assert(Instant(10u64, 100u64) - Instant(10u64, 100u64) == seconds(0u64), "e");
}

__test instantShift { // shifting an instant by a duration, forwards and backwards
    assert(Instant(10u64, 0u64) + seconds(5u64) == Instant(15u64, 0u64), "a");
    assert(Instant(10u64, 0u64) - seconds(5u64) == Instant(5u64, 0u64), "b");

    // adding a negative duration goes forwards too: the sign is dropped
    assert(Instant(10u64, 0u64) + (-seconds(5u64)) == Instant(15u64, 0u64), "c");

    // the microseconds carry over into a second
    let carried = Instant(10u64, 900_000u64) + micros(200_000u64);
    assert(carried.sec == 11u64, "d");

    assert(format("{}", Instant(2u64, 0u64)) == "2s", format("{}", Instant(2u64, 0u64)));
}

__test dateTimeZones { // a date remembers the zone it is written in, and renders it
    let utc = DateTime::zoned(Instant(0u64, 0u64), 0i64);
    assert(utc.utcOffset == 0i64 && utc.hour == 0 && utc.day == 1, "a");

    // the same instant, an hour east of utc
    let east = DateTime::zoned(Instant(0u64, 0u64), 3_600i64);
    assert(east.utcOffset == 3_600i64 && east.hour == 1, "b");

    // and five hours west of it, which is the day before
    let west = DateTime::zoned(Instant(0u64, 0u64), -18_000i64);
    assert(west.year == 1969 && west.month == 12 && west.day == 31 && west.hour == 19, "c");

    // whatever the zone, they all name the same instant
    assert(utc == east && east == west, "d");
    assert(utc.instant().sec == 0u64 && west.instant().sec == 0u64, "e");
}

__test dateTimeComponents { // DateTime::at takes the components the getters report
    let d = DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 8, day-> 26, hour-> 14, min-> 3, sec-> 11);

    assert(d.year == 2026 && d.month == 8 && d.day == 26, "a");
    assert(d.hour == 14 && d.minute == 3 && d.second == 11, "b");

    // the day and month enums name that day
    assert(d.dayName == Days::WEDNESDAY && d.monthName == Months::AUGUST, "c");

    // an out of range component is normalized
    let n = DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 1, day-> 33);
    assert(n.month == 2 && n.day == 2, "d");
}

__test dateTimeFormat { // every directive of a layout
    let d = DateTime::at(utcOffset-> 0i64, usec-> 123_456u64, year-> 2026, month-> 8, day-> 6,
                         hour-> 14, min-> 3, sec-> 11);

    assert(d.format() == "2026-08-06T14:03:11Z", d.format());
    assert(d.format(fmt-> DateFormat::ISO8601_MICROS) == "2026-08-06T14:03:11.123456Z", d.format(fmt-> DateFormat::ISO8601_MICROS));
    assert(d.format(fmt-> DateFormat::RFC1123) == "Thu, 06 Aug 2026 14:03:11 GMT", d.format(fmt-> DateFormat::RFC1123));
    assert(d.format(fmt-> DateFormat::DATE_ONLY) == "2026-08-06", d.format(fmt-> DateFormat::DATE_ONLY));
    assert(d.format(fmt-> DateFormat::TIME_ONLY) == "14:03:11", d.format(fmt-> DateFormat::TIME_ONLY));

    assert(d.format(fmt-> "%A %e %B %y") == "Thursday  6 August 26", d.format(fmt-> "%A %e %B %y"));
    assert(d.format(fmt-> "%I:%M %p") == "02:03 PM", d.format(fmt-> "%I:%M %p"));
    assert(d.format(fmt-> "%F %T %D %R") == "2026-08-06 14:03:11 08/06/26 14:03", d.format(fmt-> "%F %T %D %R"));
    assert(d.format(fmt-> "%j %L %s") == "218 123 1786024991", d.format(fmt-> "%j %L %s"));
    assert(d.format(fmt-> "100%% %z") == "100% +0000", d.format(fmt-> "100%% %z"));

    // midnight and noon on the twelve hours clock
    let midnight = DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 1, day-> 1);
    assert(midnight.format(fmt-> "%I %p") == "12 AM", midnight.format(fmt-> "%I %p"));
    assert((midnight + (12).hours()).format(fmt-> "%I %p") == "12 PM");

    // an unknown directive is written as it is, a layout never fails
    assert(d.format(fmt-> "%Q") == "%Q");
}

__test dateTimeFormatOffsets { // %z and %:z, which writes utc as Z
    let east = DateTime::at(utcOffset-> 7_200i64, year-> 2026, month-> 8, day-> 26, hour-> 16);
    assert(east.format(fmt-> "%z") == "+0200", east.format(fmt-> "%z"));
    assert(east.format(fmt-> "%:z") == "+02:00", east.format(fmt-> "%:z"));
    assert(east.format() == "2026-08-26T16:00:00+02:00", east.format());

    let west = DateTime::at(utcOffset-> -12_600i64, year-> 2026, month-> 8, day-> 26);
    assert(west.format(fmt-> "%z %:z") == "-0330 -03:30", west.format(fmt-> "%z %:z"));
}

__test dateTimeParse { // a date is read back from the layouts it is rendered with
    let iso = ("2026-08-26T14:03:11Z").to!{DateTime} ();
    assert(iso.year == 2026 && iso.month == 8 && iso.day == 26, "a");
    assert(iso.hour == 14 && iso.minute == 3 && iso.second == 11 && iso.utcOffset == 0i64, "b");

    // the offset of the zone the date is written in is kept
    let east = ("2026-08-26T16:03:11+02:00").to!{DateTime} ();
    assert(east.hour == 16 && east.utcOffset == 7_200i64, "c");

    // and it names the same instant as the utc one
    assert(east == iso, "d");

    // %S also reads the fraction of a second the layout does not mention
    let frac = ("2026-08-26T14:03:11.5Z").to!{DateTime} ();
    assert(frac.usec == 500_000u64, "e");

    // every layout is readable, not only ISO 8601
    let http = ("Wed, 26 Aug 2026 14:03:11 GMT").to!{DateTime} (fmt-> DateFormat::RFC1123);
    assert(http == iso, "f");

    let named = ("Wednesday 26 August 2026, 02:03 PM").to!{DateTime} (fmt-> "%A %e %B %Y, %I:%M %p");
    assert(named.hour == 14 && named.minute == 3 && named.day == 26, "g");

    // the fields a layout leaves out are those of the 1st of january 1970, in utc
    let partial = ("07:30").to!{DateTime} (fmt-> "%H:%M");
    assert(partial.year == 1970 && partial.month == 1 && partial.day == 1, "h");
    assert(partial.hour == 7 && partial.minute == 30, "i");
}

__test dateTimeParseRoundTrip { // every preset round trips through a parse
    let d = DateTime::at(utcOffset-> 19_800i64, usec-> 987_654u64, year-> 2027, month-> 2,
                         day-> 28, hour-> 23, min-> 59, sec-> 59);

    assert(d.format(fmt-> DateFormat::ISO8601_MICROS).to!{DateTime} (fmt-> DateFormat::ISO8601_MICROS) == d, "a");
    assert(d.format(fmt-> DateFormat::ISO8601_MICROS).to!{DateTime} (fmt-> DateFormat::ISO8601_MICROS).usec == d.usec, "b");
    assert(d.format(fmt-> DateFormat::ISO8601).to!{DateTime} ().utcOffset == 19_800i64, "c");

    // %s reads the instant straight, whatever the fields around it
    assert(("1786370591").to!{DateTime} (fmt-> "%s").instant().sec == 1_786_370_591u64, "d");
}

__test dateTimeParseErrors { // a text the layout does not describe is a failed cast
    let ok = {
        ("26 August 2026").to!{DateTime} ();
        false
    } catch {
        _: &CastFailure => { true }
    };

    assert(ok, "a");

    // a trailing text is not silently dropped
    let trailing = {
        ("2026-08-26T14:03:11Z and then some").to!{DateTime} ();
        false
    } catch {
        _: &CastFailure => { true }
    };

    assert(trailing, "b");

    // nor is a month name that names no month
    let month = {
        ("Wed, 26 Aou 2026 14:03:11 GMT").to!{DateTime} (fmt-> DateFormat::RFC1123);
        false
    } catch {
        _: &CastFailure => { true }
    };

    assert(month, "c");
}

__test dateTimeArithmetic { // durations move a date, and two dates subtract to one
    let d = DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 12, day-> 31, hour-> 23, min-> 30);

    let next = d + (1).hours();
    assert(next.year == 2027 && next.month == 1 && next.day == 1, "a");
    assert(next.hour == 0 && next.minute == 30, "b");

    // the zone of the date is kept as it moves
    let east = DateTime::at(utcOffset-> 7_200i64, year-> 2026, month-> 6, day-> 1, hour-> 12);
    assert((east + (1).days()).utcOffset == 7_200i64, "c");
    assert((east - (1).days()).day == 31 && (east - (1).days()).hour == 12, "d");

    // and the difference of two dates is a duration, whatever their zones
    assert(next - d == (1).hours(), "e");
    assert(DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 1, day-> 8)
           - DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 1, day-> 1) == (1).weeks(), "f");

    // dates compare on the instant they name
    let utcNoon = DateTime::at(utcOffset-> 0i64, year-> 2026, month-> 6, day-> 1, hour-> 12);
    let westNoon = DateTime::at(utcOffset-> -3_600i64, year-> 2026, month-> 6, day-> 1, hour-> 12);
    assert(utcNoon < westNoon, "g");
}
