in iteration;

use std::algorithm::iteration;

__test foldTemplateSlice {
    let i = copy [1, 2, 3, 4];
    assert(i.fold!{|x,y| => x + y} () == 10?, "a");
    assert(i.fold!{|x,y| => x * y} () == 24?, "b");

    let j = i[0 .. 0];
    assert(j.fold!{|x,y| => x + y} () == none, "c");
}

__test foldGrowingSlice {
    let mut x: [i32] = [];
    for i in 1 ... 4 { x ~= [i]; }

    assert(x.fold(|x, y| => x + y) == 10?, "a");
}

__test foldLambdaSlice {
    let i = copy [1, 2, 3, 4];
    assert(i.fold(|x,y| => x + y) == 10?, "d");
    assert(i.fold(|x,y| => x * y) == 24?, "e");

    let j = i[0 .. 0];
    assert(j.fold(|x,y| => x + y) == none, "f");
}

__test foldClosureSlice {
    let i = copy [1, 2, 3, 4];
    let z = 2;

    let a = i.fold(copy |x, y| => x + y + z); // 1 + (2 + 2) + (3 + 2) + (4 + 2)
    let b = i.fold(copy |x, y| => {
        if (y % z == 1) { x + y } else { x }
    }); // 1 + 3

    assert(a == 16?, "g");
    assert(b == 4?, "h");

    let j = i[0 .. 0];
    let c = j.fold(copy |x, y| => { x + y + z });

    assert(c == none, "i");
}

__test foldTemplateArray {
    let i = [1, 2, 3, 4];
    assert(i.fold!{|x,y| => x + y} () == 10);
    assert(i.fold!{|x,y| => x * y} () == 24);

    let j: [i32 ; 0] = [];
    cte assert(!__pragma!compile({
        j.fold!{|x,y| => x + y} ();
    }));
}

__test foldLambdaArray {
    let i = [1, 2, 3, 4];
    assert(i.fold(|x,y| => x + y) == 10);
    assert(i.fold(|x,y| => x * y) == 24);

    let j: [i32 ; 0] = [];
    cte assert(!__pragma!compile({
        j.fold(|x,y| => x + y);
    }));
}

__test foldClosureArray {
    let i = [1, 2, 3, 4];
    let z = 2;

    let a = i.fold(copy |x,y| => x + y + z); // 1 + (2 + 2) + (3 + 2) + (4 + 2)
    let b = i.fold(copy |x,y| => {
        if (y % z == 1) { x + y } else { x }
    }); // 1 + 3

    assert(a == 16);
    assert(b == 4);

    let j: [i32 ; 0] = [];
    cte assert(!__pragma!compile({
        j.fold(copy |x,y| => x + y + z);
    }));
}

__test iterCollect {
    let a = copy [1, 2, 3];
    assert(a.iter().collect() == [1, 2, 3], "a");

    let b = [1, 2, 3];
    assert(b.iter().collect() == [1, 2, 3], "b");

    let e = a[0 .. 0];
    assert(e.iter().collect().len == 0us, "c");
}

__test generatorIsSinglePass {
    let a = copy [1, 2, 3];
    let g = a.iter();

    assert(g.collect() == [1, 2, 3], "a");
    assert(g.collect().len == 0us, "b");
}

__test eachSlice {
    let a = copy [1, 2, 3];
    let dmut acc = copy [0, 0];
    a.each(copy |x| => { acc[0] += x; acc[1] += 1; });

    assert(acc == [6, 3], "a");

    let e = a[0 .. 0];
    let dmut none_ = copy [0];
    e.each(copy |x| => { none_[0] += x; });
    assert(none_[0] == 0, "b");
}

__test eachArray {
    let a = [1, 2, 3];
    let dmut acc = copy [0, 0];
    a.each(copy |x| => { acc[0] += x; acc[1] += 1; });

    assert(acc == [6, 3], "a");
}

__test eachGenerator {
    let a = copy [1, 2, 3];
    let dmut acc = copy [0, 0];
    a.iter().each(copy |x| => { acc[0] += x; acc[1] += 1; });

    assert(acc == [6, 3], "a");
}

__test mapSlice {
    let a = copy [1, 2, 3];
    assert(a.map!{|x| => x * 2} ().collect() == [2, 4, 6], "a");
    assert(a.map(|x: i32|-> i32 => x * 2).collect() == [2, 4, 6], "b");
    assert(a.map!{i32} (|x| => x * 2).collect() == [2, 4, 6], "c");

    let z = 10;
    assert(a.map(copy |x: i32|-> i32 => x * z).collect() == [10, 20, 30], "d");

    let e = a[0 .. 0];
    assert(e.map!{|x| => x * 2} ().collect().len == 0us, "e");

    // the result type does not have to be the element type
    assert(a.map!{|x| => cast!f64(x)} ().collect() == [1.0, 2.0, 3.0], "f");
}

__test mapArray {
    let a = [1, 2, 3];
    assert(a.map!{|x| => x * 2} ().collect() == [2, 4, 6], "a");
    assert(a.map(|x: i32|-> i32 => x * 2).collect() == [2, 4, 6], "b");
}

__test mapGenerator {
    let a = copy [1, 2, 3];
    assert(a.iter().map!{|x| => x * 2} ().collect() == [2, 4, 6], "a");
    assert(a.iter().map(|x: i32|-> i32 => x * 2).collect() == [2, 4, 6], "b");
    assert(a.map!{|x| => x * 2} ().map!{|x| => x + 1} ().collect() == [3, 5, 7], "c");

    let e = a[0 .. 0];
    assert(e.iter().map!{|x| => x * 2} ().collect().len == 0us, "d");
}

__test mapIsLazy {
    let a = copy [1, 2, 3];
    let dmut calls = copy [0];
    let g = a.map(copy |x: i32|-> i32 => { calls[0] += 1; x * 2 });

    assert(calls[0] == 0, "a");
    assert(g.next() == (2)?, "b");
    assert(calls[0] == 1, "c");
}

__test filterSlice {
    let a = copy [1, 2, 3, 4];
    assert(a.filter(|x| => x % 2 == 0).collect() == [2, 4], "a");
    assert(a.filter(|x| => x > 9).collect().len == 0us, "b");
    assert(a.filter(|x| => x > 0).collect() == [1, 2, 3, 4], "c");

    let z = 2;
    assert(a.filter(copy |x| => x > z).collect() == [3, 4], "d");
}

__test filterArray {
    let a = [1, 2, 3, 4];
    assert(a.filter(|x| => x % 2 == 0).collect() == [2, 4], "a");
}

__test filterGenerator {
    let a = copy [1, 2, 3, 4];
    assert(a.iter().filter(|x| => x % 2 == 0).collect() == [2, 4], "a");
    assert(a.filter(|x| => x > 1).filter(|x| => x < 4).collect() == [2, 3], "b");
}

__test filterMapSlice {
    let a = copy [1, 2, 3, 4];
    let r = a.filterMap!{|x| => { if (x % 2 == 0) { (x * 10)? } else { none } }} ();
    assert(r.collect() == [20, 40], "a");

    let z = 2;
    let r2 = a.filterMap(copy |x: i32|-> (i32)? => {
        if (x % z == 0) { (x * 10)? } else { none }
    });
    assert(r2.collect() == [20, 40], "b");

    let r3 = a.filterMap!{|x| => { if (x > 9) { (x)? } else { none } }} ();
    assert(r3.collect().len == 0us, "c");
}

__test filterMapArray {
    let a = [1, 2, 3, 4];
    let r = a.filterMap!{|x| => { if (x % 2 == 0) { (x * 10)? } else { none } }} ();
    assert(r.collect() == [20, 40], "a");

    let r2 = a.filterMap(|x: i32|-> (i32)? => { if (x % 2 == 0) { (x * 10)? } else { none } });
    assert(r2.collect() == [20, 40], "b");
}

__test filterMapGenerator {
    let a = copy [1, 2, 3, 4];
    let r = a.iter().filterMap!{|x| => { if (x % 2 == 0) { (x * 10)? } else { none } }} ();
    assert(r.collect() == [20, 40], "a");

    let r2 = a.iter().filterMap(|x: i32|-> (i32)? => { if (x % 2 == 0) { (x * 10)? } else { none } });
    assert(r2.collect() == [20, 40], "b");
}

__test flattenSlice {
    let a = copy [copy [1, 2], copy [3], copy [4, 5]];
    assert(a.flatten().collect() == [1, 2, 3, 4, 5], "a");

    let b = copy [copy [1], (copy [1])[0 .. 0], copy [2]];
    assert(b.flatten().collect() == [1, 2], "b");
}

__test flattenArray {
    let a = [copy [1, 2], copy [3]];
    assert(a.flatten().collect() == [1, 2, 3], "a");
}

__test flattenGenerator {
    let a = copy [copy [1, 2], copy [3], copy [4, 5]];
    assert(a.iter().flatten().collect() == [1, 2, 3, 4, 5], "a");
}

__test flatMapSlice {
    let a = copy [1, 2, 3];
    assert(a.flatMap!{|x| => copy [x, x * 10]} ().collect() == [1, 10, 2, 20, 3, 30], "a");

    let z = 10;
    assert(a.flatMap(copy |x: i32|-> [i32] => copy [x, x * z]).collect() == [1, 10, 2, 20, 3, 30], "b");
    assert(a.flatMap!{|x| => { let _ = x; copy [0 ; 0us] }} ().collect().len == 0us, "c");
}

__test flatMapArray {
    let a = [1, 2, 3];
    assert(a.flatMap!{|x| => copy [x, x * 10]} ().collect() == [1, 10, 2, 20, 3, 30], "a");
    assert(a.flatMap(|x: i32|-> [i32] => copy [x, x * 10]).collect() == [1, 10, 2, 20, 3, 30], "b");
}

__test flatMapGenerator {
    let a = copy [1, 2, 3];
    assert(a.iter().flatMap!{|x| => copy [x, x * 10]} ().collect() == [1, 10, 2, 20, 3, 30], "a");
    assert(a.iter().flatMap(|x: i32|-> [i32] => copy [x, x * 10]).collect() == [1, 10, 2, 20, 3, 30], "b");
}

__test uniqueSlice {
    let a = copy [1, 2, 1, 3, 2];
    assert(a.unique().collect() == [1, 2, 3], "a");

    let e = a[0 .. 0];
    assert(e.unique().collect().len == 0us, "b");
    assert((copy [1, 1, 1]).unique().collect() == [1], "c");
}

__test uniqueArray {
    let a = [1, 2, 1, 3, 2];
    assert(a.unique().collect() == [1, 2, 3], "a");
}

__test uniqueGenerator {
    let a = copy [1, 2, 1, 3, 2];
    assert(a.iter().unique().collect() == [1, 2, 3], "a");
    assert(a.map!{|x| => x % 2} ().unique().collect() == [1, 0], "b");
}

__test dedupSlice {
    let a = copy [1, 1, 2, 2, 2, 1];
    assert(a.dedup().collect() == [1, 2, 1], "a");

    let e = a[0 .. 0];
    assert(e.dedup().collect().len == 0us, "b");
    assert((copy [1, 2, 3]).dedup().collect() == [1, 2, 3], "c");
}

__test dedupArray {
    let a = [1, 1, 2, 2, 2, 1];
    assert(a.dedup().collect() == [1, 2, 1], "a");
}

__test dedupGenerator {
    let a = copy [1, 1, 2, 2, 2, 1];
    assert(a.iter().dedup().collect() == [1, 2, 1], "a");

    let e = a[0 .. 0];
    assert(e.iter().dedup().collect().len == 0us, "b");
}

__test reverseSlice {
    let a = copy [1, 2, 3];
    assert(a.reverse().collect() == [3, 2, 1], "a");

    let e = a[0 .. 0];
    assert(e.reverse().collect().len == 0us, "b");
    assert(a.reverse().reverse().collect() == [1, 2, 3], "c");
}

__test reverseArray {
    let a = [1, 2, 3];
    assert(a.reverse().collect() == [3, 2, 1], "a");
}

__test reverseGenerator {
    let a = copy [1, 2, 3];
    assert(a.map!{|x| => x * 2} ().reverse().collect() == [6, 4, 2], "a");

    let e = a[0 .. 0];
    assert(e.iter().reverse().collect().len == 0us, "b");
}
