in comparison;

use std::algorithm::comparison;

__test minMax {
    assert(min(1, 2) == 1);
    assert(min(9827, 8161) == 8161);
    assert(min(1u16, 2u16) == 1);
    assert(min(9827u64, 8161u64) == 8161);


    assert(min(2, 3, 1, 9, 4) == 1);
    assert(max(2, 3, 1, 9, 4) == 9);
}

__test clamp {
    assert(clamp(10, 5, 9) == 9);
    assert(clamp(3, 5, 9) == 5);
    assert(clamp(7, 5, 9) == 7);
}

__test among {
    let v = 1;
    assert(v.among('r', 2, "test", 1));
}

__test either {
    let x = either!{|x| => x > 2} (1, 2, 3);
    assert(x == (3)?);

    let y = either!{|x| => x > 3} (1, 2, 3);
    assert(y == none);
}

__test eqIgnoreCaseMatches {
    assert(eqIgnoreCase("GMT", "gmt"), "a");
    assert(eqIgnoreCase("Wednesday", "wEdNeSdAy"), "b");
    assert(eqIgnoreCase("", ""), "c");

    // only letters have a case, the other characters are compared as they are
    assert(eqIgnoreCase("+02:00", "+02:00"), "d");
    assert(!eqIgnoreCase("+02:00", "-02:00"), "e");

    // a text is never the same as a longer one
    assert(!eqIgnoreCase("a", "ab"), "f");
    assert(!eqIgnoreCase("gmt", "utc"), "g");

    // and it works on the wider character types too
    assert(eqIgnoreCase("Aug"s32, "aug"s32), "h");
}
