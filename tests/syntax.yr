use std::syntax::tokenizer;

__test tokenizeArray {
    let mut tzer = Tokenizer!{c8} (tokens-> ["(", ")", "=>", ",", " ", "="]);
    let str = "(x, y) => x = y";
    let lst = tzer.tokenize(str);
    assert(lst == ["(", "x", ",", " ", "y", ")", " ", "=>", " ", "x", " ", "=", " ", "y"]);
}

__test tokenizeSlice {
    let mut tzer = Tokenizer!{c8} (tokens-> copy ["(", ")", "=>", ",", " ", "="]);
    let str = "(x, y) => x = y";
    let lst = tzer.tokenize(str);
    assert(lst == ["(", "x", ",", " ", "y", ")", " ", "=>", " ", "x", " ", "=", " ", "y"]);
}

__test insertLongestMatch {
    let mut tzer = Tokenizer!{c8} ();
    tzer:.insert("+");
    tzer:.insert("+=");
    tzer:.insert(" ");

    let lst = tzer.tokenize("x += y");
    assert(lst == ["x", " ", "+=", " ", "y"]);
}


__test nextLength {
    let mut tzer = Tokenizer!{c8} (tokens-> ["+", " "]);
    let mut str = "fst + scd";
    let mut len = tzer.next(str)._0;
    assert(len == 3u64); // "fst"

    str = str[len .. $];
    len = tzer.next(str)._0;
    assert(len == 1u64); // " "

    str = str[len .. $];
    len = tzer.next(str)._0;
    assert(len == 1u64); // "+"

    str = str[len .. $];
    len = tzer.next(str)._0;
    assert(len == 1u64); // " "

    str = str[len .. $];
    len = tzer.next(str)._0;
    assert(len == 3u64); // "scd"

    str = str[len .. $];
    len = tzer.next(str)._0;
    assert(len == 0u64);
}

__test skipAndCommentFlags {
    let mut tzer = Tokenizer!{c8} (tokens-> ["+=", "+"]);
    tzer:.insert(" ", isSkip-> true);
    tzer:.insert("#", isComment-> "\n");

    let lst = tzer.tokenizeWithFlags("x += #");

    // Second token is a space token, and it was marked as skippable
    assert(lst[1]._0 == " " && lst[1]._1 == true);

    // Last token is '#' token, and it was flagged as being a comment, ending with '\n'
    assert(lst[$ - 1us]._0 == "#" && lst[$ - 1us]._2 == "\n");
}

/*!
 * ====================================================================================================
 * ====================================================================================================
 * =====================================          REGEX          ======================================
 * ====================================================================================================
 * ====================================================================================================
 */

use std::syntax::regex;
use std::syntax::errors;

__test regexMatches {
    let r = copy Regex("@[a-zA-Z0-9_]+");

    let lst = r.apply("@alice, @bob");
    assert(lst.len == 2us);
    assert(lst[0]._0 == 0us && lst[0]._1 == "@alice");
    assert(lst[1]._0 == 8us && lst[1]._1 == "@bob");

    let lst2 = r.apply("@charlie");
    assert(lst2.len == 1us);
    assert(lst2[0]._0 == 0us && lst2[0]._1 == "@charlie");
}

__test regexDigits {
    let r = copy Regex("[0-9]+");
    let lst = r.apply("a12b345");

    assert(lst.len == 2us);
    assert(lst[0]._0 == 1us && lst[0]._1 == "12");
    assert(lst[1]._0 == 4us && lst[1]._1 == "345");
}

__test regexEmptyMatch {
    // a pattern matching the empty string used to loop forever, one empty match
    // is reported per position, and the scan then steps over one char
    let r = copy Regex("[0-9]*");
    let lst = r.apply("abc");

    assert(lst.len == 4us);
    for i in 0us .. lst.len {
        assert(lst[i]._0 == i && lst[i]._1 == "");
    }
}

__test regexStarEmptyMatches {
    let r = copy Regex("a*");
    let lst = r.apply("baaac");

    assert(lst.len == 4us);
    assert(lst[0]._0 == 0us && lst[0]._1 == "");
    assert(lst[1]._0 == 1us && lst[1]._1 == "aaa");
    assert(lst[2]._0 == 4us && lst[2]._1 == "");
    assert(lst[3]._0 == 5us && lst[3]._1 == "");
}

__test regexEmptyText {
    let r = copy Regex("x?");
    let lst = r.apply("");

    assert(lst.len == 1us);
    assert(lst[0]._0 == 0us && lst[0]._1 == "");
}

__test regexEmptyMatchUtf8 {
    // stepping over an empty match must skip a whole utf8 code point, never land
    // in the middle of one ('é' is encoded on two c8)
    let r = copy Regex("x?");
    let lst = r.apply("éb");

    assert(lst.len == 3us);
    assert(lst[0]._0 == 0us);
    assert(lst[1]._0 == 2us);
    assert(lst[2]._0 == 3us);
}

__test regexCaretAnchorsText {
    // '^' anchors the beginning of the text, not the offset the scan resumes from
    let r = copy Regex("^a");
    let lst = r.apply("aaa");

    assert(lst.len == 1us);
    assert(lst[0]._0 == 0us && lst[0]._1 == "a");
}

__test regexCaretOnly {
    let r = copy Regex("^");
    let lst = r.apply("ab");

    assert(lst.len == 1us);
    assert(lst[0]._0 == 0us && lst[0]._1 == "");
}

__test regexUnclosedClass {
    let mut failed = false;
    {
        let _ = copy Regex("[unclosed");
    } catch {
        SyntaxError() => { failed = true; }
    }

    assert(failed);
}
