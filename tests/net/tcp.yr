in tcp;

use std::net::_;
use std::net::tcp::_;
use std::io;

use etc::c::files;
use etc::c::socket;

extern (C) fn _yrt_test_interrupt_then_write (fd: i32)-> *void;
extern (C) fn _yrt_test_interrupt_then_connect (port: u16)-> *void;
extern (C) fn _yrt_test_interrupter_join (handle: *void)-> void;

/**
 * @returns: true if the O_NONBLOCK flag is set on `fd`
 * */
fn isNonBlocking(fd: i32)-> bool {
    let flags = files::fcntl(fd, files::FileFlags::F_GETFL, 0u32);

    (flags & SocketFlag::O_NONBLOCK) != 0u32
}

/**
 * Bind a listener on the loopback, on the first free port of a small range
 * @info: `TcpListener` reports the address it was built with, never the one the kernel picked,
 *        so a port cannot be left to the kernel and has to be searched for instead
 * */
fn listenOnLoopback()-> dmut &TcpListener
    throws TcpError
{
    let mut last: (&TcpError)? = none;
    for i in 0u16 .. 16u16 {
        {
            return copy TcpListener(SockAddr(copy Ipv4Addr([127u8, 0u8, 0u8, 1u8]), 34567u16 + i));
        } catch {
            err: &TcpError => { last = err?; }
        }
    }

    if let Ok(err) = last { throw err; }

    throw copy TcpError(TcpErrorCode::BIND, "no free loopback port in the probed range");
}

__test connectKeepsBlocking { // MID-64: connect() switched the socket to O_NONBLOCK for its select() and never restored it
    {
        let dmut server = listenOnLoopback();

        let dmut client = TcpStream::connect(server.addr);
        assert(!isNonBlocking(client.getHandle()), "connect left the socket non blocking");

        let dmut accepted = server:.accept();
        client:.send("ping");
        assert(accepted:.receive!{[c8]} () == "ping", "round trip");

        client:.dispose();
        accepted:.dispose();
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test receiveRetriesWhenInterrupted { // MID-143: an EINTR from recv was taken for a closed connection
    {
        let dmut server = listenOnLoopback();
        let dmut client = TcpStream::connect(server.addr);
        let dmut accepted = server:.accept();

        let interrupter = _yrt_test_interrupt_then_write(client.getHandle());
        let byte = accepted:.receive!{u8} ();
        _yrt_test_interrupter_join(interrupter);

        assert(byte == 42u8, "a");

        client:.dispose();
        accepted:.dispose();
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}

__test acceptRetriesWhenInterrupted { // MID-143: an EINTR from accept was reported as a failed accept
    {
        let dmut server = listenOnLoopback();

        let interrupter = _yrt_test_interrupt_then_connect(server.addr.port);
        let dmut accepted = server:.accept();
        _yrt_test_interrupter_join(interrupter);

        assert(accepted.isOpen(), "a");
        accepted:.dispose();
    } catch {
        err => { println(err); assert(false, "threw"); }
    }
}
