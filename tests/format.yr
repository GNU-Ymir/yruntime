in format;

use std::format::_;

__test {
    let msg = format("Hello {}, {}", "a", ["a", "b"]);

    assert(msg == "Hello a, [a, b]");
}

__test {
    let msg = format("Hello {}, {}", "a", copy ["a", "b"]);

    assert(msg == "Hello a, [a, b]");
}

/**
 * The examples documented on std::format::format
 * */
__test {
    assert(format("i: {}, j: {}"s8, 89, "test"s8) == "i: 89, j: test"s8);
    assert(format("{:+<8}"s8, 12u32) == "12++++++"s8);
    assert(format("{:=<8+x}"s8, 12u32) == "+0xc===="s8);
    assert(format("{1:=>8}"s8, 89u32, 78u32) == "======78"s8);
    assert(format("{1:-^*}"s8, 8u32, 19u32) == "---19---"s8);
    assert(format("{1:+<*x} {0}"s8, 10, 255u32) == "0xff++++++ 10"s8);
    assert(format("{1:->10b} {0}"s8, "foo", 4u32) == "-----0b100 foo"s8);
    assert(format("{{} {0:}"s8, 9) == "{} 9"s8);
    assert(format("{} and {}"s8, 1, true) == "1 and true"s8);
}

/**
 * An alignment writes exactly 'width' chars, whatever the direction
 * */
__test {
    assert(format("{:.<6}"s8, 12) == "12...."s8);
    assert(format("{:.>6}"s8, 12) == "....12"s8);
    assert(format("{:.^6}"s8, 12) == "..12.."s8);
    assert(format("{:.^7}"s8, 12) == "..12..."s8);

    // a value wider than the alignment is not truncated
    assert(format("{:.^2}"s8, 12345) == "12345"s8);
}

/**
 * Every formatter of a format consumes an argument, whether or not it has a ':' specification
 * */
__test {
    assert(format("{} {:x} {}"s8, 1, 2, 3) == "1 0x2 3"s8);
    assert(format("{:x} {}"s8, 1, 2) == "0x1 2"s8);
    assert(format("{:+} {}"s8, 1, 2) == "+1 2"s8);

    // a '*' width consumes the argument placed before the value
    assert(format("{:^*} {}"s8, 4u32, 2, 3) == " 2   3"s8);

    // but an explicit index consumes nothing
    assert(format("{1} {} {}"s8, 1, 2) == "2 1 2"s8);
}
