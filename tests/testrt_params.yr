in testrt_params;

yield squares ()-> (i32, i32) {
    for i in 0 .. 6 {
        yield (i, i * i);
    }
}

@parameters (squares ())
__test square (i: i32, sq: i32) {
    assert(i * i == sq);
}

@parameters ((yield (i, i + 1) for i in 1 .. 4))
__test increasing (a: i32, b: i32) {
    assert(a < b);
}
